# =============================================================================
# Cloudflare Pages | Custom Response Headers
# =============================================================================
# Anything in this file ships with the deploy and Cloudflare applies the
# headers to matching routes. Documentation:
#   https://developers.cloudflare.com/pages/configuration/headers/
#
# Format:
#   /pattern
#     Header-Name: value
#     Other-Header: value
#
# Patterns use Cloudflare's match syntax. `/*` matches every route, which
# is what we want for security headers that should apply site-wide.
# =============================================================================


# -----------------------------------------------------------------------------
# Site-wide security headers
# -----------------------------------------------------------------------------
# These are the "easy wins" from a Lighthouse Trust & Safety audit. None of
# them require code changes; they just instruct the browser to behave more
# defensively.
# -----------------------------------------------------------------------------
/*
  # Force HTTPS for one year, including all subdomains. After this header
  # is seen once, the browser will refuse to connect over plain HTTP until
  # the max-age expires. `preload` is intentionally omitted: it requires
  # submission to https://hstspreload.org/ and is hard to reverse, so we
  # leave it off until we're confident in the configuration.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Refuse to be embedded in an iframe. Prevents clickjacking, where an
  # attacker overlays our site under a transparent layer on a malicious
  # page and tricks visitors into clicking through our UI.
  X-Frame-Options: DENY

  # Stop the browser from guessing MIME types based on content. If we send
  # a file with Content-Type: text/css, the browser must treat it as CSS
  # even if the bytes look like JavaScript. Closes a small attack vector
  # around MIME confusion.
  X-Content-Type-Options: nosniff

  # Trim what referrer info is sent to other origins. `strict-origin-when-
  # cross-origin` sends the full URL on same-origin navigation (useful for
  # internal analytics) and only the origin (no path) when leaving the
  # site. Default is `strict-origin-when-cross-origin` in modern browsers,
  # but stating it explicitly removes any doubt.
  Referrer-Policy: strict-origin-when-cross-origin

  # Cross-Origin-Opener-Policy. Isolates the top-level window from
  # documents loaded via window.open or as popups. Mostly defense-in-depth
  # for a static portfolio, but it's free and good hygiene.
  Cross-Origin-Opener-Policy: same-origin

  # Switch off browser features this site never uses, so a script that got in
  # somehow cannot ask for them either. An empty list means no one, not even us.
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

  # Content-Security-Policy, REPORT-ONLY: the browser logs what it would have
  # blocked and blocks nothing. What each source is for, how to read the reports
  # and how to start enforcing: docs/claude/deployment.md. Never rename this
  # header to enforce it without doing those checks.
  # The two hash markers in it are filled in by scripts/write-csp.mjs during the
  # build, with the hash of every inline script and style in dist/client.
  # Allowed from elsewhere: GA4 (googletagmanager, google-analytics) and the
  # Cloudflare beacon (cloudflareinsights). The contact form posts to the
  # site's own /api/contact/, so it needs only 'self'.
  # style-src-attr needs unsafe-inline because a client's colors arrive as
  # style="--c: ...; --p: ..." attributes, which hashes cannot cover. Style-src is
  # the fallback for browsers that do not know the two more exact directives.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__ https://static.cloudflareinsights.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; style-src-elem 'self' __CSP_STYLE_HASHES__; style-src-attr 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://cloudflareinsights.com https://www.google.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'


# -----------------------------------------------------------------------------
# Immutable, content-hashed build assets
# -----------------------------------------------------------------------------
# Everything Astro emits under /_astro/ carries a content hash in its filename
# (e.g. HeroCanvas.X9zOFzxX.js, a-font.woff2, an-image.webp), so the bytes for
# any given URL never change. Tell the browser it can keep these for a year and
# never revalidate. A content change ships a new filename, so this is safe and
# saves a round of requests on repeat visits and across pages. Lighthouse's
# "uses-long-cache-ttl" diagnostic flags these when the header is missing.
# -----------------------------------------------------------------------------
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The interaction clips (overhaul 3.5) carry a content hash too, e.g.
# /media/mas-monograms-studio.c68efbbe.mp4, written by npm run capture:clips.
# A re-recorded clip gets a new name, so a year of caching is safe here as well.
/media/*
  Cache-Control: public, max-age=31536000, immutable

# The footage, captures and the font sit in /assets/ under plain names, so they can
# change. A month of caching, revalidated after that.
/assets/*
  Cache-Control: public, max-age=2592000
