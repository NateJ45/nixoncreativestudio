{
  "name": "nixoncreativestudio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/free-dist.mjs",
    "build": "npm run placeholders && npm run og:pages && node scripts/with-workerd.mjs astro build",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "placeholders": "node scripts/generate-placeholders.mjs",
    "og": "node scripts/generate-og-default.mjs",
    "og:pages": "node scripts/generate-og.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "font-fallback": "node scripts/font-fallback.mjs",
    "free-dist": "node scripts/free-dist.mjs",
    "parity": "node scripts/page-parity.mjs",
    "sync-check": "node scripts/sync-check.mjs",
    "check": "astro check && npm run lint",
    "check:full": "npm run check && npm run test:unit && npm run build",
    "lint": "eslint src/**/*.{ts,tsx,astro} scripts/**/*.mjs",
    "lint:fix": "eslint --fix src/**/*.{ts,tsx,astro} scripts/**/*.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "node --experimental-strip-types --test src/lib/*.test.ts && npm run test:scripts",
    "test:scripts": "node --test scripts/lib/*.test.mjs",
    "test:copy": "node --test tests/unit/copy-rules.test.mjs",
    "capture:study": "node scripts/capture-case-study.mjs",
    "serve:dist": "http-server dist/client -p 4321 -s -c-1 --silent",
    "check:slashes": "node scripts/check-trailing-slash.mjs dist/client",
    "check:links": "linkinator ./dist/client --recurse --skip \"^https?://(?!(localhost|127[.]0[.]0[.]1)[:/])\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/partytown": "^2.1.9",
    "@astrojs/react": "^7.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/bebas-neue": "^5.3.0",
    "@tabler/icons": "^3.50.0",
    "@tabler/icons-react": "^3.50.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "astro-expressive-code": "^0.44.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.62.0",
    "motion": "^14.7.1",
    "next-themes": "^0.4.6",
    "plaiceholder": "^3.0.0",
    "primereact": "^10.9.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-photo-album": "^3.6.2",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "http-server": "^14.1.1",
    "linkinator": "^8.1.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "external-editor": {
      "tmp": "^0.2.6"
    }
  }
}
