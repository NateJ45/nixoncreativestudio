{
  "name": "nixoncreativestudio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/free-dist.mjs",
    "build": "npm run placeholders && npm run og:pages && astro build",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "placeholders": "node scripts/generate-placeholders.mjs",
    "og": "node scripts/generate-og-default.mjs",
    "og:pages": "node scripts/generate-og.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "free-dist": "node scripts/free-dist.mjs",
    "parity": "node scripts/page-parity.mjs",
    "sync-check": "node scripts/sync-check.mjs",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "lint": "eslint src/**/*.{ts,tsx,astro} scripts/**/*.mjs",
    "lint:fix": "eslint --fix src/**/*.{ts,tsx,astro} scripts/**/*.mjs",
    "format": "prettier --write .",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/react": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@react-three/fiber": "^9.7.0",
    "@tabler/icons": "^3.46.0",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.3.1",
    "astro-expressive-code": "^0.44.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.39.0",
    "motion": "^12.40.0",
    "next-themes": "^0.4.6",
    "plaiceholder": "^3.0.0",
    "primereact": "^10.9.8",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-photo-album": "^3.6.1",
    "shadcn": "^4.19.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^1.7.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.69.0",
    "wrangler": "^4.128.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "external-editor": {
      "tmp": "^0.2.6"
    }
  }
