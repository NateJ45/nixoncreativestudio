{
  // EMDASH TRIAL: separate Worker name so it never touches the live
  // nixoncreativestudio Worker. Lives on branch `emdash-trial`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ncs-emdash-trial",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ncs-emdash",
      "database_id": "e644f610-ae29-457c-ac97-14242b2d145b",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ncs-emdash-media" }],
  // Astro sessions (EmDash sign-in needs them). The Cloudflare adapter's default
  // session driver reads a KV binding named SESSION.
  "kv_namespaces": [{ "binding": "SESSION", "id": "73be142f7c43431ea65bd7f4211543b8" }],
  "worker_loaders": [{ "binding": "LOADER" }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
}
