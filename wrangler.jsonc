{
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "nixoncreativestudio",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve dist/client/404.html (with a 404 status) for any path that has no
    // file. Without this, Cloudflare answers an unknown URL with an empty body,
    // so a mistyped or old link showed a blank page instead of src/pages/404.astro.
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  // The contact form's own endpoint (src/contact-endpoint.ts, PORTS.md card 45):
  // every inquiry is stored here BEFORE the email is tried. Schema:
  // migrations/0001_contact_submissions.sql, applied with
  //   npx wrangler d1 migrations apply nixoncreativestudio-contact --remote
  // Read the latest rows (notified = 0 means the email did not go out):
  //   npx wrangler d1 execute nixoncreativestudio-contact --remote --command "SELECT id, received_at, name, email, notified, notify_error FROM contact_submissions ORDER BY id DESC LIMIT 10"
  "d1_databases": [
    {
      "binding": "CONTACT_DB",
      "database_name": "nixoncreativestudio-contact",
      "database_id": "c83c1426-f3c6-4158-b4e5-46223a42185c",
      "migrations_dir": "migrations",
    },
  ],
  // Cloudflare Email Sending, from the nixoncreativestudio.com sending domain
  // (cf-bounce subdomain, so Google Workspace keeps the root MX). WEB3FORMS_KEY,
  // the fallback transport, is a Worker secret:
  //   npx wrangler secret put WEB3FORMS_KEY
  "send_email": [{ "name": "EMAIL" }],
  // Both addresses are public (the site prints the first), so they are plain vars.
  "vars": {
    "CONTACT_TO": "nathan@nixoncreativestudio.com",
    "CONTACT_FROM": "website@nixoncreativestudio.com",
  },
}
