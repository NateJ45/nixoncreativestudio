    "set": {
      "featured": false,
      "year": 2026,
      "role": "Designer, Developer",
      "summary": "A new site for First Baptist Church Muncie, built around the church's own building and people, with all 142 posts from its Wix site carried across. Finished, and launching soon.",
      "description": "I rebuilt the church's Wix site on Astro, Sanity and Cloudflare Workers. The design takes its shapes from the building: the lancet window and the Adams Street door frame the photographs, and four line glyphs drawn from the sanctuary mark the church's four goals. Staff edit every page in place, and the service time and address are entered once.",
      "outcome": "Launching soon. The new site is finished and waits on the church to move fbcmuncie.org over to it.",
      "results": [
        {
          "text": "All 142 posts from the Wix site kept at their original addresses"
        },
        {
          "text": "Staff click the words on a page to edit them, with a live preview before publishing"
        },
        {
          "text": "The service time, address and main links are entered once and appear everywhere"
        },
        {
          "text": "Giving and forms link out to the church's own systems, not a second copy on the site"
        }
      ],
      "designer_note": "My first pass at this site was tidy and forgettable, and I set it aside. The second started from the building itself: the window, the door and the 1927 Hannaford rendering carry the design, so the site could only belong to this congregation.",
      "body": [
        {
          "_type": "block",
          "_key": "k1",
          "style": "h2",
          "markDefs": [],
          "children": [
