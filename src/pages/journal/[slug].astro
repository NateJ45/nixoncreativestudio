---
// Safe to edit. Dynamic journal entry page: one per MDX file in src/content/journal/.
/* ============================================================================
   /journal/{slug} | A journal entry
   ============================================================================
   The page head, then the entry in the legal pages' reading measure. Drafts build
   in `astro dev` only. Article JSON-LD comes through BaseLayout.
   ============================================================================ */
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import '../../styles/pages/legal.css';
import '../../styles/pages/sub.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Closing from '../../components/Closing.astro';
import { site } from '../../data/site';
import { ids, pageIds } from '../../lib/schema';
import { readingTime } from '../../lib/readingTime';
import { plainText, wordSpans } from '../../lib/words';

export async function getStaticPaths() {
  const entries = await getCollection('journal', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  );
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, published, updated, cover } = entry.data;

const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const canonical = new URL(`/journal/${entry.id}/`, site.url).toString();
const coverImage = cover ? await getImage({ src: cover, width: 1200, format: 'jpg' }) : undefined;
const schemas = [
  {
    '@type': 'Article',
    '@id': pageIds(canonical).article,
    headline: title,
    description: summary,
    url: canonical,
    mainEntityOfPage: { '@id': pageIds(canonical).webpage },
    datePublished: published.toISOString(),
    ...(updated ? { dateModified: updated.toISOString() } : {}),
    author: { '@id': ids.person },
    publisher: { '@id': ids.studio },
    ...(coverImage ? { image: new URL(coverImage.src, site.url).toString() } : {}),
  },
];
---

<BaseLayout
  title={`${title} | ${site.studioName}`}
  description={summary}
  ogType="article"
  ogImage={coverImage?.src}
  schemas={schemas}
  breadcrumbs={[
    { name: 'Journal', path: '/journal/' },
    { name: title, path: `/journal/${entry.id}/` },
  ]}
>
  <header class="page-head">
    <h1 aria-label={plainText(title)} set:html={wordSpans(title)} />
    <p class="lede">{summary}</p>
    <p class="updated">
      <time datetime={published.toISOString().slice(0, 10)}>{fmt.format(published)}</time>,{' '}
      {readingTime(entry.body ?? '')} min read
    </p>
  </header>
  {coverImage && (
    <figure class="photo-card sub-cover">
      <img src={coverImage.src} alt="" />
    </figure>
  )}
  <div class="doc sub-doc">
    <div class="prose">
      <Content />
    </div>
  </div>
  <Closing />
</BaseLayout>
