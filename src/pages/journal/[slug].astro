---
// Foundation, edit with care. Renders every journal entry from the CMS
// `posts` collection; layout changes here apply to every entry.
/* ============================================================================
   /journal/[slug] | Journal Entry Detail
   ============================================================================
   One server-rendered page per PUBLISHED journal entry (the CMS
   `posts` collection, Journal in the admin; looked up per request through
   src/lib/journal.ts). An unknown slug, a draft and an entry that cannot be read
   all get the site 404, never cached, so a draft is never visible here.
   Lighter-weight than the case study detail layout: single column, no service
   badges, no sidebar TOC. The reading progress bar and reading time stamp from
   the case study toolkit still apply because long journal posts deserve the
   same QoL.

   The body is Portable Text, turned into HTML by renderJournalBody() in
   src/lib/journalBody.ts (not by emdash/ui's PortableText, whose stylesheet
   would load on the homepage too; see that file). h2 and h3 get ids from their
   text so the heading anchors work as on case studies, and code blocks are
   plain monospace boxes (the old MDX journal used expressive-code, which
   Portable Text has no step for). Pictures in the body are not drawn yet.

   Bands: window-light under the header (title, summary, a caption line, the cover
   as a printed frame), paper for the reading column, then the closing banner. The
   caption line (date, reading time, tags) is sentence-case UI sans, never mono
   caps. The body is an editorial reading surface: a Bebas drop-cap on the first
   paragraph, scroll-revealed h2 headings, a serif-italic pull-quote for
   blockquotes, and figures printed with the frame shadow. The cover wrapper carries a shared
   transition:name so it morphs from the index card during a View
   Transition. All motion is reduced-motion safe via globals.css.

   OG image: the generated card at /og/journal/<slug>.png (BaseLayout's default
   for the path). A card exists for every entry published before the last deploy
   (scripts/generate-og.mjs reads /rss.xml); one published after it shows no card
   until the next deploy, the same as a new case study.
   ============================================================================ */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Band from '../../components/Band.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import ReadingProgress from '../../components/ReadingProgress';
import EmDashPhoto from '../../components/emdash/EmDashPhoto.astro';
import { SITE_URL, getSite } from '../../data/site';
import { formatJournalDate, getJournalEntry } from '../../lib/journal';
import { renderJournalBody } from '../../lib/journalBody';
import { mediaUrl } from '../../lib/photos';

const site = await getSite(Astro);
const entry = await getJournalEntry(Astro.params.slug ?? '', { cache: Astro.cache });
if (!entry) {
  // Real 404 status, rendered with the site's 404 page, never cached.
  Astro.cache.set(false);
  return new Response(null, { status: 404 });
}
const { title, summary, publishedAt, updated, cover, tags, minutes } = entry;

const publishedLabel = formatJournalDate(publishedAt, true);
const updatedLabel = updated ? formatJournalDate(updated, true) : null;

// The body as HTML: paragraphs, h2/h3 with ids, quotes, lists, code blocks (src/lib/journalBody.ts).
const bodyHtml = renderJournalBody(entry.body);

// The cover's stored original, on the canonical origin, for the Article's image.
const coverUrl = cover ? mediaUrl(cover, SITE_URL) : undefined;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description: summary,
    ...(coverUrl ? { image: coverUrl } : {}),
    datePublished: publishedAt.toISOString(),
    ...(updated ? { dateModified: updated.toISOString() } : {}),
    author: { '@id': `${SITE_URL}#organization` },
    publisher: { '@id': `${SITE_URL}#organization` },
    ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
  },
];
---

<BaseLayout
  title={`${title} | ${site.studioName}`}
  description={summary}
  ogType="article"
  schemas={schemas}
>
  <ReadingProgress client:idle />

  <article>
    <Band ground="window-light" underHeader labelledby="journal-entry-heading">
      <div class="entry-head">
        <a class="card-link back-link" href="/journal/">
          Journal
        </a>

        <h1 id="journal-entry-heading" class="type-display entry-title">
          {title}
        </h1>
        <p class="type-lede">{summary}</p>
        <p class="type-caption">
          {publishedLabel} · {minutes} min read
          {updatedLabel && updatedLabel !== publishedLabel && <> · Updated {updatedLabel}</>}
          {tags.length > 0 && <> · {tags.join(', ')}</>}
        </p>

        {cover && (
          <div class="entry-cover" transition:name={`journal-cover-${entry.id}`}>
            <EmDashPhoto
              image={cover}
              alt=""
              widths={[600, 900, 1200]}
              sizes="(min-width: 56rem) 64rem, 92vw"
              class="entry-img"
            />
          </div>
        )}
      </div>
    </Band>

    <Band tight>
      {/* Editorial reading surface. Prose styling lives in the scoped wrapper
           below so the entry body renders as a designed article. */}
      <div data-prose class="journal-prose" set:html={bodyHtml} />

      {tags.length > 0 && (
        <footer class="entry-foot" data-reveal>
          <p class="type-caption">Filed under {tags.join(', ')}.</p>
          <a class="card-link" href="/journal/">
            All entries
          </a>
        </footer>
      )}
    </Band>
  </article>

  <CtaBanner ctaHref="/contact/" />
</BaseLayout>

<style>
  .entry-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-m);
    max-width: 64rem;
  }
  .entry-title {
    font-size: var(--text-h1);
    max-width: 22ch;
  }
  .entry-cover {
    align-self: stretch;
    margin-top: var(--spacing-m);
    overflow: hidden;
    border-radius: 2px;
    background: var(--paper-deep);
    box-shadow: var(--shadow-frame);
  }
  .entry-cover :global(.entry-img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .entry-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-s) var(--spacing-l);
    max-width: 72ch;
    margin: var(--spacing-l) auto 0;
    padding-top: var(--spacing-m);
    border-top: 1px solid var(--border);
  }

  /* ==========================================================================
     Journal prose styling
     ==========================================================================
     Scoped to .journal-prose so it only dresses the entry body, never the
     chrome around it. Astro's <style> is component-scoped, so the child
     selectors need :global() to reach the HTML renderJournalBody() emits.
     ========================================================================== */
  .journal-prose {
    max-width: 72ch;
    margin-inline: auto;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.7;
    color: var(--foreground);
  }

  /* Headings inside the body. h2 is the main subsection level; h3 a step below. */
  .journal-prose :global(h2) {
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-s);
    scroll-margin-top: var(--spacing-l);
    font-size: var(--text-h3);
    line-height: 1;
    color: var(--heading);
  }
  .journal-prose :global(h2:first-child) {
    margin-top: 0;
  }
  .journal-prose :global(h3) {
    margin-top: var(--spacing-l);
    margin-bottom: var(--spacing-xs);
    font-size: var(--text-h4);
    line-height: 1.05;
    color: var(--heading);
  }

  .journal-prose :global(p) {
    margin-bottom: var(--spacing-m);
  }

  /* Drop-cap on the lead paragraph. Guarded to p:first-child (not :first-of-type)
     so it only fires when a paragraph is the very first element in the body. */
  .journal-prose > :global(p:first-child::first-letter) {
    float: left;
    margin: 0.05em 0.12em 0 0;
    font-family: var(--font-display);
    font-size: 3.6em;
    line-height: 0.7;
    color: var(--marker);
  }

  .journal-prose :global(ul) {
    margin-bottom: var(--spacing-m);
    padding-left: 1.25rem;
    list-style: disc;
  }
  .journal-prose :global(ol) {
    margin-bottom: var(--spacing-m);
    padding-left: 1.25rem;
    list-style: decimal;
  }
  .journal-prose :global(li) {
    margin-bottom: 0.35rem;
  }

  .journal-prose :global(a) {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: text-underline-offset 0.15s ease;
  }
  .journal-prose :global(a:hover) {
    text-underline-offset: 4px;
  }

  /* Pull-quote: the serif italic second voice, set large, with no side rule and no
     decorative glyph. A Markdown `>` and a Portable Text quote both land here. */
  .journal-prose :global(blockquote) {
    margin: var(--spacing-l) auto;
    max-width: 56ch;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.8rem);
    font-style: italic;
    line-height: 1.35;
    color: var(--marker);
  }
  .journal-prose :global(blockquote p) {
    margin-bottom: 0.5rem;
  }
  .journal-prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  /* A cite line inside a quote reads as the attribution: caption sans, muted. */
  .journal-prose :global(blockquote cite) {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    font-style: normal;
    color: var(--muted-foreground);
  }

  /* Figures and images in the body: printed with the frame shadow, caption beneath. */
  .journal-prose :global(figure) {
    margin: var(--spacing-l) 0;
  }
  .journal-prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
    box-shadow: var(--shadow-frame);
  }
  .journal-prose :global(figcaption) {
    margin-top: 0.75rem;
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    color: var(--muted-foreground);
  }

  .journal-prose :global(hr) {
    margin: var(--spacing-l) 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  /* Inline code and code blocks (blocks are plain monospace boxes, see
     src/lib/journalBody.ts). Code is the one place monospace belongs. */
  .journal-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  .journal-prose :global(pre) {
    margin-bottom: var(--spacing-m);
    overflow-x: auto;
    border-radius: 2px;
    background: var(--paper-deep);
    padding: 1rem 1.25rem;
  }
</style>

<script>
  // Scroll-reveal for the body's h2 headings. The Portable Text body renders raw
  // HTML, so the headings can't carry data-reveal in source. This tags each
  // h2 in the prose wrapper after the DOM is ready, letting the shared
  // reveal observer in BaseLayout.astro fade them in as they scroll into
  // view. Runs on first load and after every View Transition so the effect
  // survives client-side navigation between journal entries.
  function tagJournalHeadings() {
    document
      .querySelectorAll('.journal-prose h2:not([data-reveal])')
      .forEach((h) => h.setAttribute('data-reveal', ''));
  }

  tagJournalHeadings();
  document.addEventListener('astro:page-load', tagJournalHeadings);
</script>
