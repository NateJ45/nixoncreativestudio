---
// Safe to edit. The page wiring is foundation; the copy comes from the CMS.
/* ============================================================================
   /journal | Journal Index
   ============================================================================
   Listing for the journal (the CMS `posts` collection). Newest first, published
   entries only (a draft is never listed), one card per entry.

   Bands (DESIGN.md "Grounds"; one moving ground per page, at the top):
     1. window-light (moving, under the header): the headline and intro. With no
        entries it also holds a printed note card (the same card as the rate card
        on /photography): what is coming and where to go meanwhile.
     2. paper (only with entries): the newest entry large, the rest in a grid.
     3. paper-contours: the closing banner.

   Two paths share this page:
     1. Empty state. The live state until the first entry publishes. There is no
        placeholder entry and no "coming soon" mark: a plain note, and two ways onward
        so the page is never a dead end. (The Journal link is also hidden from the
        menus until there is an entry, see hasJournalEntries().)
     2. Populated list. The lead entry gets the most weight; each entry shows its
        cover (when it has one) as a printed frame, its date and reading time in the
        caption type, and its tags as plain words.

   The words (headline, intro, the empty-state note) are the Journal page entry in
   the CMS, with the committed fallback in cms/content/page_journal.json. The entries
   are read through src/lib/journal.ts (CMS-DESIGN PR 12). A failed read gives an empty
   list, not an error page.
   ============================================================================ */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Band from '../../components/Band.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import EmDashPhoto from '../../components/emdash/EmDashPhoto.astro';
import { buttonVariants } from '../../components/ui/button';
import { getSite } from '../../data/site';
import { getJournalPage, indexTitle } from '../../lib/indexPages';
import { formatJournalDate, getJournalEntries } from '../../lib/journal';

const site = await getSite(Astro);
const page = await getJournalPage(Astro);
const all = await getJournalEntries({ cache: Astro.cache });

// The newest entry is the lead; slicing an array of length 0 or 1 is safe.
const [lead, ...rest] = all;
---

<BaseLayout title={indexTitle(page.seoTitle, site.studioName)} description={page.seoDescription}>
  <Band ground="window-light" underHeader labelledby="journal-heading">
    <div class:list={['hero-grid', { 'hero-grid--note': all.length === 0 }]}>
      <header class="hero-copy">
        <h1 id="journal-heading" class="type-display">
          {page.heading}
        </h1>
        <p class="type-lede">{page.intro}</p>
      </header>

      {all.length === 0 && (
        <div class="note">
          <p class="note-kicker voice">{page.emptyKicker}</p>
          <h2 class="note-title type-headline">{page.emptyHeading}</h2>
          <p class="type-body">{page.emptyBody}</p>
          <div class="note-actions">
            <a href="/work/" class={buttonVariants({ variant: 'brand', size: 'cta' })}>
              See selected work
            </a>
            <a class="card-link" href="/contact/">
              Say hello
            </a>
          </div>
        </div>
      )}
    </div>
  </Band>

  {lead && (
    <Band labelledby="entries-heading">
      <h2 id="entries-heading" class="sr-only">
        All entries
      </h2>

      {/* The lead entry. The whole card is one link, so the target covers the
             cover and the words together. */}
      <a class="entry entry--lead" href={`/journal/${lead.id}/`} data-reveal>
        {lead.cover && (
          <div class="entry-cover" transition:name={`journal-cover-${lead.id}`}>
            <EmDashPhoto
              image={lead.cover}
              alt=""
              widths={[600, 900, 1200]}
              sizes="(min-width: 64rem) 55vw, 92vw"
              class="entry-img"
            />
          </div>
        )}
        <div class="entry-text">
          <p class="type-caption">
            {formatJournalDate(lead.publishedAt)} · {lead.minutes} min read
            {lead.tags.length > 0 && <> · {lead.tags.join(', ')}</>}
          </p>
          <h2 class="entry-title entry-title--lead">{lead.title}</h2>
          <p class="type-body">{lead.summary}</p>
          <span class="card-link">Read on</span>
        </div>
      </a>

      {rest.length > 0 && (
        <ul class="entry-grid">
          {rest.map((entry, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 90}ms`}>
              <a class="entry" href={`/journal/${entry.id}/`}>
                {entry.cover && (
                  <div class="entry-cover" transition:name={`journal-cover-${entry.id}`}>
                    <EmDashPhoto
                      image={entry.cover}
                      alt=""
                      widths={[400, 600, 900]}
                      sizes="(min-width: 60rem) 33vw, (min-width: 40rem) 50vw, 92vw"
                      class="entry-img"
                    />
                  </div>
                )}
                <div class="entry-text">
                  <p class="type-caption">
                    {formatJournalDate(entry.publishedAt)} · {entry.minutes} min read
                    {entry.tags.length > 0 && <> · {entry.tags.join(', ')}</>}
                  </p>
                  <h2 class="entry-title">{entry.title}</h2>
                  <p class="type-body">{entry.summary}</p>
                  <span class="card-link">Read on</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </Band>
  )}

  <CtaBanner title={page.ctaTitle} sub={page.ctaSub} ctaHref="/contact/" />
</BaseLayout>

<style>
  /* ---- hero ---- */
  .hero-grid {
    display: grid;
    gap: var(--spacing-xl);
    align-items: end;
  }
  @media (min-width: 64rem) {
    .hero-grid--note {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-m);
  }

  /* The empty-state note: a printed card, like the rate card on /photography. */
  .note {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-s);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 2px;
    box-shadow: var(--shadow-print);
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .note-kicker {
    font-size: var(--text-h4);
  }
  .note-title {
    font-size: var(--text-h3);
  }
  .note-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-s) var(--spacing-l);
    margin-top: var(--spacing-xs);
  }

  /* ---- entries ---- */
  .entry {
    display: grid;
    gap: var(--spacing-m);
    color: inherit;
    text-decoration: none;
  }
  .entry--lead {
    align-items: center;
  }
  @media (min-width: 64rem) {
    .entry--lead {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--spacing-xl);
    }
  }
  .entry-cover {
    overflow: hidden;
    box-shadow: var(--shadow-frame);
    background: var(--paper-deep);
    border-radius: 2px;
  }
  .entry-cover :global(.entry-img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.5s var(--ease-settle);
  }
  .entry:hover :global(.entry-img),
  .entry:focus-visible :global(.entry-img) {
    transform: scale(1.02);
  }
  .entry-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-xs);
  }
  .entry-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-h3);
    line-height: 0.98;
    letter-spacing: 0.01em;
    color: var(--heading);
    transition: color 0.15s ease;
  }
  .entry-title--lead {
    font-size: var(--text-h2);
  }
  .entry:hover .entry-title,
  .entry:focus-visible .entry-title {
    color: var(--link);
  }
  .entry-grid {
    display: grid;
    gap: var(--spacing-xl) var(--spacing-l);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    list-style: none;
    margin: var(--spacing-xl) 0 0;
    padding: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .entry-cover :global(.entry-img) {
      transition: none;
    }
    .entry:hover :global(.entry-img),
    .entry:focus-visible :global(.entry-img) {
      transform: none;
    }
  }
</style>
