---
// Safe to edit. The page wiring is foundation; the copy at the top is safe to swap.
/* ============================================================================
   /journal | Journal index
   ============================================================================
   Listing for the journal collection, newest first, with drafts left out of
   production builds (the same filter src/data/nav.ts uses to gate the Journal
   link, so the link appears with the first published entry). Ruled rows with
   hairlines, not cards. Empty state (the live state today): one plain line and
   two onward links.
   ============================================================================ */

import { getCollection } from 'astro:content';
import '../../styles/pages/sub.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Closing from '../../components/Closing.astro';
import { readingTime } from '../../lib/readingTime';
import { plainText, wordSpans } from '../../lib/words';

const entries = (
  await getCollection('journal', ({ data }) =>
    // Drop drafts in production. import.meta.env.PROD is true on `astro build`,
    // false on `astro dev`, so drafts stay visible locally.
    import.meta.env.PROD ? data.draft !== true : true,
  )
).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const fmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const heading = 'Notes from <b>the studio.</b>';
---

<BaseLayout
  title="Journal | Nixon Creative Studio"
  description="Short essays, process notes and field reports from Nixon Creative Studio, on web design, brand work and photography for churches, schools and nonprofits."
>
  <header class="page-head">
    <h1 aria-label={plainText(heading)} set:html={wordSpans(heading)} />
    <p class="lede">
      Short notes from the studio: process, opinions, the occasional field report. Updated whenever
      there's something worth writing down.
    </p>
  </header>
  <section class="sec tight" aria-label="Journal entries">
    {entries.length === 0 ? (
      <p class="sub-empty">
        Nothing's published yet. This is where I'll write down how the studio works: the thinking
        behind a build, notes from a shoot, the small decisions that add up. Until then, the{' '}
        <a href="/work/">case studies</a> show the work, and you can always{' '}
        <a href="/contact/">say hello</a>.
      </p>
    ) : (
      <ol class="sub-rows">
        {entries.map((entry) => (
          <li>
            <p class="label">
              <time datetime={entry.data.published.toISOString().slice(0, 10)}>
                {fmt.format(entry.data.published)}
              </time>
              , {readingTime(entry.body ?? '')} min read
            </p>
            <h2>
              <a href={`/journal/${entry.id}/`}>{entry.data.title}</a>
            </h2>
            <p>{entry.data.summary}</p>
          </li>
        ))}
      </ol>
    )}
  </section>
  <Closing />
</BaseLayout>
