---
/* ============================================================================
   /services | Prices
   ============================================================================
   The nav calls it Prices; the URL stays /services/ for search.

   PRICING LIVES IN src/data/pricing.ts. The tiers, the picker, the add-ons, the
   care table, the FAQ answers and the JSON-LD offers all read it (money() and
   dollars() in src/lib/money.ts), so a price changes there and nowhere else.
   tests/metadata.spec.ts checks every JSON-LD offer is printed on the page, and
   the FAQPage is built from the same list the page renders.

   src/scripts/prices.js adds the motion: three questions that suggest a tier, the
   tiers that lift, the folding rows. Without it everything is simply open and
   every link works.
   ============================================================================ */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/prices.css';
import Tile from '../components/Tile.astro';
import Caption from '../components/Caption.astro';
import Closing from '../components/Closing.astro';
import { site } from '../data/site';
import {
  webTiers as tiers,
  addOns,
  carePlans,
  customWorkRate,
  freeToMove,
  perWords,
  pricesAsOf,
} from '../data/pricing';
import { SITUATIONS, sectorPagePath } from '../data/sector-pages';
import { getClients } from '../lib/clients';
import { dollars, money } from '../lib/money';
import { tierCosts } from '../lib/tier-costs';
import { addOnNamed, addOnOffer, careOffers, ids, tierOffers } from '../lib/schema';
import { plainText, wordSpans } from '../lib/words';

const launch = tiers[0];
const signature = tiers.find((t) => t.highlighted) ?? tiers[1];
const flagship = tiers[tiers.length - 1];
const [signatureLow, signatureHigh] = dollars(signature.range);
const [hosting, lightCare, care, carePlus] = carePlans;
// One rate for extra changes on Hosting, one on any care plan, and one for custom development.
const hourlyRate = hosting.rate;
const careRate = lightCare.rate;
const rateLine = `Rate for extra changes: ${money(hourlyRate)} an hour on ${hosting.name}, ${money(careRate)} an hour on any care plan.`;
const photography = addOnNamed(addOns, 'Photography');
const brandStrategy = addOnNamed(addOns, 'Brand & strategy');
// "$200 per year", "$59 per month": a unit on every recurring price, in words.
const perUnit = (period: string) => perWords(period).replace(/^a /, 'per ');

// What the three questions suggest: read by src/scripts/prices.js.
const pickTiers = tiers.map((t) => ({
  name: t.name,
  from: money(t.priceFrom),
  range: `${t.range}.`,
}));

// The honest sums, computed from pricing.ts: year one Hosting is included; care is billed from month one.
// Flagship has no Hosting-only row: custom tools need Care or Care+.
const costs = tierCosts();
// The cost bars share one scale, the largest five-year total, so their lengths compare honestly.
const barMax = Math.max(...costs.map((c) => c.usual.fiveYears));
const pct = (n: number) => `${((n / barMax) * 100).toFixed(2)}%`;
const situationCols = [
  { key: 'launch', tier: launch },
  { key: 'signature', tier: signature },
  { key: 'flagship', tier: flagship },
] as const;

// One window per kind of client. Sector only: no client is tied to a tier or a price.
const clients = await getClients();
const oneOfEach = [
  'first-baptist-muncie',
  'presbyterian-academy',
  'theology-matters',
  'reid-design',
].flatMap((slug) => clients.filter((c) => c.slug === slug));

// The care table, from the plans' feature lists. Each plan's "Everything in X"
// line means it has every row before it. Edit time, the hourly rate and replies
// have rows of their own, written out in words rather than ticked.
const careRows = carePlans.flatMap((plan, i) =>
  plan.features
    .filter((f) => !f.startsWith('Everything in'))
    .map((name) => ({ name, has: carePlans.map((_, j) => j >= i) })),
);

const webBody =
  'I match the build to your budget and to whoever will maintain it after launch. Everything is built for phones first and tested for accessibility from the very first screen, then handed over with a written guide.';

const strategyBody =
  'Strategy always comes first, because the design has to serve a plan. It starts with a working session together, then I write a short brief that the rest of the project follows.';

const photoBody =
  'When the photographer and the designer are one person, the photos match the layout instead of fighting it. Images arrive edited, web-optimized, and ready to drop in.';

const faq = [
  {
    q: 'What does it cost?',
    a: `Websites start at ${money(launch.priceFrom)} for a focused ${launch.name} site. A site your team runs usually comes to ${money(signatureLow)} to ${money(signatureHigh)}, and builds with custom tools start around ${money(flagship.priceFrom)}. Every build is custom, comes with an editor your own people can use, and includes year one hosting. What moves the number is how big the site is, what it has to do, photography, and how much writing I do for you. The first conversation is free and ends with an honest ballpark before anyone is committed. Larger projects can be split into monthly payments, which is easier on cash flow.`,
  },
  {
    q: 'What if I have been quoted less somewhere else?',
    a: 'You probably can find a cheaper quote, and for a very simple need that might be the right call. Ask what it includes: accessibility checks, an editor your team can actually use, a plan for who looks after the site after launch, and who answers the phone in a year. If it covers those, take it seriously.',
  },
  {
    q: 'What happens if you are ever unavailable?',
    a: 'Your site is built on tools plenty of web developers already use: WordPress or Sanity (an editor for your content), GitHub (where the code is stored) and Cloudflare (the network the site is hosted on). Nothing is a private system only I understand, and the code, content and written guide can go to another developer, who picks it up without starting over.',
  },
  {
    q: 'How long does a typical project take?',
    a: 'Most websites take 6 to 10 weeks from the first working session to launch. Larger projects with custom photography or several kinds of content can take 12 to 16 weeks. The brief at the end of the planning sets the real timeline.',
  },
  {
    q: 'Do I need a care plan after launch?',
    a: `No. Care is optional, but every live site needs ${hosting.name}. Year one hosting is included in every build, and from year two ${hosting.name} is ${hosting.price} a year. It covers hosting, security updates, a check every 15 minutes that the site is up, daily backups, and renewals. On ${hosting.name} you make changes yourself, or I make them at ${money(hourlyRate)} an hour. ${lightCare.name} (${lightCare.price} a month), ${care.name} (${care.price} a month) and ${carePlus.name} (${carePlus.price} a month) are add-ons on top of ${hosting.name}, billed monthly from launch. They add routine software updates, changes I make for you each month, fixes at no extra charge, faster replies and, from ${care.name} up, a monthly report. Extra changes on any care plan are ${money(careRate)} an hour, and custom development is ${money(customWorkRate)} an hour, quoted first. A site with custom tools needs ${care.name} or ${carePlus.name}, because tools need looking after. ${lightCare.name} minutes carry over for three months; ${care.name} and ${carePlus.name} hours do not. You can change or cancel with 30 days notice.`,
  },
  {
    q: 'Is there a monthly fee for the editor?',
    a: 'Usually not for a small team. WordPress has no license fee, and Sanity, the other editor I use, has a free plan and a plan for nonprofits. If your team would ever outgrow the free plan, I tell you the cost before you commit.',
  },
  {
    q: 'Can you work with my existing brand?',
    a: 'Yes. If you already have a logo, palette, and type system, I use it. If you do not, brand work can be folded into the strategy phase or scoped separately.',
  },
  {
    q: 'Where are you based, and do you work with clients outside Cincinnati?',
    a: "I'm based in Cincinnati, but web design, planning, and brand work happen with clients anywhere, fully remote when that is easier. Photography is the one piece that needs me on site, so that stays within the greater Cincinnati region.",
  },
];

const studio = (id: string, name: string, description: string, regional = false) => ({
  '@type': 'Service',
  '@id': `${site.url}/services/#${id}`,
  name,
  description,
  provider: { '@id': ids.studio },
  // Photography needs me on site, so it stays regional; the rest serves
  // clients anywhere.
  areaServed: regional
    ? 'Greater Cincinnati region'
    : ['Greater Cincinnati region', 'United States'],
});
const schemas = [
  { ...studio('strategy', 'Strategy', strategyBody), offers: [addOnOffer(brandStrategy)] },
  { ...studio('web-design', 'Web design', webBody), offers: tierOffers(tiers) },
  {
    ...studio('photography', 'Photography', photoBody, true),
    offers: [addOnOffer(photography)],
  },
  {
    ...studio(
      'care',
      'Care after launch',
      'Hosting, updates and monthly edit time for a site after launch. Year one hosting is included in every build.',
    ),
    offers: careOffers(carePlans),
  },
  {
    '@type': 'FAQPage',
    '@id': `${site.url}/services/#faq`,
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];

const heading = `What I do, and <b>what it costs.</b>`;
---

<BaseLayout
  title="Services and pricing | Nixon Creative Studio"
  description={`Websites from ${money(launch.priceFrom)}, photography ${photography.price}, and care plans after launch. Every price is on the page, and the first conversation is free.`}
  schemas={schemas}
>
  <header class="page-head price-head">
    <h1 aria-label={plainText(heading)} set:html={wordSpans(heading)} />
    <p class="lede">
      You get a custom website planned, designed and built by one person, an editor your own people
      can run, and a site you can take elsewhere if you ever need to. Every price is on this page,
      and the first conversation is free and ends with an honest ballpark.
    </p>
    <ul class="glance" aria-label="The three website tiers">
      {tiers.map((t) => (
        <li>
          <a href={`#${t.name.toLowerCase()}`}>
            <span class="label">{t.name}</span>
            <span class="glance-who">{t.who}</span>
            <span class="glance-num">
              {`${money(t.priceFrom)}${t.priceSuffix}`}
              <small>one-time</small>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="after-one">
      <b>After year one:</b>
      {` ${hosting.name} ${hosting.price} ${perWords(hosting.period)}. Optional care from ${lightCare.price} ${perWords(lightCare.period)}.`}
      <a href="#care">What Hosting and care cover</a>
    </p>
    <div class="from">
      <p class="label">Websites start at, one-time</p>
      <p class="from-num">{money(launch.priceFrom)}</p>
      <ul class="from-notes">
        <li>
          <b>A site your team runs</b>
          {money(signatureLow)} to {money(signatureHigh)}
        </li>
        <li>
          <b>Year one hosting</b>Included in every build
        </li>
        <li>
          <b>Larger projects</b>Can be split into monthly payments
        </li>
      </ul>
    </div>
    <nav class="jump" aria-label="On this page">
      <a href="#fit">Help me choose</a>
      <a href="#costs">Five-year costs</a>
      <a href="#why-not">Why not a platform</a>
      <a href="#behind">Behind the site</a>
      <a href="#add-ons">Add-ons</a>
      <a href="#care">Care plans</a>
      <a href="#how">How it works</a>
      <a href="#every-build">In every build</a>
      <a href="#why">Why one person</a>
      <a href="#faq">Questions</a>
    </nav>
  </header>

  <section
    class="sec tiers-sec"
    id="websites"
    aria-labelledby="websites-h"
    data-track-view="pricing_view"
    data-track-variant="full"
  >
    <div class="wrap">
      <div class="sec-head">
        <h2 id="websites-h">Websites</h2>
        <p>Every one is custom. The difference is who runs it, and how much I take on.</p>
      </div>
      <ul class="tiers" data-tiers>
        {tiers.map((t, i) => (
          <li class="tier" id={t.name.toLowerCase()}>
            <article class:list={['t-card', { 't-ink': i > 0, 't-dark': i === 2 }]}>
              <div class="t-bg" aria-hidden="true"></div>
              <div class="t-head">
                <h3>{t.name}</h3>
                <p>{t.badge ?? t.who}</p>
              </div>
              <div class="t-fits">
                <h4 class="t-h">Who it fits</h4>
                <p>{t.fits}</p>
              </div>
              <div class="t-fits">
                <h4 class="t-h">What I take responsibility for</h4>
                <p>{t.responsible}</p>
              </div>
              <p class="t-price">{`${money(t.priceFrom)}${t.priceSuffix}`}</p>
              <p class="t-range">
                {`One-time build. ${t.range}.`}
                {t.needsCare && (
                  <span class="t-need">
                    Custom tools need {t.needsCare} or {carePlus.name} after launch.
                  </span>
                )}
              </p>
              <div class="t-keep">
                <h4 class="t-h">If you ever move on</h4>
                <ul>
                  {freeToMove.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              </div>
              <h4 class="t-inc">What's included</h4>
              <ul class="t-list ticks">
                {t.features.map((f, j) => (
                  <li style={`--i:${j}`}>{f}</li>
                ))}
              </ul>
              <p class="t-go">
                <a
                  class="cta"
                  href={`/contact/?tier=${t.name.toLowerCase()}`}
                  data-tier={t.name.toLowerCase()}
                >
                  Start with {t.name}
                </a>
              </p>
            </article>
          </li>
        ))}
      </ul>
      <p class="after" id="moves">
        What moves a price within a tier: how many pages and kinds of content it holds, how much of
        the content I write or move for you, how many outside systems connect, and whether
        photography is part of it.
      </p>
    </div>
  </section>

  <section class="sec tight fit" data-mfold id="fit" aria-labelledby="fit-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="fit-h">If this sounds like you</h2>
        <p>Find your kind of organization, then the description closest to where you are today.</p>
      </div>
      <table class="fit-table">
        <caption class="tcap">
          Which tier usually fits a church, a school, a nonprofit and a small business
        </caption>
        <thead>
          <tr>
            <td></td>
            {situationCols.map(({ tier }) => (
              <th scope="col">
                <a href={`#${tier.name.toLowerCase()}`}>{tier.name}</a>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {SITUATIONS.map((row) => (
            <tr>
              <th scope="row">
                <a href={sectorPagePath(row.sector)}>{row.label}</a>
              </th>
              {situationCols.map(({ key, tier }) => (
                <td data-tier-name={tier.name}>{row[key]}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
      <p class="after">
        These are starting points, and none of them is a promise about what your site will do. Tell
        me about yours and I'll tell you which tier fits, including if none does.
      </p>
    </div>
  </section>

  <section class="sec tight picker" data-mfold id="pick" aria-labelledby="pick-h">
    <div class="wrap">
      <div class="pick-in">
        <div class="pick-qs">
          <p class="label">Not sure yet</p>
          <h2 id="pick-h">
            Three questions to <b>suggest a tier.</b>
          </h2>
          <form data-pick data-tiers={JSON.stringify(pickTiers)}>
            <fieldset class="pick-q">
              <legend>How much does the site need to hold?</legend>
              <div class="opts-row">
                <label class="pick-o">
                  <input type="radio" name="size" value="0" />
                  <span>The essential pages</span>
                </label>
                <label class="pick-o">
                  <input type="radio" name="size" value="1" />
                  <span>Deeper sections</span>
                </label>
                <label class="pick-o">
                  <input type="radio" name="size" value="2" />
                  <span>A large, deep site</span>
                </label>
              </div>
            </fieldset>
            <fieldset class="pick-q">
              <legend>What will your team keep up to date?</legend>
              <div class="opts-row">
                <label class="pick-o">
                  <input type="radio" name="who" value="0" />
                  <span>A few pages</span>
                </label>
                <label class="pick-o">
                  <input type="radio" name="who" value="1" />
                  <span>Several kinds of content</span>
                </label>
                <label class="pick-o">
                  <input type="radio" name="who" value="2" />
                  <span>A lot, across many kinds</span>
                </label>
              </div>
            </fieldset>
            <fieldset class="pick-q">
              <legend>Does it need to do real work?</legend>
              <div class="opts-row">
                <label class="pick-o">
                  <input type="radio" name="tools" value="0" />
                  <span>Mostly inform people</span>
                </label>
                <label class="pick-o">
                  <input type="radio" name="tools" value="1" />
                  <span>Connect to other services</span>
                </label>
                <label class="pick-o">
                  <input type="radio" name="tools" value="2" />
                  <span>Custom tools, like bookings or sign-ups</span>
                </label>
              </div>
            </fieldset>
          </form>
          <p class="pick-note">
            This points you at a starting place, not a quote. The first conversation, which is free,
            gets you an honest ballpark.
          </p>
        </div>
        <div class="pick-stage" aria-live="polite" data-pick-out>
          <div class="pc pc-paper pick-card" data-pick-card>
            <div class="pc-face">
              <h3 class="label" data-pick-name>
                Your starting tier
              </h3>
              <strong data-pick-price>?</strong>
              <span class="pc-who" data-pick-who>
                Answer all three and I'll suggest a starting tier.
              </span>
            </div>
          </div>
          <p class="pick-why" data-pick-why hidden></p>
          <a class="chip go pick-go" href="/contact/" data-pick-go hidden>
            Start with <span data-pick-go-name></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec tight costs" data-mfold id="costs" aria-labelledby="costs-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="costs-h">What it costs over five years</h2>
        <p>The sum a treasurer will do anyway, so here it is.</p>
      </div>
      <table class="cost-table">
        <caption class="tcap">
          {`What each tier costs in total, from its starting price. Prices as of ${pricesAsOf}.`}
        </caption>
        <thead>
          <tr>
            <th scope="col">Tier, and what you pay after launch</th>
            <th scope="col">First year, build and hosting</th>
            <th scope="col">Total after 3 years</th>
            <th scope="col">Total after 5 years</th>
          </tr>
        </thead>
        {costs.map((c) => (
          <tbody>
            {c.rows.map((r, j) => (
              <tr class:list={{ 'with-care': j > 0 }}>
                <th scope="row">
                  <b>{c.tier.name}</b>
                  <span>
                    {r.withCare
                      ? `Plus ${r.plan.name}, ${r.plan.price} ${perUnit(r.plan.period)}, on top of ${hosting.name}`
                      : `${hosting.name} only, ${hosting.price} ${perUnit(hosting.period)} from year two`}
                  </span>
                  {j === 0 && c.tier.needsCare && (
                    <span class="t-need">
                      Custom tools need {c.tier.needsCare} or {carePlus.name}.
                    </span>
                  )}
                </th>
                <td data-label="First year">{money(r.yearOne)}</td>
                <td data-label="After 3 years">{money(r.threeYears)}</td>
                <td data-label="After 5 years">{money(r.fiveYears)}</td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
      <p class="after">
        How I worked these out: each tier's starting price, which is a one-time build cost. Year one
        hosting is included, so {hosting.name} is billed from year two. A care plan is an add-on on
        top of {hosting.name}, billed every month from launch. On {hosting.name} only, you make
        every change yourself. Any tier can take any care plan; these are the usual pairings. A
        build that lands higher in its range adds the difference. Photography, custom development,
        or a paid Sanity plan if your team ever outgrows the free one, would be extra.
      </p>
      <figure class="cost-bars" aria-labelledby="bars-cap">
        <figcaption id="bars-cap" class="tcap">
          Where the money goes over 5 years, with each tier's usual care plan
        </figcaption>
        <p class="bar-key" aria-hidden="true">
          <span class="k-build">Build, one-time</span>
          <span class="k-host">{hosting.name}, years 2 to 5</span>
          <span class="k-care">Care plan, 5 years</span>
        </p>
        <ul class="bars">
          {costs.map(({ tier, usual }) => (
            <li>
              <p class="bars-t">
                <b>
                  {tier.name} with {usual.plan.name}
                </b>
                <span class="bars-sum">{`${money(usual.fiveYears)} over 5 years`}</span>
              </p>
              <div class="bars-bar" aria-hidden="true">
                <i class="k-build" style={`width:${pct(usual.parts.build)}`}></i>
                <i class="k-host" style={`width:${pct(usual.parts.hosting)}`}></i>
                <i class="k-care" style={`width:${pct(usual.parts.care)}`}></i>
              </div>
              <p class="bars-parts">
                {`Build ${money(usual.parts.build)}, ${hosting.name} ${money(usual.parts.hosting)}, ${usual.plan.name} ${money(usual.parts.care)}. Total ${money(usual.fiveYears)}.`}
              </p>
            </li>
          ))}
        </ul>
      </figure>
      <p class="costs-go">
        <a class="chip" href="/one-page/">
          One-page summary for a board or committee
        </a>
      </p>
    </div>
  </section>

  <section class="sec tight why-not" data-mfold id="why-not" aria-labelledby="why-not-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="why-not-h">Why not a cheaper platform?</h2>
        <p>
          Sometimes you should use one. Over five years a template platform will usually cost less
          cash than anything on this page, and I won't argue with that arithmetic.
        </p>
      </div>
      <div class="why-not-in">
        <div class="why-not-yes">
          <h3>Choose a platform if</h3>
          <ul class="ticks">
            <li>
              A good template covers what you need, and someone on your team enjoys the setup.
            </li>
            <li>The budget is tight, and the site is a small part of the job.</li>
            <li>
              You want giving, email or booking on one bill, and the design limits don't bother you.
            </li>
          </ul>
          <p>
            I have built on one myself, for a church whose communications team wanted to own every
            page. With me, things like giving and email are separate services with their own terms,
            and I tell you what they cost before you commit.
          </p>
        </div>
        <div>
          <h3 class="why-not-h">What you can check, whichever you choose</h3>
          <dl class="checks">
            <div>
              <dt>Who does the work?</dt>
              <dd>
                On a platform, someone on your team fits your content into a template and keeps it
                there. With me, I plan, design and build around your content, and your people edit
                it afterward.
              </dd>
            </div>
            <div>
              <dt>Can you leave?</dt>
              <dd>
                Yes, fairly easily. I host the site and look after the code, and if you want to move
                on, the code, content and documentation go with you to another developer and another
                host. Leaving Squarespace or Wix usually means rebuilding the whole site somewhere
                else.
              </dd>
            </div>
            <div>
              <dt>What happens when your web person moves on?</dt>
              <dd>
                Every build comes with an editor and a written guide, so the next staff member or
                volunteer is not starting from nothing. Ask to see the guide, or the editor.
              </dd>
            </div>
            <div>
              <dt>Does it work for everyone?</dt>
              <dd>
                Every custom build is made to work for people with disabilities, and checked against
                WCAG AA, the usual accessibility standard. Run a free accessibility checker on this
                site, then on any site you are comparing.
              </dd>
            </div>
            <div>
              <dt>Who answers?</dt>
              <dd>
                You reach the person who built it, and the reply time is written into each care
                plan.
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="sec tight behind" data-mfold id="behind" aria-labelledby="behind-h">
    <div class="wrap">
      <div class="behind-head">
        <p class="label">Behind the site</p>
        <h2 id="behind-h">
          What your staff see <b>when they log in.</b>
        </h2>
        <p class="lede">
          A template gives you a site and a settings screen. I build the side your staff see every
          week, on WordPress or Sanity (another editor, made for teams), whichever suits the people
          running it.
        </p>
      </div>
      <div class="behind-grid">
        <figure class="behind-shot">
          <img
            src="/assets/theology-matters-cms.webp"
            width="1100"
            height="688"
            alt="The WordPress dashboard I built for Theology Matters, with tasks like adding an article and a list of scheduled articles"
            loading="lazy"
            decoding="async"
          />
          <figcaption>The home screen I built for the Theology Matters staff.</figcaption>
        </figure>
        <ul class="behind-list">
          <li>
            <b>A home screen</b>What is coming up, what needs fixing, and whether the site is live.
          </li>
          <li>
            <b>A guide beside the work</b>Written for your site, searchable, with help next to each
            page.
          </li>
          <li>
            <b>Checks before publishing</b>Missing photos and broken links get caught before a
            visitor sees them.
          </li>
          <li>
            <b>Hard to break</b>Deleted pages go to a trash can, and earlier versions are there to
            go back to.
          </li>
          <li>
            <b>Private previews</b>See a page exactly as it will look, and send the link to a
            colleague.
          </li>
        </ul>
      </div>
      <div class="behind-cards">
        <div class="card keyed see see-plain">
          <p class="label see-tag">Basic</p>
          <h3>A plain visitor counter tells you</h3>
          <ul>
            <li>How many people visited</li>
            <li>Which pages they landed on</li>
            <li>Where they came from</li>
          </ul>
        </div>
        <div class="card keyed see see-mine">
          <p class="label see-tag">What I add</p>
          <h3>What I set up tells you</h3>
          <ul>
            <li>On a church site: who started a gift, added an event, got the app</li>
            <li>On a race site: who went on to register</li>
            <li>
              On a journal: which articles got read to the end, and searches that found nothing
            </li>
            <li>Each month on Care: a short report I read first, with what to fix</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sec tight" data-mfold id="sites" aria-labelledby="sites-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="sites-h">
          Four example sites: <span class="sites-kinds">church, school, nonprofit, business</span>
        </h2>
        <p>One of each kind I work with. Open one to see inside it.</p>
      </div>
      <ul class="sites grid" data-sites>
        {oneOfEach.map((s) => (
          <li>
            <Tile client={s} lazy />
            <Caption client={s} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec tight" id="add-ons" aria-labelledby="addons-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="addons-h">Add to any project</h2>
        <p>Photos when needed, and brand work when you want it on its own.</p>
      </div>
      <div class="pair pair-wide">
        <div class="card panel keyed addon" id="photography">
          <div class="line">
            <h3>Photography</h3>
            <p class="amt">
              {photography.price}
              <small>a half-day</small>
            </p>
          </div>
          <p>{photography.note}</p>
          <p>
            When the photographer and the designer are one person, the photos match the layout
            instead of fighting it. Images arrive edited, sized for the web, and ready to use.
          </p>
          <ul class="ticks">
            <li>On-site Sunday or weekday coverage</li>
            <li>Headshots for team and staff</li>
            <li>Photos of your building and the people in it</li>
            <li>Edited images, sized for the web, delivered with the website</li>
          </ul>
          <p class="t-go">
            <a class="cta" href="/contact/?service=photography">
              Ask about photography
            </a>
          </p>
        </div>
        <div class="card panel keyed addon">
          <div class="line">
            <h3>Brand &amp; strategy</h3>
            <p class="amt">
              {brandStrategy.price}
              <small>one-time</small>
            </p>
          </div>
          <p>{brandStrategy.note}</p>
          <p>
            If you already have a logo, palette, and type system, I use it. If you do not, brand
            work can be folded into the strategy phase or scoped separately.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec tight" id="care" aria-labelledby="care-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="care-h">Care plans</h2>
        <p>
          {`${hosting.name} is ${hosting.price} ${perWords(hosting.period)}, and free in year one. Care is optional, from ${lightCare.price} ${perWords(lightCare.period)}.`}
        </p>
      </div>
      <p class="intro">
        A website is not something you print once. Hosting, security fixes, web addresses and
        security certificates keep moving, so every quote I send includes the cost after launch.
        After year one, every live site pays {hosting.name}. Care is an add-on on top of it, billed
        monthly from launch, for changes I make for you, routine software updates and faster
        replies. Care never replaces {hosting.name}.
      </p>
      <p class="intro">
        Every site I look after sits on one status board. It checks every 15 minutes that the site
        is up, and tracks how fast it answers, whether updates and backups ran, known security
        alerts in its software, and domain renewals where I manage the domain. If a site goes down,
        my phone tells me, so I usually know before you do.
      </p>
      <p class="intro rate-line">
        <b>{rateLine}</b> New features and custom tools are custom development, at{' '}
        {money(customWorkRate)} an hour, and I quote them in writing first.
      </p>
      <ul class="care-cards">
        {carePlans.map((c) => (
          <li class="card keyed care-card">
            <h3>{c.name}</h3>
            <p class="amt">
              {c.price}
              <small>{perUnit(c.period)}</small>
            </p>
            {c.addOn ? (
              <p class="care-on">On top of {hosting.name}, billed monthly from launch</p>
            ) : (
              <p class="care-on">Free in year one. Every live site needs it.</p>
            )}
            <p>{c.who}</p>
            <dl class="care-facts">
              <div>
                <dt>Changes I make for you each month</dt>
                <dd>{c.edits}</dd>
              </div>
              <div>
                <dt>Rate for extra changes</dt>
                <dd>{`${money(c.rate)} an hour`}</dd>
              </div>
              <div>
                <dt>Replies, and when something breaks</dt>
                <dd>{c.support}</dd>
              </div>
            </dl>
            <ul class="ticks">
              {c.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
      <div class="card tbox">
        <table class="care">
          <caption class="tcap">
            {`${hosting.name} and the three care plans, compared. Prices as of ${pricesAsOf}.`}
          </caption>
          <thead>
            <tr>
              <td class="corner"></td>
              {carePlans.map((c) => (
                <th scope="col">
                  <span class="pl">{c.name}</span>
                  <span class="amt">
                    {c.price}
                    <small>{perUnit(c.period)}</small>
                  </span>
                  {c.addOn ? (
                    <span class="care-on">on top of {hosting.name}</span>
                  ) : (
                    <span class="care-on">free in year one</span>
                  )}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Who it's for</th>
              {carePlans.map((c) => (
                <td>{c.who}</td>
              ))}
            </tr>
            <tr>
              <th scope="row">Changes I make for you each month</th>
              {carePlans.map((c) => (
                <td class="v">{c.edits}</td>
              ))}
            </tr>
            <tr>
              <th scope="row">Rate for extra changes</th>
              {carePlans.map((c) => (
                <td class="v">{`${money(c.rate)} an hour`}</td>
              ))}
            </tr>
            <tr>
              <th scope="row">Replies, and when something breaks</th>
              {carePlans.map((c) => (
                <td>{c.support}</td>
              ))}
            </tr>
            {careRows.map((row) => (
              <tr>
                <th scope="row">{row.name}</th>
                {row.has.map((y) => (
                  <td class={y ? 'y' : 'n'}>{y ? 'Included' : 'Not included'}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="after">
        {lightCare.name} minutes carry over for three months; {care.name} and {carePlus.name} hours
        do not. A fix means something that stopped working. Anything new, or beyond your plan, is
        quoted in writing first. Sites with custom tools need {care.name} or {carePlus.name}. Change
        or cancel with 30 days notice.
      </p>
    </div>
  </section>

  <section class="sec tight" data-mfold id="how" aria-labelledby="how-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="how-h">How it works</h2>
      </div>
      <ol class="steps">
        <li>
          <h3>Start with a conversation</h3>
          <p>
            The first conversation is free: a call about what you actually need, and an honest
            ballpark before anyone is committed. If you go ahead, the project opens with a working
            session, an hour together in person or on video, that ends with a one-page brief you
            sign off on.
          </p>
        </li>
        <li>
          <h3>Then the plan</h3>
          <p>
            I write down who the site is for, how the pages fit together, and what you want visitors
            to do next. You read it and push back, and I revise. Every design choice after that
            follows this plan.
          </p>
        </li>
        <li>
          <h3>Then I design and build</h3>
          <p>
            I design and build the pages where you can see them. A link to the work so far lands in
            your inbox at each step, so you can react early instead of seeing the whole thing for
            the first time at launch.
          </p>
        </li>
        <li>
          <h3>Launch, and follow-through</h3>
          <p>
            I launch the site with you, then stay close for the first month to fix anything that
            surfaces. After that you have a written guide and a simple way to reach me when
            something comes up.
          </p>
        </li>
      </ol>
      <details class="fold steps-fold" id="timelines">
        <summary>
          <h2>Timelines</h2>
          <i aria-hidden="true"></i>
        </summary>
        <div class="fold-a">
          <div class="fold-in">
            <p class="intro">The brief at the end of the planning sets the real timeline.</p>
            <div class="card panel span">
              <div class="bar-row">
                <p class="bar-t">
                  <b>Most websites</b>
                  <span>6 to 10 weeks from the first working session to launch</span>
                </p>
                <div class="bar" aria-hidden="true">
                  <i style="--a: 6; --b: 10"></i>
                </div>
              </div>
              <div class="bar-row">
                <p class="bar-t">
                  <b>Larger projects with custom photography or several kinds of content</b>
                  <span>12 to 16 weeks</span>
                </p>
                <div class="bar" aria-hidden="true">
                  <i style="--a: 12; --b: 16"></i>
                </div>
              </div>
              <p class="bar-scale" aria-hidden="true">
                <span>Start</span>
                <span>16 weeks</span>
              </p>
            </div>
          </div>
        </div>
      </details>
    </div>
  </section>

  <div class="sec tight folds">
    <div class="wrap rows">
      <details class="fold" id="every-build">
        <summary>
          <h2>In every build</h2>
          <i aria-hidden="true"></i>
        </summary>
        <div class="fold-a">
          <div class="fold-in">
            <div class="pair">
              <div class="card panel">
                <h3>The site itself</h3>
                <p>
                  Modern, accessible, fast websites, built on WordPress or Sanity (another editor),
                  whichever suits the people running yours.
                </p>
                <p>
                  I match the build to your budget and to whoever will maintain it after launch.
                  Everything is built for phones first and tested for accessibility from the very
                  first screen, then handed over with a written guide.
                </p>
                <ul class="ticks">
                  <li>A custom design built to your brand, not a stock template</li>
                  <li>Fast pages that load quickly, even on a slow phone connection</li>
                  <li>Layouts that work on every phone, tablet and desktop</li>
                  <li>Works for people with disabilities, checked against the WCAG AA standard</li>
                  <li>Hosting set up for you, with year one included</li>
                </ul>
              </div>
              <div class="card panel">
                <h3>Strategy, first</h3>
                <p>
                  Strategy always comes first, because the design has to serve a plan. It starts
                  with a working session together, then I write a short brief that the rest of the
                  project follows.
                </p>
                <ul class="ticks">
                  <li>A working session, then back-and-forth until the plan is right</li>
                  <li>Who the site is for, and what you want them to do next</li>
                  <li>A list of the words and photos you already have</li>
                  <li>A one-page brief the rest of the project follows</li>
                </ul>
                <p>
                  Strategy is the front of every project, not a line item. The prices above already
                  include the session and the brief, and year one hosting too.
                </p>
              </div>
            </div>
          </div>
        </div>
      </details>
      <details class="fold" id="why">
        <summary>
          <h2>Why one person</h2>
          <i aria-hidden="true"></i>
        </summary>
        <div class="fold-a">
          <div class="fold-in">
            <p class="intro">
              Plenty of people will quote you less, and for some sites that is the right call. Here
              is what this price buys.
            </p>
            <ul class="whys">
              <li>
                <h3>One person, no handoffs</h3>
                <p>
                  The person who plans your site designs it, builds it, and, when needed, shoots the
                  photos. No agency markup, and nothing lost in translation between a strategist, a
                  designer, and a developer who never quite talk to each other.
                </p>
              </li>
              <li>
                <h3>Built to be handed off</h3>
                <p>
                  Every site is set up so the next volunteer or staff member can keep it running. If
                  you ever move on, the code, content and documentation go with you.
                </p>
              </li>
              <li>
                <h3>Accessible by default</h3>
                <p>
                  Every custom build is made to work for people with disabilities, checked against
                  the WCAG AA standard until each page scores 100 in Google's accessibility check.
                  For a church, school, or nonprofit it is the right thing to do, and it is
                  included, not an upsell.
                </p>
              </li>
              <li>
                <h3>Priced where you can see it</h3>
                <p>
                  The tiers, the care plans and the five-year sums are all on this page, so you can
                  check them against anything else you are looking at before you ever talk to me.
                </p>
              </li>
            </ul>
            <p class="tools">
              I build with modern tools, including AI, the same way I use good software and a
              camera. They help one person do the work of a team. The strategy, the design, and the
              accountability stay mine, start to finish.
            </p>
          </div>
        </div>
      </details>
    </div>
  </div>

  <section class="sec tight" id="faq" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="faq-h">Common questions</h2>
      </div>
      <div class="faq">
        {faq.map(({ q, a }) => (
          <details>
            <summary>
              {q}
              <i aria-hidden="true"></i>
            </summary>
            <div class="faq-a">
              <p>{a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Closing lead="Not sure which tier <b>fits?</b>" />
