---
// Safe to edit. The words on this page are CMS content (Services page, Service
// offerings, Pricing tiers and Add-ons in the EmDash admin; the process steps are
// the Home page entry's), read below. What stays in code is listed in
// .claude/rules/homepage-and-pages.md ("/services").
/* ============================================================================
   /services | Services (redesign 2026)
   ============================================================================
   The page for depth. The homepage shows the work, a price teaser and the
   process in brief; this page answers what a buyer asks next, one band each,
   and repeats none of the homepage's bands (redesign 2026, A item 11):

     1. Hero (window-light, the one moving ground): the services headline with
        its italic turn, the intro, a call to action, and the price list as a
        printed slip (every published price on one page, each a link down).
     2. Web design (paper): the offering, its included lines, and a large
        print of a live client site (FRT's library) as proof.
     3. What a website costs (sunk paper): PriceTiers, the three tiers as one
        ruled price sheet with who each fits, then the mid-page call to action.
     4. Strategy (paper): the offering at $1,500 on its own, and the one-page
        brief drawn as the document it is (BriefSheet).
     5. How a project runs (sunk paper): ProjectTimeline, the four CMS steps
        with real durations on a week scale drawn to scale.
     6. Yours to keep (deep, the one ink band): the handoff (editor, guide,
        backups, accessibility checks, ownership) beside the Care plan.
     7. Photography (paper): the offering and a call sheet with the rate and
        the photographer's print (CallSheet). No placeholder panel.
     8. Why it costs what it costs (sunk paper): the four reasons, including
        what a cheaper quote leaves out, and the note on tools.
     9. Common questions (paper): the FAQ (native <details>).
    10. Close (sunk paper): the closing call to action, then the ink footer.

   Grounds: window-light at the top only (the moving one), paper, one deep
   band (DESIGN.md "Grounds"). The sunk bands are paper with the paper-deep
   token behind them (`bg-muted`), so the ground changes between bands without
   a second texture.

   Prices are never typed here: tiers and add-ons come from getPricingTiers()
   and getAddOns(), the offering floors from getServiceOfferings(). The FAQ
   answers are prose and cannot read those values, so a price change in the
   admin also needs the matching FAQ answer edited.

   JSON-LD: Service x3 and FAQPage from buildServiceSchemas(), unchanged (the
   golden file src/lib/servicesPage.jsonld.golden.json pins it).
   ============================================================================ */

import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/Band.astro';
import Frame from '../components/Frame.astro';
import PriceTiers from '../components/PriceTiers.astro';
import BriefSheet from '../components/services/BriefSheet.astro';
import ProjectTimeline from '../components/services/ProjectTimeline.astro';
import CallSheet from '../components/services/CallSheet.astro';
import { buttonVariants } from '../components/ui/button';
// Real proof for Web design: a live client site (the Foundation for Reformed
// Theology's library, foundationrt.org/resources), cropped from the redesign
// captures. Only live work is shown as live (docs/redesign-2026/00-synthesis.md).
import webDesignShot from '../assets/services/frt-library.webp';
import headshot from '../assets/brand/headshot.jpg';
import { SITE_URL, getSite } from '../data/site';
import { getAddOns, getPricingTiers } from '../lib/pricing';
import { getHomePage } from '../lib/homePage';
import {
  buildServiceSchemas,
  getServiceOfferings,
  getServicesPage,
  servicesTitle,
  type ServiceOffering,
} from '../lib/servicesPage';
import { voiceSplit } from '../lib/voiceSplit';

const tiers = await getPricingTiers(Astro);
const addOns = await getAddOns(Astro);
const page = await getServicesPage(Astro);
const services = await getServiceOfferings(Astro);
const home = await getHomePage(Astro);
const site = await getSite(Astro);

// The three offerings by slug. The layout places each in its own band, so a
// missing one (an admin unpublish) just drops its band.
const bySlug = (slug: string): ServiceOffering | undefined => services.find((s) => s.slug === slug);
const strategy = bySlug('strategy');
const webDesign = bySlug('web-design');
const photography = bySlug('photography');
// The add-ons by position: photography, brand and strategy, care plan.
const careAddOn = addOns.find((a) => /care/i.test(a.name));
const photoAddOn = addOns.find((a) => /photo/i.test(a.name));
// Brand work is priced as an add-on; its note sits under the Strategy chapter,
// where the price list's "Brand & strategy" line points.
const brandAddOn = addOns.find((a) => /brand/i.test(a.name));
// The Care plan's price is a display string ("from $100/mo"). The deep band sets
// its dollar figure as a numeral, so split it: the first dollar amount, and a
// per-month line when the string is a monthly price. Anything else shows whole.
const careFigure = careAddOn?.price.match(/\$[\d,]+/)?.[0];
const carePer =
  careAddOn && /\/\s*mo|month/i.test(careAddOn.price) ? 'a month, to start' : undefined;

// JSON-LD (Service per offering, FAQPage) from the same data the page shows.
// Web design has no price of its own; its floor is the first Pricing tier.
const schemas = buildServiceSchemas(services, page.faq.items, SITE_URL, tiers[0]?.priceFrom);

const money = (n: number) => `$${n.toLocaleString('en-US')}`;

// The price list in the hero: every published price, each a link to its band.
// Tier and offering floors are numbers; add-on prices are display strings.
const priceList: { label: string; price: string; href: string }[] = [
  ...tiers.map((t) => ({
    label: `${t.name} website`,
    price: `from ${money(t.priceFrom)}`,
    href: '#prices',
  })),
  ...(strategy?.priceFrom
    ? [{ label: 'Strategy on its own', price: money(strategy.priceFrom), href: '#strategy' }]
    : []),
  ...addOns.map((a) => ({
    label: a.name,
    price: a.price,
    href: /care/i.test(a.name) ? '#care' : /photo/i.test(a.name) ? '#photography' : '#strategy',
  })),
];

// Headlines turn into the italic second voice for their last phrase.
const hero = voiceSplit(page.heading);
const pricingH = voiceSplit(page.pricing.heading);
const whyH = voiceSplit(page.why.heading);
const faqH = voiceSplit(page.faq.heading);
const processH = voiceSplit(home.process.heading);
const closeH = voiceSplit(page.ctaTitle ?? site.ctaDefault.title);

// The four reasons: the last one ("What a cheaper quote leaves out") is set
// apart in the band's left column; the other three are the list.
const whyLast = page.why.items.at(-1);
const whyRest = page.why.items.slice(0, -1);

// Written in code (no CMS field yet): the handoff list. Each line is a promise
// the studio already makes elsewhere (Home hero, the Web design offering, the
// Care plan note); keep them in step.
const HANDOFF: { title: string; body: string }[] = [
  {
    title: 'An editor your team can use',
    body: 'Staff or volunteers change pages, photos and events themselves, without a developer.',
  },
  {
    title: 'A written guide',
    body: 'The everyday edits, written down for whoever runs the site next.',
  },
  {
    title: 'Backups that are checked',
    body: 'The site and its content are backed up automatically, and I check that the backups work.',
  },
  {
    title: 'Accessibility checks',
    body: 'Tested against WCAG AA before launch, on every change.',
  },
  {
    title: 'Yours outright',
    body: 'No lock-in. The custom-coded builds cost little or nothing a month to host.',
  },
];
---

<BaseLayout
  title={servicesTitle(page.seoTitle, site.studioName)}
  description={page.seoDescription}
  schemas={schemas}
  preloadFonts={['italic']}
>
  {/* 1. Hero. Window-light, the page's one moving ground. Nothing here waits on
       a reveal; the LCP element is the headline text. */}
  <Band ground="window-light" underHeader labelledby="services-hero-heading" class="svc-hero">
    <div class="svc-hero-grid">
      <div class="svc-hero-copy">
        <h1 id="services-hero-heading" class="svc-hero-title">
          {hero.head}
          {hero.tail && ' '}
          {hero.tail && <span class="voice">{hero.tail}</span>}
        </h1>
        <p class="type-lede svc-hero-intro">{page.intro}</p>
        <div class="svc-actions">
          <a href="/contact/" class={buttonVariants({ variant: 'brand', size: 'cta' })}>
            Get an honest ballpark
            <span data-nudge aria-hidden="true">
              →
            </span>
          </a>
          <a href="#prices" class="svc-textlink">
            See the price sheet
          </a>
        </div>
      </div>

      {/* The price list: a printed slip with every published price. */}
      <aside class="price-slip" aria-labelledby="price-list-title" id="price-list">
        <p class="slip-head">
          <span id="price-list-title" class="slip-title">
            Price list
          </span>
          <span class="slip-meta">{new Date().getFullYear()}</span>
        </p>
        <ul class="slip-lines" role="list">
          {priceList.map((line) => (
            <li>
              <a href={line.href}>
                <span class="slip-label">{line.label}</span>
                <span class="slip-dots" aria-hidden="true" />
                <span class="slip-price">{line.price}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="slip-foot">The first conversation is free.</p>
      </aside>
    </div>
  </Band>

  {/* 2. Web design: the offering, with a live client site printed large. */}
  {webDesign && (
    <Band ground="paper" still labelledby="web-design-heading" id="web-design">
      <div class="chapter chapter--wide">
        <div class="chapter-copy">
          <h2 id="web-design-heading" class="type-headline">
            {webDesign.title}
          </h2>
          <p class="type-lede chapter-lede">{webDesign.lede}</p>
          <p class="type-body">{webDesign.body}</p>
          <ul class="included" role="list" aria-label={`${webDesign.title}: included`}>
            {webDesign.points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </div>
        {webDesign.imageAlt && (
          <div class="chapter-proof" data-reveal>
            <Frame
              src={webDesignShot}
              alt={webDesign.imageAlt}
              url="foundationrt.org/resources"
              widths={[480, 800, 1200, 1600]}
              sizes="(min-width: 64rem) 52vw, 92vw"
              caption="Foundation for Reformed Theology, Richmond, Virginia. Decades of sermons, lectures and bibliographies in one library its own staff publish to."
            />
          </div>
        )}
      </div>
    </Band>
  )}

  {/* 3. What a website costs: the price sheet, then the mid-page CTA. */}
  <Band ground="paper" still labelledby="services-pricing-heading" id="prices" class="bg-muted">
    <div class="band-head">
      <h2 id="services-pricing-heading" class="type-headline">
        {pricingH.head}
        {pricingH.tail && ' '}
        {pricingH.tail && <span class="voice">{pricingH.tail}</span>}
      </h2>
      <p class="type-body band-sub">{page.pricing.sub}</p>
    </div>
    <PriceTiers tiers={tiers} />
    <p class="type-caption sheet-foot">{page.pricing.footnote}</p>

    <div class="midcta">
      <p class="midcta-text">
        Not sure which tier you are? Tell me what the site needs to do and I will say which one, and
        roughly what it costs. Have a quote from someone else? Send it along and I will tell you
        plainly what is different.
      </p>
      <a href="/contact/" class={buttonVariants({ variant: 'brand', size: 'cta' })}>
        Ask what yours would cost
        <span data-nudge aria-hidden="true">
          →
        </span>
      </a>
    </div>
  </Band>

  {/* 4. Strategy, and the one-page brief it produces. */}
  {strategy && (
    <Band ground="paper" still labelledby="strategy-heading" id="strategy">
      {/* The heading and the price set as one ruled line across the band, like
           the total line of an estimate; then the brief (the thing strategy
           produces) leads, and the words follow it. */}
      <div class="strat-head">
        <h2 id="strategy-heading" class="type-headline">
          {strategy.title}
        </h2>
        {strategy.priceFrom && (
          <p class="chapter-price">
            <span class="chapter-price-note">on its own, included in every website</span>
            <span class="type-numeral">{money(strategy.priceFrom)}</span>
          </p>
        )}
      </div>
      <div class="chapter chapter--flip chapter--doc-lead">
        <div class="chapter-copy">
          <p class="type-lede chapter-lede">{strategy.lede}</p>
          <p class="type-body">{strategy.body}</p>
          <ul class="included" role="list" aria-label={`${strategy.title}: included`}>
            {strategy.points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
          {brandAddOn && <p class="type-caption chapter-aside">{brandAddOn.note}</p>}
        </div>
        <div class="chapter-proof chapter-proof--doc" data-reveal>
          <BriefSheet />
        </div>
      </div>
    </Band>
  )}

  {/* 5. How a project runs, drawn to scale. */}
  <Band ground="paper" still labelledby="process-heading" id="process" class="bg-muted">
    <div class="band-head">
      <h2 id="process-heading" class="type-headline">
        {processH.head}
        {processH.tail && ' '}
        {processH.tail && <span class="voice">{processH.tail}</span>}
      </h2>
    </div>
    <ProjectTimeline steps={home.process.steps} />
  </Band>

  {/* 6. Yours to keep: the handoff, and the Care plan. The one deep band. */}
  <Band ground="deep" still labelledby="handoff-heading" id="care">
    <div class="handoff">
      <div>
        <h2 id="handoff-heading" class="type-headline">
          What you get <span class="voice">at handoff</span>
        </h2>
        <p class="type-body handoff-sub">
          A site your next volunteer can run. On launch day it is handed over with all of this:
        </p>
        <ul class="handoff-list" role="list">
          {HANDOFF.map((h) => (
            <li>
              <h3>{h.title}</h3>
              <p>{h.body}</p>
            </li>
          ))}
        </ul>
      </div>
      {careAddOn && (
        <section class="care" aria-labelledby="care-heading">
          <h3 id="care-heading" class="care-title">
            {careAddOn.name}
          </h3>
          <p class="care-price">
            <span class="type-numeral">{careFigure ?? careAddOn.price}</span>
            {careFigure && carePer && <span class="care-per">{carePer}</span>}
          </p>
          <p class="care-note">{careAddOn.note}</p>
          <a href="/contact/" class="care-link nudge">
            Ask about the Care plan{' '}
            <span data-nudge aria-hidden="true">
              →
            </span>
          </a>
        </section>
      )}
    </div>
  </Band>

  {/* 7. Photography, as a call sheet. */}
  {photography && (
    <Band ground="paper" still labelledby="photography-heading" id="photography">
      <div class="chapter chapter--flip">
        <div class="chapter-copy">
          <h2 id="photography-heading" class="type-headline">
            {photography.title}
          </h2>
          <p class="type-lede chapter-lede">{photography.lede}</p>
          <p class="type-body">{photography.body}</p>
          <a href="/contact/" class="svc-textlink nudge">
            Book a photo day{' '}
            <span data-nudge aria-hidden="true">
              →
            </span>
          </a>
        </div>
        <div class="chapter-proof chapter-proof--doc">
          <CallSheet
            priceFrom={photography.priceFrom}
            rateNote={photoAddOn?.note}
            shots={photography.points}
            headshot={headshot}
            headshotAlt="Nathan Nixon, smiling outdoors"
          />
        </div>
      </div>
    </Band>
  )}

  {/* 8. Why it costs what it costs, and what a cheaper quote leaves out. */}
  <Band ground="paper" still labelledby="services-why-heading" class="bg-muted">
    <div class="why">
      <div class="why-head">
        <h2 id="services-why-heading" class="type-headline">
          {whyH.head}
          {whyH.tail && ' '}
          {whyH.tail && <span class="voice">{whyH.tail}</span>}
        </h2>
        <p class="type-body band-sub">{page.why.sub}</p>
        {/* The last reason is the answer to "someone quoted me less": it gets
             the left column, set on a double rule like a total, so a director
             comparing quotes finds it without reading the list. */}
        {whyLast && (
          <div class="why-item why-feature">
            <h3>{whyLast.title}</h3>
            <p>{whyLast.body}</p>
          </div>
        )}
      </div>
      <div class="why-body">
        <ul class="why-list" role="list">
          {whyRest.map((item) => (
            <li class="why-item">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))}
        </ul>
        <p class="type-body why-closing">{page.why.closing}</p>
      </div>
    </div>
  </Band>

  {/* 9. Common questions. Native <details>, works without JavaScript. */}
  <Band ground="paper" still labelledby="services-faq-heading" id="faq">
    <div class="faq">
      <div class="faq-head">
        <h2 id="services-faq-heading" class="type-headline">
          {faqH.head}
          {faqH.tail && ' '}
          {faqH.tail && <span class="voice">{faqH.tail}</span>}
        </h2>
        <p class="type-body band-sub">{page.faq.sub}</p>
      </div>
      <div class="faq-list">
        {page.faq.items.map((item) => (
          <details class="faq-item">
            <summary>
              <span>{item.question}</span>
              <span class="faq-mark" aria-hidden="true" />
            </summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </Band>

  {/* 10. Close. */}
  <Band ground="paper" still labelledby="services-close-heading" class="bg-muted">
    <div class="close">
      <h2 id="services-close-heading" class="type-display close-title">
        {closeH.head}
        {closeH.tail && ' '}
        {closeH.tail && <span class="voice">{closeH.tail}</span>}
      </h2>
      <div class="close-side">
        <p class="type-body">{page.ctaSub ?? site.ctaDefault.sub}</p>
        <div class="svc-actions">
          <a href="/contact/" class={buttonVariants({ variant: 'brand', size: 'cta' })}>
            {site.ctaDefault.label}
            <span data-nudge aria-hidden="true">
              →
            </span>
          </a>
          <a href={site.emailHref} class="svc-textlink">
            {site.email}
          </a>
          <a href={site.phoneHref} class="svc-textlink">
            {site.phone}
          </a>
        </div>
      </div>
    </div>
  </Band>
</BaseLayout>

<style>
  /* ---- 1. Hero ------------------------------------------------------------ */
  .svc-hero-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .svc-hero-grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr);
    }
  }
  .svc-hero-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-h1);
    line-height: 0.92;
    letter-spacing: 0.01em;
    color: var(--heading);
    text-wrap: balance;
    max-width: 21ch;
    margin: 0;
  }
  /* The turn runs on from the caps and is set a step smaller than the usual
     voice, so the topic (the three services) stays the loudest line. */
  .svc-hero-title .voice {
    font-size: 0.74em;
    line-height: 1;
  }
  .svc-hero-intro {
    margin-top: 1.5rem;
    max-width: 44ch;
  }
  .svc-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }
  .svc-textlink {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--link) 40%, transparent);
    text-underline-offset: 0.2em;
  }
  .svc-textlink:hover {
    text-decoration-color: currentColor;
  }

  /* The price list slip: a small printed sheet laid on the windowsill. */
  .price-slip {
    background: var(--paper-raised);
    color: var(--foreground);
    border-radius: 2px;
    box-shadow: var(--shadow-print);
    padding: 1.5rem clamp(1.25rem, 3vw, 1.75rem) 1.25rem;
    max-width: 28rem;
    width: 100%;
  }
  @media (min-width: 64rem) {
    .price-slip {
      justify-self: end;
      transform: rotate(1.25deg);
    }
  }
  .slip-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 0 0 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 3px double var(--heading);
  }
  .slip-title {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    line-height: 1;
    color: var(--heading);
  }
  .slip-meta {
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    color: var(--muted-foreground);
  }
  .slip-lines {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .slip-lines a {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-height: 44px;
    padding-block: 0.65rem;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    font-family: var(--font-ui);
    font-size: var(--text-ui);
  }
  .slip-lines a:hover .slip-label,
  .slip-lines a:focus-visible .slip-label {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .slip-label {
    color: var(--heading);
  }
  /* Dot leaders, as on a printed price list. */
  .slip-dots {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1px dotted var(--muted-foreground);
    transform: translateY(-0.25em);
  }
  .slip-price {
    font-variant-numeric: tabular-nums lining-nums;
    font-weight: 600;
    color: var(--heading);
    white-space: nowrap;
  }
  .slip-foot {
    margin: 0.85rem 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.125rem;
    color: var(--marker);
  }

  /* ---- Chapters (Web design, Strategy, Photography) ------------------------ */
  .chapter {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }
  @media (min-width: 64rem) {
    .chapter {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .chapter--wide {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: center;
    }
    .chapter--flip .chapter-copy {
      order: 2;
    }
    .chapter--flip .chapter-proof {
      order: 1;
    }
  }
  .chapter-copy {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .chapter-copy > * {
    margin: 0;
  }
  .chapter-aside {
    max-width: 52ch;
  }
  .chapter-lede {
    max-width: 36ch;
  }
  .chapter-proof--doc {
    display: flex;
    justify-content: center;
  }
  /* Strategy: heading and price on one ruled line, the estimate's total. */
  .strat-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-bottom: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    border-bottom: 3px double var(--heading);
  }
