---
// Safe to edit. The arrays in this frontmatter (webPoints, strategyPoints,
// photoPoints, whyOnePerson, faq) hold the page's own copy. Prices come from
// src/data/pricing.ts only.
/* ============================================================================
   /services | What I do, and what it costs (overhaul package 2.5)
   ============================================================================
   Its job: size the project and start it. Section order IS the IA:

     Hero              H1 "What I do, and what it costs." (Heft on the
                       heavy phrase, the page's one weight animation). White,
                       no hairline (the header has its own edge).
     On this page      a sticky sub-nav under the header: Web design,
                       Photography, Pricing, Care, FAQ. `scroll-padding-top`
                       on <html> (set below, only while this nav is on the
                       page) keeps every anchored heading, and every focused
                       element, clear of the header and the nav
                       (WCAG 2.4.11, focus not obscured).
     Web design        one real capture in a BrowserFrame, the buyer-language
                       points, then strategy as "what's included", set as
                       type (no placeholder tile, no image). Paper.
     Recently shipped  two studies the home does NOT show (the home takes the
                       three lowest `order`), as small FramePairs. White.
     Photography       copy, points, the price from pricing.ts and a link to
                       /contact/?service=photography (the /photography page
                       is gated). No image: the photos in src/assets/about are
                       of Nathan, not by him, so none of them is proof of the
                       service. Paper.
     Pricing           PricingTeaser variant "full": ruled tiers, each
                       linking /contact/?tier=..., add-ons in <details>.
                       White. ("Size up your project", overhaul 3.3, goes
                       straight after this band when it is built.)
     Care              the four care levels, ruled the same way. Paper.
     How I work        ProcessBand, the same timeline as the home. White.
     Why one person    #why (the /about page links here). Paper.
     FAQ               native <details>, with the FAQPage JSON-LD built from
                       the same array, so the structured data is the visible
                       text word for word. White.
     Ink closer        the footer (BaseLayout), set by the `closer` prop.

   Surfaces alternate white and paper, so each hairline marks a real change,
   and the page ends on ink.

   PRICING LIVES IN src/data/pricing.ts. The tiers, add-ons and care levels
   render from it, and the FAQ answers and the JSON-LD offers read the same
   values (money() and dollars() in src/lib/money.ts), so a price changes in
   pricing.ts and nowhere else. tests/metadata.spec.ts checks every JSON-LD
   price is on the page.
   ============================================================================ */

import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Heft from '../components/Heft.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import FramePair from '../components/FramePair.astro';
import Media from '../components/Media.astro';
import PricingTeaser from '../components/PricingTeaser.astro';
import ProcessBand from '../components/ProcessBand.astro';
import { site } from '../data/site';
import { webTiers as tiers, addOns, carePlans } from '../data/pricing';
import { dollars, money } from '../lib/money';
import { addOnNamed, addOnOffer, careOffers, ids, tierOffers } from '../lib/schema';
import type { Closer } from '../lib/closer';

// ---------------------------------------------------------------------------
// Prices the copy quotes, read from pricing.ts so prose never disagrees with
// the ruled tiers.
const launch = tiers[0];
const signature = tiers.find((t) => t.highlighted) ?? tiers[1];
const flagship = tiers[tiers.length - 1];
const [signatureLow, signatureHigh] = dollars(signature.range);
const [hosting, lightCare, care, carePlus] = carePlans;
const [hourlyRate] = dollars(hosting.time);
const photography = addOnNamed(addOns, 'Photography');
const brandStrategy = addOnNamed(addOns, 'Brand & strategy');

// ---------------------------------------------------------------------------
// Studies. The home's Selected work takes the three lowest `order`; this page
// never repeats them. Of the rest (newest year first, then `order`), the first
// with a capture is the Web design frame and the next two are "Recently
// shipped". All of it is computed, so retiring or adding a study needs no
// edit here.
const studies = await getCollection('case-studies');
const shots = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/case-studies/shots/*-{home,mobile}.png',
  { eager: true },
);
const shot = (id: string, kind: 'home' | 'mobile'): ImageMetadata | undefined =>
  Object.entries(shots).find(([path]) => path.endsWith(`/${id}-${kind}.png`))?.[1].default;

const byOrder = [...studies].sort(
  (a, b) => (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER),
);
const notOnHome = byOrder
  .slice(3)
  .sort((a, b) => b.data.year - a.data.year)
  .map((entry) => ({ entry, desktop: shot(entry.id, 'home'), phone: shot(entry.id, 'mobile') }))
  .filter(
    (s): s is { entry: (typeof studies)[number]; desktop: ImageMetadata; phone: ImageMetadata } =>
      Boolean(s.desktop && s.phone && s.entry.data.liveUrl),
  );
const webShot = notOnHome[0];
const recent = notOnHome.slice(1, 3);

const host = (url: string) => new URL(url).hostname.replace(/^www\./, '');

// ---------------------------------------------------------------------------
// Copy.
const webLede =
  'Modern, accessible, fast websites built on the platform that fits you, from a custom-coded site to Squarespace or WordPress, and set up so your team can actually run it.';
const webBody =
  'I match the build to your budget and to whoever will maintain it after launch. Everything is built mobile-first and tested for accessibility from the very first screen, then handed off so you are never locked out of your own site.';
const webPoints = [
  'A custom design built to your brand, not a stock template',
  'Fast pages, with fonts and images served from your own site',
  'Layouts that work on every phone, tablet and desktop',
  'Accessible from the first screen, checked against WCAG AA',
  'Hosting set up for you, with year one included',
];

// Strategy is not a separate service any more: it is the front of every web
// project and already in the price, so it reads as "what's included".
const strategyBody =
  'Strategy always comes first. Without it, design becomes decoration. It starts with a working session together, then I write a short brief that the rest of the project follows.';
const strategyPoints = [
  'A working session, then back-and-forth until the plan is right',
  'Audience map and conversion path',
  'Content inventory of what you already have',
  'A one-page brief the rest of the project follows',
];

const photoLede =
  'Headshots, event coverage, and environmental photography shot for your website by the same person who designed it.';
const photoBody =
  'When the photographer and the designer are one person, the photos match the layout instead of fighting it. Images arrive edited, web-optimized, and ready to drop in.';
const photoPoints = [
  'On-site Sunday or weekday coverage',
  'Headshots for team and staff',
  'Environmental photography of your space',
  'Edited, web-optimized images delivered with the website',
];

// Why one person (#why). The old "Why it costs what it costs" points, which
// are all, at heart, about the studio being one person.
const whyOnePerson = [
  {
    title: 'One person, no handoffs',
    body: 'The person who plans your site designs it, builds it, and shoots the photos. No agency markup, and nothing lost in translation between a strategist, a designer, and a developer who never quite talk to each other.',
  },
  {
    title: 'Built to be handed off',
    body: 'Every site is set up so the next volunteer or staff member can keep it running, and you own it outright. A cheaper site that leaves you stranded the day the freelancer goes quiet costs far more to replace than it saved.',
  },
  {
    title: 'Accessible by default',
    body: 'Every page is built to WCAG AA and checked until it scores 100 for accessibility in Lighthouse. Plenty of budget builds never get checked at all. For a church, school, or nonprofit it is the right thing to do, and it is included, not an upsell.',
  },
  {
    title: 'Cheap is expensive later',
    body: 'A bargain site quietly runs into thousands a year once you bolt on the features it could not handle up front. I would rather build it once, on a stack that is nearly free to run and is yours to keep.',
  },
];

const faq = [
  {
    q: 'What does it cost?',
    a: `Websites start at ${money(launch.priceFrom)} for a focused ${launch.name} site. Most projects land between ${money(signatureLow)} and ${money(signatureHigh)}, and builds with real custom functionality start around ${money(flagship.priceFrom)}. Every build is custom, comes with a content system you can manage yourself, and includes year one hosting; what moves the number is scope, functionality, photography, and content. The first conversation is free and ends with an honest ballpark before anyone is committed, and larger projects can be split into monthly payments so the budget is about cash flow, not one big wall.`,
  },
  {
    q: 'What if I have been quoted less somewhere else?',
    a: 'You probably can find a cheaper quote, and for a very simple need that might be the right call. What a low quote usually leaves out is the part that matters later: accessibility, a content system your team can actually run, a plan for who maintains the site after launch, and someone who still answers the phone in a year. A site you have to rebuild in eighteen months is the expensive one. I would rather build it once.',
  },
  {
    q: 'How long does a typical project take?',
    a: 'Most websites land between six and ten weeks from kickoff to launch. Larger projects with custom photography or multiple content collections can run twelve to sixteen weeks. The brief at the end of strategy sets the real timeline.',
  },
  {
    q: 'Do I need a care plan after launch?',
    a: `Year one hosting is included in every build. After that, every live site needs Hosting at the least, and I quote care with every build. Your site is yours outright, but hosting, security patches, domains, and certificates all keep moving, and a site nobody is watching tends to break quietly and at a bad moment. ${hosting.name} is ${hosting.price} a year and covers hosting, uptime monitoring, daily backups, and renewals, with changes billed at ${money(hourlyRate)} an hour. If you would rather not make edits yourself, ${lightCare.name} (${lightCare.price} a month), ${care.name} (${care.price}), and ${carePlus.name} (${carePlus.price}) add monthly edit time, software updates, and faster replies. Unused hours do not roll over, and you can change or cancel with 30 days notice.`,
  },
  {
    q: 'Can you work with my existing brand?',
    a: 'Yes. If you already have a logo, palette, and type system, I use it. If you do not, brand work can be folded into the strategy phase or scoped separately.',
  },
  {
    q: 'Where are you based, and do you work with clients outside Cincinnati?',
    a: "I'm based in Cincinnati, but web design, strategy, and brand work happen with clients anywhere, fully remote when that is easier. Photography is the one piece that needs me on site, so that stays within the greater Cincinnati region.",
  },
];

// The sticky sub-nav. Each href is the id of a section's H2.
const onThisPage = [
  { label: 'Web design', href: '#web-design' },
  { label: 'Photography', href: '#photography' },
  { label: 'Pricing', href: '#pricing' },
  { label: 'Care', href: '#care' },
  { label: 'FAQ', href: '#faq' },
];

// The ink closer. "Aware of the tier": the page has just priced three tiers,
// so the closer answers the question it leaves ("which one am I?"). Package
// 3.3's "Size up your project" will prefill the pill's link with the tier a
// visitor lands on; until then it tells /contact the visitor came from here.
const closer: Closer = {
  heading: 'Not sure which tier',
  emphasis: 'fits?',
  sub: 'Tell me what you are building and I will tell you honestly where it lands. The first conversation is free, and it ends with a ballpark before anything is signed.',
  href: '/contact/?from=services',
};

// ---------------------------------------------------------------------------
// JSON-LD for /services, added to the site-wide @graph: a Service per
// offering with Offers read from pricing.ts (the same values the page prints;
// tests/metadata.spec.ts checks each one is on the page), a Service for care
// after launch, and the FAQPage, built from the same `faq` array the page
// renders. FAQPage is plain structured data for search engines and AI answer
// tools; Google stopped showing FAQ rich results for most sites in 2023, so it
// promises no search feature.
const studio = (id: string, name: string, description: string, regional = false) => ({
  '@type': 'Service',
  '@id': `${site.url}/services/#${id}`,
  name,
  description,
  provider: { '@id': ids.studio },
  // Photography needs me on site, so it stays regional; the rest serves
  // clients anywhere.
  areaServed: regional
    ? 'Greater Cincinnati region'
    : ['Greater Cincinnati region', 'United States'],
});
const schemas = [
  { ...studio('strategy', 'Strategy', strategyBody), offers: [addOnOffer(brandStrategy)] },
  { ...studio('web-design', 'Web design', webBody), offers: tierOffers(tiers) },
  {
    ...studio('photography', 'Photography', photoBody, true),
    offers: [addOnOffer(photography)],
  },
  {
    ...studio(
      'care',
      'Care after launch',
      'Hosting, updates and monthly edit time for a site after launch. Year one hosting is included in every build.',
    ),
    offers: careOffers(carePlans),
  },
  {
    '@type': 'FAQPage',
    '@id': `${site.url}/services/#faq`,
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---

<BaseLayout
  title="Services and pricing | Nixon Creative Studio"
  description={`Strategy, web design and photography, with prices on the page: websites from ${money(launch.priceFrom)}, care from ${hosting.price} a year, photography ${photography.price}.`}
  schemas={schemas}
  closer={closer}
>
  <div class="svc">
    <!-- Hero. The H1 is the page's one Heft; no data-reveal in the first
         viewport (ruling 3). -->
    <Section
      rail="Services"
      railMeta={`From ${money(launch.priceFrom)}`}
      hairline={false}
      labelledby="services-heading"
    >
      <h1 id="services-heading" class="svc-h1">
        What I do, and <Heft text="what it costs." />
      </h1>
      <p class="svc-lede">
        Websites for churches, schools, nonprofits and small businesses, with photography shot for
        the site. Every price is on this page, and the first conversation ends with an honest scope,
        not a sales pitch.
      </p>
    </Section>

    <!-- On this page. Sticky under the header for the rest of the page (its
         containing block is .svc). Below md it scrolls sideways inside itself
         rather than wrapping, so it stays one short bar. -->
    <nav class="svc-subnav" aria-label="On this page">
      <div class="ncs-container svc-subnav-inner">
        <p class="svc-subnav-label" aria-hidden="true">
          On this page
        </p>
        <ul class="svc-subnav-list" role="list">
          {onThisPage.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <!-- Web design: one real capture, the buyer points, then strategy as type. -->
    <Section
      rail="Web design"
      railMeta={`${studies.length} studies`}
      tone="paper"
      labelledby="web-design"
    >
      <h2 id="web-design" class="svc-h2">
        Web <b>design</b>
      </h2>

      <div class="svc-web">
        <div class="svc-web-copy">
          <p class="svc-lede">{webLede}</p>
          <p class="svc-body">{webBody}</p>
          <ul class="svc-points" role="list">
            {webPoints.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
        {webShot && (
          <figure class="svc-web-shot">
            <BrowserFrame url={webShot.entry.data.liveUrl!}>
              <Media
                src={webShot.desktop}
                alt={`The ${webShot.entry.data.client} homepage, designed and built by me`}
                ratio="16 / 10"
                position="top"
                widths={[480, 720, 960]}
                sizes="(min-width: 82.5rem) 34rem, (min-width: 48rem) 45vw, calc(100vw - 2rem)"
              />
            </BrowserFrame>
            <figcaption>
              <a href={`/work/${webShot.entry.id}/`}>{webShot.entry.data.client}</a>
              <span aria-hidden="true">·</span>
              <span>{webShot.entry.data.year}</span>
            </figcaption>
          </figure>
        )}
      </div>

      <div class="svc-strategy" id="strategy">
        <h3 class="svc-h3">
          What's included: <b>strategy</b>, first
        </h3>
        <p class="svc-body">{strategyBody}</p>
        <ol class="svc-type-list" role="list">
          {strategyPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ol>
        <p class="svc-small">
          Strategy is the front of every project, not a line item. The prices below already include
          the session and the brief, and year one hosting too.
        </p>
      </div>
    </Section>

    <!-- Recently shipped: two studies the home does not show. -->
    {recent.length > 0 && (
      <Section
        rail="Recently shipped"
        railMeta={`${recent.length} of ${studies.length}`}
        labelledby="recent-heading"
      >
        <h2 id="recent-heading" class="svc-h2">
          Recently <b>shipped</b>
        </h2>
        <ul class="svc-recent" role="list">
          {recent.map(({ entry, desktop, phone }) => (
            <li class="svc-recent-item">
              <FramePair
                url={entry.data.liveUrl!}
                desktop={desktop}
                phone={phone}
                alt={`The ${entry.data.client} homepage on a laptop and a phone`}
                sizes="(min-width: 82.5rem) 26rem, (min-width: 48rem) 34vw, 80vw"
                phoneSizes="(min-width: 48rem) 9vw, 22vw"
              />
              <h3 class="svc-recent-title">
                <a href={`/work/${entry.id}/`}>{entry.data.client}</a>
              </h3>
              {entry.data.hook && <p class="svc-body">{entry.data.hook}</p>}
              <a
                class="svc-host"
                href={entry.data.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {host(entry.data.liveUrl!)}
                <span aria-hidden="true">↗</span>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )}

    <!-- Photography. No image on purpose (see the header comment). -->
    <Section rail="Photography" railMeta="Cincinnati region" tone="paper" labelledby="photography">
      <h2 id="photography" class="svc-h2">
        Photos shot <b>for the site</b>
      </h2>
      <div class="svc-photo">
        <div>
          <p class="svc-lede">{photoLede}</p>
          <p class="svc-body">{photoBody}</p>
        </div>
        <div>
          <ul class="svc-points" role="list">
            {photoPoints.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
          <p class="svc-price">
            <span class="svc-price-amount">{photography.price}</span>
          </p>
          <p class="svc-small">{photography.note}</p>
          <a class="svc-arrow" href="/contact/?service=photography">
            Ask about photography <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </Section>

    <!-- Pricing: the shared ruled tiers. "Size up your project" (3.3) goes
         straight after this, before Care. -->
    <PricingTeaser variant="full" tone="white" headingId="pricing" />

    <!-- Care after launch, ruled like the tiers. -->
    <Section rail="Care" railMeta={`From ${hosting.price} a year`} tone="paper" labelledby="care">
      <h2 id="care" class="svc-h2">
        Care after <b>launch</b>
      </h2>
      <p class="svc-body svc-measure">
        A website is not something you print once. Hosting, security, domains, and certificates keep
        moving, so every site I launch is quoted with care. Year one hosting is included in every
        build. After that, Hosting is the part every live site needs, and the monthly levels add
        edit time for when you would rather not do it yourself.
      </p>
      <ul class="svc-care" role="list">
        {carePlans.map((plan) => (
          <li class="svc-care-plan">
            <h3 class="svc-care-name">{plan.name}</h3>
            <p class="svc-care-who">{plan.who}</p>
            <p class="svc-price">
              <span class="svc-price-amount">{plan.price}</span>
              <span class="svc-price-period">{plan.period}</span>
            </p>
            <p class="svc-care-time">{plan.time}</p>
            <ul class="svc-care-features">
              {plan.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
      <p class="svc-small svc-measure">
        Unused hours do not roll over. Anything beyond your plan is quoted in writing first. Change
        or cancel with 30 days notice.
      </p>
    </Section>

    <ProcessBand tone="white" headingId="process-heading" />

    <!-- Why one person. /about links to #why. -->
    <Section rail="Why one person" railMeta="No handoffs" tone="paper" labelledby="why">
      <h2 id="why" class="svc-h2">
        Why <b>one person</b>
      </h2>
      <p class="svc-body svc-measure">
        Plenty of people will quote you less. Here is what the price actually buys, and what a
        cheaper one usually leaves out.
      </p>
      <ul class="svc-why" role="list">
        {whyOnePerson.map((point) => (
          <li>
            <h3 class="svc-why-title">{point.title}</h3>
            <p class="svc-body">{point.body}</p>
          </li>
        ))}
      </ul>
      <p class="svc-body svc-measure svc-why-tools">
        I build with modern tools, including AI-assisted workflows, the same way I use frameworks
        and a camera. They help one person do the work of a team. The strategy, the design, and the
        accountability stay mine, start to finish.
      </p>
    </Section>

    <!-- FAQ. Native <details>; the FAQPage JSON-LD is built from the same
         array, so it always equals this text. -->
    <Section rail="FAQ" railMeta={`${faq.length} questions`} labelledby="faq">
      <h2 id="faq" class="svc-h2">
        Common <b>questions</b>
      </h2>
      <div class="svc-faq">
        {faq.map((item) => (
          <details class="svc-faq-item">
            <summary>{item.q}</summary>
            <div class="svc-faq-answer">
              <div>
                <p>{item.a}</p>
              </div>
            </div>
          </details>
        ))}
      </div>
    </Section>
  </div>
</BaseLayout>

<script>
  // The sub-nav sticks right under the header, whose height changes with the
  // viewport (and the wordmark's font). This measures it and hands the number
  // to CSS (--svc-header-h on <html>), which positions the nav and sets
  // scroll-padding-top. Without JavaScript the CSS fallbacks are used, which
  // match the header's measured heights closely. Re-binds on every
  // astro:page-load (View Transitions) and is a no-op on other pages.
  let observer: ResizeObserver | undefined;

  function measure() {
    observer?.disconnect();
    observer = undefined;
    const nav = document.querySelector<HTMLElement>('.svc-subnav');
    const header = document.querySelector<HTMLElement>('[data-header]');
    const root = document.documentElement;
    if (!nav || !header) {
      root.style.removeProperty('--svc-header-h');
      return;
    }
    const write = () =>
      root.style.setProperty(
        '--svc-header-h',
        `${Math.ceil(header.getBoundingClientRect().height)}px`,
      );
    write();
    observer = new ResizeObserver(write);
    observer.observe(header);
  }

  document.addEventListener('astro:page-load', measure);
</script>

<style>
  /* ---- Sticky geometry ----------------------------------------------------
     --svc-header-h: the header's height, measured by the script above.
     --svc-header-fallback: the same without JS. The header's padding is
     fluid, measured at 77px up to 640px wide, 79 at 768, 88 at 1024 and 95
     from 1280; this line runs a pixel or so above it, so the nav never
     tucks under the header.
     --svc-subnav-h: the sub-nav's own height, fixed here so it is known.
     scroll-padding-top on <html>, only while the sub-nav is on the page, puts
     an anchored heading (and any element brought into view by focus) below
     both bars with a little air (WCAG 2.4.11). */
  :global(html:has(.svc-subnav)) {
    --svc-header-fallback: clamp(4.875rem, calc(3.75rem + 2.8125vw), 6rem);
    --svc-subnav-h: 3rem;
    scroll-padding-top: calc(
      var(--svc-header-h, var(--svc-header-fallback)) + var(--svc-subnav-h) + 1.25rem
    );
  }

  .svc-subnav {
    position: sticky;
    top: var(--svc-header-h, var(--svc-header-fallback));
    z-index: 40;
    height: var(--svc-subnav-h);
    background-color: color-mix(in oklab, var(--background) 94%, transparent);
    border-block: 1px solid var(--line);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .svc-subnav-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 100%;
  }
  .svc-subnav-label {
    display: none;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  @media (min-width: 48rem) {
