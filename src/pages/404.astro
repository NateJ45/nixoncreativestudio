---
// Safe to edit. Friendly 404. Astro picks this up automatically for any
// route that doesn't match a real page and answers it with a REAL 404 status
// (src/worker.ts only rewrites the status to 200 for the literal path /404/, so
// Lighthouse CI can audit the template). The words are the Not-found page entry
// in the CMS, with the committed fallback in cms/content/page_not_found.json.
/* ============================================================================
   /404 | Page not found
   ============================================================================
   One band on the paper-contours ground: a lost visitor is looking at the map,
   which is where the Ohio River's contours belong. Left, the voice ("That page
   wandered off." with the last two words in the italic), the CMS body and the CMS
   links (the first is the button). Right, "Or go straight to", the site's own
   primary menu as large links, so a visitor who followed a dead link can reach
   any page in one click (the Journal entry is left out while there are no posts,
   exactly as in the header). A big "404" sits behind in the river's slate, as
   decoration only.

   The numeral is drawn by CSS (.notfound-glyph::before), not a text node: it is
   decoration under WCAG 1.4.3, and as a real text node axe read it as body copy
   and failed the page (Lighthouse accessibility 0.96 on staging, 2026-09-06).
   Nothing here starts at opacity 0 and nothing needs JavaScript.
   ============================================================================ */

import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/Band.astro';
import { buttonVariants } from '../components/ui/button';
import { getSite } from '../data/site';
import { getMenuItems } from '../lib/cms';
import { hasJournalEntries } from '../lib/journal';
import { getNotFoundPage, indexTitle } from '../lib/indexPages';
import { splitVoice } from '../lib/voice';

const site = await getSite(Astro);
// A real unknown URL answers 404 and must never reach the route cache (the layout
// already skips cachePublicPage for it, and src/worker.ts forces no-store on any non-200),
// so the reads only tag the page when it is rendered as a 200, i.e. for /404/ itself.
const cache = (Astro.response.status ?? 200) < 400 ? Astro.cache : undefined;
const page = await getNotFoundPage({ cache });
const menu = await getMenuItems('primary', { cache });
const showJournal = await hasJournalEntries(Astro);

// The first link is the button, the rest are plain links.
const [primaryLink, ...otherLinks] = page.links;
const { lead, voice } = splitVoice(page.heading);

// The primary menu as destinations (trailing slashes already applied by getMenuItems).
const destinations = menu.filter((item) => showJournal || !item.url.startsWith('/journal'));
---

<BaseLayout title={indexTitle(page.seoTitle, site.studioName)} description={page.seoDescription}>
  <Band ground="paper-contours" underHeader labelledby="notfound-heading" class="notfound-band">
    <div class="notfound-grid">
      <div class="notfound-copy">
        <div class="notfound-numeral" aria-hidden="true">
          <span class="notfound-glyph"></span>
        </div>

        <h1 id="notfound-heading" class="type-display notfound-title">
          {lead}
          {voice && <span class="voice">{voice}</span>}
        </h1>

        <p class="type-lede">{page.body}</p>

        <div class="notfound-actions">
          <a href={primaryLink.href} class={buttonVariants({ variant: 'brand', size: 'cta' })}>
            {primaryLink.label}
          </a>
          {otherLinks.map((link) => (
            <a class="card-link" href={link.href}>
              {link.label}
            </a>
          ))}
        </div>

        <p class="type-caption">{page.label}</p>
      </div>

      {destinations.length > 0 && (
        <nav class="notfound-nav" aria-label="Pages on this site">
          <p class="type-caption notfound-nav-label">Or go straight to</p>
          <ul>
            {destinations.map((item) => (
              <li>
                <a href={item.url}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </Band>
</BaseLayout>

<style>
  .notfound-band {
    min-height: min(80vh, 52rem);
    display: flex;
    align-items: center;
  }
  .notfound-grid {
    display: grid;
    gap: var(--spacing-xl);
    align-items: end;
  }
  @media (min-width: 64rem) {
    .notfound-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    }
  }
  .notfound-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-m);
  }
  .notfound-title {
    font-size: var(--text-h1);
    max-width: 14ch;
  }
  .notfound-title .voice {
    display: block;
  }
  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-s) var(--spacing-l);
  }

  /* The numeral, as generated content (see the note at the top). Decoration only:
     the river's slate, large, sitting above the headline. */
  .notfound-numeral {
    pointer-events: none;
    user-select: none;
    line-height: 0.8;
  }
  .notfound-glyph {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(5rem, 16vw, 11rem);
    line-height: 0.8;
    letter-spacing: 0.01em;
    color: var(--river);
  }
  .notfound-glyph::before {
    content: '404';
  }

  /* The menu as large links, set on hairlines like a ledger. */
  .notfound-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .notfound-nav li {
    border-bottom: 1px solid var(--border);
  }
  .notfound-nav a {
    display: block;
    padding-block: 0.6rem;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--heading);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .notfound-nav a:hover,
  .notfound-nav a:focus-visible {
    color: var(--link);
  }
  .notfound-nav-label {
    margin-bottom: var(--spacing-xs);
  }
</style>
