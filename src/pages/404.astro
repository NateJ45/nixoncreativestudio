---
// Safe to edit. Friendly 404. Astro picks this up automatically for any
// route that doesn't match a real page; Cloudflare Pages serves it as
// the static fallback for unknown paths in production.
/* ============================================================================
   /404 | Page not found
   ============================================================================
   Hero-style single column, centered. An oversized low-opacity navy "404"
   anchors the page as a quiet centerpiece, the "this page lost its weight"
   copy sits below, and the same helpful links carry visitors back into the site.
   The H1 runs Heft in reverse (overhaul 1.7, ruling 9): "lost its weight."
   starts heavy and drains to a hairline 200 once on load. Under reduced
   motion, without JS or under Pause motion it simply shows that end state.
   The whole block is the first viewport, so nothing here takes data-reveal
   (ruling 3). The "404" floats gently: a data-motion="loop", so it holds
   still off-screen and under Pause motion, and the local @media rule stops
   it under prefers-reduced-motion.
   ============================================================================ */

import BaseLayout from '../layouts/BaseLayout.astro';
import { buttonVariants } from '../components/ui/button';
import Heft from '../components/Heft.astro';
---

<BaseLayout
  title="Page not found | Nixon Creative Studio"
  description="This page lost its weight. Head back to the homepage, look through my case studies, or tell me what you were looking for and I'll point you to it."
>
  <section
    class="relative isolate flex min-h-[70vh] items-center overflow-hidden py-2xl"
    aria-labelledby="notfound-heading"
  >
    <div class="ncs-container flex flex-col items-center gap-m text-center">
      {/* Oversized quiet centerpiece. A low-opacity navy numeral as a backdrop.
          Decorative: the real "404" meaning is announced in the line below, so
          this is aria-hidden.

          The glyph itself is drawn by CSS (.notfound-glyph::before) rather than
          being a text node. It is pure decoration under WCAG 1.4.3, which is
          the only reason its 10-20% opacity is allowed to sit below the 3:1
          text-contrast bar; as a real text node axe read it as body copy and
          failed the page (Lighthouse accessibility 0.96 on staging,
          2026-09-06). Generated content keeps the exact same rendering and puts
          it where decoration belongs. */}
      <div
        class="notfound-figure pointer-events-none leading-none select-none"
        aria-hidden="true"
        data-motion="loop"
      >
        <span class="notfound-glyph block font-display text-[clamp(7rem,28vw,18rem)] leading-[0.85] tracking-tight text-heading/10 dark:text-heading/20"></span>
      </div>

      {/* Quiet mono label above the heading. Lowercase and lightly tracked so
          it reads as a small status line, not a shouted section eyebrow. */}
      <p class="font-mono text-sm text-text-muted">Page not found</p>

      <h1 id="notfound-heading" class="max-w-[18ch]">
        This page <Heft text="lost its weight." reverse />
      </h1>

      <p class="max-w-[50ch] text-lg leading-[1.6] text-text">
        The link you followed might be old, or the address might be a typo. Nothing's broken on this
        end. Here are a few places to try instead.
      </p>

      <div class="mt-s flex flex-wrap items-center justify-center gap-m">
        <span class="inline-block">
          <a href="/" class={buttonVariants({ variant: 'brand', size: 'cta' })}>
            Back to home
          </a>
        </span>
        <a class="card-link" href="/work/">
          See selected work
        </a>
        <a class="card-link" href="/contact/">
          Get in touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The numeral, as generated content. See the note in the markup: it is
     decoration, so it is drawn here instead of being a text node that
     contrast tooling reads as copy. Font, size, tracking and color all come
     from the utility classes on the host span. */
  .notfound-glyph::before {
    content: '404';
  }

  /* Gentle drift for the oversized 404, which keeps the page quietly alive.
     Off for visitors who prefer reduced motion, and held still under Pause
     motion (data-motion="loop" on the figure). */
  .notfound-figure {
    animation: notfound-float 7s ease-in-out infinite;
    will-change: transform;
  }

  @keyframes notfound-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notfound-figure {
      animation: none;
    }
  }
</style>
