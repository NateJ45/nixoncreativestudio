---
/* The 404: the numerals as a drawing caught mid-edit (an outline with a square
   on every anchor point, src/lib/not-found-art.ts), one client window knocked
   askew, the address that failed, and two links. The drawing is decoration and
   aria-hidden; the heading says what happened. */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/404.css';
import Tile from '../components/Tile.astro';
import { getClients } from '../lib/clients';
import { plainText, wordSpans } from '../lib/words';
import { VIEW, artPaths } from '../lib/not-found-art';

const clients = await getClients();
const first = clients[0];
const heading = `This page <b>isn't here.</b>`;
const art = artPaths();
---

<BaseLayout
  title="Page not found | Nixon Creative Studio"
  description="This page isn't here. Head back to the homepage or look through my work."
  notFound
>
  <div class="nf">
    <header class="page-head">
      <div class="nf-num" aria-hidden="true" data-nf>
        <svg viewBox={`${VIEW.x} ${VIEW.y} ${VIEW.w} ${VIEW.h}`} focusable="false">
          <path class="nf-o" d={art.outline} />
          <path class="nf-h" d={art.handles} />
          <path class="nf-e" d={art.ends} />
          <path class="nf-a" d={art.anchors} />
          <path class="nf-ai" d={art.anchors} />
        </svg>
      </div>
      <h1 aria-label={plainText(heading)} set:html={wordSpans(heading)} />
      <p class="lede">
        The link you followed might be old, or the address might be a typo. Nothing's broken on this
        end. Here are a few places to try instead.
      </p>
      <p class="lost" hidden>
        Not found: <span data-path></span>
      </p>
      <div class="nf-links">
        <a class="chip dark" href="/work/">
          See the work
        </a>
        <a class="chip" href="/">
          Back to home
        </a>
      </div>
    </header>
    <div class="knock" data-knock>
      <Tile client={first} direct lazy index={0} />
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/not-found.js';
</script>
