---
// Safe to edit. Friendly 404. Astro picks this up automatically for any
// route that doesn't match a real page and answers it with a REAL 404 status
// (src/worker.ts only rewrites the status to 200 for the literal path /404/, so
// Lighthouse CI can audit the template). The words are the Not-found page entry
// in the CMS, with the committed fallback in cms/content/page_not_found.json.
/* ============================================================================
   /404 | Page not found
   ============================================================================
   Hero-style single column, centered. An oversized low-opacity navy "404"
   anchors the page as a quiet centerpiece, the warm "that page wandered off"
   copy sits below, and the same helpful links carry visitors back into the site.
   The whole block reveals in on load. The "404" floats gently (and the
   float pauses under prefers-reduced-motion via the local @media rule).
   ============================================================================ */

import BaseLayout from '../layouts/BaseLayout.astro';
import { buttonVariants } from '../components/ui/button';
import { getSite } from '../data/site';
import { getNotFoundPage, indexTitle } from '../lib/indexPages';

const site = await getSite(Astro);
// A real unknown URL answers 404 and must never reach the route cache (the layout
// already skips cachePublicPage for it, and src/worker.ts forces no-store on any non-200),
// so the read only tags the page when it is rendered as a 200, i.e. for /404/ itself.
const page = await getNotFoundPage({
  cache: (Astro.response.status ?? 200) < 400 ? Astro.cache : undefined,
});
// The first link is the blue button, the rest are plain links.
const [primaryLink, ...otherLinks] = page.links;
---

<BaseLayout title={indexTitle(page.seoTitle, site.studioName)} description={page.seoDescription}>
  <section
    class="relative isolate flex min-h-[70vh] items-center overflow-hidden py-2xl"
    aria-labelledby="notfound-heading"
  >
    <div class="ncs-container flex flex-col items-center gap-m text-center">
      {/* Oversized quiet centerpiece. A low-opacity navy numeral as a backdrop.
          Decorative: the real "404" meaning is announced in the line below, so
          this is aria-hidden.

          The glyph itself is drawn by CSS (.notfound-glyph::before) rather than
          being a text node. It is pure decoration under WCAG 1.4.3, which is
          the only reason its 10-20% opacity is allowed to sit below the 3:1
          text-contrast bar; as a real text node axe read it as body copy and
          failed the page (Lighthouse accessibility 0.96 on staging,
          2026-09-06). Generated content keeps the exact same rendering and puts
          it where decoration belongs. */}
      <div
        class="notfound-figure pointer-events-none leading-none select-none"
        aria-hidden="true"
        data-reveal="scale"
      >
        <span class="notfound-glyph block font-display text-[clamp(7rem,28vw,18rem)] leading-[0.85] tracking-tight text-heading/10"></span>
      </div>

      {/* Quiet mono label above the heading. Lowercase and lightly tracked so
          it reads as a small status line, not a shouted section eyebrow. */}
      <p class="font-mono text-sm text-text-muted" data-reveal style="--reveal-delay: 80ms">
        {page.label}
      </p>

      <h1
        id="notfound-heading"
        class="max-w-[18ch] leading-[0.95]"
        data-reveal
        style="--reveal-delay: 160ms"
      >
        {page.heading}
      </h1>

      <p
        class="max-w-[50ch] text-lg leading-[1.6] text-text"
        data-reveal
        style="--reveal-delay: 240ms"
      >
        {page.body}
      </p>

      <div
        class="mt-s flex flex-wrap items-center justify-center gap-m"
        data-reveal
        style="--reveal-delay: 320ms"
      >
        <span class="inline-block">
          <a href={primaryLink.href} class={buttonVariants({ variant: 'brand', size: 'cta' })}>
            {primaryLink.label}
          </a>
        </span>
        {otherLinks.map((link) => (
          <a class="card-link" href={link.href}>
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The numeral, as generated content. See the note in the markup: it is
     decoration, so it is drawn here instead of being a text node that
     contrast tooling reads as copy. Font, size, tracking and color all come
     from the utility classes on the host span. */
  .notfound-glyph::before {
    content: '404';
  }

  /* Gentle drift for the oversized 404. The reveal vocabulary handles the
     entrance; this keeps it quietly alive afterward. Paused for visitors who
     prefer reduced motion. */
  .notfound-figure {
    animation: notfound-float 7s ease-in-out infinite;
    will-change: transform;
  }

  @keyframes notfound-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notfound-figure {
      animation: none;
    }
  }
</style>
