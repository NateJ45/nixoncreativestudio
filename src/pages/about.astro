---
// Safe to edit. The page words, photos, principles, Currently lists and
// Lighthouse numbers live in the EmDash admin (Pages, "About page"; read through
// getAboutPage in src/lib/aboutPage.ts, with cms/content/page_about.json as the
// committed fallback). This file holds the layout. The Testimonials band reads
// the EmDash CMS too, so this page is server-rendered (see the note above the
// template).
/* ============================================================================
   /about | About Nathan Nixon  [editorial-grid revamp]
   ============================================================================
   One page-wide editorial grid, reused by every section, so the whole page
   reads as a single ruled document with ONE dead-straight left axis:

     [ 13rem marker rail ] [ content track ]

   - The LEFT rail is a quiet mono WORD label (ABOUT / IN SHORT / STORY /
     PRACTICE / NOW) plus a little real meta where it helps (the location stamp,
     the Currently freshness + last-updated). The labels are decorative
     (aria-hidden), never headings, so the heading tree stays clean. Below lg the
     rail collapses and its label sits as a small kicker above each heading.
   - The RIGHT track holds every heading and all real content on one left edge.
     Running prose is capped to a readable measure; the h1, the thesis quote, the
     Terminal, and the principle bodies break out to the full track width, so no
     row leaves a lonely text ribbon in a wide field and nothing is centered.

   Section rhythm is one token (py) plus a single border-t hairline opening every
   section after the masthead, so the page is one continuous ruled column instead
   of a stack of slabs. The page is mostly ONE surface in both themes: the ruled
   editorial column carries no full-bleed background bands mid-page (the old
   bg-mesh-soft seam is gone). The inset surface changes are the single Currently
   .surface-card and, near the foot, the Testimonials band.

   Two deliberate full-bleed exceptions sit at the TAIL of the page, after the
   ruled column ends: the Testimonials .band-themed band (the .band-themed surface
   is owned by Testimonials.astro itself, not set here) and the closing CtaBanner.
   Both are intentional closing beats, not mid-column slabs, so the editorial
   one-surface read holds through every section above them.

   Motion: the existing data-reveal / spotlight vocabulary only, reduced-motion
   safe. No scroll-spy, no sticky positioning, no new JS.
   ============================================================================ */

import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Testimonials from '../components/Testimonials.astro';
import Terminal from '../components/Terminal.astro';
import LighthouseScore from '../components/LighthouseScore.astro';
import Lightbox from '../components/Lightbox.astro';
import { Image } from 'astro:assets';
import { blockHtml, restrictPortableText } from '../lib/portableText';
import EmDashPhoto from '../components/emdash/EmDashPhoto.astro';
import { getSite } from '../data/site';
import {
  aboutTitle,
  buildPersonSchema,
  freshnessLabel,
  getAboutPage,
  updatedLabel,
} from '../lib/aboutPage';

// Contact details, socials and the owner name come from Site settings in the CMS
// (with the committed fallback), shared with the header and footer. The words,
// photos, Currently lists and scores come from the About page entry (also with the
// committed fallback, which is what production serves until its data is loaded).
const site = await getSite(Astro);
const about = await getAboutPage(Astro);

// Pictures bundled with the site, resized at request time by the same /_image
// resizer as the CMS media. They are what the committed fallback points at
// (cms/content/page_about.json names each by its repo path), so the page still
// shows its pictures while the CMS is empty. A CMS entry carries real EmDash
// media instead and renders through EmDashPhoto (a resized WebP from /_image).
import headshot from '../assets/brand/headshot.jpg';
import familyPhoto from '../assets/about/family.jpg';
import runningPhoto from '../assets/about/running.jpg';
import exploringPhoto from '../assets/about/exploring.jpg';
import weddingPhoto from '../assets/about/wedding.jpg';
import portraitBwPhoto from '../assets/about/portrait-bw.jpg';
const bundled: Record<string, ImageMetadata> = {
  'src/assets/brand/headshot.jpg': headshot,
  'src/assets/about/family.jpg': familyPhoto,
  'src/assets/about/running.jpg': runningPhoto,
  'src/assets/about/exploring.jpg': exploringPhoto,
  'src/assets/about/wedding.jpg': weddingPhoto,
  'src/assets/about/portrait-bw.jpg': portraitBwPhoto,
};

// "Outside the studio" gallery. Real, lightly captioned snapshots of the life
// behind the one-person studio. Captions are honest and deliberately generic
// (no names), so nothing presumes more than the photo shows. Each photo is a
// click / keyboard zoom trigger for the shared Lightbox at the foot of the page.
// A photo is either CMS media (`image`) or a bundled asset (`file`); one with
// neither bundled asset nor media is dropped, never rendered half-built.
const photos = about.outside.photos.flatMap((photo) =>
  photo.image || (photo.file && bundled[photo.file])
    ? [{ ...photo, src: photo.file ? bundled[photo.file] : undefined }]
    : [],
);
const headshotSrc = about.headshot.file ? bundled[about.headshot.file] : undefined;

// The story: a Portable Text field reduced to paragraphs (headings become
// paragraphs, pictures and other blocks are ignored; bold, italic and safe links
// are the only marks) and rendered as bare <p> elements. It deliberately does NOT
// use RestrictedPortableText: that hands the blocks to emdash/ui's PortableText,
// whose 9.5 KB stylesheet would add a render-blocking <link> to this page, and a
// story of paragraphs needs none of it (measured in the PR 8 parity run).
const storyParagraphs = restrictPortableText(about.story.body).map((b) => blockHtml(b));

// The Currently block (merged in from the old standalone /now page, a Derek
// Sivers-style snapshot) is rewritten about once a quarter in the admin (Pages,
// About page). The freshness pill and the "last updated" stamp read the
// "Currently last updated" date, so the section stays honest.
const lastUpdatedLabel = updatedLabel(about.currently.updated);
const freshness = freshnessLabel(about.currently.updated);

// Capacity signals. status drives the chip color and the readable label, so
// availability never reads on color alone. open -> green, limited -> amber.
const statusMeta = {
  // Status text must clear AA (4.5:1, it is text-xs small text) on the now-sheet
  // .surface-card in BOTH themes. The brand amber (--tertiary) only passes on the
  // navy heroes, not on light, so "limited" uses amber-700 on light, mirroring the
  // emerald pattern. In dark mode the shades are lifted to amber-300 / emerald-300:
  // lighter shades on the dark navy card give more headroom over the 4.5:1 line
  // than the -400s, so the small chip text stays comfortably legible. The dot color
  // stays brand and is decorative; the readable word carries the meaning, never color.
  open: { word: 'Open', dot: 'bg-emerald-500', text: 'text-emerald-700' },
  limited: { word: 'Limited', dot: 'bg-tertiary', text: 'text-amber-700' },
};

// Reused layout tokens. railGrid is the page's one asymmetric grid; railLabel is
// the quiet mono word-label in the left rail.
const railGrid =
  'grid grid-cols-1 gap-x-[clamp(2rem,5vw,4rem)] gap-y-3 lg:grid-cols-[13rem_minmax(0,1fr)] lg:items-start';
const railLabel = 'font-mono text-sm uppercase tracking-[0.08em] text-text-muted';

// JSON-LD schemas specific to the About page: Person for the studio owner,
// linked back to the Organization defined site-wide. Built from the page entry's
// job title and the site settings, so it can never disagree with the page.
const schemas = [buildPersonSchema(about, site)];

// Server-rendered like every page (CMS-DESIGN PR 2). The Testimonials band reads case studies from EmDash (D1) at request time.
// The route cache is tagged with the case studies this page read (BaseLayout sets
// the lifetime; see src/lib/routeCache.ts), so a publish purges it.
---

<BaseLayout
  title={aboutTitle(about.seoTitle, site.studioName)}
  description={about.seoDescription}
  schemas={schemas}
>
  <!-- ====================================================================
       Masthead (ABOUT). The page head: who Nathan is, paired with the
       portrait placeholder. Establishes the rail + track spine on the first
       screen. No top hairline (it opens the page).
       ==================================================================== -->
  <section class="pt-2xl pb-2xl" aria-labelledby="about-hero-heading">
    <div class="ncs-container">
      <div class={railGrid}>
        <!-- Rail: decorative word-label + a quiet location stamp. -->
        <div class="flex flex-col gap-2" aria-hidden="true">
          <p class={railLabel}>About</p>
          <p class="font-mono text-[0.8rem] text-text-muted">{site.address}</p>
        </div>

        <!-- Track: oversized h1 breakout, then intro | portrait split. -->
        <div class="min-w-0">
          <h1 id="about-hero-heading" class="max-w-[20ch] leading-[0.95]" data-reveal>
            {about.heading} <span class="text-link">{about.headingAccent}</span>
          </h1>

          <!-- Intro | portrait split fires at lg (64rem), the same breakpoint the
               rail collapses at, so the portrait never goes side-by-side before the
               rail is beside it (no awkward mid-range two-column-before-the-rail). -->
          <div class="mt-l grid items-start gap-xl lg:grid-cols-[1.4fr_1fr]">
            <p
              class="max-w-[58ch] text-lg leading-[1.6] text-text"
              data-reveal="right"
              style="--reveal-delay: 120ms;"
            >
              {about.intro}
            </p>

            <!-- Portrait. The headshot fills the original 4:5 frame (the square
                 source is center-cropped via object-cover); the amber glow behind
                 and the ring/shadow are kept from the placeholder treatment. -->
            <div
              class="relative isolate w-full max-w-[18rem]"
              data-reveal="scale"
              style="--reveal-delay: 120ms;"
            >
              <div
                class="absolute -right-4 -bottom-4 -z-10 h-2/3 w-2/3 rounded-lg bg-tertiary/30 blur-2xl"
                aria-hidden="true"
              ></div>
              {headshotSrc ? (
                <Image
                  src={headshotSrc}
                  alt={about.headshot.alt}
                  widths={[288, 432, 576, 864]}
                  sizes="(min-width: 64rem) 18rem, 60vw"
                  loading="eager"
                  class="aspect-[4/5] w-full rounded-xl border border-border object-cover shadow-lg ring-1 ring-black/5"
                />
              ) : (
                <div class="aspect-[4/5] w-full overflow-hidden rounded-xl border border-border shadow-lg ring-1 ring-black/5">
                  <EmDashPhoto
                    image={about.headshot.image!}
                    alt={about.headshot.alt}
                    widths={[288, 432, 576, 864]}
                    sizes="(min-width: 64rem) 18rem, 60vw"
                    priority
                    class="block h-full w-full object-cover"
                  />
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================================
       Thesis (IN SHORT). The studio's one-line thesis, promoted from a stray
       centered sentence to a left-aligned breakout pull-quote on the shared
       axis. This is the only home for this line.
       ==================================================================== -->
  <section class="pb-2xl" aria-label="In short">
    <div class="ncs-container">
      <div class={`${railGrid} border-t border-border pt-2xl`}>
        <div class="flex flex-col gap-3" aria-hidden="true">
          <p class={railLabel}>In short</p>
          <span class="h-px w-12 bg-tertiary"></span>
        </div>

        <p class="max-w-[52ch] text-h4 leading-[1.3] text-heading" data-reveal="blur">
          {about.thesis.before} <span class="text-link">{about.thesis.accent}</span>{' '}
          {about.thesis.after}
        </p>
      </div>
    </div>
  </section>

  <!-- ====================================================================
       Story + Terminal (STORY). The why behind a one-person studio, with
       "plain code under the hood" SHOWN via the Terminal as a wide figure
       beside the prose.
       ==================================================================== -->
  <section class="pb-2xl" aria-labelledby="about-story-heading">
    <div class="ncs-container">
      <div class={`${railGrid} border-t border-border pt-2xl`}>
        <p class={railLabel} aria-hidden="true">
          Story
        </p>

        <div class="min-w-0">
          <header class="max-w-[60ch]" data-reveal>
            <h2 id="about-story-heading">{about.story.heading}</h2>
            <p class="mt-xs text-lg leading-[1.55] text-text-muted">{about.story.sub}</p>
          </header>

          <div class="mt-l grid gap-xl lg:grid-cols-2">
            <div
              class="flex max-w-[60ch] flex-col gap-m text-[1.0625rem] leading-[1.7] text-text"
              data-reveal
              style="--reveal-delay: 120ms;"
            >
              {storyParagraphs.map((html) => (
                <p set:html={html} />
              ))}
            </div>

            <!-- "Plain code under the hood," shown rather than told. The terminal
                 and the Lighthouse panel pair as one column that rides alongside
                 the story on desktop (lg:sticky), so the column never leaves a
                 gap below it. The grid is stretch (no items-start) so this cell
                 is as tall as the prose, giving the sticky element room to travel.
                 Both are decorative for assistive tech (each carries its own
                 sr-only summary).
                 min-w-0 matters: the terminal's window title is nowrap, so
                 without it this grid item's min-content (~318px) sets the
                 mobile column width and the page scrolls sideways at 320px
                 (WCAG 1.4.10, caught by tests/reflow.spec.ts). With it the
                 column stays at the container width and the title ellipsizes
                 the way Terminal.astro's own CSS intends. -->
            <div class="w-full min-w-0">
              <div
                class="flex flex-col gap-m lg:sticky lg:top-24"
                data-reveal="scale"
                style="--reveal-delay: 200ms;"
              >
                <Terminal />
                <LighthouseScore
                  performance={about.lighthouse.performance}
                  accessibility={about.lighthouse.accessibility}
                  bestPractices={about.lighthouse.bestPractices}
                  seo={about.lighthouse.seo}
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================================
       Outside the studio (OUTSIDE). Real snapshots of the life behind the
       one-person studio, picking up the "when I'm not at a screen" line that
       closes the Story. A CSS-columns masonry so every photo keeps its real
       aspect ratio (no uniform-grid cropping across the mix of portraits and
       landscapes); each photo is a keyboard- and click-operable zoom trigger
       (a real <button>) for the shared Lightbox rendered at the foot of the page.
       ==================================================================== -->
  <section class="pb-2xl" aria-labelledby="about-outside-heading">
    <div class="ncs-container">
      <div class={`${railGrid} border-t border-border pt-2xl`}>
        <p class={railLabel} aria-hidden="true">
          Outside
        </p>

        <div class="min-w-0">
          <header class="max-w-[60ch]" data-reveal>
            <h2 id="about-outside-heading">{about.outside.heading}</h2>
            <p class="mt-xs text-lg leading-[1.55] text-text-muted">{about.outside.sub}</p>
          </header>

          <ul class="mt-l columns-2 gap-m lg:columns-3 [&>li]:mb-m [&>li]:break-inside-avoid">
            {photos.map((photo, index) => (
              <li data-reveal style={`--reveal-delay: ${(index % 3) * 80}ms;`}>
                <figure>
                  <button
                    type="button"
                    data-zoom
                    title="View larger"
                    class="group block w-full cursor-zoom-in overflow-hidden rounded-xl border border-border shadow-[var(--shadow-card)] transition-shadow duration-300 hover:shadow-[var(--shadow-card-hover)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                  >
                    {photo.src ? (
                      <Image
                        src={photo.src}
                        alt={photo.alt}
                        widths={[320, 560, 840, 1200, 1600]}
                        sizes="(min-width: 64rem) 280px, (min-width: 40rem) 45vw, 90vw"
                        class="block w-full transition-transform duration-500 group-hover:scale-[1.03]"
                      />
                    ) : (
                      <EmDashPhoto
                        image={photo.image!}
                        alt={photo.alt}
                        widths={[320, 560, 840, 1200, 1600]}
                        sizes="(min-width: 64rem) 280px, (min-width: 40rem) 45vw, 90vw"
                        class="block h-auto w-full transition-transform duration-500 group-hover:scale-[1.03]"
                      />
                    )}
                  </button>
                  <figcaption class="mt-xs font-mono text-xs tracking-[0.06em] text-text-muted uppercase">
                    {photo.caption}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================================
       How I work (PRACTICE). Three principles as an authored manifesto: a
       hairline-ruled list (not a card grid), the body running to the track
       edge so text finally reaches the right margin. No section background.
       ==================================================================== -->
  <section class="pb-2xl" aria-labelledby="about-how-heading">
    <div class="ncs-container">
      <div class={`${railGrid} border-t border-border pt-2xl`}>
        <p class={railLabel} aria-hidden="true">
          Practice
        </p>

        <div class="min-w-0">
          <header class="max-w-[60ch]" data-reveal>
            <h2 id="about-how-heading">{about.principles.heading}</h2>
            <p class="mt-xs text-lg leading-[1.55] text-text-muted">{about.principles.sub}</p>
          </header>

          <ul class="mt-l flex flex-col">
            {about.principles.items.map((principle, index) => (
              <li
                class="grid gap-s border-t border-border py-l md:grid-cols-[1fr_2fr] md:gap-l"
                data-reveal
                style={`--reveal-delay: ${index * 100}ms;`}
              >
                <h3 class="text-h4 text-heading">{principle.title}</h3>
                <p class="leading-[1.7] text-text">{principle.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================================
       Currently (NOW). The present-tense snapshot, calmed from four loose
       carded sub-sections into one dated now-sheet. The freshness pill +
       last-updated stamp move into the rail; the body is a single
       .surface-card ledger (the only inset card on the page). id="now" +
       scroll-mt so the /now redirect and footer link still land here.
       ==================================================================== -->
  <section id="now" class="scroll-mt-2xl pb-2xl" aria-labelledby="about-currently-heading">
    <div class="ncs-container">
      <div class={`${railGrid} border-t border-border pt-2xl`}>
        <!-- Rail: word-label (decorative) + the real freshness meta. -->
        <div class="flex flex-col gap-s">
          <p class={railLabel} aria-hidden="true">
            Now
          </p>
          <p class="inline-flex w-fit items-center gap-s rounded-full border border-border bg-bg-soft px-3 py-1 text-sm font-medium text-text">
            <span class="now-pulse relative inline-flex h-2.5 w-2.5 shrink-0" aria-hidden="true">
              <span class="now-pulse-ring absolute inline-flex h-full w-full rounded-full bg-emerald-500/70"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
            </span>
            <span>{freshness}</span>
          </p>
          <p class="font-mono text-[0.8rem] text-text-muted italic">
            Last updated {lastUpdatedLabel}.
          </p>
        </div>

        <div class="min-w-0">
          <header class="max-w-[60ch]" data-reveal>
            <h2 id="about-currently-heading">{about.currently.heading}</h2>
            <p class="mt-xs text-lg leading-[1.55] text-text-muted">{about.currently.sub}</p>
          </header>

          <!-- One now-sheet: the page's single inset card. Two-column ledger at
               md; stacks to one column below. -->
          <div
            class="surface-card mt-l rounded-xl p-l md:p-xl"
            data-reveal
            style="--reveal-delay: 120ms;"
          >
            <div class="grid gap-xl md:grid-cols-2 md:gap-2xl">
              <!-- Left: Working on, then Booking. -->
              <div class="flex flex-col gap-l">
                <section aria-labelledby="now-working">
                  <h3 id="now-working" class="text-h5 text-heading">
                    Working on
                  </h3>
                  <ul class="mt-s flex flex-col">
                    {about.currently.workingOn.map((item, index) => (
                      <li
                        class="flex items-start gap-s border-t border-border py-s"
                        data-reveal="left"
                        style={`--reveal-delay: ${index * 90}ms;`}
                      >
                        <span
                          class="mt-[0.55rem] h-1.5 w-1.5 shrink-0 bg-tertiary"
                          aria-hidden="true"
                        />
                        <span class="leading-[1.55] text-text">{item}</span>
                      </li>
                    ))}
                  </ul>
                </section>

                <section aria-labelledby="now-booking">
                  <h3 id="now-booking" class="text-h5 text-heading">
                    Booking
                  </h3>
                  <ul class="mt-s flex flex-col">
                    {about.currently.booking.map((slot, index) => {
                      const meta = statusMeta[slot.status];
                      return (
                        <li
                          class="border-t border-border py-s"
                          data-reveal
                          style={`--reveal-delay: ${index * 90}ms;`}
                        >
                          <span
                            class:list={[
                              'inline-flex items-center gap-1.5 text-xs font-semibold tracking-[0.06em] uppercase',
                              meta.text,
                            ]}
                          >
                            <span
                              class:list={['h-2 w-2 rounded-full', meta.dot]}
                              aria-hidden="true"
                            />
                            {meta.word}
                          </span>
                          <span class="ml-2 align-middle font-display text-h5 text-heading">
                            {slot.label}
                          </span>
                          <p class="mt-1 leading-[1.55] text-text">{slot.detail}</p>
                        </li>
                      );
                    })}
                  </ul>
                </section>
              </div>

              <!-- Right: Reading, then Learning. -->
              <div class="flex flex-col gap-l">
                <section aria-labelledby="now-reading">
                  <h3 id="now-reading" class="text-h5 text-heading">
                    Reading
                  </h3>
                  <ul class="mt-s flex flex-col">
                    {about.currently.reading.map((book, index) => (
                      <li
                        class="border-t border-border py-s"
                        data-reveal="right"
                        style={`--reveal-delay: ${index * 90}ms;`}
                      >
                        <span class="font-display text-h5 leading-tight text-heading">
                          {book.title}
                          {book.note && (
                            <span class="ml-2 align-middle text-xs font-medium tracking-[0.06em] text-link uppercase">
                              ({book.note})
                            </span>
                          )}
                        </span>
                        <span class="block text-sm text-text-muted">{book.author}</span>
                      </li>
                    ))}
                  </ul>
                </section>

                <section aria-labelledby="now-learning">
                  <h3 id="now-learning" class="text-h5 text-heading">
                    Learning
                  </h3>
                  <ul class="mt-s flex flex-col">
                    {about.currently.learning.map((item, index) => (
                      <li
                        class="border-t border-border py-s leading-[1.55] text-text"
                        data-reveal="right"
                        style={`--reveal-delay: ${index * 90}ms;`}
                      >
                        {item}
                      </li>
                    ))}
                  </ul>
                </section>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client testimonials. Renders only when a case study carries a real
       `testimonial` in its frontmatter; otherwise this is silent (no empty
       block, no fabricated quote). This is the first of the two deliberate
       full-bleed beats at the tail of the page (after the ruled column ends):
       its .band-themed surface is set inside Testimonials.astro, not here. -->
  <Testimonials heading={about.testimonials.heading} sub={about.testimonials.sub} />

  <!-- Closing CTA: the second deliberate full-bleed break, outside the grid. -->
  <CtaBanner title={about.ctaTitle} sub={about.ctaSub} />

  <!-- Click / keyboard zoom for the Outside-the-studio photos. Rendered once. -->
  <Lightbox />
</BaseLayout>

<style>
  /* Freshness-pill pulse: an expanding, fading ring behind the solid dot (now in
     the Currently rail). The label text carries the meaning, so this is
     reinforcement only; disabled under reduced motion. */
  .now-pulse-ring {
    animation: now-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes now-ping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .now-pulse-ring {
      animation: none;
    }
  }
</style>
