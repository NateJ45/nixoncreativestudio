---
// Safe to edit. The page words, photos, principles and Currently lists live in
// the EmDash admin (Pages, "About page"; read through getAboutPage in
// src/lib/aboutPage.ts, with cms/content/page_about.json as the committed
// fallback). This file holds the layout and the "What I check" ledger. The
// Testimonials band reads the case studies, so the page is server-rendered and
// route-cached like every page.
/* ============================================================================
   /about | Nathan Nixon, a real person (redesign 2026)
   ============================================================================
   The page is the first meeting: his face and the line the copy audit kept
   ("the person you meet on day one is the same person who hands you the
   finished site"), then his story in short paragraphs beside a portrait, a
   few captioned prints from the rest of his life, how he works and what he
   checks, what he is doing now, and one way to start a conversation.

   Bands and grounds (DESIGN.md section 4):
     1. Opening       window-light (the page's one moving ground) under the
                      header: headline, intro, who for; the headshot as a print.
     2. Story         deep (still): the LAST photo of the CMS list sits large
                      beside the story (the black-and-white portrait melts into
                      the ink), the paragraphs in Nathan's voice.
     3. Prints        paper: the other photos as small captioned prints in one
                      justified row (they are snapshots, never heroes).
     4. How I work    paper-deep: three commitments, and the "What I check"
                      ledger laid beside them like a printed card.
     5. Currently     paper: booking first, then working on, reading, learning.
     6. Testimonials  silent until a case study carries a real quote.
     7. Closing       paper-contours (still): the question, the button, the email.

   No eyebrows, no mono labels, no terminal card and no score dial (the 2026
   audits: developer props aimed at the wrong buyer). Every big headline is
   Bebas, and the line under it is the italic second voice.
   ============================================================================ */

import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/Band.astro';
import Testimonials from '../components/Testimonials.astro';
import EmDashPhoto from '../components/emdash/EmDashPhoto.astro';
import { buttonVariants } from '../components/ui/button';
import { blockHtml, restrictPortableText } from '../lib/portableText';
import { getSite } from '../data/site';
import { aboutTitle, buildPersonSchema, getAboutPage, updatedLabel } from '../lib/aboutPage';

// Contact details, the owner name and the location come from Site settings
// (shared with the header and footer); everything else from the About entry.
const site = await getSite(Astro);
const about = await getAboutPage(Astro);

// Pictures bundled with the site, which the committed fallback names by repo
// path. A CMS entry carries EmDash media instead (rendered by EmDashPhoto as a
// resized WebP from /_image); both paths end up as a resized WebP.
import headshot from '../assets/brand/headshot.jpg';
import familyPhoto from '../assets/about/family.jpg';
import runningPhoto from '../assets/about/running.jpg';
import exploringPhoto from '../assets/about/exploring.jpg';
import weddingPhoto from '../assets/about/wedding.jpg';
import portraitBwPhoto from '../assets/about/portrait-bw.jpg';
const bundled: Record<string, ImageMetadata> = {
  'src/assets/brand/headshot.jpg': headshot,
  'src/assets/about/family.jpg': familyPhoto,
  'src/assets/about/running.jpg': runningPhoto,
  'src/assets/about/exploring.jpg': exploringPhoto,
  'src/assets/about/wedding.jpg': weddingPhoto,
  'src/assets/about/portrait-bw.jpg': portraitBwPhoto,
};

// Every usable photo with its proportions (width / height). The proportions
// drive the justified row of prints; a CMS image carries its stored size.
const photos = about.outside.photos.flatMap((photo) => {
  const src = photo.file ? bundled[photo.file] : undefined;
  if (!src && !photo.image) return [];
  const media = (photo.image ?? {}) as { width?: number; height?: number };
  const w = src?.width ?? media.width;
  const h = src?.height ?? media.height;
  const ratio = w && h ? w / h : 0.75;
  return [{ ...photo, src, ratio }];
});
// The last photo sits large beside the story; the rest are the small prints.
// (Production's list and the fallback both end with the black-and-white
// portrait. The reader guarantees at least three photos, so two or more prints.)
const storyPhoto = photos.at(-1);
const prints = photos.slice(0, -1);

// `sizes` for one small print, from the layout below (performance pass 2026-10-04:
// one fixed 20rem / 46vw value under-served the wide print, which renders about
// twice as wide as the portraits, and over-served the portraits on desktop).
// Phones: a two-column grid, a wide print spans both. From 48rem: one flex row,
// each print's width proportional to its ratio (flex-grow = ratio) inside a
// band whose prints share about 70rem at full width (measured: 205 px portraits,
// 428 px wide print at 1440).
const ratioSum = prints.reduce((s, p) => s + p.ratio, 0) || 1;
const printSizes = (ratio: number) => {
  const share = ratio / ratioSum;
  return `(min-width: 82.5rem) ${(70 * share).toFixed(1)}rem, (min-width: 48rem) ${(85 * share).toFixed(1)}vw, ${ratio > 1 ? '92vw' : '46vw'}`;
};
const headshotSrc = about.headshot.file ? bundled[about.headshot.file] : undefined;

// The story: Portable Text reduced to bare paragraphs (blockHtml), NOT emdash/ui's
// PortableText, whose stylesheet would be a render-blocking link (never-break 4).
const storyParagraphs = restrictPortableText(about.story.body).map((b) => blockHtml(b));

const lastUpdated = updatedLabel(about.currently.updated);

// Availability is never colour alone: each row prints its status word.
const statusWord = { open: 'Open', limited: 'Limited' } as const;

// What Nathan checks on the sites he builds and looks after. Stays in code for
// now: the page_about schema has no field for it, and the schema is frozen
// during the redesign. Keep every row TRUE (docs/redesign-2026/D: only
// accessibility is gated on every change; backups and uptime are watched).
const checks = [
  {
    what: 'Accessibility',
    how: 'Checked against WCAG AA before launch, and again by automated checks on every change I make.',
    when: 'Every change',
  },
  {
    what: 'Backups',
    how: 'Content backups run on their own, and a weekly check tells me if one did not.',
    when: 'Weekly',
  },
  {
    what: 'Uptime and DNS',
    how: 'Watched from my studio status board, so an outage or a lapsing domain reaches me early.',
    when: 'Every 15 minutes',
  },
];

// Person JSON-LD (pinned byte-for-byte by a unit test), linked to the site-wide
// Organization.
const schemas = [buildPersonSchema(about, site)];
---

<BaseLayout
  title={aboutTitle(about.seoTitle, site.studioName)}
  description={about.seoDescription}
  schemas={schemas}
  preloadFonts={['italic']}
>
  {/* 1. Opening: the window-light wall, the one moving ground on the page. */}
  <Band ground="window-light" underHeader labelledby="about-hero-heading" class="about-open">
    <div class="open-grid">
      <div class="open-copy">
        <h1 id="about-hero-heading" class="open-title">
          {about.heading} <span class="voice">{about.headingAccent}</span>
        </h1>
        <p class="type-lede open-intro">{about.intro}</p>
        <p class="open-who">
          {about.thesis.before} <strong>{about.thesis.accent}</strong> {about.thesis.after}
        </p>
      </div>

      {/* The headshot as a print on the wall. It is the LCP image on desktop:
          eager, high priority, explicit size, never revealed. */}
      <figure class="open-print">
        <div class="print">
          {headshotSrc ? (
            <Picture
              formats={['avif', 'webp']}
              pictureAttributes={{ class: 'contents' }}
              src={headshotSrc}
              alt={about.headshot.alt}
              widths={[320, 480, 640, 900]}
              sizes="(min-width: 64rem) 30rem, (min-width: 40rem) 14rem, 58vw"
              loading="eager"
              fetchpriority="high"
              class="print-img"
            />
          ) : (
            <EmDashPhoto
              image={about.headshot.image!}
              alt={about.headshot.alt}
              widths={[320, 480, 640, 900]}
              sizes="(min-width: 64rem) 30rem, (min-width: 40rem) 14rem, 58vw"
              priority
              class="print-img"
            />
          )}
        </div>
        <figcaption class="type-caption">
          {site.ownerName}, {site.address}.
        </figcaption>
      </figure>
    </div>
  </Band>

  {/* 2. The story, on the ink board: the turn of the page. */}
  <Band ground="deep" still id="story" labelledby="about-story-heading">
    <div class="story-grid">
      {storyPhoto && (
        <figure class="story-photo" data-reveal="fade">
          {storyPhoto.src ? (
            <Picture
              formats={['avif', 'webp']}
              pictureAttributes={{ class: 'contents' }}
              src={storyPhoto.src}
              alt={storyPhoto.alt}
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 64rem) 36rem, 92vw"
              class="story-img"
            />
          ) : (
            <EmDashPhoto
              image={storyPhoto.image!}
              alt={storyPhoto.alt}
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 64rem) 36rem, 92vw"
              class="story-img"
            />
          )}
          <figcaption class="type-caption">{storyPhoto.caption}</figcaption>
        </figure>
      )}

      <div class="story-copy">
        <h2 id="about-story-heading">{about.story.heading}</h2>
        <p class="voice-line">{about.story.sub}</p>
        <div class="story-body">
          {storyParagraphs.map((html) => (
            <p set:html={html} />
          ))}
        </div>
      </div>
    </div>
  </Band>

  {/* 3. The rest of life, as small prints: snapshots, captioned with facts. */}
  <Band labelledby="about-outside-heading">
    <header class="band-head">
      <h2 id="about-outside-heading">{about.outside.heading}</h2>
      <p class="voice-line">{about.outside.sub}</p>
    </header>
    <ul class="prints" role="list">
      {prints.map((photo) => (
        <li
          class:list={['prints-item', { 'is-wide': photo.ratio > 1 }]}
          style={`--r: ${photo.ratio.toFixed(3)};`}
          data-reveal
        >
          <figure>
            <div class="print print--small">
              {photo.src ? (
                <Picture
                  formats={['avif', 'webp']}
                  pictureAttributes={{ class: 'contents' }}
                  src={photo.src}
                  alt={photo.alt}
                  widths={[240, 360, 480, 720]}
                  sizes={printSizes(photo.ratio)}
                  class="print-img"
                />
              ) : (
                <EmDashPhoto
                  image={photo.image!}
                  alt={photo.alt}
                  widths={[240, 360, 480, 720]}
                  sizes={printSizes(photo.ratio)}
                  class="print-img"
                />
              )}
            </div>
            <figcaption class="type-caption">{photo.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </Band>

  {/* 4. How I work: three commitments, and the ledger of what gets checked. */}
  <Band labelledby="about-how-heading" class="ground-sunk">
    <div class="how-grid">
      <div>
        <header class="band-head">
          <h2 id="about-how-heading">{about.principles.heading}</h2>
          <p class="voice-line">{about.principles.sub}</p>
        </header>
        <ol class="commitments" role="list">
          {about.principles.items.map((principle) => (
            <li>
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </li>
          ))}
        </ol>
        <p class="how-next type-ui">
          <a href="/work/">See the sites I have built</a>
          <a href="/contact/">Start a project</a>
        </p>
      </div>

      <section class="ledger" aria-labelledby="about-checks-heading" data-reveal>
        <h3 id="about-checks-heading" class="ledger-title">
          What I check on the sites I look after
        </h3>
        <dl>
          {checks.map((row) => (
            <div class="ledger-row">
              <dt>{row.what}</dt>
              <dd class="ledger-how">{row.how}</dd>
              <dd class="ledger-when type-caption">{row.when}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </Band>

  {/* 5. Currently. id="now" keeps the /now redirect and the footer link landing here. */}
  <Band id="now" labelledby="about-currently-heading" class="scroll-mt-24">
    <div class="now-grid">
      <header class="band-head now-head">
        <h2 id="about-currently-heading">{about.currently.heading}</h2>
        <p class="voice-line">{about.currently.sub}</p>
        <p class="type-caption now-stamp">Last updated {lastUpdated}.</p>
      </header>

      <div class="now-sheet">
        <section class="now-block now-booking" aria-labelledby="now-booking">
          <h3 id="now-booking">Booking</h3>
          <ul role="list">
            {about.currently.booking.map((slot) => (
              <li>
                <p class="now-slot">
                  <span class="now-label">{slot.label}</span>
                  <span class:list={['now-status', `is-${slot.status}`]}>
                    {statusWord[slot.status]}
                  </span>
                </p>
                <p class="now-detail">{slot.detail}</p>
              </li>
            ))}
          </ul>
        </section>

        <section class="now-block" aria-labelledby="now-working">
          <h3 id="now-working">Working on</h3>
          <ul role="list">
            {about.currently.workingOn.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <section class="now-block" aria-labelledby="now-reading">
          <h3 id="now-reading">Reading</h3>
          <ul role="list">
            {about.currently.reading.map((book) => (
              <li>
                <cite>{book.title}</cite>
                <span class="now-by">
                  {book.author}
                  {book.note && <> ({book.note})</>}
                </span>
              </li>
            ))}
          </ul>
        </section>

        <section class="now-block" aria-labelledby="now-learning">
          <h3 id="now-learning">Learning</h3>
          <ul role="list">
            {about.currently.learning.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </Band>

  {/* 6. Client quotes: renders nothing until a case study carries a real one. */}
  <Testimonials heading={about.testimonials.heading} sub={about.testimonials.sub} />

  {/* 7. Closing, on the Ohio's contours (still: the wall at the top is the one moving ground). */}
  <Band ground="paper-contours" still labelledby="about-close-heading">
    <div class="close">
      <h2 id="about-close-heading">{about.ctaTitle ?? site.ctaDefault.title}</h2>
      <p class="type-lede">{about.ctaSub ?? site.ctaDefault.sub}</p>
      <div class="close-actions">
        <a href="/contact/" class={buttonVariants({ variant: 'brand', size: 'cta' })}>
          {site.ctaDefault.label}
        </a>
        <p class="type-ui close-email">
          Or write to me at <a href={site.emailHref}>{site.email}</a>
        </p>
      </div>
    </div>
  </Band>
</BaseLayout>

<style>
  /* ---- 1. Opening ------------------------------------------------------- */
  .open-grid {
    display: grid;
    gap: 2rem;
    align-items: end;
  }
  .open-copy {
    min-width: 0;
  }
  .open-title {
    font-size: var(--text-h1);
    line-height: 0.9;
    max-width: 14ch;
  }
  /* The italic turn runs long here (the kept line), so it sits on its own
     lines at a reading size instead of the usual 0.86em. */
  .open-title .voice {
    display: block;
    margin-top: 0.3em;
    font-size: 0.56em;
    line-height: 1.08;
    max-width: 22ch;
  }
  .open-intro {
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    max-width: 36ch;
  }
  .open-who {
    margin-top: 1rem;
    max-width: 44ch;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--foreground);
  }
  .open-who strong {
    font-weight: 400;
    color: var(--heading);
  }
  .open-print {
    order: -1;
    width: min(14rem, 58vw);
    margin: 0;
  }
  .open-print figcaption {
    margin-top: 0.75rem;
  }

  /* A print: the photograph with a trimmed paper border and a soft table
     shadow (DESIGN.md "Elevation"). */
  .print {
    background: var(--paper-raised);
    padding: clamp(0.4rem, 0.3rem + 0.4vw, 0.75rem);
    border-radius: 2px;
    box-shadow: var(--shadow-frame);
  }
  .print-img {
    display: block;
    width: 100%;
    height: auto;
  }
  .open-print .print-img {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
  }

  @media (min-width: 64rem) {
    .open-grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: center;
    }
    .open-print {
      order: 0;
      width: 100%;
      max-width: 30rem;
      justify-self: end;
      transform: rotate(1.25deg);
    }
    .open-print figcaption {
      transform: rotate(-1.25deg);
    }
  }

  /* ---- 2. Story --------------------------------------------------------- */
  .story-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  .story-photo {
    margin: 0;
  }
  .story-img {
    display: block;
    width: 100%;
    height: auto;
  }
  .story-photo figcaption {
    margin-top: 0.75rem;
    color: var(--muted-foreground);
  }
  .story-copy {
    min-width: 0;
  }
  .story-copy h2 {
    max-width: 16ch;
  }
  .story-body {
    margin-top: clamp(1.75rem, 1rem + 2vw, 2.5rem);
    display: grid;
    gap: 1.1em;
    max-width: 36rem;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.65;
  }
  /* The first paragraph opens at the lede size, like a standfirst. */
  .story-body > p:first-child {
    font-size: var(--text-lede);
    line-height: 1.4;
  }
  @media (min-width: 64rem) {
    .story-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
    /* The portrait travels beside the long story instead of leaving a hole. */
    .story-photo {
      position: sticky;
      top: 6rem;
    }
  }

  /* ---- Shared band head: Bebas headline, then the italic second voice. --- */
  .band-head h2 {
    max-width: 18ch;
  }
  .voice-line {
    margin-top: 0.6rem;
    max-width: 34ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-lede);
    line-height: 1.3;
    color: var(--marker);
  }

  /* ---- 3. Prints: one justified row on wide screens (every print the same
     height, each as wide as its proportions ask), two up on phones. -------- */
  .prints {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 0.875rem;
    align-items: start;
  }
  .prints-item.is-wide {
    grid-column: span 2;
  }
  .prints figure {
    margin: 0;
  }
  .prints figcaption {
    margin-top: 0.6rem;
    max-width: 28ch;
  }
  @media (min-width: 48rem) {
    .prints {
      display: flex;
      align-items: flex-start;
      gap: clamp(1rem, 2.5vw, 2.25rem);
    }
    .prints-item {
      flex: var(--r) 1 0;
      min-width: 0;
    }
    /* Laid on the table, not ruled into a grid: every other print sits a
       little lower. */
    .prints-item:nth-child(even) {
      margin-top: clamp(1.5rem, 3vw, 3rem);
    }
  }

  /* ---- 4. How I work + the ledger --------------------------------------- */
  :global(.band.ground-sunk) {
    background-color: var(--paper-deep);
  }
  .how-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }
  .commitments {
    margin-top: clamp(1.75rem, 3vw, 2.75rem);
  }
  .commitments li {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .commitments h3 {
    font-size: var(--text-h3);
  }
  .commitments p {
    max-width: 40rem;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.6;
  }
  .ledger {
    align-self: start;
    background: var(--paper-raised);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    border-radius: 2px;
    box-shadow: var(--shadow-frame);
  }
  .ledger-title {
    font-size: var(--text-h4);
    max-width: 20ch;
  }
  .ledger dl {
    margin-top: 1.25rem;
  }
  .ledger-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--border);
  }
  .ledger-row dt {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-body);
    color: var(--heading);
  }
  .ledger-how {
    grid-column: 1 / -1;
    grid-row: 2;
    font-family: var(--font-serif);
    line-height: 1.5;
  }
  .ledger-when {
    grid-column: 2;
    grid-row: 1;
    align-self: baseline;
  }
  @media (min-width: 64rem) {
    .how-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
    }
    .commitments li {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 2rem;
    }
    .ledger {
      margin-top: clamp(4rem, 8vw, 7.5rem);
      transform: rotate(-0.6deg);
    }
  }

  .how-next {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }
  .how-next a {
    display: inline-block;
    padding-block: 0.75rem;
    color: var(--link);
    font-weight: 600;
  }

  /* ---- 5. Currently ----------------------------------------------------- */
  .now-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  .now-stamp {
    margin-top: 1rem;
  }
  .now-sheet {
    display: grid;
    gap: 2rem 3rem;
  }
  .now-block h3 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-h5);
    line-height: 1.25;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }
  .now-block ul {
    margin-top: 0.25rem;
  }
  .now-block li {
    padding-block: 0.7rem;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.5;
  }
  .now-block li + li {
    border-top: 1px solid var(--border);
  }
  .now-block cite {
    font-style: italic;
    color: var(--heading);
  }
  .now-by {
    display: block;
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    color: var(--muted-foreground);
  }
  .now-slot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }
