---
// Safe to edit. The story prose, the photos array and the Currently arrays
// hold all of the user-facing copy on this page.
/* ============================================================================
   /about | About Nathan Nixon  (overhaul package 2.6)
   ============================================================================
   The page's job is trust in the person. Six beats, top to bottom:

     1. Head: the real headshot and the H1. The headshot is the page's LCP,
        so it is eager (Media's `lcp`), never revealed, and drawn big enough
        to out-size the H1 at every width (it sits first on a phone, on the
        right from lg). The H1 keeps its Heft (package 1.7) and its wording
        until Nathan picks a new one.
     2. In short: the one-line thesis plus a few plain facts. The rail's site
        count is counted from the case-studies collection, never typed.
     3. The longer story (prose).
     4. Outside the studio: a contact sheet of the five real photos in
        src/assets/about with their captions. Each frame is a real <button>
        for the shared Lightbox, which opens the whole, uncropped photo.
     5. Currently (#now): the old /now snapshot. Rewrite its arrays about once
        a quarter and bump `lastUpdated`.
     6. One line pointing at the "why it costs what it costs" block on
        /services.

   Then the footer's ink closer (BaseLayout `closer`).

   Every band after the head is a Section (rail, railMeta, tone). The head is
   its own page-grid band, because Section always puts its body in columns 4
   to 12, which leaves the H1 too narrow and the headshot too small to be the
   LCP. CSS is scoped to this page; globals.css is frozen (ruling 10).
   ============================================================================ */

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Heft from '../components/Heft.astro';
import Section from '../components/Section.astro';
import Media from '../components/Media.astro';
import Lightbox from '../components/Lightbox.astro';
import { Picture } from 'astro:assets';
import { ladder, PICTURE } from '../lib/picture';

import headshot from '../assets/brand/headshot.jpg';
import familyPhoto from '../assets/about/family.jpg';
import runningPhoto from '../assets/about/running.jpg';
import exploringPhoto from '../assets/about/exploring.jpg';
import weddingPhoto from '../assets/about/wedding.jpg';
import portraitBwPhoto from '../assets/about/portrait-bw.jpg';

// Counted, never typed (CLAUDE.md never-break rule 9).
const siteCount = (await getCollection('case-studies')).length;

// "Outside the studio" contact sheet. Real snapshots with honest, generic
// captions (no names), so nothing presumes more than the photo shows. The
// frames crop to one shape on the sheet; the Lightbox shows the whole photo.
const photos = [
  {
    src: familyPhoto,
    caption: 'A park afternoon',
    alt: 'Nathan with his family on a picnic blanket in a park, a young child eating watermelon.',
  },
  {
    src: runningPhoto,
    caption: 'Race day',
    alt: 'Nathan and a friend at the end of a charity 5K, race bibs on, in a sunny parking lot.',
  },
  {
    src: exploringPhoto,
    caption: 'Out exploring',
    alt: 'Nathan carrying a small child on a sunny day in front of old railroad cars.',
  },
  {
    src: weddingPhoto,
    caption: 'Wedding day',
    alt: 'Nathan and his wife laughing together on their wedding day, beside a lake.',
  },
  {
    src: portraitBwPhoto,
    caption: 'From the other side of the lens',
    alt: 'A black-and-white studio portrait of Nathan looking off to the side.',
  },
];

// "Currently" content, merged in from the old standalone /now page (a Derek
// Sivers-style snapshot). Rewrite these arrays about once a quarter; the
// freshness line and the "last updated" stamp keep the section honest.
const lastUpdated = '2026-10-01'; // bump whenever the arrays below change

// Parse the ISO day as LOCAL midnight. A bare 'YYYY-MM-DD' parses as UTC, so in
// a timezone behind UTC both the label and the freshness would read a day early.
const lastUpdatedDate = new Date(`${lastUpdated}T00:00:00`);
const lastUpdatedLabel = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(lastUpdatedDate);

// Relative freshness for the rail: today / N days / N weeks / N months.
// If it ever reads "8 months ago," that is the nudge to rewrite the arrays.
function freshnessLabel(iso: string): string {
  const days = Math.max(
    0,
    Math.floor((Date.now() - new Date(`${iso}T00:00:00`).getTime()) / 86_400_000),
  );
  if (days <= 0) return 'Updated today';
  if (days === 1) return 'Updated yesterday';
  if (days < 14) return `Updated ${days} days ago`;
  if (days < 60) return `Updated ${Math.round(days / 7)} weeks ago`;
  const months = Math.round(days / 30);
  return `Updated ${months} ${months === 1 ? 'month' : 'months'} ago`;
}
const freshness = freshnessLabel(lastUpdated);

// Active client + studio work, most front-of-mind first. Named orgs here are
// ones I'm public with (the Presbyterian Academy is a case study on this site);
// keep any private client generic rather than named.
const workingOn = [
  "Finishing the Presbyterian Academy website ahead of the school's first term.",
  "Buying my family's first house, here in Cincinnati.",
];

// Capacity signals. status drives the chip colour and the readable word, so
// availability never reads on colour alone.
const booking = [
  {
    status: 'open' as const,
    label: 'Web design',
    detail:
      'Open to new web design projects of every kind this quarter, from a single landing page to a full rebuild.',
  },
  {
    status: 'limited' as const,
    label: 'Photography',
    detail:
      'A few shoot days each month, fit around the web work, for portraits, families, events, and the brand photography that pairs with a new site.',
  },
];
// Tailwind palette utilities, as before the overhaul: 700 shades on light, 300
// on dark, both clear AA small text on this page's surfaces.
const statusMeta = {
  open: { word: 'Open', text: 'text-emerald-700 dark:text-emerald-300' },
  limited: { word: 'Limited', text: 'text-amber-700 dark:text-amber-300' },
};

// Books / longer-form pieces, and skills I'm sharpening.
const reading = [
  { title: 'John Adams', author: 'David McCullough' },
  { title: 'The New Father', author: 'Armin A. Brott' },
  { title: 'The Lord of the Rings', author: 'J.R.R. Tolkien', note: 're-reading' },
];
const learning = [
  'Smoother, steadier video out of my gimbal',
  'Coaxing a genuinely lush green lawn out of the backyard',
  'Going deeper on Astro, the framework this very site runs on',
];

// No page-specific JSON-LD here: Nathan's Person node is in the site-wide
// @graph on every page (src/lib/schema.ts), linked to the studio by @id.
---

<BaseLayout
  title="About Nathan Nixon | Nixon Creative Studio"
  description="I'm Nathan Nixon, the one person behind Nixon Creative Studio in Cincinnati. I plan, design and build every site myself, and shoot the photos when needed."
  closer={{
    heading: 'Want to talk about',
    emphasis: 'a project?',
    sub: 'The first conversation is free, and the earlier it happens, the easier the work is to schedule.',
  }}
>
  <!-- 1. Head. Nothing here takes data-reveal (ruling 3): the H1 and the
       headshot paint on load at full opacity. -->
  <section class="about-head" aria-labelledby="about-heading">
    <div class="ncs-container page-grid">
      <div class="about-head-text">
        <p class="about-kicker">
          <span class="about-kicker-label">About</span>
          <span aria-hidden="true">·</span>
          <span>Cincinnati, Ohio</span>
        </p>
        <h1 id="about-heading">
          A one-person studio for <Heft text="organizations that take their work seriously." />
        </h1>
        <p class="about-intro">
          I'm Nathan Nixon. I run Nixon Creative Studio out of Cincinnati, Ohio, and I work with
          small businesses, nonprofits, churches, and schools, in person around the region and
          anywhere for web work. I do the strategy, the design, the photography, and the code, so
          the person you meet on day one is the same person who hands you the finished site.
        </p>
      </div>
      <div class="about-head-photo">
        <Media
          src={headshot}
          alt="Nathan Nixon, smiling outdoors"
          ratio="4 / 5"
          widths={[320, 480, 640, 800, 1200]}
          sizes="(min-width: 82.5rem) 620px, (min-width: 64rem) calc(48.4vw - 21px), (min-width: 27rem) 384px, calc(100vw - 3rem)"
          lcp
          class="frame"
        />
      </div>
    </div>
  </section>

  <!-- 2. In short. -->
  <Section rail="In short" railMeta={`${siteCount} client sites`} label="In short">
    <p class="about-thesis">
      One person on every project, start to finish: strategy, design, photography, and code. I work
      with <a href="/work/">churches, schools, nonprofits, and small businesses</a> around
      Cincinnati in person, and anywhere for web work.
    </p>
    <dl class="about-facts" data-reveal-group>
      <div data-reveal>
        <dt>Based in</dt>
        <dd>Cincinnati, Ohio</dd>
      </div>
      <div data-reveal>
        <dt>Building websites since</dt>
        <dd>2020</dd>
      </div>
      <div data-reveal>
        <dt>On every project</dt>
        <dd>Strategy, design, photography and code</dd>
      </div>
      <div data-reveal>
        <dt>Case studies</dt>
        <dd>
          <a href="/work/">{siteCount} sites on the work page</a>
        </dd>
      </div>
    </dl>
  </Section>

  <!-- 3. The longer story. -->
  <Section rail="Story" railMeta="Edinburgh to Cincinnati" prose labelledby="about-story-heading">
    <h2 id="about-story-heading">
      The longer <b>story</b>
    </h2>
    <div class="about-story" data-reveal>
      <p>
        I came to this work through a camera. For years I photographed portraits, families,
        weddings, the events people most want to remember, and the part I loved was helping someone
        show up at their best. When the shoots dried up in 2020, I started building websites for a
        few of those same clients, and it turned out to be the same job in a new medium: work out
        what someone is really trying to say, then make it clear. Web design is the studio's main
        work now, but the photographer's eye stayed, and most projects still end up with real
        photography in them.
      </p>
      <p>
        Before any of that I studied mechanical engineering at the University of Edinburgh, back
        home in Scotland. The degree did not make me a designer, but it taught me to take a thing
        apart, understand why each piece is there, and put it back together so it holds. That is how
        I approach a website too: structure first, surface second, and built so the person who
        inherits it can actually keep it running.
      </p>
      <p>
        I also do plenty of this work as a volunteer. I'm on the media team at Crestview
        Presbyterian Church, where I run the weekly livestream, plan and buy the equipment upgrades,
        and shoot the photo and video the church uses for its website and its socials.
      </p>
      <p>
        Personally, I moved from Scotland to Cincinnati in 2017 to be with my wife, became a U.S.
        citizen in 2022, and these days{' '}
        {/* Family "we", not the studio: exempt from the copy lint (tests/unit/copy-rules.test.mjs). */}
        <span data-copy-ignore>we're raising two kids and buying our first house here.</span> When
        I'm away from a screen I'm usually out on a long run, chasing landscapes with a camera, deep
        in an ambitious Lego build with the kids, or a few episodes into a history drama.
      </p>
    </div>
  </Section>

  <!-- 4. Outside the studio: the contact sheet. Frames crop to 4:5 with
       object-fit (the full srcset stays on the <img>), so the Lightbox clone
       shows the whole photo. -->
  <Section
    tone="paper"
    rail="Outside the studio"
    railMeta={`${photos.length} frames`}
    labelledby="about-outside-heading"
  >
    <h2 id="about-outside-heading">
      Outside the <b>studio</b>
    </h2>
    <p class="about-lede">
      A few snapshots from the rest of life around Cincinnati: family, the trails, and the
      occasional turn in front of the camera.
    </p>
    <ol class="contact-sheet" role="list" data-reveal-group>
      {photos.map((photo, index) => (
        <li data-reveal>
          <figure>
            <button type="button" class="sheet-frame" data-zoom title="View larger">
              <Picture
                src={photo.src}
                alt={photo.alt}
                widths={ladder([240, 360, 480, 720, 1200, 1600])}
                sizes="(min-width: 82.5rem) 164px, (min-width: 64rem) calc(12.7vw - 5px), (min-width: 48rem) calc(31.5vw - 15px), calc(49vw - 26px)"
                class="sheet-img"
                {...PICTURE}
              />
            </button>
            <figcaption>
              <span class="sheet-num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              {photo.caption}
            </figcaption>
          </figure>
        </li>
      ))}
    </ol>
  </Section>

  <!-- 5. Currently. id="now" so the /now redirect and the footer link land
       here. -->
  <Section id="now" rail="Now" railMeta={freshness} labelledby="about-currently-heading">
    <h2 id="about-currently-heading">Currently</h2>
    <p class="about-lede">
      A present-tense snapshot of the studio: current work, what I'm reading, and what I'm trying to
      get sharper on. Rewritten every couple of months.
    </p>
    <p class="now-stamp">
      <span class="now-dot-wrap" aria-hidden="true" data-motion="loop">
        <span class="now-dot bg-emerald-500"></span>
      </span>
      Last updated {lastUpdatedLabel}.
    </p>

    <div class="now-sheet">
      <div class="now-col">
        <section aria-labelledby="now-working">
          <h3 id="now-working">Working on</h3>
          <ul class="now-list" data-reveal-group>
            {workingOn.map((item) => (
              <li data-reveal>{item}</li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="now-booking">
          <h3 id="now-booking">Booking</h3>
          <ul class="now-list" data-reveal-group>
            {booking.map((slot) => (
              <li data-reveal>
                <span class:list={['now-status', statusMeta[slot.status].text]}>
                  <span class="now-status-dot" aria-hidden="true" />
                  {statusMeta[slot.status].word}
                </span>
                <span class="now-label">{slot.label}</span>
                <span class="now-detail">{slot.detail}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <div class="now-col">
        <section aria-labelledby="now-reading">
          <h3 id="now-reading">Reading</h3>
          <ul class="now-list" data-reveal-group>
            {reading.map((book) => (
              <li data-reveal>
                <span class="now-label">
                  {book.title}
                  {book.note && <span class="now-note">({book.note})</span>}
                </span>
                <span class="now-detail now-muted">{book.author}</span>
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="now-learning">
          <h3 id="now-learning">Learning</h3>
          <ul class="now-list" data-reveal-group>
            {learning.map((item) => (
              <li data-reveal>{item}</li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </Section>

  <!-- 6. One line to the practical side, on /services. -->
  <Section rail="How I work" prose label="How I work" class="about-next">
    <p class="about-next-line">
      The practical side, how I run a project and why it costs what it costs, is on{' '}
      <a href="/services/#why">the services page</a>.
    </p>
  </Section>

  <!-- Click / keyboard zoom for the contact sheet. Rendered once. -->
  <Lightbox />
</BaseLayout>

<style>
  /* ---- 1. Head ------------------------------------------------------------
     Below lg: one column, headshot first (visual order only; the H1 stays
     first in the DOM) so the photo is the biggest thing on a phone's first
     screen. From lg: text in columns 1 to 6, headshot in 7 to 12. */
  .about-head {
    padding-block: clamp(2rem, 5vw, 4rem) var(--space-section);
  }
  .about-head .page-grid {
    row-gap: 2rem;
    align-items: start;
  }
  .about-head-photo {
    order: -1;
    width: 100%;
    max-width: 24rem;
  }
  .about-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .about-kicker-label {
    color: var(--heading);
  }
  .about-head h1 {
    max-width: 16ch;
    /* The long-title step (2.25rem floor): "organizations" at 800 needs about
       300px at the 2.75rem floor, more than a 320px screen has, and would
       break mid-word. Same size as the page H1 from about 860px up. */
    font-size: var(--text-h1-long);
  }
  .about-intro {
    max-width: 58ch;
    margin-top: 1.75rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--foreground);
  }
  @media (min-width: 64rem) {
    .about-head .page-grid {
      align-items: center;
    }
    .about-head-text {
      grid-column: 1 / 7;
    }
    .about-head-photo {
      order: 0;
      grid-column: 7 / 13;
      max-width: none;
    }
  }

  /* ---- 2. In short -------------------------------------------------------- */
  .about-thesis {
    max-width: 40ch;
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--heading);
  }
  .about-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0 var(--grid-gutter);
    margin-top: 2.5rem;
    border-bottom: 1px solid var(--line);
  }
  .about-facts > div {
    padding-block: 1rem;
    border-top: 1px solid var(--line);
  }
  .about-facts dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .about-facts dd {
    margin: 0.375rem 0 0;
    color: var(--heading);
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  /* ---- 3. Story ----------------------------------------------------------- */
  .about-story {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 2rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--foreground);
  }

  /* ---- Shared lede under an H2 ------------------------------------------- */
  .about-lede {
    max-width: 60ch;
    margin-top: 0.75rem;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--muted-foreground);
  }

  /* ---- 4. Contact sheet ---------------------------------------------------
     Uniform 4:5 frames with a mono frame number, like a proof sheet. Two
     across on a phone, three from md, all five in one strip from lg. */
  .contact-sheet {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem var(--grid-gutter);
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .contact-sheet {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .contact-sheet {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .sheet-frame {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-frame);
    box-shadow:
      0 0 0 1px var(--frame-ring),
      var(--shadow-frame);
    overflow: hidden;
    background: var(--background);
    cursor: zoom-in;
  }
  .sheet-frame:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 3px;
  }
  .sheet-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform var(--dur-settle, 0.4s) var(--ease-glide, ease);
  }
  .sheet-frame:hover .sheet-img {
    transform: scale(1.03);
  }
  figcaption {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .sheet-num {
    color: var(--heading);
  }
  @media (forced-colors: active) {
    .sheet-frame {
      outline: 1px solid CanvasText;
      outline-offset: -1px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet-img {
      transition: none;
    }
    .sheet-frame:hover .sheet-img {
      transform: none;
    }
  }

  /* ---- 5. Currently ------------------------------------------------------- */
  :global(#now) {
    scroll-margin-top: 5rem;
  }
  .now-stamp {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }
  /* The loop tag sits on a wrapper: the global Pause rule reaches the pseudo-
     elements of a loop's descendants, not of the tagged element itself. */
  .now-dot-wrap {
    display: inline-flex;
  }
  .now-dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    flex: none;
    border-radius: 9999px;
  }
  .now-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: now-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes now-ping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .now-dot::after {
      animation: none;
    }
  }

  .now-sheet {
    display: grid;
    gap: 2.5rem var(--grid-gutter);
    margin-top: 2.5rem;
  }
  @media (min-width: 48rem) {
    .now-sheet {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .now-col {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .now-col h3 {
    font-size: var(--text-h5);
  }
  .now-list {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }
  .now-list > li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 0.875rem;
    border-top: 1px solid var(--line);
    line-height: 1.55;
    color: var(--foreground);
  }
  .now-label {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.3;
    color: var(--heading);
  }
  .now-note {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .now-muted {
    font-size: 0.9375rem;
    color: var(--muted-foreground);
  }

  /* Status word plus a decorative dot; the word carries the meaning. */
  .now-status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .now-status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: currentColor;
  }

  /* ---- 6. The one line to /services --------------------------------------- */
  :global(.ncs-section.about-next) {
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .about-next-line {
