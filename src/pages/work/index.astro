---
/* /work: every client as a large desktop window, because a buyer is judging the
   page design. src/scripts/work.js filters by sector (?sector=church) and switches
   to the ruled list (?view=list). Without JavaScript the ruled list is the page.
   Under the windows, the same studies indexed by the job the site has to do
   (src/data/jobs.ts). Counts come from the case studies, never typed.
   Beside the list on a wide screen, the row you are on shows its window and its outcome. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/pages/work.css';
import Tile from '../../components/Tile.astro';
import Closing from '../../components/Closing.astro';
import WorkFigures from '../../components/WorkFigures.astro';
import LabStrip from '../../components/LabStrip.astro';
import captureSizes from '../../data/capture-sizes.json';
import { countWord, getClients, SECTOR_LABEL } from '../../lib/clients';
import { JOBS } from '../../data/jobs';
import { sectorPage, sectorPagePath } from '../../data/sector-pages';
import { plainText, wordSpans } from '../../lib/words';
import { LOCK } from '../../lib/window-chrome';

const clients = await getClients();
const n = clients.length;
const filters = [
  { key: 'all', label: 'All', n },
  ...Object.entries(SECTOR_LABEL).map(([key, label]) => ({
    key,
    label,
    n: clients.filter((c) => c.sectorKey === key).length,
  })),
];
/* The marks over each window: its place in the deck and the real size of the still and the footage
   behind it. The sizes are checked against the files by src/lib/work-figures.test.ts, so they only
   ever say what is true; a study with no entry simply prints no size. */
const pad = (v: number) => String(v).padStart(2, '0');
const sizes = captureSizes as Record<string, { still: number[]; footage: number[] } | undefined>;
const marks = clients.map((c, i) => {
  const z = sizes[c.slug];
  return {
    place: `${pad(i + 1)} / ${pad(n)}`,
    still: z ? `${z.still[0]} × ${z.still[1]}` : '',
    footage: z ? `${z.footage[0]} × ${z.footage[1]}` : '',
  };
});
const heading = `<span>${countWord(n)} selected</span> <b>case studies.</b>`;

const jobs = JOBS.map((job) => ({
  ...job,
  studies: job.studies.flatMap(({ slug, why }) => {
    const client = clients.find((c) => c.slug === slug);
    return client ? [{ client, why }] : [];
  }),
})).filter((job) => job.studies.length > 0);
---

<BaseLayout
  title="Case studies | Nixon Creative Studio"
  description="Selected case studies from websites I planned, designed and built for churches, schools, nonprofits and small businesses, with links to the live sites."
>
  <header class="page-head">
    <div class="big">
      <h1
        id="h"
        class="giant"
        style="--fit:9;--fitm:18"
        aria-label={plainText(heading)}
        set:html={wordSpans(heading)}
      />
    </div>
    <p class="lede">
      Churches, schools, nonprofits and small businesses. Look at the real pages, read how each one
      came together, then visit the live site. Or find them by{' '}
      <a href="#jobs">what the site has to do</a>.
    </p>
  </header>

  <section class="dw" aria-label="The case studies" data-section data-view="grid">
    <div class="dw-bar" data-bar>
      <div class="dw-seg" role="group" aria-label="Show case studies by sector" data-filters>
        <span class="dw-pill" data-pill aria-hidden="true"></span>
        {filters.map((f, i) => (
          <button
            type="button"
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-f={f.key}
            data-more-href={sectorPagePath(f.key)}
            data-more-label={sectorPage(f.key)?.linkText}
          >
            {f.label} <span class="n">{f.n}</span>
          </button>
        ))}
      </div>
      <div class="dw-seg" role="group" aria-label="View case studies as" data-views>
        <span class="dw-pill" data-pill aria-hidden="true"></span>
        <button type="button" aria-pressed="true" data-v="grid">
          Grid
        </button>
        <button type="button" aria-pressed="false" data-v="list">
          List
        </button>
      </div>
      <p class="dw-status" role="status" data-status>
        Showing all {n} case studies.
      </p>
      <a class="dw-more" href="/churches/" data-more hidden>
        How I build for churches
      </a>
    </div>
    <ul class="dw-grid" data-grid>
      {clients.map((s, i) => (
        <li data-key={s.sectorKey}>
          <p class="dw-mark" aria-hidden="true">
            <span>{marks[i].place}</span>
            <span class="dw-ruler" />
            {marks[i].still && <span>Still {marks[i].still}</span>}
            {marks[i].footage && <span class="dw-ft">Footage {marks[i].footage}</span>}
          </p>
          <Tile client={s} index={i} lazy={i > 1} desk />
          <div class="dw-note">
            <h2>{s.name}</h2>
            <p class="label">{s.sector}</p>
            <p class="dw-out">{s.outcome}</p>
            <p class="dw-links">
              <a href={s.study}>
                Read the case study<span class="vh">: {s.name}</span>
              </a>
              {s.live && (
                <a
                  href={s.live}
                  target="_blank"
                  rel="noopener"
                  data-cta="visit_client_site"
                  data-cta-location="work_grid"
                >
                  Visit the site<span class="vh">: {s.name} (opens in a new tab)</span>
                </a>
              )}
            </p>
          </div>
        </li>
      ))}
    </ul>
    <div class="dw-list">
      <ul class="dw-rows card" data-rows>
        {clients.map((s) => (
          <li data-key={s.sectorKey} data-slug={s.slug} style={`--c:${s.accent};--p:${s.paper}`}>
            <span class="mini" aria-hidden="true">
              <img
                src={s.still}
                srcset={s.stillSet}
                sizes="4rem"
                alt=""
                loading="lazy"
                width="584"
                height="1138"
              />
            </span>
            <h2>{s.name}</h2>
            <p class="sc">{s.sector}</p>
            <p class="wh">{s.hook}</p>
            {s.outcome && <p class="ou">{s.outcome}</p>}
            <a href={s.study}>
              Read the case study<span class="vh">: {s.name}</span>
            </a>
            {s.live && (
              <a
                class="vis"
                href={s.live}
                target="_blank"
                rel="noopener"
                data-cta="visit_client_site"
                data-cta-location="work_list"
              >
                Visit the site<span class="vh">: {s.name} (opens in a new tab)</span>
              </a>
            )}
          </li>
        ))}
      </ul>
      {/* The window for the row you are on (work.js): hover, keyboard focus, or the row nearest the
        middle of a touch screen. Hidden figures fetch nothing. The words are in the row too, so
        this whole stage is decoration. */}
      <div class="dw-peek" data-peek aria-hidden="true">
        <div class="dw-peek-in">
          {clients.map((s, i) => (
            <figure data-for={s.slug} hidden style={`--c:${s.accent};--p:${s.paper}`}>
              <p class="dw-mark">
                <span>{marks[i].place}</span>
                <span class="dw-ruler" />
                {marks[i].still && <span>Still {marks[i].still}</span>}
              </p>
              <span class="tile desk">
                <span class="b-top">
                  <span class="url">
                    <Fragment set:html={LOCK} />
                    <span>{s.host}</span>
                  </span>
                </span>
                <span class="scr">
                  <img
                    src={s.deskStill}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width="1000"
                    height="750"
                  />
                </span>
              </span>
              {s.outcome && <figcaption>{s.outcome}</figcaption>}
            </figure>
          ))}
        </div>
      </div>
    </div>
    {/* Back from a case study: its hero shrinks into this page's window for it (the leaving half is
        src/scripts/hero-morph.js). Inline, because it has to listen before the first paint. */}
    <script is:inline>
      addEventListener('pagereveal', function (e) {
        var nav = window.navigation,
          from = e.viewTransition && nav && nav.activation && nav.activation.from;
        var m = from && /^\/work\/([a-z0-9-]+)\/$/.exec(new URL(from.url).pathname);
        var el = m && document.querySelector('[data-grid] .tile[data-slug="' + m[1] + '"]');
        if (!el || document.querySelector('[data-section]').dataset.view === 'list') return;
        var r = el.getBoundingClientRect();
        if (r.bottom <= 0 || r.top >= innerHeight) return;
        el.style.viewTransitionName = 'study-hero';
        e.viewTransition.finished.finally(function () {
          el.style.viewTransitionName = '';
        });
      });
    </script>
  </section>

  <WorkFigures clients={clients} />

  <section class="sec tight jobs" id="jobs" aria-labelledby="jobs-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="jobs-h">What the site has to do</h2>
        <p>
          If your exact line of work is not above, the job may still be. Each of these is what the
          site was built to do, not a promise about the numbers.
        </p>
      </div>
      <ul class="jobs-list">
        {jobs.map((job) => (
          <li class="job" id={`job-${job.id}`}>
            <div class="job-say">
              <h3>{job.title}</h3>
              <p>{job.line}</p>
            </div>
            <ul class="job-studies">
              {job.studies.map(({ client, why }) => (
                <li>
                  <a href={client.study}>{client.name}</a>
                  <span>{why}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* The lab: things I built for my own people, after all the client work so it never pushes a
      case study down. Not case studies, never counted with them (src/components/LabStrip.astro). */}
  <LabStrip />

  <Closing lead="Don't see your kind of <b>organization?</b>" />
</BaseLayout>

<script>
  import '../../scripts/work.js';
</script>
