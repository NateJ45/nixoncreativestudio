---
/* /work: every client on the table. src/scripts/work.js deals the windows and
   re-deals them when you pick a sector (?sector=church), and switches to the
   ruled list (?view=list). Without JavaScript this is the full grid, every
   window a link. Counts come from the case studies, never typed. */
import '../../styles/pages/work.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tile from '../../components/Tile.astro';
import Caption from '../../components/Caption.astro';
import Closing from '../../components/Closing.astro';
import { getClients, SECTOR_LABEL } from '../../lib/clients';
import { plainText, wordSpans } from '../../lib/words';

const clients = await getClients();
const n = clients.length;
const filters = [
  { key: 'all', label: 'All', n },
  ...Object.entries(SECTOR_LABEL).map(([key, label]) => ({
    key,
    label,
    n: clients.filter((c) => c.sectorKey === key).length,
  })),
];
const heading = `<span>${n} sites,</span> <b>all live today.</b>`;
---

<BaseLayout
  title="Case studies | Nixon Creative Studio"
  description={`${n} live client websites I planned, designed and built for churches, schools, nonprofits and small businesses, each with the thinking behind it.`}
>
<header class="page-head">
<div class="big"><h1 id="h" class="giant" style="--fit:12.2;--fitm:18.8" aria-label={plainText(heading)} set:html={wordSpans(heading)} /></div>
<p class="lede">Churches, schools, nonprofits and small businesses. Each one started with a conversation about what the organization actually needed.</p>
</header>

<section class="dw" aria-label="The sites" data-section data-view="grid">
<div class="dw-bar" data-bar>
<div class="dw-seg" role="group" aria-label="Show sites by sector" data-filters>
<span class="dw-pill" data-pill aria-hidden="true"></span>
{filters.map((f, i) => (<button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-f={f.key}>{f.label} <span class="n">{f.n}</span></button>))}
</div>
<div class="dw-seg" role="group" aria-label="View sites as" data-views>
<span class="dw-pill" data-pill aria-hidden="true"></span>
<button type="button" aria-pressed="true" data-v="grid">Grid</button>
<button type="button" aria-pressed="false" data-v="list">List</button>
</div>
<p class="dw-status" role="status" data-status>Showing all {n} sites.</p>
<a class="dw-more" href="/churches/" data-more hidden>More on the church sites I build</a>
</div>
<ul class="grid dw-grid" data-grid>
{clients.map((s, i) => (
<li data-key={s.sectorKey}>
<Tile client={s} index={i} lazy={i > 3} />
<div class="dw-note">
<Caption client={s} index={i} />
<div class="more"><p>{s.hook}</p><a href={s.study}>Read the case study<span class="vh">: {s.name}</span></a></div>
</div>
</li>
))}
</ul>
<ul class="dw-rows card" data-rows>
{clients.map((s) => (
<li data-key={s.sectorKey} style={`--c:${s.accent};--p:${s.paper}`}>
<span class="mini" aria-hidden="true"><img src={s.still} alt="" loading="lazy" width="584" height="1138" /></span>
<h2>{s.name}</h2>
<p class="sc">{s.sector}</p>
<p class="wh">{s.hook}</p>
<a href={s.study}>Read the case study<span class="vh">: {s.name}</span></a>
</li>
))}
</ul>
</section>

<Closing lead="Don't see your kind of <b>organization?</b>" />
</BaseLayout>

<script>
  import '../../scripts/work.js';
</script>
