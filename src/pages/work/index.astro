---
// Safe to edit. Page content is driven from the case-studies content
// collection; add new MDX files in src/content/case-studies/ to grow the list.
/* ============================================================================
   /work: the index (overhaul package 2.3)
   ============================================================================
   Its job is "find one like mine, then open it". From the top:

   1. The H1, "{n} sites, all live today." n is the size of the collection,
      and "all live today" is only said when every study has a liveUrl; if one
      ever goes dark the line becomes "all shipped." on its own. The heavy
      phrase is this page's one Heft (ruling 9).
   2. WorkFilter: mono sector tabs driven by ?sector= in the URL, plus the
      aria-live line that says what is showing. Without JS every row shows.
   3. One ruled <ol>, in the `order` frontmatter field (Stone Steps, order 1,
      gets a larger first row). Each row is the client name in Bricolage, the
      hook, sector and year in mono, and two links that are siblings, never
      nested: the case study (the whole row, through a stretched ::after) and
      the live host with an arrow, which sits above the stretch.
   4. On a fine pointer from md up: hovering or focusing a row tints it in the
      client's own paper colour (light mode; in dark the row stays on ink with
      a rule in the client's dark mark, ruling 8), and the pinned preview frame
      on the right shows that site's full-page capture and pans down it once,
      for at most 6s, stopping when the pointer or focus leaves. Captures are
      fetched only when a row is first hovered, so they cost nothing at load.
   5. On touch, or below md: no preview frame; each row carries a 16:10
      thumbnail of the site's cover instead (lazy, except the first).

   The page ends on the footer closer ("Don't see your kind of organization?"),
   whose pill carries ?from=work into the contact form.

   Contrast: the light-mode tint is the client's paper behind this site's own
   heading, body, muted and link colours; src/lib/case-palettes.test.ts checks
   every one of those pairs for every study. The dark rule uses the same mark
   colour the title card does (markDark, else dark.accent, else accent), which
   that test already checks against ink.
   ============================================================================ */

import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { DEFAULT_CLOSER, SECTOR_PHRASE, SECTOR_PLURAL } from '../../lib/closer';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkFilter from '../../components/WorkFilter.astro';
import Heft from '../../components/Heft.astro';
import Media from '../../components/Media.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import { getCoverPlaceholder } from '../../lib/coverPlaceholder';
import { sectorPagePath } from '../../data/sector-pages';

// Study order: the `order` field (1 = first). A study without one sorts last,
// newest first among those, so a new draft never jumps the queue.
const entries = (await getCollection('case-studies')).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER) ||
    b.data.published.valueOf() - a.data.published.valueOf(),
);
const n = entries.length;
const allLive = entries.every((e) => Boolean(e.data.liveUrl));
const heavy = allLive ? 'all live today.' : 'all shipped.';

// Sector tabs: only sectors that have a study, in a fixed order, with counts.
const SECTOR_ORDER = ['church', 'school', 'nonprofit', 'small-business'] as const;
const sectors = SECTOR_ORDER.map((value) => ({
  value,
  label: SECTOR_PLURAL[value] ?? value,
  count: entries.filter((e) => e.data.sector === value).length,
})).filter((s) => s.count > 0);

// Sectors with a page of their own (/churches/): WorkFilter links to it while
// that sector's tab is on.
const sectorPages = Object.fromEntries(
  sectors.flatMap((s) => {
    const path = sectorPagePath(s.value);
    return path ? [[s.value, path]] : [];
  }),
);

// The sector as one word on a row ("Small business").
const sectorName = (sector: string) => {
  const phrase = SECTOR_PHRASE[sector] ?? sector.replace(/-/g, ' ');
  return phrase.charAt(0).toUpperCase() + phrase.slice(1);
};

// The host as people say it: no protocol, no "www.", no trailing slash.
const hostOf = (url: string) => new URL(url).hostname.replace(/^www\./, '');

// Full-page captures for the preview pan (shots/{slug}-home.png, 1440 wide and
// up to 10824 tall). Cropped from the top to 2.4x the width, which is plenty
// to pan through in 6s, and served as WebP at three widths. Only URLs go into
// the page; the browser fetches a capture when its row is first hovered.
const homeShots = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/case-studies/shots/*-home.png',
  { eager: true },
);
const shotFor = (id: string): ImageMetadata | undefined =>
  Object.entries(homeShots).find(([path]) => path.endsWith(`/${id}-home.png`))?.[1].default;

const PREVIEW_DEPTH = 2.4; // capture height as a multiple of its width
const PREVIEW_WIDTHS = [480, 720, 1040];
// The preview column: 5 of 12 columns from md, 4 of 12 from lg.
const PREVIEW_SIZES = '(min-width: 64rem) 34vw, 40vw';

const rows = await Promise.all(
  entries.map(async (entry, i) => {
    const shot = shotFor(entry.id) ?? entry.data.cover;
    const width = Math.min(Math.max(...PREVIEW_WIDTHS), shot.width);
    const height = Math.round(width * Math.min(shot.height / shot.width, PREVIEW_DEPTH));
    const preview = await getImage({
      src: shot,
      width,
      height,
      widths: PREVIEW_WIDTHS.filter((w) => w <= shot.width),
      fit: 'cover',
      position: 'top',
      format: 'webp',
    });
    const palette = entry.data.palette;
    const markDark = palette ? (palette.markDark ?? palette.dark?.accent ?? palette.accent) : '';
    return {
      entry,
      first: i === 0,
      host: entry.data.liveUrl ? hostOf(entry.data.liveUrl) : '',
      sector: entry.data.facts?.sector ?? sectorName(entry.data.sector),
      year: entry.data.facts?.year ?? String(entry.data.year),
      preview: {
        src: preview.src,
        srcset: preview.srcSet.attribute,
        ratio: `${width} / ${height}`,
      },
      style: palette
        ? `--row-paper: ${palette.paper}; --row-mark: ${palette.accent}; --row-mark-dark: ${markDark};`
        : undefined,
    };
  }),
);

// The preview frame starts on the first study's capture, at rest.
const lead = rows[0];
---

<BaseLayout
  title="Case studies | Nixon Creative Studio"
  description={`${n} live client websites I planned, designed and built for churches, schools, nonprofits and small businesses, each with the thinking behind it.`}
  closer={{
    heading: "Don't see your kind of",
    emphasis: 'organization?',
    sub: DEFAULT_CLOSER.sub,
    href: '/contact/?from=work',
  }}
>
  <section class="work-index py-section" aria-labelledby="work-index-heading">
    <div class="ncs-container page-grid">
      {/* The H1 and filter span the full width. This band does not use
          Section.astro: the list and the pinned preview need the whole
          12 columns, not Section's body columns 4 to 12. */}
      <header class="work-head">
        <h1 id="work-index-heading">
          {n} sites, <Heft text={heavy} />
        </h1>
        <p class="work-lede">
          Churches, schools, nonprofits and small businesses. Each one started with a conversation
          about what the organization actually needed.
        </p>
        {sectors.length > 1 && (
          <WorkFilter sectors={sectors} total={n} phrases={SECTOR_PHRASE} pages={sectorPages} />
        )}
      </header>

      <ol class="work-list" data-work-list>
        {rows.map((row) => {
          const { entry } = row;
          return (
            <li
              class:list={['work-row', row.first && 'work-row--lead']}
              data-work-row
              data-sector={entry.data.sector}
              data-slug={entry.id}
              data-host={row.host}
              data-preview-src={row.preview.src}
              data-preview-srcset={row.preview.srcset}
              data-preview-ratio={row.preview.ratio}
              style={row.style}
            >
              <div class="work-row-text">
                <h2 class="work-name">
                  <a class="work-link" href={`/work/${entry.id}/`}>
                    {entry.data.client}
                    <span class="sr-only">, case study</span>
                  </a>
                </h2>
                {entry.data.hook && <p class="work-hook">{entry.data.hook}</p>}
                <p class="work-meta">
                  <span>{row.sector}</span>
                  <span aria-hidden="true">·</span>
                  <span>{row.year}</span>
                </p>
                <p class="work-actions">
                  <span class="work-cta" aria-hidden="true">
                    Case study <span class="work-arrow">→</span>
                  </span>
                  {entry.data.liveUrl && (
                    <a
                      class="work-host"
                      href={entry.data.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {row.host}
                      <span aria-hidden="true">↗</span>
                      <span class="sr-only">(live site, opens in a new tab)</span>
                    </a>
                  )}
                </p>
              </div>
              {/* Touch and small screens only (hidden on a fine pointer from
                  md, where the preview frame does this job, so the lazy image
                  is never fetched there). alt="" because the name beside it
                  says the same thing. */}
              <div class="work-thumb">
                <Media
                  src={entry.data.cover}
                  alt=""
                  ratio="16 / 10"
                  position="top"
                  widths={row.first ? [360, 560, 720, 960] : [360, 560, 720]}
                  sizes={
                    row.first
                      ? '(min-width: 48rem) 50vw, calc(100vw - 2rem)'
                      : '(min-width: 48rem) 38vw, calc(100vw - 2rem)'
                  }
                  lcp={row.first}
                  placeholder={getCoverPlaceholder(entry.id)}
                  class="work-thumb-media"
                />
              </div>
            </li>
          );
        })}
      </ol>

      {/* The pinned preview. Decorative (aria-hidden): every row already
          names its site and links to it. Shown only on a fine pointer from md
          up; starts on the lead study's capture, lazily loaded, so it costs
          nothing on a phone, where it is display: none. */}
      {lead && lead.host && (
        <aside class="work-preview" aria-hidden="true" data-work-preview>
          <BrowserFrame url={lead.entry.data.liveUrl ?? ''} class="work-preview-frame">
            <div class="work-preview-screen">
              <img
                class="work-preview-img"
                src={lead.preview.src}
                srcset={lead.preview.srcset}
                sizes={PREVIEW_SIZES}
                style={`aspect-ratio: ${lead.preview.ratio}`}
                alt=""
                loading="lazy"
                decoding="async"
                data-preview-img
              />
            </div>
          </BrowserFrame>
        </aside>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .work-head {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .work-head h1 {
    max-width: 16ch;
  }
  .work-lede {
    max-width: 52ch;
    margin: 1.25rem 0 2rem;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--muted-foreground);
  }

  /* ---- The ruled list ---------------------------------------------------- */
  .work-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .work-row {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding: 1.75rem 0.75rem;
    border-bottom: 1px solid var(--line);
    /* The client mark: a 4px rule on the left, shown on hover and focus. */
    box-shadow: inset 0 0 0 transparent;
    transition:
      background-color var(--dur-quick) var(--ease-glide),
      box-shadow var(--dur-quick) var(--ease-glide);
  }

  .work-name {
    margin: 0;
    font-size: clamp(2rem, 5vw, 4.5rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .work-row--lead {
    padding-block: 2.5rem;
  }
  .work-row--lead .work-name {
    font-size: clamp(2.5rem, 7vw, 6rem);
  }

  /* The whole row is the case-study link: a stretched ::after covers the
     <li>. The host link sits above it (z-index), so the two are siblings
     with their own targets and never nest. */
  .work-link {
    color: var(--heading);
    text-decoration: none;
  }
  .work-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .work-link:focus-visible {
    outline: none;
  }
  .work-link:focus-visible::after {
    outline: 2px solid var(--ring);
    outline-offset: -2px;
  }

  .work-hook {
    margin: 0.75rem 0 0;
    max-width: 44ch;
    font-size: 1.125rem;
    line-height: 1.45;
    color: var(--foreground);
  }
  .work-row--lead .work-hook {
    font-size: 1.25rem;
  }

  .work-meta,
  .work-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin: 0.75rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .work-actions {
    gap: 0.25rem 1.5rem;
    margin-top: 1rem;
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .work-cta {
    color: var(--heading);
  }
  .work-arrow {
    display: inline-block;
    transition: transform var(--dur-quick) var(--ease-glide);
  }
  .work-host {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
  }
  .work-host:hover,
  .work-host:focus-visible {
    text-decoration-color: currentColor;
  }
  .work-host:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: 2px;
  }
  @media (pointer: coarse) {
    .work-host {
      min-height: 44px;
      align-items: center;
    }
  }

  /* ---- Thumbnails (touch, or below md) ----------------------------------- */
  .work-thumb :global(.work-thumb-media) {
    border-radius: var(--radius-frame);
    box-shadow: 0 0 0 1px var(--frame-ring);
  }
  @media (min-width: 48rem) {
    .work-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 38%);
      align-items: center;
      gap: 2rem;
    }
    .work-row--lead {
      grid-template-columns: minmax(0, 1fr) minmax(0, 50%);
    }
  }

  /* ---- The preview frame (fine pointer, md and up) ----------------------- */
  .work-preview {
    display: none;
  }

  @media (min-width: 48rem) and (hover: hover) and (pointer: fine) {
    .work-list {
      grid-column: 1 / 8;
    }
    .work-preview {
      display: block;
      grid-column: 8 / 13;
      align-self: start;
      position: sticky;
      top: 7rem;
    }
    .work-row,
    .work-row--lead {
      grid-template-columns: minmax(0, 1fr);
    }
    .work-thumb {
      display: none;
    }

    /* Hover and focus: the client's paper behind this site's own text, and
       the client's accent as a 4px rule on the left. */
    .work-row:hover,
    .work-row:focus-within {
      background-color: var(--row-paper, var(--paper));
      box-shadow: inset 4px 0 0 var(--row-mark, var(--line-strong));
    }
    .work-row:hover .work-arrow,
    .work-row:focus-within .work-arrow {
      transform: translateX(4px);
    }
    /* Dark mode never borrows a client's light paper (ruling 8): the row sits
       on ink with the client's dark mark as the rule. */
    :global(.dark) .work-row:hover,
    :global(.dark) .work-row:focus-within {
      background-color: var(--ink);
      box-shadow: inset 4px 0 0 var(--row-mark-dark, var(--line-strong));
    }
  }
  @media (min-width: 64rem) and (hover: hover) and (pointer: fine) {
    .work-list {
      grid-column: 1 / 9;
    }
    .work-preview {
      grid-column: 9 / 13;
    }
  }

  .work-preview-screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--paper);
  }
  .work-preview-img {
    position: absolute;
    inset: 0 0 auto;
    display: block;
    width: 100%;
    height: auto;
    will-change: transform;
  }

  @media (forced-colors: active) {
    .work-row:hover,
    .work-row:focus-within {
      outline: 2px solid Highlight;
      outline-offset: -2px;
    }
  }
</style>

<script>
  import { isMotionPaused, prefersReducedMotion } from '../../scripts/motion';

  // The longest a pan may run (Part B: capped at 6s).
  const PAN_MS = 6000;

  function initWorkPreview(): void {
    const preview = document.querySelector<HTMLElement>('[data-work-preview]:not([data-bound])');
    if (!preview) return;
    preview.dataset.bound = 'true';
    const img = preview.querySelector<HTMLImageElement>('[data-preview-img]');
    const screen = img?.parentElement;
    const host = preview.querySelector<HTMLElement>('.bf-host');
    if (!img || !screen) return;

    // Only worth wiring where the frame is actually shown.
    const fine = window.matchMedia('(min-width: 48rem) and (hover: hover) and (pointer: fine)');
    let current: HTMLElement | null = null;
    let pan: Animation | null = null;

    function startPan(): void {
      pan?.cancel();
      pan = null;
      if (prefersReducedMotion() || isMotionPaused()) return;
      const travel = img!.offsetHeight - screen!.clientHeight;
      if (travel <= 0) return;
      pan = img!.animate(
        [{ transform: 'translateY(0)' }, { transform: `translateY(-${travel}px)` }],
        {
          duration: PAN_MS,
          easing: 'cubic-bezier(0.45, 0, 0.55, 1)',
          fill: 'forwards',
        },
      );
    }

    function show(row: HTMLElement): void {
      if (!fine.matches) return;
      if (row === current) {
        // Back on the same row: carry on from where the pan stopped.
        if (pan && pan.playState === 'paused') pan.play();
        return;
      }
      current = row;
      pan?.cancel();
      pan = null;
      const src = row.dataset.previewSrc ?? '';
      if (img!.getAttribute('src') !== src) {
        img!.style.aspectRatio = row.dataset.previewRatio ?? '';
        img!.srcset = row.dataset.previewSrcset ?? '';
        img!.src = src;
      }
      if (host) host.textContent = row.dataset.host ?? '';
      // Pan once the capture has its pixels (it may still be on the wire).
      if (img!.complete && img!.naturalHeight > 0) startPan();
      else img!.addEventListener('load', () => current === row && startPan(), { once: true });
    }

    function stop(): void {
      // "Stops on leave": the pan holds where it is, it does not snap back.
      if (pan && pan.playState === 'running') pan.pause();
    }

    document.querySelectorAll<HTMLElement>('[data-work-row]').forEach((row) => {
      row.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') show(row);
      });
      row.addEventListener('pointerleave', stop);
      row.addEventListener('focusin', () => show(row));
      row.addEventListener('focusout', (e) => {
        if (!row.contains(e.relatedTarget as Node | null)) stop();
      });
    });
  }

  document.addEventListener('astro:page-load', initWorkPreview);
</script>
