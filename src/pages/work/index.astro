---
// Safe to edit. Page content is read from the EmDash CMS (collection
// `case_studies`, and the Work page entry for the words); add or edit entries in
// the EmDash admin. Server-rendered like every page; the route cache is tagged with
// the rows this page read (src/lib/routeCache.ts), so a publish purges it.
/* ============================================================================
   /work | The work
   ============================================================================
   Rebuilt in the 2026 redesign (A item 11: the old page was one featured card,
   eight identical cards and then the same nine sites again as a link table).
   Now a contact sheet laid out on the table, three bands:

     1. Hero (window-light, the one moving ground): the Work page headline and
        intro, then the LEAD printed large: the live study with the lowest
        homepage scene order (Stone Steps today; src/lib/workIndex.ts), in a
        film frame with its facts on the edge.
     2. The rest of the live work (paper), a varied composition of browser
        prints at different sizes and offsets, not a uniform grid. Film edges
        stay on the lead only (one device, used once:
        2026-10-04 review). Its heading and line
        are the Work page's "live" fields.
     3. Also built (deep, still): work that is finished or underway but not
        live, smaller and quieter, each with its status label
        (launchStatusLabel) and, for a launching-soon study, its preview link.
        Never presented as live proof.

   No sector filter: with nine studies in two groups the chips did not earn
   their place (or their React island). The Work page's "eyebrow" and "filter
   message" fields are no longer shown.
   ============================================================================ */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Band from '../../components/Band.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import WorkPrint from '../../components/WorkPrint.astro';
import { getSite } from '../../data/site';
import { getCaseStudies } from '../../lib/caseStudies';
import { getWorkPage, indexTitle } from '../../lib/indexPages';
import { launchStatusLabel } from '../../lib/launchStatus';
import { arrangeWork, prettyDomain, sectorLabel } from '../../lib/workIndex';
import { LEDGER_FACTS } from '../../data/workExtras';

const site = await getSite(Astro);
const page = await getWorkPage(Astro);
const entries = await getCaseStudies(Astro.cache);
const { lead, live, also } = arrangeWork(entries);

// The headline turns into the italic voice for its last word ("SELECTED work."),
// the way every big headline on the site does; a one-word headline stays all caps.
const words = page.heading.trim().split(/\s+/);
const headCaps = words.length > 1 ? words.slice(0, -1).join(' ') : page.heading;
const headVoice = words.length > 1 ? words[words.length - 1] : undefined;

const placeOf = (id: string) => LEDGER_FACTS[id]?.place;
---

<BaseLayout title={indexTitle(page.seoTitle, site.studioName)} description={page.seoDescription}>
  {/* 1. The headline and the lead print. */}
  <Band ground="window-light" underHeader labelledby="work-title" class="w-hero">
    <header class="w-head">
      <h1 id="work-title" class="type-display">
        {headCaps} {headVoice && <span class="voice">{headVoice}</span>}
      </h1>
      <p class="type-lede w-intro">
        {entries.length}
        {entries.length === 1 ? ' project' : ' projects'} {page.intro}
      </p>
    </header>
    {lead && (
      <div class="w-lead" data-work-lead>
        <WorkPrint
          cs={lead}
          variant="film"
          eager
          headingLevel={2}
          place={placeOf(lead.id)}
          sizes="(min-width: 64rem) 58vw, 92vw"
        />
      </div>
    )}
  </Band>

  {/* 2. The rest of the live work, printed at different sizes. */}
  {live.length > 0 && (
    <Band ground="paper" labelledby="work-live" class="w-live">
      <header class="w-live-head">
        <h2 id="work-live" class="type-headline">
          {page.liveHeading}
        </h2>
        <p class="w-live-body">{page.liveBody}</p>
      </header>
      <ul class="w-sheet" role="list">
        {live.map((cs) => (
          <li class="w-sheet-item">
            <WorkPrint
              cs={cs}
              variant="browser"
              place={placeOf(cs.id)}
              sizes="(min-width: 64rem) 50vw, 92vw"
            />
          </li>
        ))}
      </ul>
    </Band>
  )}

  {/* 3. Also built: honest about what is not live yet. */}
  {also.length > 0 && (
    <Band ground="deep" still labelledby="work-also" class="w-also">
      <div class="w-also-head">
        <h2 id="work-also" class="type-headline">
          Also <span class="voice">built</span>
        </h2>
        <p class="w-also-body">
          Finished or underway, but not live yet. Each one says where it stands.
        </p>
      </div>
      <ul class="w-also-list" role="list">
        {also.map((cs) => {
          const status = launchStatusLabel(cs.launchStatus);
          const host = cs.liveUrl ? prettyDomain(cs.liveUrl) : undefined;
          return (
            <li class="w-also-item" data-work-also data-status={cs.launchStatus}>
              <p class="w-also-meta type-caption">
                {status && <span class="w-also-status">{status}</span>}
                <span>{sectorLabel(cs.sector)}</span>
              </p>
              <h3 class="w-also-title">
                <a href={`/work/${cs.id}/`}>{cs.title}</a>
              </h3>
              <p class="w-also-text">{cs.outcome ?? cs.summary}</p>
              <p class="w-also-links type-ui">
                <a href={`/work/${cs.id}/`} class="card-link">
                  Read the case study
                </a>
                {host && (
                  <a
                    href={cs.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-also-visit"
                  >
                    See the finished build
                    <span aria-hidden="true"> ↗</span>
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                )}
              </p>
            </li>
          );
        })}
      </ul>
    </Band>
  )}

  <CtaBanner title={page.ctaTitle} sub={page.ctaSub} />
</BaseLayout>

<style>
  /* ---- 1. hero -------------------------------------------------------------- */
  .w-head {
    display: grid;
    gap: var(--spacing-m);
    align-items: end;
  }
  .w-head h1 {
    margin: 0;
  }
  .w-intro {
    margin: 0;
  }
  @media (min-width: 64rem) {
    .w-head {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: var(--spacing-xl);
    }
  }
  .w-lead {
    margin-top: var(--spacing-xl);
  }
  /* The lead: the print large on the left, its words beside it at the foot. */
  @media (min-width: 64rem) {
    .w-lead :global(.wp) {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      column-gap: var(--spacing-xl);
      align-items: end;
    }
  }

  /* ---- 2. the sheet ----------------------------------------------------------- */
  .w-live-head {
    display: grid;
    gap: var(--spacing-s);
    max-width: 44rem;
    margin-bottom: var(--spacing-xl);
  }
  .w-live-head h2 {
    margin: 0;
  }
  .w-live-body {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-lede);
    line-height: 1.4;
    color: var(--foreground);
  }
  .w-sheet {
    display: grid;
    gap: var(--spacing-2xl) var(--spacing-l);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Phones: one column, the prints stepping left and right like a hand-laid sheet. */
  @media (max-width: 47.99rem) {
    .w-sheet-item:nth-child(even) {
      padding-left: 8%;
    }
    .w-sheet-item:nth-child(odd) {
      padding-right: 8%;
    }
  }
  /* Tablets: two columns, the second one dropped. */
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .w-sheet {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .w-sheet-item:nth-child(even) {
      margin-top: var(--spacing-2xl);
    }
  }
  /* Desktop: a twelve-column table; five placements repeat, each a different size
     and offset, so no two neighbours share a shape. */
  @media (min-width: 64rem) {
    .w-sheet {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      row-gap: var(--spacing-xl);
    }
    .w-sheet-item:nth-child(5n + 1) {
      grid-column: 1 / span 7;
    }
    .w-sheet-item:nth-child(5n + 2) {
      grid-column: 9 / span 4;
      margin-top: var(--spacing-3xl);
    }
    .w-sheet-item:nth-child(5n + 3) {
      grid-column: 2 / span 5;
    }
    .w-sheet-item:nth-child(5n + 4) {
      grid-column: 7 / span 6;
      margin-top: calc(var(--spacing-2xl) * -1);
    }
    .w-sheet-item:nth-child(5n) {
      grid-column: 3 / span 8;
    }
    /* The wide one sets its words beside the print. */
    .w-sheet-item:nth-child(5n) :global(.wp) {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      column-gap: var(--spacing-l);
      align-items: end;
    }
  }

  /* ---- 3. also built ---------------------------------------------------------- */
  .w-also-head {
    display: grid;
    gap: var(--spacing-s);
    margin-bottom: var(--spacing-l);
  }
  @media (min-width: 64rem) {
    .w-also-head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: end;
      column-gap: var(--spacing-xl);
    }
  }
  .w-also-head h2 {
    margin: 0;
  }
  .w-also-body {
    margin: 0;
    max-width: 40ch;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--muted-foreground);
  }
  .w-also-list {
    display: grid;
    gap: var(--spacing-l);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .w-also-list {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }
  .w-also-item {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-top: var(--spacing-m);
    border-top: 1px solid color-mix(in oklab, var(--on-ink-muted) 40%, transparent);
  }
  .w-also-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 0;
  }
  .w-also-status {
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    background: var(--marker-hot);
    color: var(--ink);
    font-weight: 700;
  }
  .w-also-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    line-height: 1;
  }
  .w-also-title a {
    color: var(--heading);
    text-decoration: none;
  }
  .w-also-title a:hover,
  .w-also-title a:focus-visible {
    color: var(--link);
  }
  .w-also-text {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--muted-foreground);
  }
  .w-also-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--spacing-m);
    margin: 0;
  }
  .w-also-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .w-also-visit {
    color: var(--on-ink-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .w-also-visit:hover,
  .w-also-visit:focus-visible {
    color: var(--link);
  }
</style>
