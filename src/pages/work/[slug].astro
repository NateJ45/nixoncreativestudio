---
/* ============================================================================
   /work/{slug} | A case study
   ============================================================================
   The hero on the client's color with the laptop and phone thrown onto the page,
   then the story beside a phone that scrolls through the real site as you read,
   then the hand-off to the next client (a band in THEIR color that grows to fill
   the screen), a short neutral row of links, and the closing.

   The hero's first screen is tied to the scroll in CSS alone (study.css, --settle):
   the two windows start a touch large and tilted and come level as you scroll, and
   on a wide screen the hero holds still while they do (.s-pin). Behind the title is
   a halftone of the client's own backdrop picture in their two colors, made at
   build time by scripts/halftones.mjs.

   The story is the MDX body. Its chapters run in the page's order and its blocks
   render through the components below, so the study's words live in one place.
   src/scripts/study.js adds the motion. Client colors arrive through --c and --p
   on <body>, and nothing else on the page sets a color of its own.
   ============================================================================ */
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/pages/study.css';
import Closing from '../../components/Closing.astro';
import Decision from '../../components/Decision.astro';
import FeatureHighlight from '../../components/FeatureHighlight.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import ResultsBlock from '../../components/ResultsBlock.astro';
import CourseLine from '../../components/CourseLine.astro';
import SiteShowcase from '../../components/SiteShowcase.astro';
import WhatYouEdit from '../../components/WhatYouEdit.astro';
import Chapter from '../../components/study/Chapter.astro';
import FullBuild from '../../components/study/FullBuild.astro';
import FullList from '../../components/study/FullList.astro';
import Idea from '../../components/study/Idea.astro';
import Lede from '../../components/study/Lede.astro';
import LongPhone from '../../components/study/LongPhone.astro';
import Prose from '../../components/study/Prose.astro';
import ProseLink from '../../components/ProseLink.astro';
import Quotes from '../../components/study/Quotes.astro';
import Sub from '../../components/study/Sub.astro';
import Stars from '../../components/Stars.astro';
import { firstName } from '../../lib/reviews';
import { hostOf, toClient } from '../../lib/clients';
import { inline } from '../../lib/study-markup';
import { LOCK, TOOLS } from '../../lib/window-chrome';
import { SECTOR_PHRASE, SECTOR_PLURAL } from '../../lib/closer';
import { cmsShotProblem, nextInLoop } from '../../lib/study';
import { site } from '../../data/site';
import { studyTitle } from '../../lib/seo';
import { ids, pageIds } from '../../lib/schema';
import { sectorPage, sectorPagePath } from '../../data/sector-pages';
import halftones from '../../data/halftones.json';

export async function getStaticPaths() {
  const all = await getCollection('case-studies');
  const loop = all.map((e) => ({ id: e.id, order: e.data.order, entry: e }));
  return all.map((entry) => {
    const next = nextInLoop(loop, entry.id)?.entry;
    return { params: { slug: entry.id }, props: { entry, next } };
  });
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const problem = cmsShotProblem(d);
if (problem) throw new Error(`${entry.id}: ${problem}`);

const s = toClient(entry);
const nx = next ? toClient(next) : s;
// For "The {client} homepage": a client whose name starts with The keeps just the one.
const clientName = d.client.replace(/^The /, '');
const longest = Math.max(...d.client.split(' ').map((w) => w.length));
const host = d.facts?.host ?? (d.liveUrl ? hostOf(d.liveUrl) : '');
/** This client's public review, when there is one (the opening's review line). */
const review = d.testimonials?.find((t) => t.source);
const builtWith = (d.facts?.stack ?? d.stack)?.join(', ');
const facts: [string, string | undefined][] = [
  ['Sector', d.facts?.sector ?? s.sector],
  ['Role', d.facts?.role ?? d.role],
];
// The halftone behind the title (scripts/halftones.mjs): a mask of dots made from the study's
// backdrop picture. The hash keeps a re-run past the month-long cache on /assets/. A study with
// no backdrop has no entry, and its hero keeps the flat colour.
const dots = (halftones as Record<string, string | undefined>)[entry.id];
const halftone = dots ? `/assets/halftone/${entry.id}.webp?v=${dots}` : '';
// "Photographs by me" goes only on a study that already lists Photography among the services I
// delivered (its frontmatter). It is never guessed from the pictures.
const myPhotos = d.services.some((v) => v.trim().toLowerCase() === 'photography');
// "Building for a church?" on a church study. Small business reads as two words.
const phrase = SECTOR_PHRASE[d.sector] ?? d.sector.replace('-', ' ');

// Published and updated dates are intentionally not displayed: they feed the sort
// order, the RSS feed and the JSON-LD below.
// Schema image only. og:image is the generated /og/work/<slug>.png (BaseLayout default),
// which carries the studio name (scripts/generate-og.mjs).
const ogCover = await getImage({ src: d.cover, width: 1200, format: 'jpg' });
const ogCoverUrl = new URL(ogCover.src, site.url).toString();
const pageTitle = studyTitle(d.title, d.sector, site.studioName);
const pageDescription = d.metaDescription ?? d.summary;
const canonical = new URL(`/work/${entry.id}/`, site.url).toString();

const schemas = [
  {
    '@type': 'CreativeWork',
    '@id': pageIds(canonical).work,
    name: d.title,
    headline: d.title,
    description: pageDescription,
    image: ogCoverUrl,
    url: canonical,
    mainEntityOfPage: { '@id': pageIds(canonical).webpage },
    datePublished: d.published.toISOString(),
    ...(d.updated ? { dateModified: d.updated.toISOString() } : {}),
    creator: { '@id': ids.studio },
    author: { '@id': ids.person },
    publisher: { '@id': ids.studio },
    about: { '@type': 'Organization', name: d.client, ...(d.liveUrl ? { url: d.liveUrl } : {}) },
    keywords: d.services.join(', '),
  },
];

const breadcrumbs = [
  { name: 'Work', path: '/work/' },
  {
    name: SECTOR_PLURAL[d.sector] ?? d.sector,
    path: sectorPagePath(d.sector) ?? `/work/?sector=${d.sector}`,
  },
  { name: d.client, path: `/work/${entry.id}/` },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImageAlt={`${clientName}, a case study by ${site.studioName}`}
  ogType="article"
  schemas={schemas}
  breadcrumbs={breadcrumbs}
  onColor
  bodyStyle={`--c:${s.accent};--c-night:${s.night};--p:${s.paper};--oncolor:${s.paper};--long:${longest}`}
>
  {/* .s-pin is only a holder: on a wide screen, where scroll-driven animation exists, it is a
      little taller than the hero so the hero can hold still while the windows settle. */}
  <div class="s-pin">
    <section class="s-hero" aria-labelledby="sh">
      {halftone && (
        <div
          class="s-bg"
          aria-hidden="true"
          style={`--ht:url(${halftone})${d.backdrop?.position ? `;--ht-at:${d.backdrop.position}` : ''}`}
        />
      )}
      <div class="s-hero-t">
        <h1 id="sh">{d.client}</h1>
        {d.outcome && <p class="s-out" set:html={inline(d.outcome)} />}
        {/* A public review from this client: their face, the stars, a jump to the full review
            further down (study/Quotes.astro). Only shown when the frontmatter has one. */}
        {review && (
          <a class="s-rv" href="#in-their-words">
            {review.photo && (
              <img src={`${review.photo}-96.webp`} width="32" height="32" alt="" decoding="async" />
            )}
            <Stars rating={review.source!.rating} />
            <span>
              {firstName(review.name)}'s Google review
              <span aria-hidden="true"> ↓</span>
            </span>
          </a>
        )}
        <dl class="s-facts">
          {facts.map(
            ([k, v]) =>
              v && (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ),
          )}
          {d.liveUrl && (
            <div>
              <dt>Live</dt>
              <dd>
                <a
                  href={d.liveUrl}
                  target="_blank"
                  rel="noopener"
                  data-cta="visit_client_site"
                  data-cta-location="title"
                >
                  {host}
                  <span class="sr"> (opens in a new tab)</span>
                </a>
              </dd>
            </div>
          )}
        </dl>
      </div>
      <div class="s-stage">
        <div
          class="s-fan"
          role="img"
          aria-label={`The ${clientName} homepage on a laptop and a phone`}
        >
          <figure class="pane p-home" style="--d:0" data-pane>
            <div>
              <img src={s.deskStill} alt="" fetchpriority="high" />
              <video muted loop playsinline preload="none" data-src={s.desk}></video>
            </div>
          </figure>
          <figure class="pane p-phone" style="--d:1">
            <div class="tile inv" style={`--c:${s.paper};--p:${s.accent}`}>
              <span class="b-top" aria-hidden="true">
                <span class="url">
                  <span data-lock set:html={LOCK} />
                  <span>{host}</span>
                </span>
              </span>
              <span class="scr" aria-hidden="true">
                <img
                  src={s.still}
                  srcset={s.stillSet}
                  sizes="(max-width: 480px) 60vw, 346px"
                  alt=""
                />
                <video muted loop playsinline preload="none" data-src={s.clip}></video>
              </span>
              <span class="b-bot" aria-hidden="true" data-tools set:html={TOOLS} />
            </div>
          </figure>
        </div>
      </div>
    </section>
  </div>
  {/* Before the first paint: is a window from the last page growing into the desktop pane
      (src/scripts/hero-morph.js)? Then the pane shows at once, so the morph lands on it. If not,
      the pane gives up its view-transition name, so nothing fades in where the fan will land. */}
  <script is:inline>
    (function () {
      var path = null;
      try {
        path = sessionStorage.getItem('ncs-hero');
        sessionStorage.removeItem('ncs-hero');
      } catch (_e) {
        /* No storage, no morph: the fan runs as usual. */
      }
      if (path === location.pathname) document.documentElement.classList.add('hero-morph');
      else {
        var p = document.querySelector('.s-fan .p-home');
        if (p) p.style.viewTransitionName = 'none';
      }
    })();
  </script>

  <div class="story" data-story>
    <div class="chaps">
      <Content
        study={{ ...d, slug: entry.id }}
        components={{
          p: Prose,
          a: ProseLink,
          ul: FullList,
          h3: Sub,
          Chapter,
          Lede,
          Idea,
          Decision,
          FeatureHighlight,
          BeforeAfter,
          ResultsBlock,
          CourseLine,
          SiteShowcase,
          WhatYouEdit,
          Quotes,
          FullBuild,
        }}
      />
      {myPhotos && (
        <p class="s-photos">
          Photographs by me.{' '}
          <a href="/photography/">
            See more<span class="sr"> of my photography</span>
          </a>
        </p>
      )}
      {/* Tool names live only here, behind a plain lead, never in the client's path above. */}
      {builtWith && (
        <p class="s-built">For the technically curious, it is built with {builtWith}.</p>
      )}
    </div>
    <aside class="rail" aria-hidden="true">
      <div class="rail-in">
        <LongPhone slug={entry.id} host={host} variant="rp" />
        <p class="rail-cap">The real homepage, on a phone</p>
      </div>
    </aside>
  </div>

  {/* The hand-off. A full-width band in the NEXT client's color, with their window, their name and
      their one-line outcome. The name is the link and it is stretched over the whole band, so a
      click anywhere (or Enter on it) opens their study, and their window grows into its hero by the
      same `study-hero` morph as every other window (src/scripts/hero-morph.js finds the window on
      screen). Scrolling only grows the band (study.css); it never changes the page for you. */}
  <section
    class="next"
    aria-labelledby="nh"
    data-cursor="Open"
    style={`--c:${nx.accent};--p:${nx.paper}`}
  >
    <div class="next-band">
      <div class="next-t">
        <p class="next-l">Up next</p>
        <h2 id="nh" data-rise="off">
          <a href={nx.study}>{nx.name}</a>
        </h2>
        <p class="next-k">{nx.outcome || nx.hook}</p>
      </div>
      <div class="next-w">
        <a
          class="tile desk next-tile"
          href={nx.study}
          data-slug={nx.slug}
          data-direct
          data-sheen
          aria-label={`${nx.name}, ${nx.host}: ${nx.hook}`}
        >
          <span class="b-top" aria-hidden="true">
            <span class="url">
              <Fragment set:html={LOCK} />
              <span>{nx.host}</span>
            </span>
          </span>
          <span class="scr" aria-hidden="true">
            <img
              src={nx.deskStill}
              alt=""
              loading="lazy"
              decoding="async"
              width="1000"
              height="750"
            />
            <video muted loop playsinline preload="none" data-src={nx.desk}></video>
          </span>
        </a>
      </div>
    </div>
  </section>
  {/* A neutral row between the band and the closing: a color band never touches the closing. */}
  <nav class="next-more" aria-label="More of the work">
    <a class="tlink" href="/work/">
      See all the work
    </a>
    {sectorPagePath(d.sector) && (
      <a class="tlink" href={sectorPagePath(d.sector)}>
        {sectorPage(d.sector)?.linkText}
      </a>
    )}
  </nav>
  <Closing lead={`Building for a <b>${phrase}?</b>`} />
</BaseLayout>

<script>
  import '../../scripts/study.js';
</script>
