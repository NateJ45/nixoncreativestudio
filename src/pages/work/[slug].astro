---
// Foundation, edit with care. This page renders every case study from the
// content collection; layout changes here apply to every entry.
/* ============================================================================
   /work/[slug] | Case Study Detail Page (the case-study frame, overhaul 2.4a)
   ============================================================================
   One static page per case study, generated at build time from the
   case-studies content collection. Adding a new MDX file in
   src/content/case-studies/ creates its page on the next build.

   Top to bottom:
     1. Title card: a band in the client's own paper with a 4px rule in their
        accent (dark mode: this site's ink with only the client's mark and
        swatches, ruling 8). Breadcrumb (Work / Sector / Client), the client
        name as the H1 (the page's one Heft), the hook, the "Visit" button.
     2. Stage: the live site on a laptop and a phone (FramePair), bleeding
        wide. It is the LCP: eager, high priority, never data-reveal (ruling
        3). transition:name="cover-{id}" ties it to the /work and homepage
        cards for the View Transition.
     3. Specimen: the client's swatches with hex values, and "Set in {face}".
     3b. The idea (Signature, 2.4b), only where the study has a featureShot.
     4. Rail (StudyRail): the facts and the chapter list with its gliding
        marker, beside the body: summary, MDX prose, What changed, the
        client's own words (Testimonial), the designer's note.
     5. Up next: the next study by `order`, looping, in that client's palette.
     6. The footer's ink closer, sector-matched ("Building for a church?").
   Plus a CSS-only scroll progress bar (ScrollProgress) and print styles.

   The client palette arrives as scoped --cs-* custom properties on the
   <article> (paletteStyle() in src/lib/study.ts). Each one is read with a
   site-token fallback, so a study without a palette still renders.
   src/lib/case-palettes.test.ts checks every pair this page uses.
   ============================================================================ */

import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DEFAULT_CLOSER, SECTOR_PHRASE, SECTOR_PLURAL, type Closer } from '../../lib/closer';
import CaseStudyCover from '../../components/CaseStudyCover.astro';
import FramePair from '../../components/FramePair.astro';
import Heft from '../../components/Heft.astro';
import Specimen from '../../components/Specimen.astro';
import StudyRail from '../../components/StudyRail.astro';
import UpNext from '../../components/UpNext.astro';
import ScrollProgress from '../../components/ScrollProgress.astro';
import Signature from '../../components/Signature.astro';
import ResultsBlock from '../../components/ResultsBlock.astro';
import DesignerNote from '../../components/DesignerNote.astro';
import Testimonial from '../../components/Testimonial.astro';
import { buttonVariants } from '../../components/ui/button';
import { cn } from '../../lib/utils';
import { getCoverPlaceholder } from '../../lib/coverPlaceholder';
import { hostOf, nextInLoop, paletteStyle, studyFacts } from '../../lib/study';
import { site } from '../../data/site';
import { studyTitle } from '../../lib/seo';
import { ids, pageIds } from '../../lib/schema';

// Each route gets its own entry plus the one study the Up next panel hands
// off to (by `order`, wrapping from the last back to the first), trimmed to
// the fields the panel draws, so a page never carries the whole catalogue.
export async function getStaticPaths() {
  const all = await getCollection('case-studies');
  const loop = all.map((e) => ({ id: e.id, order: e.data.order }));
  return all.map((entry) => {
    const n = nextInLoop(loop, entry.id);
    const next = n ? all.find((e) => e.id === n.id) : undefined;
    return {
      params: { slug: entry.id },
      props: {
        entry,
        next: next
          ? {
              id: next.id,
              client: next.data.client,
              hook: next.data.hook,
              liveUrl: next.data.liveUrl,
              palette: next.data.palette,
            }
          : undefined,
      },
    };
  });
}

const { entry, next } = Astro.props;
const { Content, headings } = await render(entry);

const {
  title,
  client,
  sector,
  services,
  summary,
  metaDescription,
  cover,
  published,
  updated,
  liveUrl,
  outcome,
  testimonials,
  results,
  designerNote,
  hook,
  palette,
  mobileShot,
  featureShot,
  featureShotAlt,
} = entry.data;

// The full-page homepage captures (src/assets/case-studies/shots/
// {slug}-home.png, written by `npm run capture:study`). They are not a
// frontmatter field, so they are found by name. The stage uses this study's;
// the Up next panel uses the next study's.
const homeShots = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/case-studies/shots/*-home.png',
  { eager: true },
);
const homeShot = (slug: string): ImageMetadata | undefined =>
  Object.entries(homeShots).find(([path]) => path.endsWith(`/${slug}-home.png`))?.[1].default;
const desktopShot = homeShot(entry.id);

// Chapters for the rail: the body's H2s (Astro gives each one an id).
const chapters = (headings ?? [])
  .filter((h) => h.depth === 2)
  .map((h) => ({ slug: h.slug, text: h.text }));
const facts = studyFacts(entry.data);
const host = liveUrl ? hostOf(liveUrl) : undefined;
const sectorPlural = SECTOR_PLURAL[sector] ?? sector;

// The footer's ink closer, written for this study's sector: "Building for a
// church?" on a church study. The pill deep-links to the contact form with
// the study and the matching Organization type (/contact/?from=<slug>&
// org_type=<sector>), so the visitor lands with "Church" already chosen. A
// sector with no phrase falls back to the site default.
const phrase = SECTOR_PHRASE[sector];
const closer: Closer = phrase
  ? {
      heading: 'Building for a',
      emphasis: `${phrase}?`,
      sub: DEFAULT_CLOSER.sub,
      href: `/contact/?from=${entry.id}&org_type=${sector}`,
    }
  : DEFAULT_CLOSER;

// Note: published / updated dates are intentionally NOT displayed in the UI
// (the client doesn't want project timing showcased). They stay in the
// frontmatter and feed sort order, the RSS feed, and the JSON-LD below.

// Resolve the cover through Astro's image pipeline for the OG image and the
// CreativeWork schema. Social platforms cap previews at 1200px anyway.
const ogCover = await getImage({ src: cover, width: 1200, format: 'jpg' });
const ogCoverUrl = new URL(ogCover.src, site.url).toString();
const coverBlur = getCoverPlaceholder(entry.id);

// Page title and search description. The title is built from the study name
// and sector to fit about 60 characters (src/lib/seo.ts); the description is
// the study's own metaDescription, written for search results, or its summary.
const pageTitle = studyTitle(title, sector, site.studioName);
const pageDescription = metaDescription ?? summary;
const canonical = new URL(`/work/${entry.id}/`, site.url).toString();

// CreativeWork JSON-LD for this case study, one node in the page's @graph
// (see StructuredData.astro). It names the studio as creator and Nathan as
// author by @id, and points at the live site when there is one.
const schemas = [
  {
    '@type': 'CreativeWork',
    '@id': pageIds(canonical).work,
    name: title,
    headline: title,
    description: pageDescription,
    image: ogCoverUrl,
    url: canonical,
    mainEntityOfPage: { '@id': pageIds(canonical).webpage },
    datePublished: published.toISOString(),
    ...(updated ? { dateModified: updated.toISOString() } : {}),
    creator: { '@id': ids.studio },
    author: { '@id': ids.person },
    publisher: { '@id': ids.studio },
    about: { '@type': 'Organization', name: client, ...(liveUrl ? { url: liveUrl } : {}) },
    keywords: services.join(', '),
  },
];

// One trail, two renderings: the visible breadcrumb in the title card and the
// BreadcrumbList JSON-LD (BaseLayout prefixes Home). The sector crumb is the
// /work index filtered to this sector (/work/?sector=church).
const sectorPath = `/work/?sector=${sector}`;
const breadcrumbs = [
  { name: 'Work', path: '/work/' },
  { name: sectorPlural, path: sectorPath },
  { name: client, path: `/work/${entry.id}/` },
];

const nextShot = next ? homeShot(next.id) : undefined;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogCover.src}
  ogType="article"
  schemas={schemas}
  breadcrumbs={breadcrumbs}
  closer={closer}
>
  <article class="study" style={paletteStyle(palette)}>
    {/* 1 to 3. The title card: one band holding the title, the stage and the
        specimen, so the client's palette reads as one block. */}
    <header class="cs-title">
      <div class="ncs-container">
        <nav aria-label="Breadcrumb" class="cs-crumbs">
          <ol>
            <li>
              <a href="/work/">Work</a>
            </li>
            <li>
              <a href={sectorPath}>{sectorPlural}</a>
            </li>
            <li aria-current="page">{client}</li>
          </ol>
        </nav>

        {/* The client name, once, as the H1. All of it is the heavy phrase,
            so it fills to 800 (the page's one Heft, ruling 9). Never
            data-reveal. Long names wrap anywhere (ruling 16). */}
        <h1 class="cs-h1 text-h1-long">
          <Heft text={client} />
        </h1>

        <p class="cs-hook">{hook ?? summary}</p>

        {liveUrl && host && (
          <p class="cs-visit">
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class={cn(buttonVariants({ variant: 'brand', size: 'cta' }), 'rounded-full')}
            >
              Visit {host} <span aria-hidden="true">↗</span>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
            <span class="cs-visit-url">{liveUrl}</span>
          </p>
        )}

        {/* The stage. alt describes the pair once; the phone frame's image is
            alt="" inside FramePair. Eager and high priority: it is the LCP. */}
        <div class="cs-stage" transition:name={`cover-${entry.id}`}>
          {desktopShot && mobileShot && liveUrl ? (
            <FramePair
              url={liveUrl}
              desktop={desktopShot}
              phone={mobileShot}
              alt={`The ${client} homepage on a laptop and a phone`}
              lcp
            />
          ) : (
            <CaseStudyCover
              cover={cover}
              placeholder={coverBlur}
              alt=""
              widths={[640, 960, 1440]}
              sizes="(min-width: 82.5rem) 78rem, calc(100vw - 3rem)"
              lcp
            />
          )}
        </div>

        {palette && (
          <div class="cs-specimen">
            <Specimen swatches={palette.swatches} typeface={palette.typeface} />
          </div>
        )}
      </div>
    </header>

    {/* 3b. "The idea" (Signature, package 2.4b): the hook beside one real
        still. Only when the study has a featureShot, because the title card
        already shows the hook and a band of the hook alone would repeat it.
        Lazy: never in the first viewport. */}
    {featureShot && hook && (
      <Signature
        hook={hook}
        src={featureShot}
        alt={featureShotAlt ?? `A feature on the live ${client} site`}
        url={liveUrl}
      />
    )}

    {/* 4. The rail beside the body. */}
    <div class="ncs-container page-grid cs-body">
      <StudyRail facts={facts} chapters={chapters} />

      <div class="grid-body">
        <p class="cs-lede">{summary}</p>
        {outcome && <p class="cs-outcome">{outcome}</p>}

        {/* MDX prose. Text blocks sit at one rem measure (40rem) so their edges
            line up; media (FeatureHighlight, SiteShowcase) spans the column.
            The descendant selectors style the MDX output without leaking
            site-wide; scroll-mt clears the sticky header on a chapter jump. */}
        <div
          data-prose
          class:list={[
            'text-[1.0625rem] leading-[1.7] text-text',
            '[&_h2]:mt-l [&_h2]:mb-s [&_h2]:scroll-mt-[6.5rem] [&_h2]:text-h3 [&_h2]:text-heading [&_h2:first-child]:mt-0',
            '[&_h3]:mt-l [&_h3]:mb-s [&_h3]:max-w-[40rem] [&_h3]:font-display [&_h3]:text-h4 [&_h3]:text-heading',
            '[&_li]:mb-1 [&_p]:mb-m [&_ul]:mb-m [&_ul]:list-disc [&_ul]:pl-5',
            '[&_ol]:mb-m [&_ol]:max-w-[40rem] [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:text-text',
            '[&_a]:text-link [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:underline-offset-4',
            '[&_strong]:font-semibold [&_strong]:text-heading',
            '[&_code]:font-mono [&_code]:text-[0.9em]',
            '[&_blockquote]:max-w-[40rem] [&_blockquote]:text-text-muted [&_blockquote]:italic',
            '[&_h2]:max-w-[40rem] [&_p]:max-w-[40rem] [&_ul]:max-w-[40rem]',
          ]}
        >
          <Content />
        </div>

        {/* "What changed" (the ruled ledger) and the signed designer's note. Each
            draws its own top rule and measure (package 2.4b). */}
        {/* Then, in order: a frontmatter "What changed" list (most studies
            close their MDX on a ResultsBlock instead), the client's own words
            (Testimonial, right after the ledger, real and verbatim from the
            `testimonials` frontmatter, nothing when there are none) and the
            signed designer's note. Each draws its own top rule and measure. */}
        {(results?.length || testimonials?.length || designerNote) && (
          <div class="mt-2xl flex flex-col gap-2xl">
            {results && results.length > 0 && <ResultsBlock changes={results} />}
            {testimonials && testimonials.length > 0 && <Testimonial testimonials={testimonials} />}
            {designerNote && <DesignerNote note={designerNote} />}
          </div>
        )}
      </div>
    </div>

    {/* 5. Up next, in the next client's palette. */}
    {next && (
      <UpNext
        slug={next.id}
        client={next.client}
        hook={next.hook}
        url={next.liveUrl}
        shot={nextShot}
        style={paletteStyle(next.palette)}
      />
    )}
  </article>

  {/* CSS-only reading bar. AFTER the article on purpose: position: fixed, so
      its DOM place does not show, and the article stays <main>'s first child
      for the first-screen reveal exemption (Gotcha 10). */}
  <ScrollProgress />
</BaseLayout>

<style>
  /* ---- Title card --------------------------------------------------------
     Light: the client's paper, their accent as a 4px top rule. Client colours
     never carry text: the text is this site's own foreground and heading,
     checked on every client paper in case-palettes.test.ts. Dark (ruling 8):
     this site's ink with only the client's dark mark as the rule, so no
     client dark palette is invented. */
  .cs-title {
    background-color: var(--cs-paper, var(--paper));
    color: var(--foreground);
    border-top: 4px solid var(--cs-accent, var(--accent));
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  :global(.dark) .cs-title {
    background-color: var(--ink);
    color: var(--foreground);
    border-top-color: var(--cs-mark-dark, var(--accent));
  }

  .cs-crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cs-crumbs li {
    display: inline-flex;
    gap: 0.5rem;
  }

  /* The separator is drawn, so screen readers hear only the crumbs. */
  .cs-crumbs li + li::before {
    content: '/';
    opacity: 0.6;
  }

  .cs-crumbs a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }

  .cs-crumbs a:hover,
  .cs-crumbs a:focus-visible {
    text-decoration-thickness: 2px;
  }

  @media (pointer: coarse) {
    .cs-crumbs a {
      display: inline-block;
      padding-block: 0.75rem;
    }
  }

  .cs-h1 {
    margin: 1.5rem 0 0;
    color: var(--heading);
  }

  .cs-hook {
    margin: 1rem 0 0;
    max-width: 36ch;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 300;
    line-height: 1.3;
  }

  .cs-visit {
    margin: 1.75rem 0 0;
  }

  /* On paper the button prints as its address (print block below). */
  .cs-visit-url {
    display: none;
  }

  /* ---- Stage: bleeds to the container's full width. Never data-reveal. */
  .cs-stage {
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  /* ---- Specimen under the stage, on a hairline in the band's ink. */
  .cs-specimen {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, currentColor 25%, transparent);
  }

  /* ---- Rail and body ---------------------------------------------------- */
  .cs-body {
    padding-block: var(--space-section);
  }

  .cs-lede {
    margin: 0 0 1rem;
    max-width: 40rem;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--heading);
  }

  .cs-outcome {
    margin: 0 0 2.5rem;
    max-width: 40rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.4;
    color: var(--heading);
  }

  @media (forced-colors: active) {
    .cs-title {
      border-top: 4px solid CanvasText;
    }
  }

  /* ---- Print (boards get these forwarded) --------------------------------
     Ink bands drop out (the footer and its closer), the Up next panel and the
     chapter list go, and hosts print as full URLs: the Visit button becomes
     its address, the rail's host fact prints its URL (StudyRail) and the
     browser frames print theirs (BrowserFrame). Scoped to this page. */
  @media print {
    :global(.band-ink) {
      display: none !important;
    }
    .cs-title {
      border-top: 0;
      padding-block: 0 1rem;
    }
    .cs-visit a {
      display: none;
    }
    .cs-visit-url {
      display: inline;
      font-family: var(--font-mono);
    }
    .cs-body {
      padding-block: 1rem;
    }
  }
</style>
