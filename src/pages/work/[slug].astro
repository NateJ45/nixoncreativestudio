---
/* ============================================================================
   /work/{slug} | A case study
   ============================================================================
   The hero on the client's color with the laptop and phone thrown onto the page,
   then the story beside a phone that scrolls through the real site as you read,
   then Up next and the closing.

   The story is the MDX body. Its chapters run in the page's order and its blocks
   render through the components below, so the study's words live in one place.
   src/scripts/study.js adds the motion. Client colors arrive through --c and --p
   on <body>, and nothing else on the page sets a color of its own.
   ============================================================================ */
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/pages/study.css';
import Closing from '../../components/Closing.astro';
import Decision from '../../components/Decision.astro';
import FeatureHighlight from '../../components/FeatureHighlight.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import ResultsBlock from '../../components/ResultsBlock.astro';
import CourseLine from '../../components/CourseLine.astro';
import SiteShowcase from '../../components/SiteShowcase.astro';
import WhatYouEdit from '../../components/WhatYouEdit.astro';
import Chapter from '../../components/study/Chapter.astro';
import FullBuild from '../../components/study/FullBuild.astro';
import FullList from '../../components/study/FullList.astro';
import Idea from '../../components/study/Idea.astro';
import Lede from '../../components/study/Lede.astro';
import LongPhone from '../../components/study/LongPhone.astro';
import Prose from '../../components/study/Prose.astro';
import Quotes from '../../components/study/Quotes.astro';
import Sub from '../../components/study/Sub.astro';
import { hostOf, toClient } from '../../lib/clients';
import { inline } from '../../lib/study-markup';
import { LOCK, TOOLS } from '../../lib/window-chrome';
import { SECTOR_PHRASE, SECTOR_PLURAL } from '../../lib/closer';
import { cmsShotProblem, nextInLoop } from '../../lib/study';
import { site } from '../../data/site';
import { studyTitle } from '../../lib/seo';
import { ids, pageIds } from '../../lib/schema';
import { sectorPagePath } from '../../data/sector-pages';

export async function getStaticPaths() {
  const all = await getCollection('case-studies');
  const loop = all.map((e) => ({ id: e.id, order: e.data.order, entry: e }));
  return all.map((entry) => {
    const next = nextInLoop(loop, entry.id)?.entry;
    return { params: { slug: entry.id }, props: { entry, next } };
  });
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const problem = cmsShotProblem(d);
if (problem) throw new Error(`${entry.id}: ${problem}`);

const s = toClient(entry);
const nx = next ? toClient(next) : s;
// For "The {client} homepage": a client whose name starts with The keeps just the one.
const clientName = d.client.replace(/^The /, '');
const longest = Math.max(...d.client.split(' ').map((w) => w.length));
const host = d.facts?.host ?? (d.liveUrl ? hostOf(d.liveUrl) : '');
const builtWith = (d.facts?.stack ?? d.stack)?.join(', ');
const facts: [string, string | undefined][] = [
  ['Sector', d.facts?.sector ?? s.sector],
  ['Role', d.facts?.role ?? d.role],
];
// "Building for a church?" on a church study. Small business reads as two words.
const phrase = SECTOR_PHRASE[d.sector] ?? d.sector.replace('-', ' ');

// Published and updated dates are intentionally not displayed: they feed the sort
// order, the RSS feed and the JSON-LD below.
const ogCover = await getImage({ src: d.cover, width: 1200, format: 'jpg' });
const ogCoverUrl = new URL(ogCover.src, site.url).toString();
const pageTitle = studyTitle(d.title, d.sector, site.studioName);
const pageDescription = d.metaDescription ?? d.summary;
const canonical = new URL(`/work/${entry.id}/`, site.url).toString();

const schemas = [
  {
    '@type': 'CreativeWork',
    '@id': pageIds(canonical).work,
    name: d.title,
    headline: d.title,
    description: pageDescription,
    image: ogCoverUrl,
    url: canonical,
    mainEntityOfPage: { '@id': pageIds(canonical).webpage },
    datePublished: d.published.toISOString(),
    ...(d.updated ? { dateModified: d.updated.toISOString() } : {}),
    creator: { '@id': ids.studio },
    author: { '@id': ids.person },
    publisher: { '@id': ids.studio },
    about: { '@type': 'Organization', name: d.client, ...(d.liveUrl ? { url: d.liveUrl } : {}) },
    keywords: d.services.join(', '),
  },
];

const breadcrumbs = [
  { name: 'Work', path: '/work/' },
  {
    name: SECTOR_PLURAL[d.sector] ?? d.sector,
    path: sectorPagePath(d.sector) ?? `/work/?sector=${d.sector}`,
  },
  { name: d.client, path: `/work/${entry.id}/` },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogCover.src}
  ogImageWidth={Number(ogCover.attributes.width)}
  ogImageHeight={Number(ogCover.attributes.height)}
  ogImageAlt={`The ${clientName} website`}
  ogType="article"
  schemas={schemas}
  breadcrumbs={breadcrumbs}
  onColor
  bodyStyle={`--c:${s.accent};--p:${s.paper};--oncolor:${s.paper};--long:${longest}`}
>
  <section class="s-hero" aria-labelledby="sh">
    <div class="s-hero-t">
      <h1 id="sh">{d.client}</h1>
      {d.outcome && <p class="s-out" set:html={inline(d.outcome)} />}
      <dl class="s-facts">
        {facts.map(
          ([k, v]) =>
            v && (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ),
        )}
        {d.liveUrl && (
          <div>
            <dt>Live</dt>
            <dd>
              <a
                href={d.liveUrl}
                target="_blank"
                rel="noopener"
                data-cta="visit_client_site"
                data-cta-location="title"
              >
                {host}
                <span class="sr"> (opens in a new tab)</span>
              </a>
            </dd>
          </div>
        )}
      </dl>
    </div>
    <div class="s-fan" role="img" aria-label={`The ${clientName} homepage on a laptop and a phone`}>
      <figure class="pane p-home" style="--d:0" data-pane>
        <div>
          <img src={s.deskStill} alt="" fetchpriority="high" />
          <video muted loop playsinline preload="none" data-src={s.desk}></video>
        </div>
      </figure>
      <figure class="pane p-phone" style="--d:1">
        <div class="tile inv" style={`--c:${s.paper};--p:${s.accent}`}>
          <span class="b-top" aria-hidden="true">
            <span class="url">
              <span data-lock set:html={LOCK} />
              <span>{host}</span>
            </span>
          </span>
          <span class="scr" aria-hidden="true">
            <img src={s.still} alt="" />
            <video muted loop playsinline preload="none" data-src={s.clip}></video>
          </span>
          <span class="b-bot" aria-hidden="true" data-tools set:html={TOOLS} />
        </div>
      </figure>
    </div>
  </section>

  <div class="story" data-story>
    <div class="chaps">
      <Content
        study={{ ...d, slug: entry.id }}
        components={{
          p: Prose,
          ul: FullList,
          h3: Sub,
          Chapter,
          Lede,
          Idea,
          Decision,
          FeatureHighlight,
          BeforeAfter,
          ResultsBlock,
          CourseLine,
          SiteShowcase,
          WhatYouEdit,
          Quotes,
          FullBuild,
        }}
      />
      {builtWith && <p class="s-built">Built with {builtWith}</p>}
    </div>
    <aside class="rail" aria-hidden="true">
      <div class="rail-in">
        <LongPhone slug={entry.id} host={host} variant="rp" />
        <p class="rail-cap">The real homepage, on a phone</p>
      </div>
    </aside>
  </div>

  <section class="next" aria-labelledby="nh">
    <div class="next-t">
      <p class="next-l">Up next</p>
      <h2 id="nh">
        <a href={nx.study}>{nx.name}</a>
      </h2>
      <p class="next-k">{nx.hook}</p>
      <p>
        <a class="tlink" href="/work/">
          See all the work
        </a>
      </p>
      {sectorPagePath(d.sector) && (
        <p>
          <a class="tlink" href={sectorPagePath(d.sector)}>
            How I build for churches
          </a>
        </p>
      )}
    </div>
    <div class="next-w">
      <a
        class="tile next-tile"
        href={nx.study}
        data-slug={nx.slug}
        data-direct
        aria-label={`${nx.name}, ${nx.host}: ${nx.hook}`}
        style={`--c:${nx.accent};--p:${nx.paper}`}
      >
        <span class="b-top" aria-hidden="true">
          <span class="url">
            <span data-lock set:html={LOCK} />
            <span>{nx.host}</span>
          </span>
        </span>
        <span class="scr" aria-hidden="true">
          <img src={nx.still} alt="" loading="lazy" />
          <video muted loop playsinline preload="none" data-src={nx.clip}></video>
        </span>
        <span class="b-bot" aria-hidden="true" data-tools set:html={TOOLS} />
      </a>
    </div>
  </section>
  <Closing lead={`Building for a <b>${phrase}?</b>`} />
</BaseLayout>

<script>
  import '../../scripts/study.js';
</script>
