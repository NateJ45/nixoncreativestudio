---
// Safe to edit (the 2026 redesign rebuilt it). This page renders every case study
// from the EmDash CMS; layout changes here apply to every entry.
/* ============================================================================
   /work/[slug] | Case study
   ============================================================================
   One server-rendered page per case study, read per request from the EmDash
   `case_studies` collection (D1). There is no getStaticPaths: an unknown slug
   renders the site's 404 page with a real 404 status. The route cache is tagged
   with the rows this page read (src/lib/routeCache.ts), so a published edit
   purges it.

   Written for a church board member, not a developer (2026 redesign, A items 7
   and 11, B 2.2): outcome first, then the decision, then the proof. Bands:

     1. Hero (window-light, the page's one moving ground): sector and status,
        the title ONCE (the client name only appears again when it differs),
        the outcome as the standfirst, the visit link, then the site
        printed large: a directed showreel for the studies that have one
        (src/data/workExtras.ts SHOWREELS; the poster is the LCP), otherwise
        the cover in a browser frame. Under it, a short facts ledger in plain
        labels and the stack in one quiet line.
     2. What changed (paper): the `results` lines, then a mid-page call to
        action that preselects the sector on the contact form.
     3. The story (paper-deep): the body (the brief, the decision, what was
        built), headings in the margin.
     4. The details (deep, still): 2 to 4 detail crops at a legible size from
        `highlights` (click to zoom), then the before/after slider.
     5. A note from the designer, a testimonial if one exists, more work.
     6. The closing call to action (CtaBanner, contours) and the footer.

   Honesty (launchStatus.ts): a study that is not live shows its status label
   next to the sector, in the frame's chrome and in the ledger, and never a
   "visit the live site" link. Launching soon links its preview build, labelled
   as such. The body is drawn by renderJournalBody() (a pure renderer), never by
   emdash/ui's PortableText, whose stylesheet would block rendering.
   ============================================================================ */

import { Image as EmDashImage } from 'emdash/ui';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Band from '../../components/Band.astro';
import Frame from '../../components/Frame.astro';
import Showreel from '../../components/Showreel.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Lightbox from '../../components/Lightbox.astro';
import DesignerNote from '../../components/DesignerNote.astro';
import { buttonVariants } from '../../components/ui/button';
import { getCaseStudies } from '../../lib/caseStudies';
import { launchStatusLabel } from '../../lib/launchStatus';
import { renderJournalBody } from '../../lib/journalBody';
import { prettyDomain, sectorLabel, sectorLine } from '../../lib/workIndex';
import { getSite, SITE_URL } from '../../data/site';
import { BODY_HELD_BACK, BUNDLED_MEDIA, LEDGER_FACTS, SHOWREELS } from '../../data/workExtras';

// The static pages 301 /about to /about/ (Cloudflare's asset handler). This server
// route does the same, so /work/reid-design is not a second live copy of the page.
if (!Astro.url.pathname.endsWith('/')) {
  return Astro.redirect(`${Astro.url.pathname}/${Astro.url.search}`, 301);
}

const slug = Astro.params.slug ?? '';
// One list read gives us the entry, its neighbours and the sector count.
const all = await getCaseStudies(Astro.cache);
const index = all.findIndex((e) => e.id === slug);

if (index === -1) {
  // Unknown slug: an empty-body 404 response. Astro sees the 404 status with no
  // body and renders the site's own 404 page in its place, keeping the real 404
  // status. Never cached: a slug published later must not hit a stored 404.
  Astro.cache.set(false);
  return new Response(null, { status: 404 });
}

const site = await getSite(Astro);
const cs = all[index];
const {
  title,
  client,
  sector,
  summary,
  role,
  stack,
  year,
  outcome,
  testimonial,
  results,
  designerNote,
} = cs;

// Newest first: the next index is the OLDER project, the previous index the newer one.
const neighbours = [all[index - 1], all[index + 1]].filter(Boolean).map((e) => ({
  id: e.id,
  title: e.title,
  status: launchStatusLabel(e.launchStatus),
  sector: sectorLabel(e.sector),
}));

// ---- status and links --------------------------------------------------------
const status = launchStatusLabel(cs.launchStatus);
const isLive = cs.launchStatus === 'live';
// gateLinks() already dropped liveUrl for anything not live, except a launching-soon
// study's preview build, which is labelled as a preview here and never as live.
const visitUrl = cs.liveUrl;
const visitHost = visitUrl ? prettyDomain(visitUrl) : undefined;

// ---- the hero picture ----------------------------------------------------------
const reel = isLive ? SHOWREELS[cs.id] : undefined;
const bundled = BUNDLED_MEDIA[cs.id];
const heroAlt =
  bundled?.cover?.alt ?? `The ${client} home page${isLive ? '' : `, ${status?.toLowerCase()}`}`;

// ---- the facts ledger (plain labels; rows only when there is a real value) -----
const facts = LEDGER_FACTS[cs.id] ?? {};
const sameName = (a: string, b: string) =>
  a.toLowerCase().replace(/^the\s+/, '') === b.toLowerCase().replace(/^the\s+/, '');
const ledger = [
  // The title IS the client name for most entries; print it once (A item 7).
  !sameName(client, title) && { label: 'Client', value: client },
  facts.place && { label: 'Place', value: facts.place },
  year && { label: 'Year', value: String(year) },
  role && { label: 'My role', value: role },
  // Only for a site the client actually runs: never claim a handover that has not happened.
  (isLive || cs.launchStatus === 'launching-soon') &&
    facts.runsThemselves && { label: 'What they run themselves', value: facts.runsThemselves },
].filter(Boolean) as { label: string; value: string }[];

// ---- the details (2 to 4 legible crops) ---------------------------------------
// The CMS highlights, unless the study has bundled replacements for stale CMS images.
type Detail =
  | {
      kind: 'cms';
      image: (typeof cs.highlights)[number]['image'];
      alt: string;
      title: string;
      caption: string;
    }
  | { kind: 'bundled'; image: ImageMetadata; alt: string; title?: string; caption?: string };
const details: Detail[] = (
  bundled?.details
    ? bundled.details.map((d) => ({
        kind: 'bundled' as const,
        image: d.src,
        alt: d.alt,
        title: d.title,
        caption: d.caption,
      }))
    : cs.highlights.map((h) => ({
        kind: 'cms' as const,
        image: h.image,
        alt: h.alt,
        title: h.title,
        caption: h.caption,
      }))
).slice(0, 4);
const hasBeforeAfter = !!(cs.beforeImage && cs.afterImage);

// ---- the story ----------------------------------------------------------------
// A body that still describes features that are not live is held back (workExtras.ts).
// The story is the brief and the decisions; the "What I built" feature list after it reads
// like a spec, so it folds into a disclosure under the story (open it to read the full list).
const bodyBlocks = BODY_HELD_BACK.has(cs.id) ? [] : cs.body;
const builtAt = bodyBlocks.findIndex(
  (b) =>
    b.style === 'h2' &&
    /^what (i|we) built$/i.test(
      (b.children ?? [])
        .map((c) => c.text ?? '')
        .join('')
        .trim(),
    ),
);
const storyBlocks = builtAt >= 0 ? bodyBlocks.slice(0, builtAt) : bodyBlocks;
// The list runs from after its heading to the next h2 (anything after that stays in the story).
const nextH2 = builtAt >= 0 ? bodyBlocks.findIndex((b, i) => i > builtAt && b.style === 'h2') : -1;
const builtBlocks =
  builtAt >= 0 ? bodyBlocks.slice(builtAt + 1, nextH2 > 0 ? nextH2 : undefined) : [];
const afterBlocks = nextH2 > 0 ? bodyBlocks.slice(nextH2) : [];
const bodyHtml = renderJournalBody(storyBlocks);
const builtHtml = builtBlocks.length ? renderJournalBody(builtBlocks) : '';
const afterHtml = afterBlocks.length ? renderJournalBody(afterBlocks) : '';

// ---- calls to action ----------------------------------------------------------
// The sector preselects Organization type on the contact form (/contact/?org_type=<sector>).
const contactHref = `/contact/?org_type=${sector}`;
const countLine = sectorLine(all, sector);
const ctaSub = [countLine, site.ctaDefault.sub].filter(Boolean).join(' ');

// Social card. BaseLayout derives /og/work/<slug>.png from the pathname (the
// per-case-study card generated by scripts/generate-og.mjs); the JSON-LD image
// points at the same card.
const ogCardUrl = new URL(`/og/work/${cs.id}.png`, SITE_URL).toString();
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': ['Article', 'CreativeWork'],
    headline: title,
    description: summary,
    image: ogCardUrl,
    datePublished: cs.published.toISOString(),
    ...(cs.updated ? { dateModified: cs.updated.toISOString() } : {}),
    author: { '@id': `${SITE_URL}#organization` },
    publisher: { '@id': `${SITE_URL}#organization` },
    about: client,
    keywords: cs.services.join(', '),
  },
];
---

<BaseLayout
  title={`${title} | ${site.studioName}`}
  description={summary}
  ogType="article"
  schemas={schemas}
>
  <article class="cs">
    {/* 1. Hero: outcome first, then the site itself, then the facts. */}
    <Band ground="window-light" underHeader labelledby="cs-title" class="cs-hero">
      <div class="cs-top">
        <div class="cs-head">
          <p class="cs-kind type-ui">
            <a href="/work/" class="cs-crumb">
              All work
            </a>
            <span aria-hidden="true">/</span>
            <span>{sectorLabel(sector)}</span>
            {status && <span class="cs-status">{status}</span>}
          </p>
          <h1
            id="cs-title"
            class:list={['type-display cs-title', title.length > 20 && 'cs-title--long']}
          >
            {title}
          </h1>
          <p class="type-lede cs-outcome">{outcome ?? summary}</p>
          {visitUrl && (
            <p class="cs-visit type-ui">
              <a href={visitUrl} target="_blank" rel="noopener noreferrer" class="card-link">
                {isLive ? `Visit ${visitHost}` : `See the finished build at ${visitHost}`}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
              {!isLive && status && (
                <span class="cs-visit-note"> {status}: the address is a preview.</span>
              )}
            </p>
          )}
        </div>

        <div class="cs-facts">
          {ledger.length > 0 && (
            <dl class="cs-ledger">
              {ledger.map((row) => (
                <div class="cs-ledger-row">
                  <dt class="type-caption">{row.label}</dt>
                  <dd>{row.value}</dd>
                </div>
              ))}
            </dl>
          )}
          {stack.length > 0 && <p class="type-caption cs-stack">Built with {stack.join(', ')}.</p>}
        </div>

        <div class="cs-print">
          {reel ? (
            <Showreel slug={cs.id} spec={reel} url={visitHost} />
          ) : bundled?.cover ? (
            <Frame
              src={bundled.cover.src}
              alt={heroAlt}
              eager
              url={visitHost}
              tag={status}
              widths={[640, 960, 1280, 1440]}
              sizes="(min-width: 82.5rem) 76rem, 92vw"
            />
          ) : (
            cs.cover && (
              <Frame alt={heroAlt} url={isLive ? visitHost : undefined} tag={status}>
                <EmDashImage
                  image={cs.cover}
                  alt={heroAlt}
                  priority
                  sizes="(min-width: 82.5rem) 76rem, 92vw"
                />
              </Frame>
            )
          )}
        </div>
      </div>
    </Band>

    {/* 2. What changed: the result, then a call to action mid-page. */}
    {results.length > 0 && (
      <Band ground="paper" labelledby="cs-changed" class="cs-changed">
        <div class="cs-split">
          <h2 id="cs-changed" class="type-headline">
            What <span class="voice">changed</span>
          </h2>
          <ul class="cs-results" role="list">
            {results.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </div>
        <div class="cs-midcta">
          <p class="type-lede">
            Planning something like this for your {sectorLabel(sector).toLowerCase()}?
          </p>
          <a href={contactHref} class={buttonVariants({ variant: 'brand', size: 'cta' })}>
            {site.ctaDefault.label}
            <span data-nudge aria-hidden="true">
              →
            </span>
          </a>
        </div>
      </Band>
    )}

    {/* 3. The story: the brief and the decisions, headings in the margin. */}
    {(bodyHtml || builtHtml || afterHtml) && (
      <section class="band ground cs-story" aria-label="The story">
        <div class="ncs-container">
          {bodyHtml && <div class="cs-prose" set:html={bodyHtml} />}
          {builtHtml && (
            <details class="cs-built">
              <summary class="type-ui">The full build, as a list</summary>
              <div class="cs-prose cs-prose--list" set:html={builtHtml} />
            </details>
          )}
          {afterHtml && <div class="cs-prose cs-prose--after" set:html={afterHtml} />}
        </div>
      </section>
    )}

    {/* 4. The details, printed on the ink board. */}
    {(details.length > 0 || hasBeforeAfter) && (
      <Band ground="deep" still labelledby="cs-details" class="cs-details">
        <h2 id="cs-details" class="type-headline cs-details-title">
          In the <span class="voice">details</span>
        </h2>
        {details.length > 0 && (
          <ul class:list={['cs-crops', `cs-crops--${details.length}`]} role="list">
            {details.map((d) => (
              <li class="cs-crop">
                <figure>
                  <button
                    type="button"
                    class="cs-zoom"
                    data-zoom
                    aria-label={`View ${d.title ?? 'this detail'} full size`}
                  >
                    {d.kind === 'cms' ? (
                      <EmDashImage
                        image={d.image}
                        alt={d.alt}
                        sizes="(min-width: 64rem) 46vw, 92vw"
                      />
                    ) : (
                      <Image
                        src={d.image}
                        alt={d.alt}
                        widths={[640, 960, 1440]}
                        sizes="(min-width: 64rem) 46vw, 92vw"
                      />
                    )}
                  </button>
                  {(d.title || d.caption) && (
                    <figcaption>
                      {d.title && <h3 class="cs-crop-title">{d.title}</h3>}
                      {d.caption && <p class="cs-crop-caption">{d.caption}</p>}
                    </figcaption>
                  )}
                </figure>
              </li>
            ))}
          </ul>
        )}
        {hasBeforeAfter && (
          <div class="cs-ba">
            <h3 class="cs-ba-title">Before and after</h3>
            <BeforeAfter
              beforeImage={cs.beforeImage}
              afterImage={cs.afterImage}
              beforeAlt={cs.beforeAlt ?? 'The previous site'}
              afterAlt={cs.afterAlt ?? 'The redesigned site'}
              beforeLabel={cs.beforeLabel}
              afterLabel={cs.afterLabel}
            />
          </div>
        )}
        {details.length > 0 && <Lightbox />}
      </Band>
    )}

    {/* 5. The designer's note, a client's words if there are any, and more work. */}
    <Band ground="paper" label="A note from the designer, and more work" class="cs-close">
      {designerNote && <DesignerNote note={designerNote} />}
      {testimonial && (
        <figure class="cs-quote">
          <blockquote>
            <p>“{testimonial.quote}”</p>
          </blockquote>
          <figcaption class="type-caption">
            {testimonial.name}
            {testimonial.title ? `, ${testimonial.title}` : ''}
          </figcaption>
        </figure>
      )}
      {neighbours.length > 0 && (
        <nav class="cs-more" aria-label="More case studies">
          {neighbours.map((n) => (
            <a href={`/work/${n.id}/`} class="cs-more-link">
              {/* The title comes first for screen readers ("MAS Monograms, Small business"). */}
              <span class="cs-more-title">{n.title}</span>
              <span class="type-caption cs-more-kind">
                <span class="sr-only">, </span>
                {n.sector}
                {n.status && ` / ${n.status}`}
              </span>
            </a>
          ))}
          <a href="/work/" class="card-link cs-more-all">
            All the work
          </a>
        </nav>
      )}
    </Band>
  </article>

  <CtaBanner sub={ctaSub} ctaHref={contactHref} />
</BaseLayout>

<style>
  /* ---- 1. hero -------------------------------------------------------------- */
  .cs-head {
    display: grid;
    gap: var(--spacing-m);
    align-content: start;
  }
  .cs-kind {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 0;
    color: var(--muted-foreground);
  }
  .cs-crumb {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--link);
    font-weight: 600;
  }
  .cs-status {
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .cs-title {
    margin: 0;
  }
  /* A long name ("Second Presbyterian Church of Chicago") steps down a size so it
     sets in two or three lines, not four. */
  .cs-title--long {
    font-size: clamp(2.75rem, 1.4rem + 4.4vw, 5.25rem);
  }
  .cs-outcome {
    max-width: 44ch;
    margin: 0;
    color: var(--heading);
  }
  .cs-visit {
    margin: 0;
  }
  .cs-visit .card-link {
    min-height: 44px;
  }
  .cs-visit-note {
    color: var(--muted-foreground);
  }
  /* Phone: words, picture, facts. Desktop: words beside the facts, then the
     picture across the whole width. Only the facts move visually; they hold no
     links, so the focus order is unaffected. */
  .cs-top {
    display: grid;
    gap: var(--spacing-l);
    grid-template-areas: 'head' 'print' 'facts';
  }
  .cs-head {
    grid-area: head;
  }
  .cs-facts {
    grid-area: facts;
  }
  .cs-print {
    grid-area: print;
  }
  @media (min-width: 64rem) {
    .cs-top {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      grid-template-areas: 'head facts' 'print print';
      column-gap: var(--spacing-xl);
      align-items: end;
    }
    .cs-print {
      margin-top: var(--spacing-s);
    }
  }
  /* The ledger: the facts of the job in plain labels, sentence case, no mono,
     each on a hairline like the rows of a contact sheet's notes. */
  .cs-ledger {
    display: grid;
    margin: 0;
  }
  .cs-ledger-row {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: var(--spacing-s);
    padding: 0.6rem 0;
    border-top: 1px solid var(--border);
  }
  .cs-ledger-row:last-child {
    border-bottom: 1px solid var(--border);
  }
  .cs-ledger-row dt {
    padding-top: 0.15rem;
  }
  .cs-ledger-row dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--heading);
  }
  @media (max-width: 26rem) {
    .cs-ledger-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
  }
  .cs-stack {
    margin: var(--spacing-s) 0 0;
  }

  /* ---- 2. what changed ------------------------------------------------------ */
  .cs-split {
    display: grid;
    gap: var(--spacing-l);
  }
  @media (min-width: 56rem) {
    .cs-split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }
  .cs-split h2 {
    margin: 0;
  }
  .cs-results {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  .cs-results li {
    padding: var(--spacing-s) 0;
    border-top: 1px solid var(--border);
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.45;
    color: var(--heading);
    text-wrap: pretty;
  }
  .cs-results li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .cs-midcta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-m) var(--spacing-l);
    margin-top: var(--spacing-xl);
    padding: var(--spacing-l);
    background: var(--paper-deep);
    border-radius: 2px;
  }
  .cs-midcta p {
    margin: 0;
    max-width: 32ch;
    color: var(--heading);
  }

  /* ---- 3. the story --------------------------------------------------------- */
  .cs-story {
    background: var(--paper-deep);
  }
  /* Headings sit in the left margin at desktop; paragraphs, lists and the smaller
     headings run in the reading column. The markup is renderJournalBody()'s, so the
     selectors are :global. */
  .cs-prose {
    display: grid;
    gap: 0 var(--spacing-xl);
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--foreground);
  }
  @media (min-width: 64rem) {
    .cs-prose {
      grid-template-columns: 16rem minmax(0, var(--container-prose));
    }
    .cs-prose > :global(*) {
      grid-column: 2;
    }
    .cs-prose > :global(h2) {
      grid-column: 1;
      position: sticky;
      top: 6.5rem;
      align-self: start;
    }
  }
  .cs-prose :global(h2) {
    margin: var(--spacing-l) 0 var(--spacing-s);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-h3);
    line-height: 1;
    color: var(--heading);
    scroll-margin-top: 6.5rem;
  }
  .cs-prose :global(h2:first-child) {
    margin-top: 0;
  }
  @media (min-width: 64rem) {
    .cs-prose :global(h2) {
      margin-top: 0.35rem;
    }
    .cs-prose :global(h2 + *) {
      margin-top: 0;
    }
  }
  .cs-prose :global(h3) {
    margin: var(--spacing-l) 0 var(--spacing-xs);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--heading);
  }
  .cs-prose :global(p),
  .cs-prose :global(ul),
  .cs-prose :global(ol),
  .cs-prose :global(blockquote) {
    max-width: var(--container-prose);
    margin: 0 0 var(--spacing-m);
  }
  .cs-prose :global(ul),
  .cs-prose :global(ol) {
    padding-left: 1.25rem;
  }
  .cs-prose :global(ul) {
    list-style: disc;
  }
  .cs-prose :global(ol) {
    list-style: decimal;
  }
  .cs-prose :global(li) {
    margin-bottom: 0.4rem;
  }
  .cs-prose :global(a) {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .cs-prose :global(strong) {
    font-weight: 600;
    color: var(--heading);
  }
  .cs-prose :global(blockquote) {
    font-style: italic;
    color: var(--muted-foreground);
  }

  /* ---- 4. the details ------------------------------------------------------- */
  /* Its own class, not ".cs-details h2": cs-details sits on the Band component's root,
     which does not carry this page's scope, so that selector never matched and the
     heading sat flush on the first crop (2026-10-04 review). */
  .cs-details-title {
    margin: 0 0 var(--spacing-xl);
  }
  .cs-crops {
    display: grid;
    gap: var(--spacing-xl) var(--spacing-l);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 64rem) {
