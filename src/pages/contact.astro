---
// Foundation, edit with care. The form structure, the Web3Forms wiring, and the
// inline enhancement script are the production inquiry pipeline; touch only with
// intent. The layout shell around them is on the redesign's Band grounds.
/* ============================================================================
   /contact | Contact
   ============================================================================
   Goal: the shortest honest path to an inquiry.

   Bands (DESIGN.md "Grounds"; one moving ground per page, at the top):
     1. window-light (moving, under the header): a plain headline, the free-first-
        conversation reassurance, and the two no-form ways to reach me.
     2. paper: the form beside the "what happens next" ledger.
     3. paper-contours (still): "Where I am" (the Ohio bend IS the map: a static
        ground, no third-party iframe, no request that can fail) and the closing
        email/phone line.

   THE FORM asks for three things: name, email and what the project is. Everything
   else (organization, type, current site, budget, timeline, phone, how you heard)
   is optional and sits in a native <details>, so a visitor can send in a minute
   and a qualified lead can still say more. The page does NOT mark required fields;
   it marks optional ones (see optionalMark) and says plainly up top what is needed.

   WEB3FORMS WIRING, unchanged: the three hidden inputs, the honeypot `botcheck`,
   field names and ids, a native POST without JavaScript, fetch + JSON with it.
   The `novalidate` attribute is added by the script (form.noValidate), not in the
   markup, so without JavaScript the browser's own required/type checks still run.

   SUCCESS: the form swaps for a thank-you panel, the first step of the ledger is
   ticked, location.hash becomes #sent and a `ncs:contact-sent` CustomEvent fires on
   window. That event is the conversion hook: no analytics vendor is wired, so a tag
   (GA4, Plausible, Cloudflare Web Analytics events) listens for it. The detail
   carries only choice labels, never the name, email or message. See
   .claude/rules/homepage-and-pages.md "Contact" for the listener snippet.

   Spam protection is the hidden honeypot field (botcheck) alone (hCaptcha was
   removed; Turnstile was never on this page).
   ============================================================================ */

import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import headshot from '../assets/brand/headshot.jpg';
import Band from '../components/Band.astro';
import { getSite } from '../data/site';
import { buttonVariants } from '../components/ui/button';
import { contactTitle, getContactPage } from '../lib/contactPage';

// Email, phone, location, the booking link and the form subject all come from
// Site settings in the CMS (with the committed fallback).
const site = await getSite(Astro);

// Organization type options. Match the sectors used in the case-studies
// schema so the data we collect lines up with how we describe the work. The
// values are the codes /contact?org_type=<sector> links rely on.
const orgTypes = [
  { value: 'church', label: 'Church' },
  { value: 'school', label: 'School' },
  { value: 'nonprofit', label: 'Nonprofit' },
  { value: 'small-business', label: 'Small business' },
  { value: 'other', label: 'Something else' },
];

// The page words and the three choice lists (Budget range, Project timeline, How
// did you hear about us) come from the Contact page entry in the CMS (committed
// fallback: cms/content/page_contact.json). Each choice's LABEL is also the value
// the form submits, so the inquiry email reads "Budget: Under $4,000" and not a
// code. Keep the budget brackets in line with the Pricing tiers (the lowest bracket
// starts at the lowest tier's price so the form never implies work below it); the
// timeline list helps triage against the per-quarter project cap, and "heard from"
// is a cheap signal on which channels bring inquiries in.
const page = await getContactPage(Astro);
const { budgets, timelines, heardFrom: heardFromOptions, nextSteps } = page;

// Web3Forms access key. PUBLIC_ prefix exposes it to the client at build
// time, which is required because the form runs in the browser.
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const formActive = web3formsKey.length > 0;

// Shortest message that still tells me something. Mirrored in the script's error
// text and the textarea's minlength.
const MIN_MESSAGE = 20;

// Timing labels for the ledger rows, in the order of the CMS steps. Only used
// when the CMS still has three steps, so an edited list never gets a wrong label.
const stepWhen = nextSteps.length === 3 ? ['Today', 'Day 1 to 2', 'After that'] : [];

const optionalMark = 'optional';
---

{/* The first screen sets the italic voice in the h1, so its font is preloaded
     with the core files: arriving late, it reflowed the hero (a layout shift). */}
<BaseLayout
  title={contactTitle(page.seoTitle, site.studioName)}
  description={page.seoDescription}
  preloadFonts={['italic']}
>
  {/* ====================================================================
       Band 1: the calm top. Window-light ground (the one moving ground),
       under the transparent header. The only h1. Nothing here is hidden or
       revealed: it is the first screen.
       ==================================================================== */}
  <Band ground="window-light" underHeader tight labelledby="contact-hero-heading">
    <div class="contact-hero">
      <div class="contact-hero-text">
        <h1 id="contact-hero-heading" class="type-headline contact-title">
          {page.heading} <span class="voice">{page.headingAccent}</span>
        </h1>
        <p class="type-lede contact-lede">{page.intro}</p>
        <p class="contact-free">The first conversation is free.</p>
        <p class="contact-direct">
          <a href={site.emailHref}>{site.email}</a>
          <span aria-hidden="true">/</span>
          <a href={site.phoneHref}>{site.phone}</a>
        </p>
      </div>
      {/* A real photograph and a true line: one person reads what you send. */}
      <figure class="contact-person">
        <Picture
          formats={['avif', 'webp']}
          pictureAttributes={{ class: 'contents' }}
          src={headshot}
          alt={`${site.ownerName}, who runs ${site.studioName} and reads every message`}
          widths={[176, 264, 352]}
          sizes="(min-width: 48rem) 11rem, 8rem"
          loading="eager"
          class="contact-person-img"
        />
        <figcaption class="type-caption">
          {site.ownerName}, {site.address}
        </figcaption>
      </figure>
    </div>
  </Band>

  {/* ====================================================================
       Band 2: the inquiry. The form on the left, the ledger on the right
       (under the form on a phone). Paper ground, still.
       ==================================================================== */}
  <Band ground="paper" labelledby="contact-form-heading">
    <div class="contact-grid">
      <div class="contact-main">
        <h2 id="contact-form-heading" class="contact-form-title type-headline">
          Send me <span class="voice">a few lines.</span>
        </h2>
        <p class="contact-voice">I read every message myself.</p>
        <p class="type-caption contact-need">
          Your name, your email and what you are working on are all I need. Everything else is
          optional.
        </p>

        <div class="contact-card">
          <form
            method="post"
            action="https://api.web3forms.com/submit"
            class="contact-form"
            data-contact-form
          >
            {/* Web3Forms hidden fields:
                - access_key: routes the submission to Nathan's inbox.
                - subject: sets the email subject so inquiries are obvious.
                - from_name: sets the visible sender name.
              The form posts natively to the same endpoint if JS is disabled,
              so submissions always reach Web3Forms. */}
            <input type="hidden" name="access_key" value={web3formsKey} />
            <input type="hidden" name="subject" value={`New project inquiry from ${site.domain}`} />
            <input type="hidden" name="from_name" value={`${site.studioName} website`} />

            <div class="field">
              <label for="name">Your name</label>
              <input
                class="control"
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                autocapitalize="words"
                aria-describedby="name-error"
              />
              <p class="field-error" id="name-error" data-error-for="name" hidden></p>
            </div>

            <div class="field">
              <label for="email">Email</label>
              <input
                class="control"
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                inputmode="email"
                autocapitalize="none"
                spellcheck="false"
                aria-describedby="email-error"
              />
              <p class="field-error" id="email-error" data-error-for="email" hidden></p>
            </div>

            <div class="field">
              <label for="message">What are you working on?</label>
              <textarea
                class="control"
                id="message"
                name="message"
                required
                minlength={MIN_MESSAGE}
                rows="9"
                aria-describedby="message-hint message-error"
              ></textarea>
              <p class="field-hint" id="message-hint">
                A few sentences is plenty: what the project is, who it is for, and roughly when you
                would like it live.
              </p>
              <p class="field-error" id="message-error" data-error-for="message" hidden></p>
            </div>

            {/* Everything below is optional. A native <details> so it works with no
              JavaScript; the script opens it when a draft or ?org_type preselect
              put a value in it. */}
            <details class="more" data-contact-more>
              <summary>
                <span class="more-label">Tell me more</span>
                <span class="more-note">{optionalMark}</span>
              </summary>

              <div class="more-body">
                <div class="field-pair">
                  <div class="field">
                    <label for="organization">Organization</label>
                    <input
                      class="control"
                      type="text"
                      id="organization"
                      name="organization"
                      autocomplete="organization"
                    />
                  </div>
                  <div class="field">
                    <label for="org_type">Type of organization</label>
                    <select class="control" id="org_type" name="org_type">
                      <option value="" selected>
                        Choose one
                      </option>
                      {orgTypes.map((opt) => (
                        <option value={opt.value}>{opt.label}</option>
                      ))}
                    </select>
                  </div>
                </div>

                <div class="field-pair">
                  <div class="field">
                    <label for="budget">Budget range</label>
                    <select class="control" id="budget" name="budget">
                      <option value="" selected>
                        Pick a range
                      </option>
                      {/* The label is the submitted value (see the top of the file). */}
                      {budgets.map((label) => (
                        <option value={label}>{label}</option>
                      ))}
                    </select>
                    <p class="field-hint">
                      Not sure? <a href="/services/">See what each tier covers</a>.
                    </p>
                  </div>
                  <div class="field">
                    <label for="timeline">Timeline</label>
                    <select class="control" id="timeline" name="timeline">
                      <option value="" selected>
                        No preference
                      </option>
                      {timelines.map((label) => (
                        <option value={label}>{label}</option>
                      ))}
                    </select>
                  </div>
                </div>

                <div class="field">
                  <label for="current_website">Current website</label>
                  <input
                    class="control"
                    type="url"
                    id="current_website"
                    name="current_website"
                    autocomplete="url"
                    inputmode="url"
                    autocapitalize="none"
                    spellcheck="false"
                    placeholder="https://"
                  />
                </div>

                <div class="field-pair">
                  <div class="field">
                    <label for="phone">Phone</label>
                    <input
                      class="control"
                      type="tel"
                      id="phone"
                      name="phone"
                      autocomplete="tel"
                      inputmode="tel"
                    />
                  </div>
                  <div class="field">
                    <label for="heard_from">How did you find me?</label>
                    <select class="control" id="heard_from" name="heard_from">
                      <option value="" selected>
                        Pick one if you like
                      </option>
                      {heardFromOptions.map((label) => (
                        <option value={label}>{label}</option>
                      ))}
                    </select>
                  </div>
                </div>
              </div>
            </details>

            {/* Honeypot. sr-only keeps it off screen; aria-hidden and tabindex -1
              keep it out of the accessibility tree and the tab order. Bots tend to
              fill every field, so the script discards submissions where this is
              non-empty. */}
            <div class="sr-only" aria-hidden="true">
              <label for="botcheck">Leave this field empty</label>
              <input type="text" id="botcheck" name="botcheck" tabindex="-1" autocomplete="off" />
            </div>

            <p class="form-summary" data-form-summary role="alert" hidden></p>

            <div class="submit-row">
              <button
                type="submit"
                class={`${buttonVariants({ variant: 'brand', size: 'cta' })} send`}
                data-contact-submit
              >
                {/* Spinner: hidden until the submit handler adds .is-spinning. */}
                <span class="contact-spinner" aria-hidden="true"></span>
                <span data-contact-submit-label>Send me your project</span>
              </button>
              <p class="type-caption">It goes straight to my inbox.</p>
            </div>

            {/* No access key in this build. The developer's note shows under
                 `astro dev` only; any built copy without the key (a branch
                 preview, the CI preview) tells a visitor plainly instead.
                 Production sets PUBLIC_WEB3FORMS_KEY in the Cloudflare BUILD
                 variables (docs/claude/deployment.md), so neither shows there. */}
            {!formActive && import.meta.env.DEV && (
              <p class="type-caption">
                The Web3Forms access key is missing. Set <code>PUBLIC_WEB3FORMS_KEY</code> in{' '}
                <code>.env</code> locally and in the Cloudflare build settings before launch.
              </p>
            )}
            {!formActive && !import.meta.env.DEV && (
              <p class="type-caption">
                This copy of the site is a preview, and its form does not send. Email me at{' '}
                <a href={site.emailHref} class="text-link underline underline-offset-2">
                  {site.email}
                </a>{' '}
                instead.
              </p>
            )}
          </form>

          {/* Thank-you panel. Starts hidden; the submit handler reveals it, moves
            focus here and announces it (role=status). */}
          <div class="contact-thanks" data-contact-thanks role="status" tabindex="-1" hidden>
            <h2 class="type-headline">
              Thanks, <span class="voice">your message is in.</span>
            </h2>
            <p class="type-body">
              I will reply to <strong data-sent-email>your email address</strong>, and a person (me)
              will be the one writing. If you do not hear back, check your spam folder for a message
              from {site.domain}, or email me at <a href={site.emailHref}>{site.email}</a>.
            </p>
            <p class="type-body">
              The steps beside this note show what comes next. In the meantime,
              <a href="/work/">have a look at the work</a>.
            </p>
          </div>

          {/* Error panel. role=alert so a failure is announced. */}
          <div class="contact-error" data-contact-error role="alert" tabindex="-1" hidden>
            <p>
              The message did not go through. Please try once more, or email me at
              <a href={site.emailHref}>{site.email}</a>
              or call <a href={site.phoneHref}>{site.phone}</a>. Your text is still in the form.
            </p>
          </div>
        </div>
      </div>

      <aside class="contact-aside" aria-labelledby="contact-next-heading">
        <h2 id="contact-next-heading" class="contact-aside-title type-headline">
          What happens <span class="voice">next</span>
        </h2>
        {/* A quiet ledger of the real sequence. The script ticks the first row when
          the message is sent. The CMS controls the wording (Contact page). */}
        <ol class="steps" data-contact-steps>
          {nextSteps.map((step, i) => (
            <li>
              <span class="step-tick" aria-hidden="true" />
              <span class="step-text">
                {stepWhen[i] && <span class="step-when">{stepWhen[i]}</span>}
                {step}
              </span>
            </li>
          ))}
        </ol>

        {site.bookingUrl && (
          <p class="type-body contact-book">
            Would a call suit you better?{' '}
            <a href={site.bookingUrl} target="_blank" rel="noopener noreferrer">
              Pick a time on my calendar
            </a>
            .
          </p>
        )}
      </aside>
    </div>
  </Band>

  {/* ====================================================================
       Band 3: where I am. The paper-contours ground draws the Ohio bend at
       Cincinnati, so the place is shown without a map embed: nothing to load,
       nothing to leak, nothing to fail. Still (the page's one moving ground is
       the hero). No street address, only what Site settings publish.
       ==================================================================== */}
  <Band ground="paper-contours" still labelledby="contact-where-heading">
    <div class="contact-where">
      <div>
        <h2 id="contact-where-heading" class="type-headline">
          Working from <span class="voice">{site.address}.</span>
        </h2>
        <p class="type-body">{page.whereText}</p>
      </div>
      {site.bookingUrl && (
        <div class="contact-close">
          <p class="contact-close-title">Would a call suit you better?</p>
          <p class="type-body">
            A half-hour on my calendar. No pitch, just a working conversation.
          </p>
          <p class="contact-close-links">
            <a
              class={buttonVariants({ variant: 'brand', size: 'cta' })}
              href={site.bookingUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Pick a time
            </a>
          </p>
        </div>
      )}
    </div>
  </Band>

  <style>
    /* ---- Band 1: the calm top ---------------------------------------------- */
    .contact-hero {
      display: grid;
      gap: var(--spacing-l);
      align-items: end;
    }
    @media (min-width: 48rem) {
      .contact-hero {
        grid-template-columns: minmax(0, 1fr) auto;
        gap: var(--spacing-2xl);
      }
    }
    .contact-hero-text {
      display: grid;
      gap: var(--spacing-s);
      max-width: 46rem;
    }
    .contact-title {
      font-size: var(--text-h1);
      margin: 0;
    }
    .contact-lede {
      margin: 0;
      /* 40ch of Newsreader (its zero is 0.5665em), in em so the measure does
         not change while a fallback font is showing (ch follows the font). */
      max-width: 22.66em;
    }
    .contact-free {
      margin: 0;
      font-family: var(--font-serif);
      font-size: var(--text-body);
      color: var(--foreground);
    }
    .contact-direct {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0 var(--spacing-s);
      margin: 0;
      font-family: var(--font-serif);
      font-size: var(--text-body);
      color: var(--muted-foreground);
    }
    /* On a phone the two links stack. Side by side they sit right at the
       wrap point of a 360 to 420 px screen, so the web font swapping in
       (Newsreader is a touch wider than any fallback) pushed the phone number
       onto a second line and everything under it down: a layout shift in CI.
       Stacked, neither font wraps. */
    @media (max-width: 30rem) {
      .contact-direct {
        flex-direction: column;
        align-items: flex-start;
      }
      .contact-direct > span[aria-hidden='true'] {
        display: none;
      }
    }
    .contact-direct a {
      /* Body size, with a 44px touch height that does not change the line. */
      display: inline-block;
      padding-block: 0.85rem;
      color: var(--link);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .contact-person {
      display: grid;
      gap: var(--spacing-xs);
      margin: 0;
      justify-items: start;
    }
    .contact-person-img {
      width: 8rem;
      height: 8rem;
      object-fit: cover;
      border-radius: 2px;
      box-shadow: var(--shadow-frame);
    }
    @media (min-width: 48rem) {
      .contact-person-img {
        width: 11rem;
        height: 11rem;
      }
    }

    /* ---- Band 2: form + ledger ---------------------------------------------- */
    .contact-grid {
      display: grid;
      gap: var(--spacing-xl);
    }
    @media (min-width: 60rem) {
      .contact-grid {
        grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
        gap: var(--spacing-2xl);
        align-items: start;
      }
      .contact-aside {
        position: sticky;
        top: calc(var(--header-h) + var(--spacing-l));
      }
    }
    .contact-form-title,
    .contact-aside-title {
      margin: 0 0 var(--spacing-xs);
      font-size: var(--text-h3);
    }
    .contact-need {
      margin: 0 0 var(--spacing-m);
      max-width: 52ch;
    }
    /* The form is a tray: a step deeper than the page, with a hairline and the
       soft print shadow (DESIGN.md "Elevation": no hard offset shadows), so the
       fields (a step LIGHTER than both) are the thing you see. */
    .contact-card {
      background: var(--muted);
      border: 1px solid var(--input);
      box-shadow: var(--shadow-print);
      padding: clamp(1.1rem, 1rem + 2.2vw, 2.25rem);
    }
    .contact-voice {
      margin: 0 0 var(--spacing-xs);
      font-family: var(--font-serif);
      font-style: italic;
      font-size: var(--text-lede);
      line-height: 1.2;
      color: var(--marker);
    }
    .contact-form {
      display: grid;
      gap: var(--spacing-m);
    }
    .field {
      display: grid;
      gap: 0.4rem;
      min-width: 0;
    }
    .field-pair {
      display: grid;
      align-items: start;
      gap: var(--spacing-m);
    }
    @media (min-width: 40rem) {
      .field-pair {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    .field label {
      font-family: var(--font-ui);
      font-size: 1rem;
      font-weight: 600;
      color: var(--heading);
    }
    .control {
      width: 100%;
      min-height: 3rem;
      padding: 0.65rem 0.8rem;
      font-family: var(--font-ui);
      /* 16px stops iOS Safari zooming the page on focus. */
      font-size: 1rem;
      line-height: 1.4;
      color: var(--foreground);
      background: var(--card);
      border: 1px solid var(--input);
      scroll-margin-top: calc(var(--header-h) + 1rem);
      border-radius: 2px;
    }
    textarea.control {
      min-height: 12rem;
      resize: vertical;
    }
    /* Invalid is a tinted field with a heavy brick edge; the focus ring (marker,
       outside the box) stays a separate cue. */
    .control[aria-invalid='true'] {
      border: 2px solid var(--link);
      background: color-mix(in srgb, var(--link) 7%, var(--card));
    }
    .field-hint a {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      color: var(--link);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .form-summary {
      margin: 0;
      padding: var(--spacing-xs) var(--spacing-s);
      border: 2px solid var(--link);
      background: color-mix(in srgb, var(--link) 7%, var(--card));
      font-family: var(--font-ui);
      font-weight: 600;
      color: var(--foreground);
    }
    .form-summary[hidden] {
      display: none;
    }
    @media (min-width: 40rem) {
      .form-summary {
        display: none;
      }
    }
    .field-hint {
      margin: 0;
      font-family: var(--font-ui);
      font-size: var(--text-caption);
      line-height: 1.4;
      color: var(--muted-foreground);
    }
    .field-error {
      margin: 0;
      font-family: var(--font-ui);
      font-size: 0.9375rem;
      font-weight: 600;
      line-height: 1.4;
      color: var(--link);
    }
    .field-error[hidden] {
      display: none;
    }

    /* The optional fields: a native disclosure with a 48px summary. */
    .more {
      border-top: 1px solid var(--border);
      padding-top: var(--spacing-xs);
    }
    .more summary {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      min-height: 3rem;
      padding-block: 0.6rem;
      cursor: pointer;
      font-family: var(--font-ui);
      font-size: 0.9375rem;
      font-weight: 600;
      color: var(--heading);
      list-style: none;
    }
    .more summary::-webkit-details-marker {
      display: none;
    }
    .more summary::before {
      content: '+';
      display: inline-block;
      width: 1rem;
      font-weight: 400;
      color: var(--marker);
    }
    .more[open] summary::before {
      content: '\2212';
    }
    .more-note {
      font-weight: 400;
      color: var(--muted-foreground);
    }
    .more-body {
      display: grid;
      gap: var(--spacing-m);
      padding-top: var(--spacing-xs);
    }

    .submit-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--spacing-s) var(--spacing-m);
    }
    .send {
      min-height: 3.25rem;
      padding-inline: 2rem;
    }
    .submit-row p {
      margin: 0;
    }
    code {
      font-size: 0.9em;
    }

    .contact-thanks {
      display: grid;
      gap: var(--spacing-s);
    }
    .contact-thanks[hidden],
    .contact-error[hidden] {
      display: none;
    }
    .contact-thanks h2 {
      margin: 0;
      font-size: var(--text-h3);
    }
    .contact-thanks p {
      margin: 0;
    }
    .contact-thanks a,
    .contact-error a,
    .contact-book a {
      color: var(--link);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .contact-error {
      scroll-margin-top: calc(var(--header-h) + 1rem);
      margin-top: var(--spacing-m);
      padding: var(--spacing-s) var(--spacing-m);
      border: 2px solid var(--link);
      background: var(--card);
      color: var(--foreground);
    }
    .contact-error p {
      margin: 0;
    }

    /* The ledger. */
    .steps {
      margin: 0;
      padding: 0;
      list-style: none;
      border-bottom: 1px solid var(--border);
    }
    .steps li {
      display: flex;
      align-items: flex-start;
      gap: var(--spacing-s);
      padding-block: var(--spacing-s);
      border-top: 1px solid var(--border);
      font-family: var(--font-serif);
      font-size: var(--text-body);
      line-height: 1.5;
      color: var(--foreground);
    }
    .step-text {
      display: grid;
      gap: 0.1rem;
    }
    .step-when {
      font-family: var(--font-ui);
      font-size: var(--text-caption);
      font-weight: 600;
      color: var(--link);
    }
    .steps li[data-done] .step-when {
      color: var(--muted-foreground);
    }
    .step-tick {
      flex: none;
      width: 1rem;
      height: 2px;
      margin-top: 0.8em;
      background: var(--marker);
    }
    .steps li[data-done] {
      color: var(--muted-foreground);
    }
    .steps li[data-done] .step-tick {
      height: 0.55rem;
      width: 0.9rem;
      margin-top: 0.45em;
      background: none;
      border-bottom: 2px solid var(--marker);
      border-left: 2px solid var(--marker);
      transform: rotate(-45deg) scale(0.8);
    }
    .contact-book {
      margin: var(--spacing-m) 0 0;
    }

    /* ---- Band 3: where I am ------------------------------------------------- */
    .contact-where {
      display: grid;
      gap: var(--spacing-xl);
    }
    @media (min-width: 56rem) {
      .contact-where {
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
        gap: var(--spacing-2xl);
        align-items: end;
      }
    }
    .contact-where h2 {
      margin: 0 0 var(--spacing-s);
      font-size: var(--text-h2);
    }
    .contact-where p {
      margin: 0;
    }
    .contact-close {
      display: grid;
      gap: var(--spacing-xs);
    }
    .contact-close-title {
      font-family: var(--font-display);
      font-size: var(--text-h4);
      line-height: 1;
      letter-spacing: 0.01em;
      color: var(--heading);
    }
    .contact-close-links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--spacing-s) var(--spacing-m);
    }
    .contact-where .contact-close-links {
      margin: var(--spacing-xs) 0 0;
    }
    .contact-phone {
      display: inline-block;
      padding-block: 0.85rem;
      font-family: var(--font-ui);
      font-weight: 600;
      color: var(--link);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    /* ---- Submit spinner ------------------------------------------------------
       Collapsed until the submit handler adds .is-spinning, then a small ring
       before the label. Static under prefers-reduced-motion (still a state cue). */
    .contact-spinner {
      display: none;
      width: 1em;
      height: 1em;
      border-radius: 9999px;
      border: 2px solid color-mix(in srgb, currentColor 35%, transparent);
      border-top-color: currentColor;
      flex-shrink: 0;
    }
    [data-contact-submit].is-spinning .contact-spinner {
      display: inline-block;
      animation: contact-spin 0.7s linear infinite;
    }
    @keyframes contact-spin {
      to {
        transform: rotate(360deg);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      [data-contact-submit].is-spinning .contact-spinner {
        animation: none;
      }
    }
  </style>

  {/* ----------------------------------------------------------------------
       Enhancement script: inline validation, draft save/restore, honeypot,
       fetch submit, thank-you/error swap, the conversion hook.
       ---------------------------------------------------------------------- */}
  <script>
    // Registered on astro:page-load so the form's JS layer re-binds after a View
    // Transitions navigation, not just on a hard load. The dataset guard keeps it
    // from binding twice to the same form instance.
    type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

    function initContactForm(): void {
      const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
      const thanks = document.querySelector<HTMLElement>('[data-contact-thanks]');
      const errorEl = document.querySelector<HTMLElement>('[data-contact-error]');
      const submit = document.querySelector<HTMLButtonElement>('[data-contact-submit]');
      const label = document.querySelector<HTMLElement>('[data-contact-submit-label]');
      const more = document.querySelector<HTMLDetailsElement>('[data-contact-more]');
      const steps = document.querySelector<HTMLElement>('[data-contact-steps]');
      const summary = document.querySelector<HTMLElement>('[data-form-summary]');

      if (!form || !thanks || !errorEl || !submit || !label) return;
      if (form.dataset.enhanced) return;
      form.dataset.enhanced = 'true';

      // We draw our own error text below, so switch off the browser's bubbles. Done
      // here (not in the markup) so a no-JS visitor still gets native validation.
      form.noValidate = true;

      const originalLabel = label.textContent ?? 'Send me your project';
      const field = (name: string): Field | null => form.elements.namedItem(name) as Field | null;
      const minMessage = Number(field('message')?.getAttribute('minlength') ?? '20');

      /* ---- Draft auto-save ----------------------------------------------------
         A long message survives an accidental refresh: saved on input (debounced),
         restored on load, cleared after a successful send. The honeypot and the
         Web3Forms hidden fields are never saved. Storage can be blocked (private
         browsing), so every access is in try/catch. */
      const DRAFT_KEY = 'ncs-contact-draft';
      const persistedNames = [
        'name',
        'email',
        'phone',
        'organization',
        'org_type',
        'current_website',
        'budget',
        'timeline',
        'message',
        'heard_from',
      ];
      // Optional fields live in the disclosure; open it when one holds a value.
      const optionalNames = persistedNames.filter(
        (n) => n !== 'name' && n !== 'email' && n !== 'message',
      );

      function openMoreIfFilled(): void {
        if (!more) return;
        if (optionalNames.some((n) => field(n)?.value)) more.open = true;
      }

      function restoreDraft(): void {
        try {
          const raw = localStorage.getItem(DRAFT_KEY);
          if (!raw) return;
          const data = JSON.parse(raw) as Record<string, string>;
          persistedNames.forEach((name) => {
            const el = field(name);
            if (el && typeof data[name] === 'string' && data[name].length > 0) {
              // A select's options are CMS-editable. Restore a saved choice only if an
              // option with that exact value still exists, so an old draft (codes) or a
              // renamed choice leaves the select on its placeholder instead of blank.
              if (
                el instanceof HTMLSelectElement &&
                !Array.from(el.options).some((o) => o.value === data[name])
              ) {
                return;
              }
              el.value = data[name];
            }
          });
        } catch {
          /* swallow */
        }
      }

      function saveDraft(): void {
        try {
          const out: Record<string, string> = {};
          persistedNames.forEach((name) => {
            const el = field(name);
            if (el && el.value) out[name] = el.value;
          });
          if (Object.keys(out).length === 0) {
            localStorage.removeItem(DRAFT_KEY);
            return;
          }
          localStorage.setItem(DRAFT_KEY, JSON.stringify(out));
        } catch {
          /* swallow */
        }
      }

      function clearDraft(): void {
        try {
          localStorage.removeItem(DRAFT_KEY);
        } catch {
          /* swallow */
        }
      }

      let saveTimer: number | undefined;
      function scheduleSave(): void {
        if (saveTimer) window.clearTimeout(saveTimer);
        saveTimer = window.setTimeout(saveDraft, 250);
      }

      restoreDraft();

      // Context-aware preselect. A case study's closing CTA links here as
      // /contact/?org_type=<sector>, so a visitor from a church study lands with
      // "Church" already chosen. Applied only when the field is still empty (never
      // over a restored draft); the param is then stripped so a refresh does not
      // re-apply it. Convenience only: the form works the same without it.
      try {
        const params = new URLSearchParams(window.location.search);
        const wanted = params.get('org_type');
        if (wanted) {
          const orgSelect = field('org_type');
          if (
            orgSelect instanceof HTMLSelectElement &&
            !orgSelect.value &&
            Array.from(orgSelect.options).some((o) => o.value === wanted)
          ) {
            orgSelect.value = wanted;
            scheduleSave();
          }
          params.delete('org_type');
          const qs = params.toString();
          window.history.replaceState(
            null,
            '',
            window.location.pathname + (qs ? `?${qs}` : '') + window.location.hash,
          );
        }
      } catch {
        /* URL / select access guarded; the preselect is never required */
      }

      openMoreIfFilled();

      /* ---- Inline validation --------------------------------------------------
         Three required fields. Each has a <p data-error-for> that the input points
         at with aria-describedby, so a screen reader reads the error when focus
         lands on the field. */
      const rules: Record<string, (v: string) => string> = {
        name: (v) => (v.trim() ? '' : 'Please add your name so I know who to reply to.'),
        email: (v) => {
          const t = v.trim();
          if (!t) return 'Please add your email so I can reply.';
          return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(t)
            ? ''
            : 'That email address does not look right. Check for a missing @ or dot.';
        },
        message: (v) => {
          const t = v.trim();
          if (!t) return 'Tell me a little about the project.';
          return t.length < minMessage
            ? `A few more words, please: at least ${minMessage} characters, so I can reply with something useful.`
            : '';
        },
      };

      function setError(name: string, text: string): void {
        const el = field(name);
        const out = form!.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
        if (!el || !out) return;
        out.textContent = text;
        out.hidden = !text;
        if (text) el.setAttribute('aria-invalid', 'true');
        else el.removeAttribute('aria-invalid');
      }

      function validate(): Field | null {
        let first: Field | null = null;
        Object.keys(rules).forEach((name) => {
          const el = field(name);
          if (!el) return;
          const msg = rules[name](el.value);
          setError(name, msg);
          if (msg && !first) first = el;
        });
        return first;
      }

      // Once a field has shown an error, re-check it as the visitor fixes it.
      Object.keys(rules).forEach((name) => {
        const el = field(name);
        el?.addEventListener('input', () => {
          if (el.getAttribute('aria-invalid') === 'true') setError(name, rules[name](el.value));
        });
      });

      form.addEventListener('input', scheduleSave);
      form.addEventListener('change', scheduleSave);

      function showSent(): void {
        const email = field('email')?.value.trim();
        const slot = thanks!.querySelector<HTMLElement>('[data-sent-email]');
        if (slot && email) slot.textContent = email;
        form!.hidden = true;
        errorEl!.hidden = true;
        thanks!.hidden = false;
        // Tick the first step of the ledger and mark the next one as current.
        if (steps) {
          const rows = steps.querySelectorAll('li');
          rows[0]?.setAttribute('data-done', '');
          rows[1]?.setAttribute('aria-current', 'step');
        }
        thanks!.focus({ preventScroll: true });
        const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        thanks!.scrollIntoView({ behavior: calm ? 'auto' : 'smooth', block: 'center' });
      }

      // The conversion hook. Not fired for a honeypot hit. The URL gets a #sent
      // hash (a refresh does not re-count, and a hash cannot 404) and window gets a
      // CustomEvent a tag can listen for. The detail holds choice labels only,
      // never the name, email or message.
      function announceSent(): void {
        try {
          window.history.replaceState(
            null,
            '',
            window.location.pathname + window.location.search + '#sent',
          );
        } catch {
          /* history may be locked down; the event is the real hook */
        }
        window.dispatchEvent(
          new CustomEvent('ncs:contact-sent', {
            detail: {
              orgType: field('org_type')?.value ?? '',
              budget: field('budget')?.value ?? '',
              timeline: field('timeline')?.value ?? '',
              heardFrom: field('heard_from')?.value ?? '',
            },
          }),
        );
      }

      // A failed send: show the panel, move focus to it and scroll it clear of the
      // sticky header, so nobody is left looking at a form that seems to do nothing.
      function failSend(): void {
        errorEl!.hidden = false;
        errorEl!.focus({ preventScroll: true });
        errorEl!.scrollIntoView({ behavior: 'auto', block: 'center' });
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        // Validate first and stop before any request, so a blank or too-short field
        // never silently submits and waits on a server reject.
        const firstBad = validate();
        if (summary) {
          const bad = Object.keys(rules).filter(
            (n) => field(n)?.getAttribute('aria-invalid') === 'true',
          );
          summary.hidden = bad.length === 0;
          summary.textContent = bad.length
            ? `Please fix ${bad.length === 1 ? 'one thing' : bad.length + ' things'} above: ${bad.join(', ')}.`
            : '';
        }
        if (firstBad) {
          firstBad.focus();
          return;
        }

        // Honeypot. Real users never fill this; bots usually do. Pretend it worked
        // but drop the request (and do not count a conversion).
        if (field('botcheck')?.value) {
          showSent();
          clearDraft();
          return;
        }

        errorEl.hidden = true;
        if (summary) summary.hidden = true;
        submit.disabled = true;
        submit.classList.add('is-spinning');
        label.textContent = 'Sending...';

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (response.ok) {
            showSent();
            clearDraft();
            announceSent();
          } else {
            failSend();
          }
        } catch (_err) {
          failSend();
        } finally {
          submit.disabled = false;
          submit.classList.remove('is-spinning');
          label.textContent = originalLabel;
        }
      });
    }
    document.addEventListener('astro:page-load', initContactForm);
    initContactForm();
  </script>
</BaseLayout>
