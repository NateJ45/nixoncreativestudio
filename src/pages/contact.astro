---
// Foundation, edit with care. The form structure, the Web3Forms wiring and
// src/scripts/contact.js are the production inquiry pipeline; touch only with
// intent. Copy is safe to edit.
/* ============================================================================
   /contact | Start a project
   ============================================================================
   The job: a qualified inquiry in under two minutes. Posts to Web3Forms.

   One question at a time with the brief phone beside it, when scripts run. The
   markup is one plain form with every field showing, so without JavaScript it
   posts natively (no novalidate in the markup, so the browser checks the
   required fields; the script turns validation over to itself with
   form.noValidate). Web3Forms then redirects to /contact/?sent=1#sent, and the
   success panel shows through CSS :target.

   The form, field by field:
     Required: name, email, org_type (radios), message.
     Optional: budget, as radios whose labels read from the web tier floors in
     src/data/pricing.ts. Then organization, phone, current_website, timeline
     and heard_from on the last step.
     Hidden: access_key, subject, from_name and redirect (Web3Forms), the
     botcheck honeypot, and four origin fields the script fills from the URL:
     from (the page or study that sent the visitor), tier, service and
     origin_org_type (the org type the link carried; the visible radios are
     org_type itself, so the hidden copy takes another name rather than send two
     org_type values).

   With JavaScript (src/scripts/contact.js): validation in plain words, draft
   save and restore, URL prefill, the brief, fetch submit, the same success panel
   with focus on its heading and two studies from the visitor's sector, the error
   panel, and one generate_lead event carrying no field value.

   Prefill: ?org_type picks the radio, ?tier picks the matching budget and fills
   `tier`, ?service fills `service`, ?from fills `from`. Values are checked
   against a slug pattern before use, and a prefill never overrides a restored
   draft.

   Spam protection is the hidden honeypot field (botcheck) alone. To bring
   hCaptcha back: restore the .h-captcha div, the js.hcaptcha.com/1/api.js script
   tag, a captcha gate in the submit handler, and turn hCaptcha back on in the
   Web3Forms dashboard (and name it in /privacy).
   ============================================================================ */

import { getCollection } from 'astro:content';
import '../styles/pages/start.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { webTiers } from '../data/pricing';
import { money } from '../lib/money';
import { SECTOR_LABEL } from '../lib/clients';
import { LOCK, TOOLS } from '../lib/window-chrome';
import { plainText, wordSpans } from '../lib/words';

// Organization types. Same keys as the case-studies `sector` field, so ?org_type
// from a study's closing lines up and the success panel can pick studies from
// the same sector.
const orgTypes = [
  ...Object.entries(SECTOR_LABEL).map(([value, label]) => ({ value, label })),
  { value: 'other', label: 'Something else' },
];

// Budget ranges, built from the three web tier floors in src/data/pricing.ts, so
// a price change there moves them too. The `value`s are what the form submits,
// so they stay fixed even if the numbers move.
const [launchFloor, signatureFloor, flagshipFloor] = webTiers.map((t) => money(t.priceFrom));
const budgets = [
  { value: 'under-4k', label: `Under ${launchFloor}` },
  { value: '4k-7k', label: `${launchFloor} to ${signatureFloor}` },
  { value: '7k-12k', label: `${signatureFloor} to ${flagshipFloor}` },
  { value: '12k-plus', label: `${flagshipFloor} or more` },
  { value: 'not-sure', label: 'Not sure yet' },
];

// ?tier=<name> picks the budget that starts at that tier's floor.
const tierInfo = Object.fromEntries(
  webTiers.map((t, i) => [
    t.name.toLowerCase(),
    { name: t.name, from: money(t.priceFrom), budget: budgets[i + 1]?.value ?? '' },
  ]),
);

const timelines = [
  { value: 'asap', label: 'Right away' },
  { value: '1-3-months', label: 'In the next 1 to 3 months' },
  { value: '3-6-months', label: '3 to 6 months from now' },
  { value: '6-plus', label: 'More than 6 months out' },
  { value: 'flexible', label: 'Flexible, no fixed deadline' },
];

const heardFromOptions = [
  { value: 'referral', label: 'A referral from someone I know' },
  { value: 'search', label: 'Google or another search engine' },
  { value: 'social', label: 'Instagram, LinkedIn, or other social' },
  { value: 'past-client', label: "I've worked with Nathan before" },
  { value: 'event', label: 'In person, at an event or through a church or school' },
  { value: 'other', label: 'Somewhere else' },
];

// What happens next. The reply line is the promise this page already made; do
// not change the timing without Nathan.
const nextSteps = [
  site.replyPromise,
  'If it looks like a fit, a half-hour call to talk it through.',
];

// Case studies, for two things: the brief names the study a visitor came from
// (?from=<slug>), and the success panel links two studies from the visitor's
// sector. Ordered by `order`, the same loop Up next uses.
const studies = (await getCollection('case-studies')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);
const studyNames = Object.fromEntries(studies.map((s) => [s.id, s.data.client]));
// Two studies per sector, padded with the next studies in order when a sector
// has fewer than two. `any` is the default (no sector, or "other").
const pickTwo = (sector?: string) => {
  const own = sector ? studies.filter((s) => s.data.sector === sector) : [];
  const rest = studies.filter((s) => !own.includes(s));
  return [...own, ...rest].slice(0, 2);
};
const successSets = [
  { key: 'any', items: pickTwo() },
  ...orgTypes
    .filter((o) => studies.some((s) => s.data.sector === o.value))
    .map((o) => ({ key: o.value, items: pickTwo(o.value) })),
];

// Web3Forms access key. The PUBLIC_ prefix exposes it to the client at build
// time, which the browser-side form needs.
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const formActive = web3formsKey.length > 0;

// Where Web3Forms sends a no-JS visitor after a successful post. The #sent
// fragment is what shows the success panel without a script (CSS :target).
const redirectUrl = `${site.url}/contact/?sent=1#sent`;

const heading = 'Start a project, or just <b>say hello.</b>';
---

<BaseLayout
  title="Start a project | Nixon Creative Studio"
  description="Tell me about your website, brand or photography project. I read every message myself and reply within one or two business days, with honest next steps."
>
  <div class="st">
    <div class="st-main" data-contact data-state="form">
      <header class="st-head">
        <h1 id="sth" aria-label={plainText(heading)} set:html={wordSpans(heading)} />
        <p class="lede">
          A sentence about your project is enough to get started. If you'd rather{' '}
          <a href={site.emailHref}>email</a> or <a href={site.phoneHref}>call</a>, those work just
          as well.
        </p>
      </header>

      <p class="tier-note" data-tier-note hidden></p>

      <form
        class="card keyed q-form"
        method="post"
        action="https://api.web3forms.com/submit"
        data-contact-form
        data-form
        data-tiers={JSON.stringify(tierInfo)}
        data-studies={JSON.stringify(studyNames)}
        aria-labelledby="sth"
      >
        <span class="pip" aria-hidden="true" data-q-pip>
          1
        </span>
        <span class="pip flip" aria-hidden="true" data-q-pip>
          1
        </span>

        <!-- Web3Forms fields. access_key routes the post to Nathan's inbox, subject
             and from_name label the email, redirect is where a no-JS visitor lands. -->
        <input type="hidden" name="access_key" value={web3formsKey} />
        <input type="hidden" name="subject" value={`New project inquiry from ${site.domain}`} />
        <input type="hidden" name="from_name" value={`${site.studioName} website`} />
        <input type="hidden" name="redirect" value={redirectUrl} />

        <!-- Origin fields. Empty unless the script finds them in the URL. -->
        <input type="hidden" name="from" value="" data-origin="from" />
        <input type="hidden" name="tier" value="" data-origin="tier" />
        <input type="hidden" name="service" value="" data-origin="service" />
        <input type="hidden" name="origin_org_type" value="" data-origin="org_type" />

        <div class="q-count" data-count-box>
          <p data-count>Question 1 of 6</p>
          <span class="q-bar" aria-hidden="true">
            <i data-bar></i>
          </span>
        </div>
        <p class="sr-only" aria-live="polite" data-live></p>

        <div class="q on" data-step="name">
          <label class="q-t" for="name">
            What's your name?
          </label>
          <input
            class="f"
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            aria-describedby="name-err"
          />
          <p class="err" id="name-err" data-err></p>
        </div>

        <div class="q" data-step="email">
          <label class="q-t" for="email">
            What's your email?
          </label>
          <p class="q-h" id="email-h">
            This is where I'll reply.
          </p>
          <input
            class="f"
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            inputmode="email"
            aria-describedby="email-h email-err"
          />
          <p class="err" id="email-err" data-err></p>
        </div>

        <fieldset class="q" data-step="org_type" aria-describedby="org-h org-err">
          <legend class="q-t">What kind of organization is it?</legend>
          <p class="q-h" id="org-h">
            Pick the closest.
          </p>
          <div class="opts">
            {orgTypes.map((o, i) => (
              <label class="opt">
                <input type="radio" name="org_type" value={o.value} required={i === 0} />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
          <p class="err" id="org-err" data-err></p>
        </fieldset>

        <div class="q" data-step="message">
          <label class="q-t" for="message">
            What are you hoping to build?
          </label>
          <p class="q-h" id="msg-h">
            At least a few sentences, please. The more you share, the better I can scope the first
            conversation.
          </p>
          <textarea
            class="f"
            id="message"
            name="message"
            rows="5"
            required
            minlength="30"
            aria-describedby="msg-h message-err"
            placeholder="What you're trying to do and roughly when you'd like to launch."
          ></textarea>
          <p class="enter-h" data-enter-h aria-hidden="true">
            Enter to continue, Shift and Enter for a new line.
          </p>
          <p class="err" id="message-err" data-err></p>
        </div>

        <fieldset class="q" data-step="budget">
          <legend class="q-t">
            What's your budget range? <span class="opt-mark">(optional)</span>
          </legend>
          <div class="opts" data-budgets>
            {budgets.map((b) => (
              <label class="opt">
                <input type="radio" name="budget" value={b.value} />
                <span>{b.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="q q-more" data-step="details">
          <legend class="q-t">A few optional details</legend>
          <p class="q-h">All of these can stay empty.</p>
          <div class="more">
            <div class="m-f">
              <label for="organization">Organization name</label>
              <input
                class="f s"
                type="text"
                id="organization"
                name="organization"
                autocomplete="organization"
              />
            </div>
            <div class="m-f">
              <label for="phone">Phone</label>
              <input
                class="f s"
                type="tel"
                id="phone"
                name="phone"
                autocomplete="tel"
                inputmode="tel"
              />
            </div>
            <div class="m-f">
              <label for="current_website">Current website</label>
              <input
                class="f s"
                type="url"
                id="current_website"
                name="current_website"
                autocomplete="url"
                inputmode="url"
                placeholder="https://"
                aria-describedby="site-err"
              />
              <p class="err" id="site-err" data-err></p>
            </div>
            <div class="m-f">
              <label for="timeline">Project timeline</label>
              <select class="f s" id="timeline" name="timeline">
                <option value="" selected>
                  No preference
                </option>
                {timelines.map((t) => (
                  <option value={t.value}>{t.label}</option>
                ))}
              </select>
            </div>
            <div class="m-f m-w">
              <label for="heard_from">How did you hear about {site.studioName}?</label>
              <select class="f s" id="heard_from" name="heard_from">
                <option value="" selected>
                  Pick one if you'd like
                </option>
                {heardFromOptions.map((h) => (
                  <option value={h.value}>{h.label}</option>
                ))}
              </select>
            </div>
          </div>
        </fieldset>

        <!-- Honeypot. Hidden from sighted users and screen readers; bots tend to fill
             every field, so a filled one is dropped. -->
        <div class="hp" aria-hidden="true">
          <label for="botcheck">Leave this field empty</label>
          <input type="text" id="botcheck" name="botcheck" tabindex="-1" autocomplete="off" />
        </div>

        <div class="q-nav">
          <button type="button" class="b ghost" data-back>
            Back
          </button>
          <button type="button" class="b" data-next>
            Next
          </button>
          <button type="submit" class="b" data-send data-contact-submit>
            <span class="contact-spinner" aria-hidden="true"></span>
            <span data-contact-submit-label>Send</span>
          </button>
        </div>
        {!formActive && (
          <p class="ns">
            The Web3Forms access key is missing. Set <code>PUBLIC_WEB3FORMS_KEY</code> in
            <code>.env</code> locally and in Cloudflare settings before launch.
          </p>
        )}
      </form>

      <!-- Error panel: something went wrong on my end, without red. -->
      <div class="send-err" data-contact-error role="alert" hidden>
        <p>
          Something went wrong on my end. Please try again, or email
          <a href={site.emailHref}>{site.email}</a> directly.
        </p>
      </div>

      <!-- Success panel. Shown when data-state="sent" (the script) or when #sent is the
           URL target (the no-JS redirect). The heading takes focus after a script submit. -->
      <div id="sent" class="card keyed sent" data-sent data-contact-thanks>
        <h2 tabindex="-1" data-sent-h data-contact-thanks-heading>
          Thanks, your message is in.
        </h2>
        <p>
          If you don't hear back, check your spam folder for a reply from {site.domain}, then try
          the email address on this page.
        </p>
        <ol>
          {nextSteps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
        <h3 class="sent-more">While you wait, two sites I built</h3>
        {successSets.map((set) => (
          <div class="sent-links" data-success-studies={set.key} hidden={set.key !== 'any'}>
            {set.items.map((s) => (
              <a class="b ghost" href={`/work/${s.id}/`}>
                {s.data.client}
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>

    <aside class="st-phone" aria-label="Your brief so far" data-phone-wrap>
      <div class="tile brief" data-phone style="--c:#1B1B1A;--p:#fff">
        <span class="b-top" aria-hidden="true">
          <span class="url">
            <span data-lock set:html={LOCK} />
            <span>{site.domain}</span>
          </span>
        </span>
        <div class="scr" data-scr>
          <div class="doc">
            <h2 class="doc-h" id="brief-h">
              Your brief
            </h2>
            <dl class="lines" data-lines></dl>
          </div>
        </div>
        <span class="b-bot" aria-hidden="true" data-tools set:html={TOOLS} />
      </div>
    </aside>
  </div>
  <aside class="direct" aria-label="Other ways to reach me">
    <h2>Rather skip the form? Just email me.</h2>
    <div class="direct-links">
      <a class="b light" href={site.emailHref}>
        {site.email}
      </a>
      <a class="b light" href={site.phoneHref}>
        {site.phone}
      </a>
      {site.bookingUrl && (
        <a
          class="b light"
          href={site.bookingUrl}
          data-cta="book_call_click"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open my calendar
        </a>
      )}
    </div>
    <p>
      {site.replyPromise} {site.firstConversation}
    </p>
  </aside>
  <p class="st-legal">
    <a href="/privacy/">Privacy</a>
    <a href="/accessibility/">Accessibility</a>
    <a href="/colophon/">How this site is built</a>
  </p>
</BaseLayout>

<script>
  import '../scripts/contact.js';
</script>
