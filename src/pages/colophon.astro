---
// Safe to edit. Every line on this page must stay TRUE: it is the studio's
// honest account of how the site is built. If a fact changes (stack, fonts,
// hosting, the accessibility commitment), change it here too.
/* ============================================================================
   /colophon | How this site is made
   ============================================================================
   The classic designer's "house" page: a plain, honest account of the stack,
   the type, and the standards behind the site. Peers read the stack and nod;
   everyone else reads "accessible, fast, private" in plain language. It reads
   quiet and factual, not boastful.

   Tied to the code, so it cannot drift:
     - the Astro and Tailwind versions come from package.json,
     - the page-weight limits come from tests/page-weight.config.json (the
       same file the build's page-weight test reads),
     - "Last updated" is the build date, so it never goes stale.

   Layout: DocumentLayout (overhaul 2.9), shared with /privacy and
   /accessibility. The live parts (overhaul package 3.4) are components in
   src/components/colophon/: the weight slider under Typography, the token
   chips under Color, the grid inspector under The grid and the live
   measurement ledger under Performance. They make no network calls, and the
   ledger's privacy line ("These numbers stay in your browser") must stay
   true with Google Analytics on. The component check page stays at
   /colophon/parts/.
   ============================================================================ */

import DocumentLayout from '../layouts/DocumentLayout.astro';
import pkg from '../../package.json';
import weight from '../../tests/page-weight.config.json';
import LiveColophon from '../components/colophon/LiveColophon.astro';
import WeightSlider from '../components/colophon/WeightSlider.astro';
import TokenChips from '../components/colophon/TokenChips.astro';
import GridInspector from '../components/colophon/GridInspector.astro';

// "^7.4.2" -> "7". The major version is the part a reader cares about.
const major = (range: string | undefined) => range?.replace(/^[^\d]*/, '').split('.')[0] ?? '';
const astroMajor = major(pkg.dependencies.astro);
const tailwindMajor = major(pkg.dependencies.tailwindcss);

const { maxScriptKb, maxImagesKb } = weight.defaults;

// Build-time stamp. This is about the SITE (when it was last built), not any
// project's timing, so it is fine to show.
const lastBuilt = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(new Date());

const sections = [
  { id: 'built-with', label: 'Built with' },
  { id: 'typography', label: 'Typography' },
  { id: 'color', label: 'Color' },
  { id: 'grid', label: 'The grid' },
  { id: 'accessibility', label: 'Accessibility' },
  { id: 'performance', label: 'Performance' },
  { id: 'screenshots', label: 'Screenshots' },
  { id: 'privacy', label: 'Privacy' },
];
---

<DocumentLayout
  title="Colophon: how this site is built | Nixon Creative Studio"
  description="How I built this site: the framework, the hosting, the typefaces, and the accessibility, speed and privacy standards I hold it to before anything ships."
  tag="Colophon"
  lead="How this site is"
  heavy="made."
  updated={lastBuilt}
  sections={sections}
  headingId="colophon-heading"
  closer={{ heading: 'Want a site built', emphasis: 'the same way?' }}
>
  <p slot="intro">
    How this site is made, and the standards behind it. Custom-built, so the same care that goes
    into client work goes into my own.
  </p>

  <h2 id="built-with">Built with</h2>
  <p>
    Custom-coded in Astro {astroMajor} with TypeScript, styled with Tailwind CSS {tailwindMajor},
    and deployed to Cloudflare. Every page is built ahead of time as plain HTML, and the case
    studies are text files that live with the code. No page builder, no stock template, no lock-in.
  </p>

  <h2 id="typography">Typography</h2>
  <p>
    Headings are set in Bricolage Grotesque, light with a heavy phrase, and everything else in
    Source Sans 3. The wordmark at the top is Bebas Neue. All three are self-hosted, so nothing
    loads from a third party.
  </p>
  <p>
    Weight is how the site says what matters: a light lead and a heavy phrase. Drag the slider to
    see Bricolage move through its whole range, from 200 to 800.
  </p>
  <WeightSlider />

  <h2 id="color">Color</h2>
  <p>
    White, a pale paper and a deep navy ink, split by thin hairlines. Blue is kept for things you
    can click, and amber means live. These are the tokens the site is painted with, read from this
    page as you look at it, so they change when you switch between light and dark.
  </p>
  <TokenChips />

  <h2 id="grid">The grid</h2>
  <p>
    Every page sits on one 12-column grid. Labels hang in the first three columns, running text
    takes columns 4 to 10 so a line never gets too long to read, and wider things run to 12. Turn
    the grid on to see it over this page; links under it still work.
  </p>
  <GridInspector />

  <h2 id="accessibility">Accessibility</h2>
  <p>
    Built toward WCAG AA and checked automatically on every deploy. In plain terms: it works with a
    keyboard, with a screen reader, and in light or dark. There is a fuller statement on the{' '}
    <a href="/accessibility/">accessibility page</a>.
  </p>

  <h2 id="performance">Performance</h2>
  <p>
    Every page is static HTML, images are optimized at build time, and the fonts ship with the site,
    so it stays fast on a phone and a slow connection.
  </p>
  <p>Here is this page, measured as it loaded for you:</p>
  <LiveColophon />
  <p>
    A test fails the build if a page ships more than {maxScriptKb} KB of script or {maxImagesKb} KB
    of images. The few pages that show more client work, like the homepage, have their own
    written-down limit instead.
  </p>

  <h2 id="screenshots">Screenshots</h2>
  <p>
    Every client site shown here is a real, live site. The screenshots are captured from the live
    pages by a script that lives with the code, not mocked up.
  </p>

  <h2 id="privacy">Privacy</h2>
  <p>
    Two analytics tools: Cloudflare's, which sets no cookies, and Google Analytics, with its
    advertising features left off. No advertising trackers. The <a href="/privacy/">privacy page</a>{' '}
    lists everything the site collects.
  </p>
  <p>
    The measurements in the Performance section are read by a small script in your browser. It makes
    no network request and stores nothing, so these numbers stay in your browser.
  </p>
</DocumentLayout>
