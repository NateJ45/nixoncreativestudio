---
/* /colophon: must stay true of the code: fonts, hosting, analytics, colors. */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/legal.css';
import '../styles/pages/colophon.css';
import Closing from '../components/Closing.astro';
import Tile from '../components/Tile.astro';
import Caption from '../components/Caption.astro';
import { getClients } from '../lib/clients';
import { plainText, wordSpans } from '../lib/words';

// Every client's window, stacked in the side column. colophon-deck.js shows one at a time and
// moves to the next every few seconds; with no script only the first shows.
const clients = await getClients();
const heading = `How this site is <b>made.</b>`;
// The build date, printed when the site is built (the deploy runs the build), so the live rows
// below have one fact that needs no script.
const built = new Date();
const builtText = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'America/New_York',
}).format(built);
---

<BaseLayout
  title="Colophon: how this site is built | Nixon Creative Studio"
  description="How I built this site: the framework, the hosting, the typefaces, and the accessibility, speed and privacy standards I hold it to before anything ships."
>
  <header class="page-head">
    <h1 aria-label={plainText(heading)} set:html={wordSpans(heading)} />
    <p class="lede">
      How this site is made, and the standards behind it. Custom-built, so the same care that goes
      into client work goes into my own.
    </p>
    <p class="updated">Last updated November 15, 2026</p>
  </header>
  <div class="doc">
    <nav class="toc card" aria-label="On this page">
      <p>On this page</p>
      <ul>
        <li>
          <a href="#built-with">Built with</a>
        </li>
        <li>
          <a href="#typography">Typography</a>
        </li>
        <li>
          <a href="#color">Color</a>
        </li>
        <li>
          <a href="#accessibility">Accessibility</a>
        </li>
        <li>
          <a href="#performance">Performance</a>
        </li>
        <li>
          <a href="#right-now">This page, right now</a>
        </li>
        <li>
          <a href="#screenshots">Screenshots</a>
        </li>
        <li>
          <a href="#privacy">Privacy</a>
        </li>
      </ul>
    </nav>
    <div class="prose">
      <h2 id="built-with">Built with</h2>
      <p>
        Custom-coded in Astro 7 with TypeScript, and deployed to Cloudflare. Every page is built
        ahead of time as plain HTML, and the case studies are text files that live with the code. No
        page builder, no stock template, no lock-in.
      </p>
      <h2 id="typography">Typography</h2>
      <p>Everything is set in Hanken Grotesk, served from this site, not from a font service.</p>
      <h2 id="color">Color</h2>
      <p>
        A near-white page, near-black ink and one blue of my own, for headlines, buttons, one price
        card and the closing panel. Every other color on the site is a client's, inside the window,
        sheet or section that shows their work.
      </p>
      <h2 id="accessibility">Accessibility</h2>
      <p>
        Built to WCAG 2.2 AA and checked automatically on every deploy. In plain terms: it works
        with a keyboard and with a screen reader. There is a fuller statement on the{' '}
        <a href="/accessibility/">accessibility page</a>.
      </p>
      <h2 id="performance">Performance</h2>
      <p>Every page is static HTML, so it stays fast on a phone and a slow connection.</p>
      {/* Live facts about this page, measured in the visitor's browser (src/scripts/colophon.js).
           The build row is printed at build; the rest need the script and hide without it. */}
      <h2 id="right-now">This page, right now</h2>
      <p>
        Measured in your browser as this page loaded, so these are true of your visit, not numbers I
        typed in.
      </p>
      <dl class="colo-live" data-live>
        <div class="colo-m">
          <dt class="label">Transferred</dt>
          <dd>
            <span data-roll data-live-kb>
              0
            </span>{' '}
            KB
          </dd>
        </div>
        <div class="colo-m">
          <dt class="label">Requests</dt>
          <dd>
            <span data-roll data-live-req>
              0
            </span>
          </dd>
        </div>
        <div class="colo-m">
          <dt class="label">Fonts in use</dt>
          <dd data-live-fonts>Measuring</dd>
        </div>
        <div class="colo-m">
          <dt class="label">Theme</dt>
          <dd data-live-theme>Measuring</dd>
        </div>
        <div class="colo-m">
          <dt class="label">Motion</dt>
          <dd data-live-motion>Measuring</dd>
        </div>
        <div>
          <dt class="label">Built</dt>
          <dd>
            <time datetime={built.toISOString()}>{builtText}</time>
          </dd>
        </div>
      </dl>
      <p class="colo-live-note">
        A file your browser already had costs nothing to fetch, so a second visit reads lighter.
      </p>
      <p class="colo-live-off">
        The other rows are measured by a small script, and scripts are off, so only the build date
        shows.
      </p>
      <h2 id="screenshots">Screenshots</h2>
      <p>
        Every client site shown here is a real, live site. The screenshots and footage are captured
        from the live pages by a script that lives with the code, not mocked up.
      </p>
      <h2 id="privacy">Privacy</h2>
      <p>
        Two analytics tools: Cloudflare's, which sets no cookies, and Google Analytics, with its
        advertising features left off. No advertising trackers. The{' '}
        <a href="/privacy/">privacy page</a> lists everything the site collects.
      </p>
    </div>
    <div class="colo-win" data-colo-win>
      <div class="colo-deck">
        {clients.map((c, i) => (
          <div class="colo-slide" data-colo-slide inert={i > 0 ? true : undefined}>
            <Tile client={c} lazy={i > 0} />
            <Caption client={c} />
          </div>
        ))}
      </div>
      <button class="colo-hold label" type="button" aria-pressed="false" data-colo-hold hidden>
        Pause
      </button>
    </div>
  </div>
  <Closing lead="Want a site built <b>the same way?</b>" />
</BaseLayout>

<script>
  import { ui } from '../scripts/kit.js';
  import '../scripts/colophon.js';
  import '../scripts/colophon-deck.js';
  /* Hover plays the window in front. Touch skips the play-on-scroll: the stacked windows all sit
     at the middle together, and the deck already moves. */
  if (!matchMedia('(hover: none)').matches)
    ui.wireFootage(document.querySelector('[data-colo-win]'));
</script>
