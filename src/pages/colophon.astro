---
// Foundation, edit with care. The words on this page are the "Colophon" entry of
// "Other pages" in the EmDash admin (Pages group), not this file. Every line must
// stay TRUE: it is the studio's honest account of how the site is built. If a fact
// changes (stack, fonts, hosting, the accessibility commitment), change it in the
// entry too. Those facts are tied to the code and the hosting, so a developer
// checks them.
/* ============================================================================
   /colophon | How this site is made
   ============================================================================
   The classic designer's "house" page: a plain, honest account of the stack, the
   type, and the standards behind the site. It is the home for the technical-craft
   signal (peers read the stack and nod; non-technical visitors read "accessible,
   fast, private, photographed by Nathan" in plain language and feel reassured). It
   deliberately reads quiet and factual, not boastful.

   Since CMS-DESIGN PR 10 the headline, lead paragraph and label/detail rows live in
   the CMS (getProsePage() in src/lib/prosePage.ts, committed fallback
   cms/content/pages.json) and src/components/ProsePage.astro draws them. The "Last
   built" row stays here: it is stamped at render time (the page is route-cached
   for a few minutes), so it can never go stale and is not something to type.
   ============================================================================ */

import ProsePage from '../components/ProsePage.astro';
import { getProsePage } from '../lib/prosePage';

const page = await getProsePage('colophon', Astro);

// Render-time stamp. This is about the SITE (when it was last served from a fresh
// build), not about any project's timing, so it is fine to show.
const lastBuilt = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' }).format(
  new Date(),
);
---

<ProsePage page={page} extraRows={[{ label: 'Last built', detail: lastBuilt }]} />
