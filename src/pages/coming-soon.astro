---
// Safe to edit. Standalone "coming soon" landing page. Always live, even when
// PUBLIC_COMING_SOON is unset, useful for previewing the page without flipping
// the site-wide gate.
/* ============================================================================
   /coming-soon | Coming Soon landing
   ============================================================================
   Renders the ComingSoon component as the entire body. Uses its own minimal
   HTML doc rather than BaseLayout, for full isolation from the dock and closing.

   When PUBLIC_COMING_SOON=true is set at build time, every other route on the
   site also renders this same component (see BaseLayout). To take the site
   live, unset the env var in Cloudflare and redeploy.
   ============================================================================ */

import '../styles/kit.css';
import { site } from '../data/site';
import ComingSoon from '../components/ComingSoon.astro';

const title = `${site.studioName} | Launching soon`;
const description = `${site.studioName} is one person in ${site.address}: web design anywhere, photography across the region. The new site opens soon.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/hanken.woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site.url}/coming-soon/`} />
    <meta property="og:image" content={`${site.url}/og-default.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <main>
      <ComingSoon />
    </main>
  </body>
</html>
