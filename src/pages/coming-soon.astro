---
// Safe to edit. Standalone "coming soon" landing page. Always live, even
// when PUBLIC_COMING_SOON is unset, useful for previewing the page
// without flipping the site-wide gate.
/* ============================================================================
   /coming-soon | Coming Soon landing
   ============================================================================
   Renders the ComingSoon component as the entire body. Uses its own
   minimal HTML doc rather than BaseLayout because the goal is full
   isolation from the WIP nav and footer: visitors should see one
   focused page with the logo, a short pitch, and direct contact
   options. It is noindex and is not in the sitemap.

   When PUBLIC_COMING_SOON=true is set at build time, every other route
   on the site also renders this same component (see BaseLayout). To
   take the site live, unset the env var (Cloudflare Pages > Settings >
   Variables) and redeploy.
   ============================================================================ */

import '../styles/globals.css';
import { getSite, SITE_URL } from '../data/site';
import ComingSoon from '../components/ComingSoon.astro';
import { cachePublicPage } from '../lib/routeCache';
// The same files globals.css's @font-face points at, so each preload and the
// stylesheet's own fetch are one request (see BaseLayout).
import bebasWoff2 from '../assets/fonts/bebas-neue-latin-400.woff2?url';
import newsreaderWoff2 from '../assets/fonts/newsreader-latin-400.woff2?url';
import newsreaderItalicWoff2 from '../assets/fonts/newsreader-latin-400-italic.woff2?url';

// Standalone document (no BaseLayout), so it opts into the route cache itself.
cachePublicPage(Astro.cache, Astro.url);

// Studio name and location come from Site settings in the CMS (with the fallback).
const site = await getSite(Astro);

const title = `${site.studioName} | Launching soon`;
const description = `${site.studioName} is a small studio in ${site.address}: strategy-led web design and brand work for clients anywhere, plus photography across the Cincinnati region. The new site launches soon.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    {/* Keep the gate page out of search: it is a pre-launch holding page, not content
        (and it is not in the sitemap). */}
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#e8dfcf" />

    <link rel="preload" as="font" type="font/woff2" href={bebasWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={newsreaderWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={newsreaderItalicWoff2} crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${SITE_URL}/coming-soon/`} />
    <meta property="og:image" content={`${SITE_URL}/og-default.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <ComingSoon />
    {/* The grounds script attaches the wall texture after load and pauses the light
        off screen; the mailto fallback copies the address when no mail app opens. */}
    <script>
      import '../scripts/grounds';
      import '../scripts/mailto-fallback';
    </script>
  </body>
</html>
