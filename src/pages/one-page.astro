---
/* /one-page: the summary a staff member can send to a board or committee. It answers, in
   order: what I do, the three tiers (who each fits, the usual price, what I take on), what it
   costs over five years (Hosting first, then with care; Flagship only with care, because custom
   tools need it), what Hosting and care cover, what is in every build, what happens if you move
   on, and how to reach me. Every price and sum reads src/data/pricing.ts and
   src/lib/tier-costs.ts, and the date reads `pricesAsOf`.

   The sheet prints on one US Letter page: src/styles/pages/one-page.css has the print
   stylesheet, and tests/one-page.spec.ts prints it and counts the pages. Keep it to what
   fits. Anything new here means something else comes out. */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/one-page.css';
import Closing from '../components/Closing.astro';
import { carePlans, customWorkRate, freeToMove, perWords, pricesAsOf } from '../data/pricing';
import { site } from '../data/site';
import { money } from '../lib/money';
import { tierCosts } from '../lib/tier-costs';

const costs = tierCosts();
const [hosting, lightCare, care, carePlus] = carePlans;
const perUnit = (period: string) => perWords(period).replace(/^a /, 'per ');
const servicesUrl = `${site.domain}/services/`;
// "Usually $3,500 to $6,000", or for a tier quoted by scope, its own range line.
const usually = (t: (typeof costs)[number]['tier']) =>
  t.rangeTo ? `Usually ${money(t.priceFrom)} to ${money(t.rangeTo)}` : t.range;
---

<BaseLayout
  title="A one-page summary | Nixon Creative Studio"
  description="What I do, the three website tiers, what they cost over five years, what Hosting and care cover, and how to reach me, on one page to print or forward."
>
  <div class="op-page">
    <div class="op-bar" data-op-bar>
      <button type="button" class="chip go" data-print>
        Print or save as PDF
      </button>
      <p>For a board or committee. It prints on one Letter page.</p>
    </div>

    <article class="op-sheet">
      <header class="op-head">
        <div>
          <p class="label">{site.studioName}</p>
          <h1>Websites, and what they cost</h1>
          <p class="op-date">Prices as of {pricesAsOf}</p>
        </div>
        <p class="op-reach">
          <b>{site.ownerName}</b>
          <a href={site.emailHref}>{site.email}</a>
          <a href={site.smsHref}>Text {site.phone}</a>
          <span>{`${site.domain}, ${site.address}`}</span>
        </p>
      </header>

      <section aria-labelledby="op-do">
        <h2 id="op-do">What I do</h2>
        <p>
          I plan, design and build websites for churches, schools, nonprofits and small businesses,
          on my own, so you always talk to the person doing the work. Every site is custom, with an
          editor and a written guide for your people, and works for people with disabilities.
        </p>
      </section>

      <section aria-labelledby="op-tiers">
        <h2 id="op-tiers">Three sizes of website</h2>
        <ul class="op-tiers">
          {costs.map(({ tier }, i) => (
            <li class:list={['op-tier', `op-t${i}`]}>
              <h3>{tier.name}</h3>
              <p class="op-price">
                {`${money(tier.priceFrom)}${tier.priceSuffix}`} <small>one-time</small>
              </p>
              <p class="op-range">
                {usually(tier)}
                {tier.needsCare && (
                  <span class="op-need">
                    {`Custom tools need ${tier.needsCare} or ${carePlus.name}.`}
                  </span>
                )}
              </p>
              <p>
                <b>Who it fits.</b> {tier.fits}
              </p>
              <p>
                <b>What I take responsibility for.</b> {tier.responsible}
              </p>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="op-cost">
        <table class="op-table">
          <caption id="op-cost">
            <span class="op-cap">What it costs over five years</span>
            {`Totals from each tier's starting price: ${hosting.name} only first, then with care on top.`}
          </caption>
          <thead>
            <tr>
              <th scope="col">Tier, and what you pay after launch</th>
              <th scope="col" class="n">
                First year, build and hosting
              </th>
              <th scope="col" class="n">
                Total after 3 years
              </th>
              <th scope="col" class="n">
                Total after 5 years
              </th>
            </tr>
          </thead>
          {costs.map((c) => (
            <tbody>
              {c.rows.map((r) => (
                <tr>
                  <th scope="row">
                    <b>{c.tier.name}</b>
                    <span>
                      {r.withCare
                        ? `plus ${r.plan.name}, ${r.plan.price} ${perUnit(r.plan.period)}`
                        : `${hosting.name} only, ${hosting.price} ${perUnit(hosting.period)}`}
                    </span>
                  </th>
                  <td class="n" data-label="First year">
                    {money(r.yearOne)}
                  </td>
                  <td class="n" data-label="After 3 years">
                    {money(r.threeYears)}
                  </td>
                  <td class="n" data-label="After 5 years">
                    {money(r.fiveYears)}
                  </td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
        <p class="op-note">
          {`Each total is the tier's starting price, plus ${hosting.name} at ${hosting.price} ${perWords(hosting.period)} from year two, plus the care plan shown, billed monthly from launch.`}
        </p>
      </section>

      <section class="op-cover" aria-labelledby="op-care">
        <h2 id="op-care">What Hosting and care cover</h2>
        <dl>
          <div>
            <dt>
              {`${hosting.name}, ${hosting.price} ${perUnit(hosting.period)}`}
              <small>free in year one; every live site needs it</small>
            </dt>
            <dd>{hosting.short}</dd>
          </div>
          {[lightCare, care, carePlus].map((p) => (
            <div>
              <dt>
                {`${p.name}, ${p.price} ${perUnit(p.period)}`}
                <small>{`optional, on top of ${hosting.name}`}</small>
              </dt>
              <dd>{p.short}</dd>
            </div>
          ))}
        </dl>
        <p class="op-note">
          {`Extra changes are ${money(lightCare.rate)} an hour on any care plan. Custom development is ${money(customWorkRate)} an hour, quoted first.`}
        </p>
      </section>

      <div class="op-three">
        <section aria-labelledby="op-every">
          <h2 id="op-every">In every build</h2>
          <ul>
            <li>A planning session and a brief, before design</li>
            <li>A custom design, built for phones first</li>
            <li>Accessibility checked (WCAG 2.2 AA)</li>
            <li>An editor, and a guide for your people</li>
            <li>Year one hosting included</li>
            <li>A first month close by after launch</li>
          </ul>
        </section>
        <section aria-labelledby="op-keep">
          <h2 id="op-keep">If you ever move on</h2>
          <ul>
            {freeToMove.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </section>
        <section aria-labelledby="op-reach">
          <h2 id="op-reach">How to reach me</h2>
          <p>{`Text ${site.phone} or email ${site.email}. ${site.firstConversation}`}</p>
          <p class="op-note">{`Prices as of ${pricesAsOf}. More detail: ${servicesUrl}`}</p>
        </section>
      </div>
    </article>
  </div>

  <Closing lead="Have a question the page didn't <b>answer?</b>" />
</BaseLayout>

<script>
  import '../scripts/one-page.js';
</script>
