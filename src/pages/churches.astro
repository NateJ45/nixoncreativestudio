---
/* /churches: the sector page. As you read the four points, the church's real
   phone page scrolls along in its window (src/scripts/churches.js). The two
   studies, their outcomes and the quotes all come from the case studies. Title
   and description live in src/data/sector-pages.ts with the sector path. */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/sector.css';
import '../styles/pages/churches.css';
import Tile from '../components/Tile.astro';
import Caption from '../components/Caption.astro';
import DealtPrices from '../components/DealtPrices.astro';
import Closing from '../components/Closing.astro';
import { getClients, toClient, type Client } from '../lib/clients';
import { CHURCHES } from '../data/sector-pages';
import { site } from '../data/site';
import { webTiers } from '../data/pricing';
import { SITUATIONS } from '../data/sector-pages';
import { money } from '../lib/money';
import { plainText, wordSpans } from '../lib/words';

const clients = await getClients();
const bySlug = (slug: string) => clients.find((c) => c.slug === slug) as Client;
const entries = (await getCollection('case-studies')).filter(
  (e) => e.data.sector === CHURCHES.sector,
);
const places = ['Muncie, Indiana', 'Orangeburg, South Carolina'];

// The four questions, and where each answer sits on the church's real phone page,
// in pixels of the 560-wide capture (one phone screen is about 1,090 of them).
// Each answer says in words where it was found, so the reader does not have to
// read the picture: `where` is how far down, `a` is what is there. They name the
// page's own headings, not the church's details, so they stay true when the times
// or the sermon change.
const sunday = [
  {
    q: 'When is it, and where?',
    where: 'Found it on the first screen,',
    a: 'under Sundays and Where, before anything else.',
    stop: 170,
  },
  {
    q: 'What happens when I walk in?',
    where: 'Found it about 1 scroll down,',
    a: 'under What to expect: who meets you and where they point you.',
    stop: 1370,
  },
  {
    q: 'How does the morning run?',
    where: 'Found it about 1 scroll down,',
    a: 'under What to expect: the whole morning in order, with the times.',
    stop: 1500,
  },
  {
    q: 'What about my kids?',
    where: 'Found it about 2 scrolls down,',
    a: 'in the note on nursery care, before you have to ask anyone.',
    stop: 1700,
  },
];
const studies = entries
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map((entry) => ({
    entry,
    s: toClient(entry),
    t:
      entry.data.testimonials?.find((q) => q.name.includes('Kendall Ellis')) ??
      entry.data.testimonials?.[0],
  }));
const n = entries.length;
// Which tier usually fits, the same list the lean sector pages carry (SectorLean.astro), from the
// church row of SITUATIONS. Situations only: no church is tied to a tier here.
const situation = SITUATIONS.find((row) => row.sector === CHURCHES.sector);
const fits = situation
  ? webTiers.map((tier, i) => ({
      tier,
      text: [situation.launch, situation.signature, situation.flagship][i],
    }))
  : [];
const path = `/${CHURCHES.path}/`;
const canonical = new URL(path, site.url).toString();
const schemas = [
  {
    '@type': 'ItemList',
    '@id': `${canonical}#studies`,
    name: 'Church website case studies',
    numberOfItems: n,
    itemListElement: studies.map(({ s }, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(s.study, site.url).toString(),
      name: s.name,
    })),
  },
];
const heading = `Church websites, starting with <b>the first Sunday.</b>`;
---

<BaseLayout
  title={`${CHURCHES.title} | ${site.studioName}`}
  description={CHURCHES.description.replace('{n}', String(n))}
  breadcrumbs={[{ name: CHURCHES.label, path }]}
  pageType="CollectionPage"
  schemas={schemas}
>
  <div class="ch" data-ch>
    <header class="ch-head">
      <h1 id="h" aria-label={plainText(heading)} set:html={wordSpans(heading)} />
      <p class="lede">
        Every church site I build starts with the person who has never been inside: when the service
        is, how to get there, and what happens when they walk in. Then it has to work for the people
        who keep it running, so the staff can post the week’s news without waiting on a developer.
      </p>
      <div class="ch-links">
        <a class="chip ink" href="/contact/">
          Start a project
        </a>
        <a class="chip soft" href="/work/?sector=church">
          See the church case studies
        </a>
      </div>
    </header>

    <div class="stand a" data-stand="first-baptist-muncie">
      <Tile
        client={bySlug('first-baptist-muncie')}
        long="/assets/churches/first-baptist-muncie-long.webp"
      />
      <Caption client={bySlug('first-baptist-muncie')} />
    </div>

    <h2 class="ch-job" data-job>
      What a church site has to do
    </h2>
    <article class="pt p1" data-pt>
      <div class="pt-in">
        <h3>Make the first visit easy</h3>
        <p>
          A first-time visitor should know the time, the place and how the morning runs before they
          arrive. So the service times, the address and a plain what-to-expect page come first,
          ahead of everything the members already know.
        </p>
      </div>
    </article>
    <article class="pt p2" data-pt>
      <div class="pt-in">
        <h3>Let the staff run it</h3>
        <p>
          I match the site to whoever keeps it up after launch. One church got a custom build where
          the staff edit the pages and see each change before it goes live. Another got Wix, because
          its communications team wanted to own every page. Either way, the bulletin, the events and
          the news go up without me.
        </p>
      </div>
    </article>

    <div class="stand b" data-stand="first-presbyterian-orangeburg">
      <Tile
        client={bySlug('first-presbyterian-orangeburg')}
        long="/assets/churches/first-presbyterian-orangeburg-long.webp"
        lazy
      />
      <Caption client={bySlug('first-presbyterian-orangeburg')} />
    </div>

    <article class="pt p3" data-pt>
      <div class="pt-in">
        <h3>Cover the rest of the week</h3>
        <p>
          A church building is busy all week, and a church has a history worth keeping. On the sites
          below that meant one form for booking the building, a page about the building itself, and
          an old blog brought across with every post at its address.
        </p>
      </div>
    </article>
    <article class="pt p4" data-pt>
      <div class="pt-in">
        <h3>Open to everyone</h3>
        <p>
          Every custom build is checked against the accessibility standard most public bodies use
          (WCAG 2.2 AA), so people who use screen readers or have poor eyesight can use it too. That
          work is part of the price, not an extra. For a church it is simply the right thing to do.
        </p>
      </div>
    </article>
  </div>

  <section class="sec sun" aria-labelledby="sun-h" data-sun>
    <div class="sun-in">
      <div class="sun-say">
        <p class="label">Try it</p>
        <h2 id="sun-h">
          Ask what a <b>first-time visitor</b> asks.
        </h2>
        <p class="sun-lede">
          This is the real First Baptist Muncie homepage on a phone. Tap a question and the page
          scrolls to its answer, so you can see how far a visitor would have to look.
        </p>
      </div>
      {/* On a phone the picture comes before the questions (the grid areas in churches.css), so a
          tap never changes something hidden below the fold or behind the dock. */}
      <div class="sun-ask">
        <p class="label sun-hint" id="sun-hint">
          Tap a question
        </p>
        <ul class="sun-qs" aria-labelledby="sun-hint">
          {sunday.map((q, i) => (
            <li>
              <button type="button" data-sun-q={q.stop} aria-pressed={i === 0 ? 'true' : 'false'}>
                <span>{q.q}</span>
                <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                  <path d="M7.5 4.5 13 10l-5.5 5.5" />
                </svg>
              </button>
              <p class="sun-a" data-sun-a>
                <b>{q.where}</b> {q.a}
              </p>
            </li>
          ))}
        </ul>
      </div>
      <div class="sun-w" data-sun-w>
        <Tile
          client={bySlug('first-baptist-muncie')}
          long="/assets/churches/first-baptist-muncie-long.webp"
          lazy
        />
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="sh">
    <div class="wrap">
      <div class="big">
        <h2 id="sh" class="giant" data-weigh data-build style="--fit:10;--fitm:17.2">
          <span>Churches</span> <span>I have built for</span>
        </h2>
      </div>
      <div class="ledger">
        <ul class="label">
          {places.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
        <p>
          <a href="/work/">See all the case studies</a>
        </p>
      </div>
      <ul class="ch-studies">
        {studies.map(({ s, entry, t }) => (
          <li class="study" style={`--c:${s.accent};--c-night:${s.night};--p:${s.paper}`}>
            <div class="study-w">
              <Tile client={s} lazy />
            </div>
            <div class="study-t">
              <h3>{s.name}</h3>
              <p class="hook">{s.hook}</p>
              <p class="out">{entry.data.outcome}</p>
              {t && <blockquote>{t.quote}</blockquote>}
              {t && (
                <p class="by">
                  <b>{t.name}</b>
                  {t.title}
                  {t.context && <span class="ctx">{t.context}</span>}
                </p>
              )}
              <div class="study-links">
                <a class="chip" href={s.study}>
                  Read the case study
                </a>
                <a class="chip ghost" href={s.live} rel="noopener" data-cta="visit_client_site">
                  Visit {s.host}
                </a>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec tight" aria-labelledby="ch-tier">
    <div class="wrap">
      <h2 id="ch-tier" class="sl-h">
        Which tier usually fits
      </h2>
      <ul class="sl-tiers">
        {fits.map(({ tier, text }) => (
          <li>
            <h3>
              <a href={`/services/#${tier.name.toLowerCase()}`}>{tier.name}</a>
            </h3>
            <p>{text}</p>
            <p class="sl-from">From {money(tier.priceFrom)}</p>
          </li>
        ))}
      </ul>
      <div class="sl-after">
        <p>
          See <a href="/services/#costs">what each tier costs over five years</a>, or forward
          <a href="/one-page/">a one-page summary</a> to whoever has to say yes.
        </p>
      </div>
    </div>
  </section>

  <DealtPrices />

  <Closing lead="Building for a <b>church?</b>" />
</BaseLayout>

<script>
  import '../scripts/churches.js';
</script>
