---
// Foundation, edit with care. The words on this page are the "Privacy" entry of
// "Other pages" in the EmDash admin (Pages group), not this file.
/* ============================================================================
   /privacy | Privacy notice
   ============================================================================
   Short, honest accounting of what the site collects: the contact form, the
   Cloudflare analytics beacon, Google Analytics 4 (it sets first-party cookies,
   so the Analytics and Cookies sections name it and link the opt-out), the
   embedded Google Map, server logs. No marketing pixels, no advertising trackers.
   Keep every claim TRUE: if what the site collects changes, update the entry (and
   its "last updated" date) the same day.

   Since CMS-DESIGN PR 10 the text lives in the CMS (getProsePage() in
   src/lib/prosePage.ts, committed fallback cms/content/pages.json, schema
   cms/schema/pages.mjs) and src/components/ProsePage.astro draws it: the "On this
   page" list and the scroll-spy come from the body's Heading 2s. The section ids
   (#contact-form, #analytics, #server-logs, #cookies, #your-data, #changes) are the
   slugs of those headings, so inbound links keep working.
   ============================================================================ */

import ProsePage from '../components/ProsePage.astro';
import { getProsePage } from '../lib/prosePage';

const page = await getProsePage('privacy', Astro);
---

<ProsePage page={page} />
