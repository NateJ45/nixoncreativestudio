---
// Safe to edit (copy). The gate lives in src/data/photography-gate.ts.
/* ============================================================================
   /photography | Photography and film  [the light table]
   ============================================================================
   Every photo and short film in the `photos` collection (src/content/photos),
   laid out as prints on an endless light table you can move around in any
   direction: drag, scroll, the arrow keys, or the buttons under it. The table
   repeats, so there is no edge. A film plays when it comes near the middle.
   A print opens into a full view with its story, and Previous / Next walk the
   table in order.

   The table has depth and light: columns slide at different speeds, prints
   ease smaller toward the corners, a lamp follows the mouse, the table takes
   the colour of the print in its middle (src/data/photo-colors.json, written
   by `npm run photo-colors`), and it zooms and fills the screen. All of that
   is in src/scripts/photo-table.js, and none of it is needed to see a photo.

   Around the table (2026-11-13): a hero frame (the featured photo) that opens
   the page, a strip of the films, a Films filter (the page opens on everything;
   the Selects filter went 2026-11-14), a tour, a colour order, an address for every print
   (?print=<slug>), a set strip, a link to the client's case study and a booking
   card in the full view, and "What I shoot" rows that lead to their filter.
   The page shows no dates anywhere.

   Motion first (prototype, 2026-11-14): the hero is a silent reel cut from the
   best graded films; "Whole days" tells one shoot per chapter (CHAPTERS in
   src/lib/photo-table.ts); "Everything" opens on the grid with the films playing
   in place, and the light table is one press away (or ?view=table). The film
   strip went; "How a shoot works" follows "What I shoot", then "The kit"
   (src/data/photo-kit.ts): camera, lenses with a frame shot on each, gimbal, software.

   Real markup first. The server prints a plain grid of links (each one to its
   full-size image), the filter bar and an empty full-view dialog. Without
   JavaScript that grid IS the gallery. src/scripts/photo-table.js lays the
   same prints out on the table and swaps the grid out; "Grid" in the view
   switch brings it back, which is also the way through for a screen reader.

   The gate. While the collection holds fewer than MIN_PHOTOS photos the page
   is noindex, out of the sitemap and out of the closing's index (see
   src/data/photography-gate.ts). With the table filled it is open.

   Order, filters and the words on each print: src/lib/photo-table.ts.
   ============================================================================ */

import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/photography.css';
import Closing from '../components/Closing.astro';
import { photographyOpen } from '../data/photography-gate';
import { addOns } from '../data/pricing';
import { addOnNamed } from '../lib/schema';
import { plainText, wordSpans } from '../lib/words';
import {
  dealOrder,
  filtersFor,
  printLine,
  inFilter,
  SETS,
  STUDY_FOR_CLIENT,
  BOOKING_EVERY,
  CHAPTERS,
  chapterFrames,
} from '../lib/photo-table';
import photoColors from '../data/photo-colors.json';
import {
  CAMERA,
  GIMBAL,
  LENSES,
  SOFTWARE,
  fovDeg,
  focalLabel,
  yearsShooting,
  LIGHTING,
} from '../data/photo-kit';
import reelPoster from '../assets/photography/reel-poster.jpg';

const photography = addOnNamed(addOns, 'Photography');
const all = await getCollection('photos');
const open = photographyOpen(all.length);

// One print per entry, in the dealt order, with the two sizes the table needs:
// a small one for the table and the grid, a large one for the full view.
const dealt = dealOrder(all.map((e) => ({ slug: e.id, ...e.data })));
const prints = await Promise.all(
  dealt.map(async (p, i) => {
    const small = await getImage({ src: p.image, width: 560, format: 'webp', quality: 72 });
    const large = await getImage({
      src: p.image,
      widths: [1100, 1800],
      format: 'webp',
      quality: 80,
    });
    return {
      i,
      slug: p.slug,
      title: p.title,
      alt: p.alt,
      kind: p.category,
      line: printLine(p),
      place: p.location ?? '',
      caption: p.caption ?? '',
      video: p.video ?? '',
      // One of the best frames: the page opens on these (src/content.config.ts, `select`).
      select: p.select ?? false,
      // The shoot it came from, and that shoot's name, for the strip in the full view.
      set: p.set ?? '',
      setName: p.set ? SETS[p.set] : '',
      // The client's case study on this site, when there is one, and who the client is.
      client: p.client ?? '',
      study: p.client && STUDY_FOR_CLIENT[p.client] ? `/work/${STUDY_FOR_CLIENT[p.client]}/` : '',
      // The photo's own colour, for the table's wash and the full view (npm run photo-colors).
      c: (photoColors as Record<string, string>)[p.slug] ?? '',
      w: p.image.width,
      h: p.image.height,
      small: small.src,
      large: large.src,
      largeSet: large.srcSet.attribute,
    };
  }),
);
const filters = filtersFor(all.map((e) => ({ slug: e.id, ...e.data })));
const filmPrints = prints.filter((p) => p.video);
const films = filmPrints.length;
const stills = prints.length - films;

// The hero: a silent reel cut from the strongest graded films (public/photography/video/reel.mp4,
// 1600x900, about 22 s), with its first frame as the poster and the page's first image.
const reelStill = await getImage({
  src: reelPoster,
  widths: [768, 1280, 1600],
  format: 'webp',
  quality: 74,
});

// Chapters: whole days, each led by its best frame (src/lib/photo-table.ts, CHAPTERS). The lead
// gets a larger image; a film lead plays while it is on screen.
const chapters = await Promise.all(
  CHAPTERS.map(async (c) => {
    const frames = chapterFrames(prints, c);
    const leadEntry = dealt.find((d) => d.slug === frames[0]?.slug);
    const leadImg = leadEntry
      ? await getImage({ src: leadEntry.image, widths: [640, 960], format: 'webp', quality: 76 })
      : null;
    return {
      ...c,
      name: SETS[c.set],
      count: prints.filter((p) => p.set === c.set).length,
      frames,
      leadSrc: leadImg?.src ?? '',
      leadSet: leadImg?.srcSet.attribute ?? '',
    };
  }),
).then((list) => list.filter((c) => c.frames.length >= 3));

// "What I shoot": each row names the filters it leads to and shows three of its frames.
const rows = [
  {
    title: 'Church and events',
    body: 'Ash Wednesday by candlelight, a full house at Easter, Christmas Eve, a week of Vacation Bible School, a conference panel and the hallway after: the services, seasons and events a website needs all year.',
    go: [{ filter: 'church', label: 'See church and events' }],
  },
  {
    title: 'People and places',
    body: 'Staff pages, headshots and weddings, in natural light where I can get it, with people who look like themselves. And the rooms and hills they live in.',
    go: [{ filter: 'people', label: 'See people and places' }],
  },
  {
    title: 'Short films',
    body: 'Short silent loops from Christmas Eve, the hanging of the greens, choir and band rehearsals, Easter, Vacation Bible School, a creek picnic and Trunk or Treat, cut from the same days as the photos.',
    go: [{ filter: 'films', label: 'See the films' }],
  },
].map((row) => ({
  ...row,
  // Three frames, taken in turn from the row's filters so a two-filter row shows both.
  thumbs: [0, 1, 2]
    .map((n) => {
      const filter = row.go[n % row.go.length].filter;
      // Stills for every row but the films row, whose frames are the films' own posters.
      return prints.filter((p) => inFilter(p, filter) && (filter === 'films' || !p.video))[
        Math.floor(n / row.go.length)
      ];
    })
    .filter(Boolean),
}));

// "How a shoot works": the steps, then the kit in one line.
const how = [
  {
    title: 'Planning the day',
    body: 'What matters most, who has to be in it, where the light is and when. For a church that is often the moments a website will need all year, not just the event itself.',
  },
  {
    title: 'On the day',
    body: 'Quiet and out of the way. Photos and slow-motion film from the same camera, so one visit covers both.',
  },
  {
    title: 'The edit',
    body: 'Every frame picked and colour graded by hand: Lightroom for the photos, DaVinci Resolve for the films.',
  },
  {
    title: 'Ready for your site',
    body: 'A full gallery, plus short silent loops and crops sized for the web, so they drop straight onto your pages.',
  },
];
// "The kit": the camera, lenses, gimbal and software (src/data/photo-kit.ts), each lens with a
// photo on the page that was shot on it and the field of view it sees, drawn as a wedge.
const bySlug = new Map(prints.map((p) => [p.slug, p]));
const kitCamera = { ...CAMERA, print: bySlug.get(CAMERA.film) };
const kitGimbal = { ...GIMBAL, print: bySlug.get(GIMBAL.film) };
// A lens's view as a fan: apex at the left middle of a 120 x 140 box, radius 110, opening right.
const fan = (deg: number) => {
  const h = (deg / 2) * (Math.PI / 180);
  const R = 110,
    ax = 6,
    ay = 70;
  const x = (ax + R * Math.cos(h)).toFixed(1),
    y1 = (ay - R * Math.sin(h)).toFixed(1),
    y2 = (ay + R * Math.sin(h)).toFixed(1);
  return `M${ax} ${ay} L${x} ${y1} A${R} ${R} 0 0 1 ${x} ${y2} Z`;
};
const kitLenses = LENSES.map((l) => ({
  ...l,
  label: focalLabel(l.focal),
  // The wedge opens to the wide end; a zoom also draws its long end inside it.
  wide: fovDeg(l.focal[0]),
  tele: fovDeg(l.focal[1]),
  zoom: l.focal[0] !== l.focal[1],
  print: l.sample ? bySlug.get(l.sample.slug) : undefined,
}));

const contactHref = '/contact/?service=photography';
const heading = 'Photography that matches <b>the website it lives on.</b>';
---

<BaseLayout
  title="Photography and film in Cincinnati | Nixon Creative Studio"
  description={`Weddings, worship, events and portraits across Cincinnati, with short films to match, by the person who designs your website. Photography ${photography.price}.`}
  noindex={!open}
>
  <header class="page-head pt-head">
    {/* The hero reel: silent, looping, and decorative (the films themselves are below, each
         named). The poster is the first image; the script starts the reel unless the visitor
         asks for reduced motion or less data, and the button pauses it (WCAG 2.2.2). It still
         settles into a matted print as it scrolls away (CSS only). */}
    <div class="pt-hero pt-hero-reel">
      <img
        src={reelStill.src}
        srcset={reelStill.srcSet.attribute}
        sizes="100vw"
        width={1600}
        height={900}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <video
        data-hero-reel
        data-src="/photography/video/reel.mp4"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        tabindex="-1"
      ></video>
      <button type="button" class="pt-hero-pause" data-hero-pause aria-pressed="false" hidden>
        <span data-hero-pause-label>Pause the reel</span>
      </button>
    </div>
    <h1 aria-label={plainText(heading)} set:html={wordSpans(heading)} />
    <p class="lede">
      Weddings, Sunday mornings, conferences and portraits across Cincinnati, and short films to go
      with them. The same person designs the site and shows up with the camera, so the two look like
      one piece of work.
    </p>
    <p class="pt-acts">
      <a class="chip go" href={contactHref}>
        Book a shoot
      </a>
      <span class="label">Photography {photography.price}</span>
    </p>
  </header>

  {/* Chapters: one day each, led by its best frame. Every frame is a link to its full-size image
       and opens the full view (with that day's strip) like any print; a film lead plays while it
       is on screen. */}
  <section class="sec pt-days" aria-labelledby="pt-days-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="pt-days-title">Whole days</h2>
        <p>One shoot at a time, the way a church or a couple would book it.</p>
      </div>
      <ol class="pt-chapters">
        {chapters.map((c) => {
          const [lead, ...rest] = c.frames;
          return (
            <li class="pt-chapter">
              <div class="pt-chapter-head">
                <h3>{c.name}</h3>
                <p>{c.line}</p>
                <p class="label">{c.count} frames</p>
              </div>
              <div class="pt-chapter-frames">
                <a
                  class="print pt-chapter-lead"
                  href={lead.video || lead.large}
                  data-print={lead.i}
                  data-reel={lead.video || undefined}
                  aria-label={`${lead.video ? 'Film ' : ''}${lead.title}. ${lead.alt}`}
                >
                  <img
                    src={c.leadSrc}
                    srcset={c.leadSet}
                    sizes="(min-width: 52rem) 60vw, 100vw"
                    width={lead.w}
                    height={lead.h}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                  {lead.video && <span class="pt-film label">Film</span>}
                </a>
                {rest.map((p) => (
                  <a
                    class="print"
                    href={p.video || p.large}
                    data-print={p.i}
                    aria-label={`${p.video ? 'Film ' : ''}${p.title}. ${p.alt}`}
                  >
                    <img
                      src={p.small}
                      width={560}
                      height={Math.round((560 * p.h) / p.w)}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                    {p.video && <span class="pt-film label">Film</span>}
                  </a>
                ))}
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="pt" aria-labelledby="pt-title" data-table data-view="grid">
    <div class="pt-all-head">
      <h2 id="pt-title">Everything</h2>
      <p>
        All {stills} photos and {films} short films, the films playing as you pass. Lay them out on
        the table if you would rather wander.
      </p>
    </div>

    <div class="pt-bar-wrap">
      <div class="dw-bar" data-bar>
        <div class="dw-seg" role="group" aria-label="Show photos of" data-filters>
          <span class="dw-pill" data-pill aria-hidden="true"></span>
          <button type="button" aria-pressed="true" data-f="all">
            All <span class="n">{prints.length}</span>
          </button>
          {filters.map((f) => (
            <button type="button" aria-pressed="false" data-f={f.kind}>
              {f.label} <span class="n">{f.count}</span>
            </button>
          ))}
          <button type="button" aria-pressed="false" data-f="films">
            Films <span class="n">{films}</span>
          </button>
        </div>
        <div class="dw-seg" role="group" aria-label="View photos as" data-views>
          <span class="dw-pill" data-pill aria-hidden="true"></span>
          <button type="button" aria-pressed="true" data-v="grid">
            Grid
          </button>
          <button type="button" aria-pressed="false" data-v="table">
            Table
          </button>
        </div>
        <p class="dw-status" role="status" data-status>
          Showing all {prints.length}.
        </p>
      </div>
    </div>

    {/* The table. Empty in the markup: the script fills it from the grid below. */}
    <div class="pt-stage" data-stage hidden>
      <div class="pt-lamp" data-lamp aria-hidden="true" />
      <div
        class="pt-world"
        data-world
        tabindex="0"
        role="region"
        aria-roledescription="light table"
        aria-label="Light table of photos. Arrow keys move around, Enter opens the print in the middle."
      ></div>
      <div class="pt-hud" aria-hidden="true">
        <span class="label" data-coords>
          0, 0
        </span>
        <span class="label" data-zoomed>
          100%
        </span>
        <span class="label pt-hint">Drag, scroll or use the arrow keys</span>
      </div>
      <div class="pt-nudge" role="group" aria-label="Move the table">
        <button type="button" data-nudge="0,-1" aria-label="Move up">
          <span aria-hidden="true">↑</span>
        </button>
        <button type="button" data-nudge="-1,0" aria-label="Move left">
          <span aria-hidden="true">←</span>
        </button>
        <button type="button" data-nudge="1,0" aria-label="Move right">
          <span aria-hidden="true">→</span>
        </button>
        <button type="button" data-nudge="0,1" aria-label="Move down">
          <span aria-hidden="true">↓</span>
        </button>
      </div>
      <div class="pt-tools" role="group" aria-label="Zoom and full screen">
        <button
          type="button"
          class="pt-pill"
          data-tour
          aria-pressed="false"
          aria-label="Play a tour of the table"
        >
          Tour
        </button>
        <button
          type="button"
          class="pt-pill"
          data-colour
          aria-pressed="false"
          aria-label="Sort the table by colour"
        >
          Colour
        </button>
        <button type="button" data-zoom="out" aria-label="Zoom out">
          <span aria-hidden="true">−</span>
        </button>
        <button type="button" data-zoom="in" aria-label="Zoom in">
          <span aria-hidden="true">+</span>
        </button>
        <button type="button" data-full aria-label="Fill the screen" aria-pressed="false">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path
              d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>
      <p class="pt-vh" aria-live="polite" data-now></p>
    </div>

    {/* The grid: the gallery without JavaScript, and the Grid view with it. */}
    <ul class="pt-grid" data-grid>
      {prints.map((p) => (
        <li data-kind={p.kind} data-i={p.i}>
          <a
            class="print"
            href={p.large}
            data-print={p.i}
            data-reel={p.video || undefined}
            aria-label={`${p.title}${p.video ? ', a short film' : ''}. ${p.alt}`}
          >
            <img
              src={p.small}
              width={560}
              height={Math.round((560 * p.h) / p.w)}
              alt=""
              loading="lazy"
              decoding="async"
            />
            {p.video && <span class="pt-film label">Film</span>}
          </a>
        </li>
      ))}
    </ul>

    <script type="application/json" id="pt-data" set:html={JSON.stringify(prints)} />
    {/* The booking card the full view shows after every few steps (BOOKING_EVERY). */}
    <template data-booking data-every={BOOKING_EVERY}>
      <div class="pt-book">
        <p class="label">Photography {photography.price}</p>
        <p class="pt-book-line">
          Day-of coverage, portraits and short films. Often booked with a website, sometimes on
          their own.
        </p>
        <a class="chip go" href={contactHref}>
          Book a shoot
        </a>
      </div>
    </template>
    {/* The full view. A native dialog the script fills; Escape and the close button shut it.
         It sits inside the section so it still shows when the section fills the screen. */}
    <dialog class="pt-open" aria-labelledby="pt-open-title" data-open>
      <div class="pt-open-card card">
        <figure class="pt-open-media" data-media></figure>
        <div class="pt-open-text">
          <p class="label" data-line></p>
          <h2 id="pt-open-title" data-title></h2>
          <p data-alt></p>
          <p class="pt-open-place" data-place></p>
          <p class="pt-open-study" data-study-wrap hidden>
            <a data-study href="/work/">
              See the website
            </a>
          </p>
          <div class="pt-set" data-set hidden>
            <p class="label" data-set-name></p>
            <div class="pt-set-strip" data-set-strip role="group" aria-label="More from this set" />
          </div>
          <div class="pt-open-acts">
            <button type="button" class="chip" data-prev>
              Previous
            </button>
            <button type="button" class="chip" data-next>
              Next
            </button>
            <button type="button" class="chip" data-copy>
              Copy link
            </button>
            <button type="button" class="chip go" data-close>
              Close
            </button>
          </div>
          <p class="label pt-open-count" data-count></p>
        </div>
      </div>
    </dialog>
  </section>

  <section class="sec pt-what" aria-labelledby="pt-what-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="pt-what-title">What I shoot</h2>
      </div>
      <ul class="pt-rows">
        {rows.map((row) => (
          <li>
            <h3>{row.title}</h3>
            <div class="pt-row-body">
              <p>{row.body}</p>
              <div class="pt-row-more">
                <span class="pt-row-thumbs" aria-hidden="true">
                  {row.thumbs.map((t) => (
                    <img
                      src={t.small}
                      width={560}
                      height={Math.round((560 * t.h) / t.w)}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  ))}
                </span>
                {row.go.map((g) => (
                  <a class="chip" href="#pt-title" data-go={g.filter}>
                    {g.label}
                  </a>
                ))}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* How a shoot works: the process. The kit follows in its own section. */}
  <section class="sec pt-how" aria-labelledby="pt-how-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="pt-how-title">How a shoot works</h2>
      </div>
      <ol class="pt-rows pt-steps">
        {how.map((s, n) => (
          <li>
            <h3>
              <span class="label">{String(n + 1).padStart(2, '0')}</span> {s.title}
            </h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* The kit, as a bento of tiles: the camera over a playing film, each lens with its numbers,
       a wedge for how wide it sees and a photo on the page shot on it (the settings from the
       file's EXIF), the gimbal over a moving shot, and the software. No product renders. Every
       photo or film is a link that opens the full view. */}
  <section class="sec pt-kit" aria-labelledby="pt-kit-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="pt-kit-title">The kit</h2>
        <p>
          {yearsShooting()} years behind the camera, on professional full-frame gear chosen for
          churches: dim rooms, long aisles, moments that do not happen twice.
        </p>
      </div>
      <ul class="kit-grid">
        <li class="kit-tile kit-camera">
          {kitCamera.print && (
            <a
              class="print kit-media"
              href={kitCamera.print.video}
              data-print={kitCamera.print.i}
              data-reel={kitCamera.print.video}
              aria-label={`Film ${kitCamera.print.title}. ${kitCamera.print.alt}`}
            >
              <img
                src={kitCamera.print.small}
                width={560}
                height={315}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </a>
          )}
          <div class="kit-copy">
            <p class="label">Camera · {kitCamera.maker}</p>
            <h3>{kitCamera.name}</h3>
            <ul class="kit-specs">
              {kitCamera.specs.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
            <p class="kit-second">
              <span class="label">Second body</span> {kitCamera.second.maker}{' '}
              {kitCamera.second.name} · {kitCamera.second.line}
            </p>
          </div>
        </li>
        <li class="kit-tile kit-gimbal">
          {kitGimbal.print && (
            <a
              class="print kit-media"
              href={kitGimbal.print.video}
              data-print={kitGimbal.print.i}
              data-reel={kitGimbal.print.video}
              aria-label={`Film ${kitGimbal.print.title}. ${kitGimbal.print.alt}`}
            >
              <img
                src={kitGimbal.print.small}
                width={560}
                height={315}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </a>
          )}
          <div class="kit-copy">
            <p class="label">Gimbal · {kitGimbal.maker}</p>
            <h3>{kitGimbal.name}</h3>
            <p>{kitGimbal.line}</p>
          </div>
        </li>
        <li class="kit-tile kit-soft">
          <p class="label">Software</p>
          <ul class="kit-apps">
            {SOFTWARE.map((s) => (
              <li>
                <h3>
                  <span class="kit-maker">{s.maker}</span> {s.name}
                </h3>
                <p>{s.line}</p>
              </li>
            ))}
          </ul>
        </li>
        {kitLenses.map((l) => (
          <li
            class:list={['kit-tile', 'kit-lens', { 'kit-lens-wide': l.zoom && l.focal[1] >= 70 }]}
          >
            <div class="kit-copy">
              <p class="label">Lens</p>
              <p class="kit-num">
                <b>{l.label}</b>
                <span>mm</span> <b class="kit-f">{l.aperture}</b>
              </p>
              <h3>
                {l.maker} {l.name}
              </h3>
              <p class="kit-role">{l.role}</p>
            </div>
            {/* How wide it sees: a wedge to scale, the long end of a zoom drawn inside it. */}
            <div class="kit-fov" aria-hidden="true">
              <svg viewBox="0 0 120 140" class="kit-fov-svg">
                <path class="kit-fov-wide" d={fan(l.wide)} />
                {l.zoom && <path class="kit-fov-tele" d={fan(l.tele)} />}
              </svg>
              <span class="kit-fov-deg label">
                {Math.round(l.wide)}°{l.zoom ? `–${Math.round(l.tele)}°` : ''}
              </span>
            </div>
            {!l.sample && l.macro && (
              <p class="kit-macro">
                {l.macro}
                <span>Life-size macro</span>
              </p>
            )}
            {l.print && l.sample && (
              <a
                class="print kit-sample"
                href={l.print.large}
                data-print={l.print.i}
                aria-label={`${l.sample.at ? `Shot at ${l.sample.at}` : 'Shot on this lens'}: ${l.print.title}. ${l.print.alt}`}
              >
                <img
                  src={l.print.small}
                  width={560}
                  height={Math.round((560 * l.print.h) / l.print.w)}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <span class="kit-at label">
                  {l.sample.at ? `Shot at ${l.sample.at}` : 'Shot on this lens'}
                </span>
              </a>
            )}
          </li>
        ))}
        <li class="kit-tile kit-light">
          <div class="kit-gels" aria-hidden="true">
            {LIGHTING.gels.map((c) => (
              <span style={`--gel: ${c}`} />
            ))}
          </div>
          <div class="kit-copy">
            <p class="label">Lighting · {LIGHTING.maker}</p>
            <h3>{LIGHTING.title}</h3>
            <p>{LIGHTING.line}</p>
          </div>
          <ul class="kit-light-items">
            {LIGHTING.items.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </li>
      </ul>
    </div>
  </section>

  <Closing lead="Need photos <b>for your project?</b>" />
</BaseLayout>

<script>
  import '../scripts/photo-table.js';
</script>
