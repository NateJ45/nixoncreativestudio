---
// Safe to edit (copy). The gate itself lives in src/data/photography-gate.ts.
/* ============================================================================
   /photography | Photography  [gated]
   ============================================================================
   The gallery is not ready, so this page says so plainly: one real photo, one
   honest line, and a way to ask for samples. No placeholder images.

   The gate. Until the `photos` collection (src/content/photos/*.json) holds
   MIN_PHOTOS real photographs, this page is noindex, out of the sitemap (the
   filter in astro.config.mjs) and out of the closing's links (src/data/nav.ts).
   All three read photographyOpen() from src/data/photography-gate.ts, so they
   open together. tests/photography-gate.spec.ts checks the closed state.
   Ungating: docs/PENDING.md.

   The photo. No photo in the repo is yet a confirmed frame of Nathan's own client
   work, so this is the portrait from the About page, captioned for what it is.
   ============================================================================ */

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/sub.css';
import Closing from '../components/Closing.astro';
import { photographyOpen } from '../data/photography-gate';
import { addOns } from '../data/pricing';
import { addOnNamed } from '../lib/schema';
import { plainText, wordSpans } from '../lib/words';

// The photography price quoted in the meta description, from pricing.ts.
const photography = addOnNamed(addOns, 'Photography');

// Closed until the collection holds enough real photos (see the header note).
const open = photographyOpen((await getCollection('photos')).length);

// Where every "ask" on this page goes: the contact form, preset to photography.
const contactHref = '/contact/?service=photography';
const heading = 'Photography that matches <b>the website it lives on.</b>';
---

<BaseLayout
  title="Photography in Cincinnati | Nixon Creative Studio"
  description={`Headshots, events and environmental photos across the Cincinnati region, shot by the person who designs your website. Photography starts ${photography.price}.`}
  noindex={!open}
>
  <div class="photo-gate">
    <header class="page-head">
      <h1 aria-label={plainText(heading)} set:html={wordSpans(heading)} />
      <p class="lede">
        I photograph events, portraits and places across Cincinnati. The gallery is being assembled;
        ask for samples.
      </p>
      <p>
        <a class="chip go" href={contactHref}>
          Ask for samples
        </a>
      </p>
    </header>
    <figure class="photo-card">
      <img
        src="/assets/about/portrait-bw.webp"
        srcset="/assets/about/portrait-bw-520.webp 520w, /assets/about/portrait-bw.webp 960w"
        sizes="(min-width: 60rem) 42vw, 100vw"
        width="960"
        height="1200"
        alt="A black-and-white studio portrait of Nathan looking off to the side."
        fetchpriority="high"
      />
      <figcaption>Me, from the other side of the lens.</figcaption>
    </figure>
  </div>
  <Closing lead="Need photography <b>for your project?</b>" />
</BaseLayout>
