---
// Foundation, edit with care.
/* ============================================================================
   /photography | Photography  [CMS-driven]
   ============================================================================
   Image-heavy showcase. The words come from the `page_photography` entry and the
   pictures from the `photos` collection, both edited in the EmDash admin
   (Pages, Photography page; Photography, Photos). Server-rendered like every page;
   the route cache is tagged with what this page read (src/lib/routeCache.ts), so a
   publish purges it. Readers: src/lib/indexPages.ts and src/lib/photos.ts.

   Until real photos exist, the page does NOT ship placeholder rectangles (a
   photographer's page full of blank gradients is the worst possible tell).
   Instead it shows an honest "in progress" state and points visitors to the
   work pages, where the photography already appears in context. Production is in
   that state today: zero photos, and the committed text in
   cms/content/page_photography.json renders until its CMS entry is loaded.

   To add work: Photography, Photos, "Add new": upload the picture, write what it
   shows (the description is required, a photo without one is left out), pick its
   group and year. The hero uses the first Featured photo; a group with photos gets
   its own gallery section. Pictures are served as resized WebP through the
   width-only /_image resizer (src/lib/photos.ts explains the 4096 px rule).

   All motion below is reduced-motion safe (handled globally in globals.css).
   ============================================================================ */

import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import EmDashPhoto from '../components/emdash/EmDashPhoto.astro';
import PhotoGallery from '../components/PhotoGallery';
import { getSite } from '../data/site';
import { getPhotographyPage, indexTitle } from '../lib/indexPages';
import { galleryItems, getPhotos, groupPhotos, heroPhoto } from '../lib/photos';

const site = await getSite(Astro);
const page = await getPhotographyPage(Astro);
const allPhotos = await getPhotos(Astro);
const hasPhotos = allPhotos.length > 0;

// Group into non-empty categories. cover drives the bento card thumbnail; items
// drives the gallery for that category (width-only /_image URLs, see photos.ts).
const categories = groupPhotos(allPhotos).map((group) => ({
  id: group.id,
  title: page.categories[group.id].title,
  body: page.categories[group.id].body,
  cover: group.cover.image,
  count: group.photos.length,
  photos: galleryItems(group, Astro.url.origin),
}));

// Hero background: a featured photo if one is flagged, else the first photo,
// else nothing (the aurora carries the hero in the in-progress state).
const heroImage = heroPhoto(allPhotos)?.image;

const [leadCategory, ...restCategories] = categories;
---

<BaseLayout title={indexTitle(page.seoTitle, site.studioName)} description={page.seoDescription}>
  <!-- ----------------------------------------------------------------------
       Hero. When a real photo exists it fills the surface behind a navy
       scrim; until then a navy aurora carries it (no placeholder image). The
       headline accent is a solid amber phrase (no gradient text). data-hero-dark
       makes the sticky header go transparent over it.
       ---------------------------------------------------------------------- -->
  <section
    class="relative isolate flex flex-col justify-end overflow-hidden bg-primary text-primary-foreground"
    aria-labelledby="photography-hero-heading"
    style="min-height: clamp(30rem, 78vh, 46rem);"
    data-hero-dark
  >
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      {heroImage ? (
        <EmDashPhoto
          image={heroImage}
          alt=""
          class="h-full w-full object-cover"
          priority
          widths={[768, 1280, 1920]}
          sizes="100vw"
        />
      ) : (
        <div class="bg-aurora grain absolute inset-0" />
      )}
      <!-- Vertical scrim so the bottom-anchored copy always reads. -->
      <div class="absolute inset-0 bg-gradient-to-b from-primary/30 via-primary/45 to-primary/90"></div>
    </div>

    <!-- Foreground copy cluster, anchored to the bottom of the frame. Opens
         straight on the headline (no tracked-uppercase eyebrow); the Cincinnati
         base reads in the lede below. -->
    <div class="ncs-container relative z-10 py-2xl">
      <h1
        id="photography-hero-heading"
        class="mb-m max-w-[20ch] leading-[0.92] text-primary-foreground"
        data-reveal
        style="text-wrap: balance;"
      >
        {page.heading} <span class="text-tertiary">{page.headingAccent}</span>
      </h1>

      <p
        class="max-w-[58ch] text-lg leading-[1.6] text-primary-foreground/90"
        data-reveal
        style="--reveal-delay: 120ms;"
      >
        {page.intro}
      </p>
    </div>
  </section>

  {hasPhotos && leadCategory ? (
    <>
      {/* ------------------------------------------------------------------
           Category overview. Asymmetric spotlight cards: the lead category
           fills a tall feature card, the rest stack beside it. Each shows its
           newest photo behind the label and a small count, then jumps to that
           category's gallery. The full blurb lives on the gallery section header
           below, so it isn't repeated here.
           ------------------------------------------------------------------ */}
      <section class="bg-bg-soft py-2xl" aria-label="Browse photography by category">
        <div class="ncs-container">
          <ul class="grid gap-l lg:grid-cols-2 lg:grid-rows-2">
            <li class="lg:row-span-2" data-reveal>
              <a
                class="spotlight-card group hover-lift relative block h-full min-h-[20rem] overflow-hidden rounded-lg text-inherit no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                href={`#${leadCategory.id}`}
                data-spotlight
              >
                <EmDashPhoto
                  image={leadCategory.cover}
                  alt=""
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                  widths={[480, 768, 1024]}
                  sizes="(min-width: 1024px) 50vw, 100vw"
                />
                <div
                  class="absolute inset-0 bg-gradient-to-t from-primary/90 via-primary/40 to-primary/10"
                  aria-hidden="true"
                />
                <div class="relative z-10 flex h-full flex-col justify-end gap-xs p-l text-primary-foreground">
                  <h2 class="text-h3 text-primary-foreground">{leadCategory.title}</h2>
                  <p class="font-mono text-sm text-primary-foreground/80">
                    {leadCategory.count} {leadCategory.count === 1 ? 'photo' : 'photos'}
                  </p>
                </div>
              </a>
            </li>

            {restCategories.map((category, i) => (
              <li data-reveal style={`--reveal-delay: ${120 * (i + 1)}ms;`}>
                <a
                  class="spotlight-card group hover-lift relative block h-full min-h-[14rem] overflow-hidden rounded-lg text-inherit no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                  href={`#${category.id}`}
                  data-spotlight
                >
                  <EmDashPhoto
                    image={category.cover}
                    alt=""
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                    widths={[480, 768]}
                    sizes="(min-width: 1024px) 25vw, 100vw"
                  />
                  <div
                    class="absolute inset-0 bg-gradient-to-t from-primary/90 via-primary/40 to-primary/10"
                    aria-hidden="true"
                  />
                  <div class="relative z-10 flex h-full flex-col justify-end gap-xs p-l text-primary-foreground">
                    <h2 class="text-h3 text-primary-foreground">{category.title}</h2>
                    <p class="font-mono text-sm text-primary-foreground/80">
                      {category.count} {category.count === 1 ? 'photo' : 'photos'}
                    </p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* ------------------------------------------------------------------
           Gallery sections, one per non-empty category. PhotoGallery runs
           react-photo-album (justified grid) + yet-another-react-lightbox.
           ------------------------------------------------------------------ */}
      {categories.map((category) => (
        <section
          class="scroll-mt-2xl py-2xl"
          id={category.id}
          aria-labelledby={`${category.id}-heading`}
        >
          <div class="ncs-container">
            <header class="mb-l flex flex-col gap-s" data-reveal>
              <h2 id={`${category.id}-heading`} class="text-heading">
                {category.title}
              </h2>
              <p class="max-w-[56ch] text-lg leading-[1.5] text-text-muted">{category.body}</p>
            </header>
            <div data-reveal style="--reveal-delay: 120ms;">
              {/* client:visible so each gallery hydrates only as it scrolls into view */}
              <PhotoGallery client:visible photos={category.photos} />
            </div>
          </div>
        </section>
      ))}

      {/* Where the photos come from. A branded region note rather than a raw
           third-party map embed (which shipped as a blank tile box). */}
      <section class="bg-mesh-soft py-2xl" aria-labelledby="photo-area-heading">
        <div class="ncs-container">
          <div class="surface-card mx-auto max-w-[52ch] rounded-2xl p-l text-center">
            <h2 id="photo-area-heading" class="text-heading">
              Where these photos come from
            </h2>
            <p class="mt-s leading-[1.6] text-text-muted">
              Almost everything here was shot within an hour of downtown Cincinnati: the city
              itself, the northern suburbs, and the towns around them.
            </p>
          </div>
        </div>
      </section>
    </>
  ) : (
    /* In-progress state. No placeholder galleries; an honest note plus a
         route to the work pages where the photography already lives. */
    <section class="py-2xl" aria-label="Photography portfolio status">
      <div class="ncs-container">
        <div class="band-themed mx-auto max-w-[60ch] rounded-2xl p-xl text-center" data-reveal>
          <p class="text-sm font-semibold tracking-[0.12em] text-link uppercase">In progress</p>
          <h2 class="mt-s text-heading">{page.emptyHeading}</h2>
          <p class="mt-s leading-[1.6] text-text-muted">{page.emptyBody}</p>
          <a class="card-link mt-m inline-flex" href="/work/">
            See the work
          </a>
        </div>
      </div>
    </section>
  )}

  <CtaBanner title={page.ctaTitle} sub={page.ctaSub} />
</BaseLayout>
