---
// Foundation, edit with care.
/* ============================================================================
   /photography | Photography  [CMS-driven]
   ============================================================================
   A service page for photography across the Cincinnati region, with the real
   gallery underneath once there are photographs. The words come from the
   `page_photography` entry, the rate from the Photography add-on (Pricing add-ons)
   and the pictures from the `photos` collection, all edited in the EmDash admin.
   Server-rendered like every page; the route cache is tagged with what this page
   read (src/lib/routeCache.ts), so a publish purges it. Readers:
   src/lib/indexPages.ts, src/lib/pricing.ts and src/lib/photos.ts.

   Bands (DESIGN.md "Grounds"; one moving ground per page, at the top):
     1. window-light (moving, under the header): the headline, the intro, the ask,
        and on the right either the lead photograph as a film frame (a photo is
        flagged or exists) or the rate card (zero photos).
     2. paper: what a shoot looks like (events, portraits, environments, the three
        groups from the CMS). A group with photos links to its gallery; with zero
        photos a plain, honest note says where the work is shown instead.
     3. paper: one gallery per non-empty group (PhotoGallery island, client:visible).
        Only when photos exist.
     4. deep (still): how booking works, four real steps in order.
     5. paper-contours (CtaBanner).

   NEVER FAKE PHOTOGRAPHS. The zero-photo state ships no placeholder pictures and
   none of Nathan's personal snapshots standing in for client work: it is a real
   service page (what, how much, how it goes) and a sentence saying the public
   gallery is on its way. The first published photo turns the gallery on with no
   deploy.

   SEARCH. While the gallery is empty the page asks to stay out of search results
   (`robots: noindex, follow`, photographyRobots() in src/lib/photos.ts, through
   BaseLayout's `robots` prop). It flips to indexable with the first photo.

   To add work: Photography, Photos, "Add new": upload the picture, write what it
   shows (the description is required, a photo without one is left out), pick its
   group and year. The hero uses the first Featured photo; a group with photos gets
   its own gallery section. Pictures are served as resized WebP through the
   width-only /_image resizer (src/lib/photos.ts explains the 4096 px rule).

   Still in code: the three band headings, the four booking steps and the gallery
   note (Photography page entry has no fields for them).
   ============================================================================ */

import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/Band.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Frame from '../components/Frame.astro';
import PhotoRateCard from '../components/PhotoRateCard.astro';
import PhotoGallery from '../components/PhotoGallery';
import { buttonVariants } from '../components/ui/button';
import { getSite } from '../data/site';
import { getPhotographyPage, indexTitle } from '../lib/indexPages';
import { getAddOns } from '../lib/pricing';
import {
  galleryItems,
  getPhotos,
  groupPhotos,
  heroPhoto,
  mediaUrl,
  photographyRobots,
  resizedUrl,
} from '../lib/photos';

const site = await getSite(Astro);
const page = await getPhotographyPage(Astro);
const allPhotos = await getPhotos(Astro);
const addOns = await getAddOns(Astro);
const hasPhotos = allPhotos.length > 0;

// The Photography add-on carries the floor and the half-day / full-day sentence.
const rate = addOns.find((a) => a.name.toLowerCase() === 'photography');

// Non-empty groups for the galleries (width-only /_image URLs, see photos.ts).
const groups = groupPhotos(allPhotos);
const countFor = (id: string) => groups.find((g) => g.id === id)?.photos.length ?? 0;
const galleries = groups.map((group) => ({
  id: group.id,
  title: page.categories[group.id].title,
  body: page.categories[group.id].body,
  photos: galleryItems(group, Astro.url.origin),
}));

// The lead photograph for the hero: a Featured photo, else the first. Drawn as a film
// frame with its real facts on the rebate. Width-only resizer URL, real proportions.
const lead = heroPhoto(allPhotos);
const leadUrl = lead ? mediaUrl(lead.image, Astro.url.origin) : undefined;
const leadWidth = lead ? Math.min(lead.width, 1600) : 0;
const lead16 =
  lead && leadUrl
    ? {
        src: resizedUrl(leadUrl, leadWidth),
        width: leadWidth,
        height: Math.round(leadWidth * (lead.height / lead.width)),
        alt: lead.alt,
        edge: [lead.title, lead.location, lead.year ? String(lead.year) : undefined].filter(
          (f): f is string => Boolean(f),
        ),
        caption: lead.caption,
      }
    : undefined;

// The three shoot types, in order. The words are the CMS group titles and intros.
const shootTypes = (['events', 'portraits', 'environments'] as const).map((id) => ({
  id,
  title: page.categories[id].title,
  body: page.categories[id].body,
  count: countFor(id),
}));

// How booking goes: a real sequence, so these four are numbered. In code, not the CMS.
const steps = [
  {
    title: 'Tell me what you need',
    body: 'Send a note about the event, the people or the rooms, and where the pictures will be used.',
  },
  {
    title: 'I send a written quote',
    body: 'It follows the rates here and says what the day covers. Nothing is booked until you say yes.',
  },
  {
    title: 'We shoot',
    body: 'I come to you around Cincinnati. If I am building your site, the shoot is planned alongside the design so the pictures fit the pages.',
  },
  {
    title: 'You get edited files',
    body: 'Sized for the web, so the pages stay fast. For a website project they go straight into the build.',
  },
];

// While the gallery is empty this page is a thin result for search, so it opts out.
const robots = photographyRobots(allPhotos.length);
---

<BaseLayout
  title={indexTitle(page.seoTitle, site.studioName)}
  description={page.seoDescription}
  robots={robots}
>
  {/* ------------------------------------------------------------------
       1. Hero. Plain headline with the italic voice, the intro and the ask.
       The right column is the lead photograph when one exists, else the
       rate card (real information in the space a photograph would fill).
       Nothing here waits on JavaScript or starts at opacity 0.
       ------------------------------------------------------------------ */}
  <Band ground="window-light" underHeader labelledby="photography-hero-heading">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 id="photography-hero-heading" class="type-headline hero-title">
          {page.heading}
          <span class="voice">{page.headingAccent}</span>
        </h1>
        <p class="type-lede">{page.intro}</p>
        <div class="hero-actions">
          <a href="/contact/" class={buttonVariants({ variant: 'brand', size: 'cta' })}>
            Ask about a shoot
          </a>
          <a class="card-link" href="/work/">
            See the sites it was shot for
          </a>
        </div>
      </div>

      <div class="hero-side">
        {lead16 ? (
          <Frame
            variant="film"
            src={lead16.src}
            width={lead16.width}
            height={lead16.height}
            alt={lead16.alt}
            edge={lead16.edge}
            caption={lead16.caption}
            eager
            sizes="(min-width: 64rem) 40vw, 92vw"
          />
        ) : (
          rate && <PhotoRateCard price={rate.price} note={rate.note} />
        )}
      </div>
    </div>
  </Band>

  {/* ------------------------------------------------------------------
       2. What a shoot looks like. The three groups from the CMS, set as
       three columns on hairlines (no cards). With photos each links to its
       gallery; with none, one honest line says where the work shows instead.
       ------------------------------------------------------------------ */}
  <Band labelledby="shoots-heading">
    <header class="band-head" data-reveal>
      <h2 id="shoots-heading" class="type-headline">
        What a shoot <span class="voice">looks like.</span>
      </h2>
    </header>

    <ul class="shoot-grid">
      {shootTypes.map((shoot, i) => (
        <li class="shoot" data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
          <h3 class="shoot-title type-headline">{shoot.title}</h3>
          <p class="type-body">{shoot.body}</p>
          {shoot.count > 0 && (
            <a class="card-link" href={`#${shoot.id}`}>
              {shoot.count} {shoot.count === 1 ? 'photo' : 'photos'}
            </a>
          )}
        </li>
      ))}
    </ul>

    {!hasPhotos && (
      <div class="gallery-note" data-reveal>
        <h3 class="type-headline gallery-note-title">{page.emptyHeading}</h3>
        <div class="gallery-note-body">
          <p class="type-body">{page.emptyBody}</p>
          <a class="card-link" href="/work/">
            See the work
          </a>
        </div>
      </div>
    )}
  </Band>

  {/* ------------------------------------------------------------------
       3. Galleries, one per non-empty group. PhotoGallery runs
       react-photo-album (justified grid) + yet-another-react-lightbox, and
       hydrates only as it scrolls into view.
       ------------------------------------------------------------------ */}
  {galleries.map((gallery) => (
    <Band
      id={gallery.id}
      labelledby={`${gallery.id}-heading`}
      class="gallery-band scroll-mt-[4rem]"
      tight
    >
      <header class="band-head" data-reveal>
        <h2 id={`${gallery.id}-heading`} class="type-headline">
          {gallery.title}
        </h2>
        <p class="type-lede">{gallery.body}</p>
      </header>
      <div data-reveal style="--reveal-delay: 120ms;">
        <PhotoGallery client:visible photos={gallery.photos} />
      </div>
    </Band>
  ))}

  {hasPhotos && (
    <Band tight label="Where these photographs were taken">
      <p class="type-body place-note">
        Almost everything here was shot within an hour of downtown Cincinnati: the city itself, the
        northern suburbs, and the towns around them.
      </p>
    </Band>
  )}

  {/* ------------------------------------------------------------------
       4. How booking works. The deep ground, still. Four steps in order
       (a real sequence, so numbered). With a lead photograph the rate card
       sits here, since the hero spent its right column on the picture.
       ------------------------------------------------------------------ */}
  <Band ground="deep" still labelledby="booking-heading">
    <div class="booking-grid">
      <header class="booking-head" data-reveal>
        <h2 id="booking-heading" class="type-headline">
          How booking <span class="voice">works.</span>
        </h2>
        {lead16 && rate && (
          <PhotoRateCard price={rate.price} note={rate.note} class="booking-rate" />
        )}
        <p>
          <a href="/contact/" class={buttonVariants({ variant: 'brand', size: 'cta' })}>
            Ask about a shoot
          </a>
        </p>
      </header>

      <ol class="steps">
        {steps.map((step, i) => (
          <li class="step" data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
            <span class="step-n type-numeral" aria-hidden="true">
              {i + 1}
            </span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-body">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </Band>

  <CtaBanner title={page.ctaTitle} sub={page.ctaSub} ctaHref="/contact/" />
</BaseLayout>

<style>
  /* ---- 1. hero ---- */
  .hero-grid {
    display: grid;
    gap: var(--spacing-xl);
    align-items: end;
  }
  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    }
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-m);
  }
  /* The headline is long ("Photography that matches the website it lives on."), so it
     sets at h1 size rather than the display size. */
  .hero-title {
    font-size: var(--text-h1);
    max-width: 14ch;
  }
  .hero-title .voice {
    display: block;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-m) var(--spacing-l);
    margin-top: var(--spacing-xs);
  }

  /* ---- 2. shoots ---- */
  .band-head {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s);
    margin-bottom: var(--spacing-l);
  }
  .shoot-grid {
    display: grid;
    gap: var(--spacing-l);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 48rem) {
    .shoot-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--spacing-xl);
    }
  }
  .shoot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-s);
    padding-top: var(--spacing-m);
    border-top: 1px solid var(--border);
  }
  .shoot-title {
    font-size: var(--text-h3);
  }
  .gallery-note {
    display: grid;
    gap: var(--spacing-m);
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-l);
    border-top: 1px solid var(--border);
  }
  @media (min-width: 64rem) {
    .gallery-note {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: var(--spacing-xl);
    }
  }
  .gallery-note-title {
    font-size: var(--text-h3);
  }
  .gallery-note-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-s);
  }

  /* ---- 3. galleries ---- */
  .place-note {
    max-width: 52ch;
  }

  /* ---- 4. booking ---- */
  .booking-grid {
    display: grid;
    gap: var(--spacing-xl);
  }
  @media (min-width: 64rem) {
    .booking-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }
  }
  .booking-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-m);
  }
  .booking-head :global(.booking-rate) {
    box-shadow: none;
  }
  .steps {
    display: grid;
    gap: var(--spacing-l);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 40rem) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    padding-top: var(--spacing-m);
    border-top: 1px solid var(--border);
  }
  .step-n {
    font-size: var(--text-h2);
    color: var(--marker);
  }
  .step-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-h4);
    letter-spacing: 0.01em;
    color: var(--heading);
  }
  .step-body {
    max-width: 38ch;
    color: var(--muted-foreground);
  }
</style>
