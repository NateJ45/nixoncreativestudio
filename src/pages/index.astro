---
// Safe to edit. Server-rendered and route-cached like every page (BaseLayout).
/* ============================================================================
   Homepage (redesign 2026)
   ============================================================================
   Section order is the IA. Each band has one job and its own ground, and the
   ground changes deliberately between bands (DESIGN.md "Grounds"):

     HomeHero     paper-contours (the one moving ground)  the tagline, who it
                  is for, the button, the price floor, the reel of his sites
     FactDemo     deep, still           change one fact (a made-up church's
                  service time) and watch six places keep up
     ProofSheet   window-light, still   the work: film strips from four live
                  sites, Stone Steps first
     HomePrices   deep, still           the three published tiers
     HomeProcess  paper                 four steps and how long they take
     HomeAbout    deep, still           who you work with
     HomeClose    paper-contours, still the closing call
     Footer       deep (BaseLayout)

   Words: the CMS "Home page" entry (getHomePage, fallback cms/content/
   page_home.json) and the pricing tiers. Work: curated in src/lib/homeWork.ts,
   gated by the case studies' launch status and featured flag (read once here
   and passed down). Rules: .claude/rules/homepage-and-pages.md.
   ============================================================================ */

import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import FactDemo from '../components/home/FactDemo.astro'; // V2-DEMO
import ProofSheet from '../components/home/ProofSheet.astro';
import HomePrices from '../components/home/HomePrices.astro';
import HomeProcess from '../components/home/HomeProcess.astro';
import HomeAbout from '../components/home/HomeAbout.astro';
import HomeClose from '../components/home/HomeClose.astro';
import { getHomePage, homeTitle } from '../lib/homePage';
import { getCaseStudies } from '../lib/caseStudies';
import type { StudyGate } from '../lib/homeWork';
import { getSite } from '../data/site';

const home = await getHomePage(Astro);
const site = await getSite(Astro);

// The case studies decide which curated sites may show (homeWork.ts). The read tags the
// route cache, so publishing a study purges the homepage. If it fails, the bundled sites
// stand (each was checked live), and the page still renders.
let studies: StudyGate[] = [];
try {
  studies = (await getCaseStudies(Astro.cache)).map((s) => ({
    id: s.id,
    featured: s.featured,
    launchStatus: s.launchStatus,
  }));
} catch (err) {
  console.warn('[home] case studies unreadable, showing the bundled work', err);
}
---

<BaseLayout
  title={homeTitle(home.seoTitle, site.studioName)}
  description={home.seoDescription}
  preloadFonts={['italic']}
>
  <HomeHero studies={studies} />
  {/* V2-DEMO: the "change one fact" band, right after the hero (FactDemo.astro; deep, still). */}
  <FactDemo />
  <ProofSheet studies={studies} />
  <HomePrices />
  <HomeProcess />
  <HomeAbout />
  <HomeClose />
</BaseLayout>
