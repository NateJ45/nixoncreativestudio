---
/* ============================================================================
   / | The homepage
   ============================================================================
   Top to bottom:
     Hero        the headline, with the portrait inside the sentence, and the
                 empty space the hand of clients is dealt into.
     Work        the giant "Eight selected case studies.", the ledger, and the grid. Every
                 window has one spot here; scroll carries it from the hand.
     Quote band  one real client quote on their color, phone breaking out.
     Prices      the three cards, dealt out of a stack.
     Closing     the gathering deck and the "Start a project" card.

   All of it is in the markup. src/scripts/home.js only moves the windows, so
   with no JavaScript the hand's space collapses and the grid is simply the grid.
   ============================================================================ */
import BaseLayout from '../layouts/BaseLayout.astro';
import Tile from '../components/Tile.astro';
import Caption from '../components/Caption.astro';
import QuoteBand from '../components/QuoteBand.astro';
import DealtPrices from '../components/DealtPrices.astro';
import Closing from '../components/Closing.astro';
import { countWord, getClients } from '../lib/clients';
import { webTiers } from '../data/pricing';
import { site } from '../data/site';
import { money } from '../lib/money';

const clients = await getClients();
const city = site.address.split(',')[0];
const ledger = ['Since 2020', 'One person', city];
/* Every sector word is a link to its page, so the row never looks church-first. */
const sectors = [
  { name: 'Churches', href: '/churches/' },
  { name: 'Schools', href: '/schools/' },
  { name: 'Nonprofits', href: '/nonprofits/' },
  { name: 'Small businesses', href: '/small-business/' },
];

const lead = ['I', 'build', 'websites'];
const heavy = ['pull', 'their', 'weight.'];
---

<BaseLayout
  title="Nixon Creative Studio | Cincinnati websites and photography"
  description="I design and build fast, accessible websites for churches, schools, nonprofits and small businesses. Based in Cincinnati, working with clients anywhere."
>
  <section class="hero" aria-labelledby="h">
    <h1 id="h" aria-label="I build websites that pull their weight.">
      {lead.map((w, i) => (
        <>
          <span class="w" aria-hidden="true" style={`--n:${i}`}>
            {w}
          </span>{' '}
        </>
      ))}
      <span class="me" aria-hidden="true">
        <img
          src="/assets/portrait.webp"
          srcset="/assets/portrait-160.webp 160w, /assets/portrait.webp 320w"
          sizes="(max-width: 768px) 80px, 160px"
          alt=""
        />
        <span>Hi, that's me</span>
      </span>
      <span class="w" aria-hidden="true" style="--n:3">
        that
      </span>
      {heavy.map((w, i) => (
        <>
          <b>
            <span class="w" aria-hidden="true" style={`--n:${i + 4}`}>
              {w}
            </span>
          </b>{' '}
        </>
      ))}
    </h1>
    <p class="sub">
      Websites for churches, schools, nonprofits and small businesses, from{' '}
      {money(webTiers[0].priceFrom)}. One person does the design, the build and, when needed, the
      photos.
    </p>
    <div class="stackspace" data-space></div>
  </section>
  <section class="work" id="work" aria-labelledby="wh">
    <div class="big">
      <h2 id="wh" class="giant stack" data-weigh="0.38 0.06" style="--fit:17.4;--fitm:18.4">
        <span>{countWord(clients.length)} selected</span>
        <span>case studies.</span>
      </h2>
    </div>
    <div class="ledger">
      <div class="ledger-rows">
        <ul class="label" data-ledger>
          {ledger.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
        <p class="ledger-for">
          <span class="label">Websites for:</span>
          {sectors.map((s) => (
            <a href={s.href}>{s.name}</a>
          ))}
        </p>
      </div>
      <p class="ledger-do">
        Tap any phone to look inside, or{' '}
        <button type="button" class="draw" data-draw>
          Show me a random one
        </button>
      </p>
    </div>
    <ul class="grid" data-grid>
      {clients.map((s, i) => (
        <li>
          <Tile client={s} index={i} />
          <Caption client={s} index={i} />
        </li>
      ))}
    </ul>
  </section>
  <QuoteBand
    slug="theology-matters"
    label="In their words"
    class="home-band"
    ariaLabel="What a client says"
  />
  <DealtPrices id="prices" />
  <Closing />
</BaseLayout>

<script>
  import '../scripts/home.js';
</script>
