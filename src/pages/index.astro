---
/* ============================================================================
   / | The homepage
   ============================================================================
   Top to bottom:
     Hero        the headline, with the portrait inside the sentence and a marker line drawn
                 under "pull their weight.", the results line under it (one real client
                 figure at a time, the `heroProof` list below), and the empty space the
                 hand of clients is dealt into.
     Work        the giant "Eight selected case studies.", the ledger, and the grid. Every
                 window has one spot here; scroll carries it from the hand.
     What changed  the sourced figures (the `proof` list below), each a wide card on its
                 client's color (home/WhatChanged.astro).
     Quote band  every real client quote, one at a time, on its client's color with
                 their phone; Previous and Next step through them (quote-cycle.js).
     Edit it     "Your team edits it. Try it.": a demo editor beside a made-up
                 organization's page in a phone (home/EditDemo.astro, edit-demo.js).
     Photographs one row of my own prints that drifts with the scroll (home/PhotoStrip.astro).
     Prices      the three cards, dealt out of a stack; each turns over (PriceHand.astro).
     Process     the four steps of How it works, drawn in order (home/ProcessBeats.astro).
     Client marks  a tile per client in its own colour with its real logo, each a
                 link to its study (home/ClientMarks.astro).
     Closing     the gathering deck and the "Start a project" card.

   A quote band never touches the closing: the neutral sections after it keep them apart.

   All of it is in the markup. src/scripts/home.js only moves the windows and
   src/scripts/home-more.js the sections below them, so with no JavaScript the hand's
   space collapses, the grid is simply the grid and every section is simply there.
   The rules for the lower sections are in src/styles/pages/home.css; the hero, grid,
   band and price hand stay in kit.css.
   ============================================================================ */
import BaseLayout from '../layouts/BaseLayout.astro';
import Tile from '../components/Tile.astro';
import Caption from '../components/Caption.astro';
import QuoteBand from '../components/QuoteBand.astro';
import DealtPrices from '../components/DealtPrices.astro';
import Closing from '../components/Closing.astro';
import RatingChip from '../components/RatingChip.astro';
import WhatChanged from '../components/home/WhatChanged.astro';
import ClientMarks from '../components/home/ClientMarks.astro';
import EditDemo from '../components/home/EditDemo.astro';
import PhotoStrip from '../components/home/PhotoStrip.astro';
import ProcessBeats from '../components/home/ProcessBeats.astro';
import '../styles/pages/home.css';
import { countWord, getClients } from '../lib/clients';
import { webTiers } from '../data/pricing';
import { site } from '../data/site';
import { money } from '../lib/money';

const clients = await getClients();
const city = site.address.split(',')[0];
const ledger = ['Since 2020', 'One person', city];
/* Every sector word is a link to its page, so the row never looks church-first. Reaching for one
   with a mouse or the keyboard also deals that sector's own client windows beside it (up to three,
   in deck order, read from the case studies). The pictures are only a preview of the page the link
   goes to, so a touch screen gets the plain link and misses nothing. */
const sectors = [
  { name: 'Churches', href: '/churches/', key: 'church' },
  { name: 'Schools', href: '/schools/', key: 'school' },
  { name: 'Nonprofits', href: '/nonprofits/', key: 'nonprofit' },
  { name: 'Small businesses', href: '/small-business/', key: 'small-business' },
].map((s) => ({ ...s, cards: clients.filter((c) => c.sectorKey === s.key).slice(0, 3) }));

/* What changed: real counts from the case studies, each linking to the study that sources it.
   Each figure is sourced in its case study's frontmatter comments. Add one here only once the
   client has seen it published there, and never reword a number. */
const proof = [
  {
    slug: 'west-chester-preschool',
    figure: '58%',
    what: 'more students, with 41 of 43 places filled',
    who: 'West Chester Preschool',
  },
  {
    slug: 'foundation-for-reformed-theology',
    figure: 'About 60%',
    what: 'more clicks from Google since the relaunch',
    who: 'Foundation for Reformed Theology',
  },
  {
    slug: 'stone-steps-50k',
    figure: 'Next morning',
    what: 'results, records and runner pages live after each race, with nobody touching them',
    who: 'Stone Steps 50K',
  },
];

/* The results line under the headline: one short figure per kind of client, each copied from the
   sourced figure in that client's case study (never reworded, never rounded). The first is the one
   that shows before any script and the one the line comes back to and rests on. Picked for what a
   client hiring a site wants to see: more people (students, visitors, requests), more found on
   Google, and money saved. */
const heroProof = [
  { figure: '58%', what: 'more students', who: 'West Chester Preschool' },
  { figure: '100%', what: 'more clicks from Google', who: 'Reid Design' },
  { figure: '66%', what: 'more visitors a day', who: 'First Baptist Church Muncie' },
  { figure: '94', what: 'journal requests in four weeks', who: 'Theology Matters' },
  { figure: '$264', what: 'a year back from Squarespace', who: 'MAS Monograms' },
];

const lead = ['I', 'build', 'websites'];
const heavy = ['pull', 'their', 'weight.'];
---

<BaseLayout
  title="Nixon Creative Studio | Cincinnati web design and photography"
  description="I design and build fast, accessible websites for churches, schools, nonprofits and small businesses. Based in Cincinnati, working with clients anywhere."
>
  <section class="hero" aria-labelledby="h">
    <h1 id="h" aria-label="I build websites that pull their weight.">
      {lead.map((w, i) => (
        <>
          <span class="w" aria-hidden="true" style={`--n:${i}`}>
            {w}
          </span>{' '}
        </>
      ))}
      {/* The portrait links to the About page (2026-11-15). It is a real, focusable link, so it
          is not aria-hidden like the words around it; its name comes from aria-label. */}
      <a class="me" href="/about/" aria-label="About me">
        <img
          src="/assets/portrait.webp"
          srcset="/assets/portrait-160.webp 160w, /assets/portrait.webp 320w"
          sizes="(max-width: 768px) 80px, 160px"
          alt=""
        />
        <span aria-hidden="true">Hi, that's me</span>
      </a>
      <span class="w" aria-hidden="true" style="--n:3">
        that
      </span>
      {heavy.map((w, i) => (
        <>
          <b>
            <span class="w" aria-hidden="true" style={`--n:${i + 4}`}>
              {w}
            </span>
          </b>{' '}
        </>
      ))}
    </h1>
    {/* The results line (2026-11-15, replacing the blue vow stamp): one real client figure at a
        time. The first is in place at load (nothing in the first screen starts hidden); after the
        headline lands, hero-proof.js steps through the rest once, about a second and a half
        each, and comes back to rest on the first. A screen reader hears the whole list instead,
        once. Its height matches the old stamp, so the hero sums (616 and 559) are unchanged. */}
    <div class="proof" data-proof>
      <ul class="vh">
        {heroProof.map((p) => (
          <li>
            {p.figure} {p.what}, {p.who}
          </li>
        ))}
      </ul>
      <p class="proof-run" aria-hidden="true">
        {heroProof.map((p, i) => (
          <span class={i === 0 ? 'proof-i on' : 'proof-i'}>
            <b>{p.figure}</b> {p.what} <span class="proof-who">{p.who}</span>
          </span>
        ))}
      </p>
    </div>
    {/* The Google rating, with the reviewers' faces (added 2026-11-15, RatingChip.astro). */}
    <RatingChip />
    <p class="sub">
      Websites for churches, schools, nonprofits and small businesses, from{' '}
      {money(webTiers[0].priceFrom)}. One person does the design, the build and, when needed, the
      photos.
    </p>
    <div class="stackspace" data-space></div>
  </section>
  <section class="work" id="work" aria-labelledby="wh">
    <div class="big">
      <h2
        id="wh"
        class="giant stack"
        data-weigh="0.38 0.06"
        data-build
        style="--fit:17.4;--fitm:18.4"
      >
        <span>{countWord(clients.length)} selected</span>
        <span>case studies.</span>
      </h2>
    </div>
    <div class="ledger">
      <div class="ledger-rows">
        <ul class="label" data-ledger>
          {ledger.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
        <p class="ledger-for">
          <span class="label">Websites for:</span>
          {sectors.map((s) => (
            <span class="lf">
              <a href={s.href}>{s.name}</a>
              {s.cards.length > 0 && (
                <span class="lf-stack" aria-hidden="true" data-lf>
                  {s.cards.map((c, i) => (
                    <span
                      class="lf-card"
                      style={`--c:${c.accent};--d:${i - (s.cards.length - 1) / 2};--i:${i}`}
                      data-src={`/assets/${c.slug}-m-320.webp`}
                    />
                  ))}
                </span>
              )}
            </span>
          ))}
        </p>
        <p class="ledger-note">
          I take on a handful of new builds a year, so each one gets my full attention. Three of
          these {countWord(clients.length).toLowerCase()} came back to me for their second site.
        </p>
      </div>
      <p class="ledger-do">
        Tap any phone to look inside, or{' '}
        <button type="button" class="draw" data-draw>
          Show me a random one
        </button>
      </p>
    </div>
    <ul class="grid" data-grid>
      {clients.map((s, i) => (
        <li>
          <Tile
            client={s}
            index={i}
            sizes="(max-width: 52rem) calc(50vw - 27px), min(20vw, 290px)"
          />
          <Caption client={s} index={i} />
        </li>
      ))}
    </ul>
  </section>
  <WhatChanged proof={proof} clients={clients} />
  <QuoteBand
    slug="theology-matters"
    label="In their words"
    class="home-band"
    cycle
    ariaLabel="What clients say"
  />
  <EditDemo />
  <PhotoStrip />
  <DealtPrices id="prices" />
  <ProcessBeats />
  <ClientMarks clients={clients} />
  <Closing />
</BaseLayout>

<script>
  import '../scripts/home.js';
  import '../scripts/home-more.js';
  import '../scripts/quote-cycle.js';
  import '../scripts/hero-proof.js';
</script>
