---
/* ============================================================================
   Homepage (overhaul package 2.2)
   ============================================================================
   Its job: proof of craft, then fit, then price. Section order IS the IA:

     Hero           "The Reel" (Hero.astro + HeroReel.astro). Not changed
                    by 2.2.
     Selected work  three client sites (the lowest `order`) as FramePairs,
                    alternating sides, with the peek on hover and focus, then
                    "All {n} sites" to /work/. White.
     Who I build for  SectorIndex: one hairline row per sector with its count,
                    each linking /work/?sector={key}. Paper.
     (testimonial)  one real quote goes here; see the comment in the markup.
     What it costs  PricingTeaser, variant "teaser": the ruled tiers from
                    src/data/pricing.ts. White.
     How I work     ProcessBand, the weighted timeline. Paper.
     Ink closer     the footer (BaseLayout), set by the `closer` prop below.

   Surfaces alternate white and paper so each hairline marks a real change,
   and the page always ends on ink. Details: .claude/rules/homepage-and-pages.md.
   ============================================================================ */

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SelectedWork from '../components/SelectedWork.astro';
import SectorIndex from '../components/SectorIndex.astro';
import PricingTeaser from '../components/PricingTeaser.astro';
import ProcessBand from '../components/ProcessBand.astro';
import type { Closer } from '../lib/closer';

// The home's last word. ProcessBand used to close the page with this line and
// its own button; the footer's ink closer carries it now, with the same
// promise under it.
const closer: Closer = {
  heading: 'Tell me what you are',
  emphasis: 'building.',
  sub: 'The first conversation is free and ends with an honest ballpark, so you know where you stand before anything is signed.',
};
---

<BaseLayout
  title="Nixon Creative Studio | Cincinnati websites and photography"
  description="I design and build fast, accessible websites for churches, schools, nonprofits and small businesses. Based in Cincinnati, working with clients anywhere."
  closer={closer}
>
  <Hero />
  <SelectedWork />
  <SectorIndex tone="paper" />
  {/* TESTIMONIAL SLOT (the testimonials package fills it): one real quote,
       verbatim, from _vault/projects/ncs-testimonials.md, goes HERE, between
       "Who I build for" and "What it costs". Nothing renders here until then.
       Never a made-up or paraphrased quote (CLAUDE.md never-break rule 9).
       Keep the surfaces alternating: if the quote band is white, swap
       PricingTeaser to tone="paper" and ProcessBand to tone="white". */}
  <PricingTeaser variant="teaser" tone="white" />
  <ProcessBand tone="paper" />
</BaseLayout>
