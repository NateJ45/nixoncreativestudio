---
/* /drawer/, in `npm run dev` only (injected by the dev-drawer integration in astro.config.mjs, so
   it is never built or deployed). Every object in the drawer (src/components/ephemera/) on one
   page, each on the plain ground and on a card, so a change to one shows up next to the others.
   Flip the theme in the dock to check both sides. Add each new object here when it joins the
   drawer. The example words are About's own, so nothing here is made up. */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/stamp.css';
import CrewList from '../components/ephemera/CrewList.astro';
import FilmStrip from '../components/ephemera/FilmStrip.astro';
import Stamp from '../components/ephemera/Stamp.astro';
import Ticket from '../components/ephemera/Ticket.astro';
import PressPass from '../components/ephemera/PressPass.astro';
import MarginNote from '../components/ephemera/MarginNote.astro';
import PaperPrint from '../components/ephemera/PaperPrint.astro';
import NotebookPage from '../components/ephemera/NotebookPage.astro';
import PortraitCard from '../components/ephemera/PortraitCard.astro';
import WorkStub from '../components/ephemera/WorkStub.astro';
import stream from '../assets/photography/canvas/fall-stream.jpg';
import stones from '../assets/photography/canvas/old-stones.jpg';
import tm from '../assets/case-studies/shots/theology-matters-home.png';
import mas from '../assets/case-studies/shots/mas-monograms-home.png';

const frames = [{ src: stream }, { src: stones }, { src: tm, web: true }, { src: mas, web: true }];
---

<BaseLayout title="The drawer (dev only)" noindex>
  <div class="drawer">
    <h1>The drawer</h1>
    <p>
      The paper objects any page can borrow. Dev only. Components in src/components/ephemera/, looks
      in src/styles/ephemera.css, src/styles/ephemera/ and stamp.css.
    </p>

    <section>
      <h2>Stamp</h2>
      <div class="row">
        <Stamp word="One person" under="Start to finish" />
        <Stamp word="Decoration" under="aria-hidden" decor />
        <div class="card-ish">
          <Stamp word="On a card" under="--stamp-paper" />
        </div>
      </div>
    </section>

    <section>
      <h2>Crew list</h2>
      <div class="card-ish narrow">
        <CrewList roles={['Strategy', 'Design', 'The build', 'Photos, when needed']} />
      </div>
    </section>

    <section>
      <h2>Film strip</h2>
      <div class="narrow">
        <FilmStrip frames={frames} splice="2020" />
      </div>
    </section>

    <section>
      <h2>Ticket</h2>
      <div class="night">
        <Ticket head={['Boarding pass', 'One way']} route={['EDI', 'CVG']} seed={20170}>
          <h3>From Scotland, in the U.S. since 2017</h3>
          <dl class="pass-fields">
            <div>
              <dt>Departed</dt>
              <dd>2017</dd>
            </div>
            <div>
              <dt>Based in</dt>
              <dd>Cincinnati since 2022</dd>
            </div>
          </dl>
          <p class="pass-note">In person around the region, anywhere for web work.</p>
        </Ticket>
      </div>
    </section>

    {/* The journal's objects. The words are the church cost post's own (its date, its sources). */}
    <section>
      <h2>Press pass</h2>
      <div class="row">
        <PressPass photo="/assets/about/portrait-bw-520.webp" seed={20261110}>
          <dl class="press-fields">
            <div>
              <dt>Published</dt>
              <dd>November 10, 2026</dd>
            </div>
            <div>
              <dt>Section</dt>
              <dd>Costs</dd>
            </div>
          </dl>
        </PressPass>
        <PressPass photo="/assets/about/portrait-bw-520.webp" seed={20261111}>
          <dl class="press-fields">
            <div>
              <dt>Published</dt>
              <dd>November 10, 2026</dd>
            </div>
          </dl>
          <span slot="stamp" class="stamp" aria-hidden="true">
            <span class="stamp-word">Stamp</span>
            <span class="stamp-date">slot</span>
          </span>
        </PressPass>
      </div>
    </section>

    <section>
      <h2>Margin note</h2>
      <div class="row">
        <MarginNote class="narrow">
          <p>
            Sources: <a href="https://www.wix.com/plans">Wix plans</a> and
            <a href="https://www.squarespace.com/pricing">Squarespace pricing</a>, as of November
            2026.
          </p>
        </MarginNote>
        <div class="card-ish">
          <MarginNote tilt={1.5}>
            <p>On a card</p>
          </MarginNote>
        </div>
      </div>
    </section>

    <section>
      <h2>Print</h2>
      <div class="row">
        <div class="narrow">
          <PaperPrint>
            <img src={stream.src} alt="" width="320" height="214" style="width:100%;height:auto" />
          </PaperPrint>
        </div>
      </div>
    </section>

    <section>
      <h2>Notebook page</h2>
      <NotebookPage as="article" class="nb-demo">
        <p class="label">Costs</p>
        <h3>How much does a church website cost in 2026?</h3>
      </NotebookPage>
    </section>
    <section>
      <h2>Portrait card, small</h2>
      <div class="row">
        <PortraitCard />
        <div class="card-ish">
          <PortraitCard />
        </div>
      </div>
    </section>
    <section>
      <h2>Work-order stub</h2>
      <div class="row">
        <WorkStub no={1} seed={4101} />
        <div class="card-ish stub-on-card">
          <WorkStub no={2} seed={4498} />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .drawer {
    max-width: 64rem;
    margin: 0 auto;
    padding: 6rem 1rem 8rem;
    display: grid;
    gap: 3rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem;
  }
  .row :global(.stamp) {
    float: none;
    margin: 0;
  }
  .card-ish {
    --stamp-paper: var(--card);
    padding: 1.5rem;
    border-radius: 1rem;
    background: var(--card);
    box-shadow: var(--rim);
  }
  .narrow {
    max-width: 24rem;
  }
  .drawer :global(.nb-demo) {
    max-width: 36rem;
    padding: 2rem 2rem 2.5rem 4rem;
  }
  .night {
    --ticket-ground: #0b0e1f;
    padding: 1.5rem;
    border-radius: 1rem;
    background: #0b0e1f;
  }
  .stub-on-card {
    --stub-ground: var(--card);
  }
</style>
