---
/* /drawer/, in `npm run dev` only (injected by the dev-drawer integration in astro.config.mjs, so
   it is never built or deployed). Every object in the drawer (src/components/ephemera/) on one
   page, each on the plain ground and on a card, so a change to one shows up next to the others.
   Flip the theme in the dock to check both sides. Add each new object here when it joins the
   drawer. The example words are About's own, so nothing here is made up. */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/stamp.css';
import CrewList from '../components/ephemera/CrewList.astro';
import FilmStrip from '../components/ephemera/FilmStrip.astro';
import Stamp from '../components/ephemera/Stamp.astro';
import Signature from '../components/ephemera/Signature.astro';
import Ticket from '../components/ephemera/Ticket.astro';
import stream from '../assets/photography/canvas/fall-stream.jpg';
import stones from '../assets/photography/canvas/old-stones.jpg';
import tm from '../assets/case-studies/shots/theology-matters-home.png';
import mas from '../assets/case-studies/shots/mas-monograms-home.png';

const frames = [{ src: stream }, { src: stones }, { src: tm, web: true }, { src: mas, web: true }];
---

<BaseLayout title="The drawer (dev only)" noindex>
  <div class="drawer">
    <h1>The drawer</h1>
    <p>
      The paper objects any page can borrow. Dev only. Components in src/components/ephemera/, looks
      in src/styles/ephemera.css, stamp.css and src/styles/ephemera/.
    </p>

    <section>
      <h2>Stamp</h2>
      <div class="row">
        <Stamp word="One person" under="Start to finish" />
        <Stamp word="Decoration" under="aria-hidden" decor />
        <div class="card-ish">
          <Stamp word="On a card" under="--stamp-paper" />
        </div>
      </div>
    </section>

    <section>
      <h2>Crew list</h2>
      <div class="card-ish narrow">
        <CrewList roles={['Strategy', 'Design', 'The build', 'Photos, when needed']} />
      </div>
    </section>

    <section>
      <h2>Film strip</h2>
      <div class="narrow">
        <FilmStrip frames={frames} splice="2020" />
      </div>
    </section>

    <section>
      <h2>Ticket</h2>
      <div class="night">
        <Ticket head={['Boarding pass', 'One way']} route={['EDI', 'CVG']} seed={20170}>
          <h3>From Scotland, in the U.S. since 2017</h3>
          <dl class="pass-fields">
            <div>
              <dt>Departed</dt>
              <dd>2017</dd>
            </div>
            <div>
              <dt>Based in</dt>
              <dd>Cincinnati since 2022</dd>
            </div>
          </dl>
          <p class="pass-note">In person around the region, anywhere for web work.</p>
        </Ticket>
      </div>
    </section>

    <section>
      <h2>Signature</h2>
      <p>
        Writes itself when it comes into view (scroll it out and reload to watch again). On the
        ground, on a card, and small.
      </p>
      <div class="row">
        <Signature at="drawer1" />
        <div class="card-ish">
          <Signature at="drawer2" />
        </div>
        <Signature class="sig-small" at="drawer3" />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .drawer :global(.sig-small) {
    --sig-w: 6rem;
  }
  .drawer {
    max-width: 64rem;
    margin: 0 auto;
    padding: 6rem 1rem 8rem;
    display: grid;
    gap: 3rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem;
  }
  .row :global(.stamp) {
    float: none;
    margin: 0;
  }
  .card-ish {
    --stamp-paper: var(--card);
    padding: 1.5rem;
    border-radius: 1rem;
    background: var(--card);
    box-shadow: var(--rim);
  }
  .narrow {
    max-width: 24rem;
  }
  .night {
    --ticket-ground: #0b0e1f;
    padding: 1.5rem;
    border-radius: 1rem;
    background: #0b0e1f;
  }
</style>
