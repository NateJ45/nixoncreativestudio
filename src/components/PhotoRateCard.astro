---
/* ============================================================================
   PhotoRateCard
   ============================================================================
   The photography rate, printed like a card laid on the table: the floor as a
   Bebas numeral and the plain-language note under it. Both strings are the
   "Photography" entry of Add-ons in the CMS (src/lib/pricing.ts), so the
   number can never drift from /services or the homepage.

   It is the designed state of /photography when the gallery has no photographs
   yet (it fills the space a photograph would), and sits in the booking band once
   there is one. Real information, never a placeholder picture.
   ============================================================================ */

interface Props {
  /** The display price, e.g. "from $900". */
  price: string;
  /** The sentence that explains it (half day, full day, where). */
  note: string;
  class?: string;
}

const { price, note, class: className } = Astro.props;
---

<div class:list={['rate-card', className]}>
  <p class="rate-label type-caption">What a shoot costs</p>
  <p class="rate-price type-numeral">{price}</p>
  <p class="rate-note type-body">{note}</p>
</div>

<style>
  .rate-card {
    background: var(--card); /* paper-raised on paper, ink-raised inside .on-ink */
    border: 1px solid var(--border);
    border-radius: 2px;
    box-shadow: var(--shadow-print);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--card-foreground);
  }
  .rate-label {
    margin: 0 0 0.75rem;
  }
  .rate-price {
    margin: 0 0 1rem;
    text-transform: uppercase;
  }
  .rate-note {
    margin: 0;
    font-size: 1.0625rem;
  }
</style>
