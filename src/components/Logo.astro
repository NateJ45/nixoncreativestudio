---
// Foundation, edit with care.
/* ============================================================================
   Logo
   ============================================================================
   Nathan's official lockup: NIXON CREATIVE STUDIO over WEB DESIGN |
   PHOTOGRAPHY | STRATEGY, in navy (on paper) or white (on the deep ground).
   Never redraw, recolour, stretch or set it in live type (LOGO-NOTES.md in
   docs/redesign-2026/brand/).

   Props:
     tone     'navy' (default) on paper grounds, 'white' on .on-ink grounds.
     lockup   'full' (default) the two-line lockup.
              'top' the top line only, for narrow headers.
              'responsive' top line below 48rem, full lockup above, as one
              <picture> (only the matching file downloads).
     width    display width in CSS px of the full lockup (the top line is
              drawn at topWidth). Height follows the artwork's ratio.
     topWidth display width of the top-line mark (default 150).
     eager    true for the header (in the first screen), false elsewhere.

   The accessible name is the studio name from getSite() (never hardcoded).
   Inside a link that is the link's name, so the wrapping <a> needs no
   aria-label.

   SOURCE: the vector rebuild (logo-*.svg, crisp at every DPR, cached as a
   file) is used since 2026-10-04. Its outlines are fitted Bebas glyphs and
   differ from the PNG master on some edges (LOGO-NOTES.md "Fidelity"); flip
   SOURCE to 'raster' to use the exact PNG-derived WebPs instead. Regenerate
   both with `node scripts/brand/build-logo.mjs`.
   ============================================================================ */
import { getSite } from '../data/site';
import navySvg from '../assets/brand/logo-navy.svg?url';
import whiteSvg from '../assets/brand/logo-white.svg?url';
import topNavySvg from '../assets/brand/logo-top-navy.svg?url';
import topWhiteSvg from '../assets/brand/logo-top-white.svg?url';
import navyWebp from '../assets/brand/logo-navy-640.webp?url';
import whiteWebp from '../assets/brand/logo-white-640.webp?url';
import topNavyWebp from '../assets/brand/logo-top-navy-440.webp?url';
import topWhiteWebp from '../assets/brand/logo-top-white-440.webp?url';

const SOURCE: 'svg' | 'raster' = 'svg';

interface Props {
  tone?: 'navy' | 'white';
  lockup?: 'full' | 'top' | 'responsive';
  width?: number;
  topWidth?: number;
  eager?: boolean;
  class?: string;
}

const {
  tone = 'navy',
  lockup = 'full',
  width = 236,
  topWidth = 150,
  eager = false,
  class: className,
} = Astro.props;

const site = await getSite(Astro);

// Artwork ratios (LOGO-NOTES.md): full 1423:361, top line 1423:183 for the SVG.
// The raster top line was cropped at the first empty row (440x58).
const FULL_RATIO = 361 / 1423;
const TOP_RATIO = SOURCE === 'svg' ? 183 / 1423 : 58 / 440;

const files =
  SOURCE === 'svg'
    ? {
        full: tone === 'white' ? whiteSvg : navySvg,
        top: tone === 'white' ? topWhiteSvg : topNavySvg,
      }
    : {
        full: tone === 'white' ? whiteWebp : navyWebp,
        top: tone === 'white' ? topWhiteWebp : topNavyWebp,
      };

const full = { src: files.full, width, height: Math.round(width * FULL_RATIO) };
const top = { src: files.top, width: topWidth, height: Math.round(topWidth * TOP_RATIO) };
const loading = eager ? 'eager' : 'lazy';
---

{lockup === 'responsive' ? (
  <picture class:list={['logo', className]}>
    <source media="(max-width: 47.99rem)" srcset={top.src} width={top.width} height={top.height} />
    <img
      src={full.src}
      width={full.width}
      height={full.height}
      alt={site.studioName}
      loading={loading}
      decoding="async"
    />
  </picture>
) : (
  <img
    class:list={['logo', className]}
    src={lockup === 'top' ? top.src : full.src}
    width={lockup === 'top' ? top.width : full.width}
    height={lockup === 'top' ? top.height : full.height}
    alt={site.studioName}
    loading={loading}
    decoding="async"
  />
)}

<style>
  /* The image keeps its ratio when a parent sizes it with max-width. */
  .logo,
  .logo :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>
