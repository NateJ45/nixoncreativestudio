---
/* ============================================================================
   ComingSoon
   ============================================================================
   Foundation, edit with care. The "launching soon" view. Renders as the entire
   <body> contents on /coming-soon/ (always), and over every other route when
   PUBLIC_COMING_SOON=true (via BaseLayout). Nothing moves: the name, one line
   and the email from site.ts, beside a still fan of the real client windows.
   The fan is decorative (aria-hidden). kit.css is always loaded with it.
   ============================================================================ */
import { site } from '../data/site';
import { getClients } from '../lib/clients';

const clients = (await getClients()).slice(0, 5);
const [first, ...rest] = site.studioName.split(' ');
---

<div class="ncs-cs" id="main">
  <div class="ncs-cs__copy">
    <h1>
      <b>{first}</b> {rest.join(' ')}
    </h1>
    <p class="lede">The new site opens soon. Until then, email me:</p>
    <p>
      <a class="chip" href={site.emailHref}>
        {site.email}
      </a>
    </p>
  </div>
  <div class="ncs-cs__fan" aria-hidden="true">
    {clients.map((s, i) => (
      <span
        class="ncs-cs__card"
        style={`--c:${s.accent};--d:${i - (clients.length - 1) / 2};z-index:${5 - Math.abs(i - 2)}`}
      >
        <img src={s.still} alt="" width="584" height="1138" loading="lazy" />
      </span>
    ))}
  </div>
</div>

<style>
  .ncs-cs {
    display: grid;
    align-content: center;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    min-height: 100dvh;
    padding: clamp(2rem, 6vw, 5rem) var(--gut);
    overflow: hidden;
    background: var(--ground);
  }
  .ncs-cs h1 {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 300;
    overflow-wrap: anywhere;
  }
  .ncs-cs__copy .lede {
    margin: 1.5rem 0 1rem;
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
  }
  .ncs-cs__copy .chip {
    overflow-wrap: anywhere;
    white-space: normal;
  }
  .ncs-cs__fan {
    position: relative;
    height: clamp(16rem, 50vh, 28rem);
  }
  .ncs-cs__card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: clamp(7rem, 15vw, 12rem);
    aspect-ratio: 584 / 1138;
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--c);
    box-shadow: 0 18px 40px -22px rgba(0, 0, 0, 0.5);
    transform: translate(calc(-50% + var(--d) * 42%), calc(-50% + var(--d) * var(--d) * 3%))
      rotate(calc(var(--d) * 6deg));
  }
  .ncs-cs__card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 56rem) {
    .ncs-cs {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }
</style>
