---
/* ============================================================================
   ComingSoon
   ============================================================================
   Safe to edit. The visual treatment for the WIP gate. Renders as the entire
   <body> contents on:
     - /coming-soon/ (always; kept out of the sitemap and marked noindex)
     - every other route when PUBLIC_COMING_SOON=true (via BaseLayout)

   One band on the limewash window-light ground: the real logo lockup, "Launching
   soon" with the italic second voice, a short honest line about the studio, and
   the two ways to reach Nathan. No nav, no footer.

   Both hosts load globals.css (BaseLayout and the standalone /coming-soon/ page),
   so this uses the site's tokens and the Band component like any other page; there
   is no separate palette to keep in step. Nothing starts at opacity 0 and nothing
   needs JavaScript (the grounds script only attaches the textures and pauses the
   light off screen). Under prefers-reduced-motion the ground shows its still.
   ============================================================================ */

import Band from './Band.astro';
import Logo from './Logo.astro';
import { getSite } from '../data/site';

// Studio name, location, email and phone come from Site settings in the CMS.
const site = await getSite(Astro);
---

<main class="ncs-cs">
  <Band ground="window-light" labelledby="coming-soon-heading" class="cs-band">
    <div class="cs-inner">
      <Logo lockup="full" width={280} eager />

      <h1 id="coming-soon-heading" class="type-display cs-title">
        Launching <span class="voice">soon.</span>
      </h1>

      <p class="type-lede">
        {site.studioName} is a small studio in {site.address}. Web design and strategy for small
        businesses, nonprofits, churches and schools anywhere, and photography across the Cincinnati
        region. The new site goes live this season.
      </p>

      <p class="type-body">
        If you have a project in mind in the meantime, email or call me directly. I read every
        inquiry myself.
      </p>

      <ul class="cs-contact">
        <li>
          <a href={site.emailHref}>{site.email}</a>
        </li>
        <li>
          <a href={site.phoneHref}>{site.phone}</a>
        </li>
      </ul>
    </div>
  </Band>
</main>

<style>
  .ncs-cs {
    display: block;
    min-height: 100vh;
    min-height: 100dvh;
    background: var(--background);
  }
  .ncs-cs :global(.cs-band) {
    display: flex;
    align-items: center;
    min-height: inherit;
    padding-block: clamp(2rem, 6vw, 5rem);
  }
  .cs-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-m);
    max-width: 44rem;
  }
  .cs-title {
    margin-top: var(--spacing-m);
    font-size: var(--text-h1);
  }
  .cs-title .voice {
    display: block;
  }

  /* The two contact links: large, set on hairlines, 44px+ targets. */
  .cs-contact {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    margin: var(--spacing-s) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .cs-contact li {
    border-bottom: 1px solid var(--border);
  }
  .cs-contact a {
    display: block;
    padding-block: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: var(--heading);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 0.15s ease;
  }
  .cs-contact a:hover,
  .cs-contact a:focus-visible {
    color: var(--link);
  }
</style>
