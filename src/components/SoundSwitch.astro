---
/* The sound switch. Sound is OFF until someone asks for it here, and the choice is kept on the
   device (src/scripts/sound.js). It says the state in words, "Sound off" or "Sound on": both labels
   are in the markup and CSS shows the right one from aria-pressed, the way the light and dark
   switch does. It does nothing without script, so it is hidden without script too (the `.turn`
   and `.fc` rules in kit.css already do that for these two shapes).

   Two copies: one in the closing band's fine print beside the light and dark switch (every width,
   and the only one on a phone), and one as a third small card in the dock's theme hand. */
interface Props {
  /** 'end' sits in the closing band's fine print; 'dock' is a card in the dock's theme hand. */
  where?: 'dock' | 'end';
}
const { where = 'end' } = Astro.props;
---

{where === 'end' ? (
  <button class="turn turn-end snd" type="button" data-sound aria-pressed="false">
    <span class="snd-off">
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path d="M3 7.8h2.6L9.5 4.6v10.8L5.6 12.2H3z" />
        <path d="m12.8 8 4 4M16.8 8l-4 4" />
      </svg>
      Sound off
    </span>
    <span class="snd-on">
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path d="M3 7.8h2.6L9.5 4.6v10.8L5.6 12.2H3z" />
        <path d="M12.6 7.6a3.4 3.4 0 0 1 0 4.8M14.9 5.4a6.5 6.5 0 0 1 0 9.2" />
      </svg>
      Sound on
    </span>
  </button>
) : (
  <button
    class="fc fc-theme fc-snd"
    type="button"
    data-sound
    aria-pressed="false"
    data-cap="Sound: small cues, off until you ask"
  >
    <span class="fc-in">
      {/* A drawing of the state, not a meter: five bars, flat when off, standing when on. */}
      <span class="fc-mini fc-bars" aria-hidden="true">
        <i />
        <i />
        <i />
        <i />
        <i />
      </span>
      <span class="label snd-off">Sound off</span>
      <span class="label snd-on">Sound on</span>
    </span>
  </button>
)}
