---
/* The "Every price is public" section: the copy beside the price hand. */
import PriceHand from './PriceHand.astro';

interface Props {
  id?: string;
}
const { id } = Astro.props;
---

<section class="sec dealt" id={id} aria-labelledby="ph">
  <div class="dealt-copy">
    <p class="label">Three starting points</p>
    <h2 id="ph">
      Every price is <b>public.</b>
    </h2>
    <p>Every site is custom. The difference is scope.</p>
    <a class="chip go" href="/services/">
      See what each one includes
    </a>
  </div>
  <PriceHand />
</section>
