---
// Safe to edit.
/* ============================================================================
   UpNext: the hand-off at the end of a case study (overhaul package 2.4a)
   ============================================================================
   A full-width panel in the NEXT study's palette, with that study's homepage
   capture in a slightly tilted browser frame (the hero reel's angle), linking
   to it. The /work/[slug] template picks the next study by `order` and wraps
   from the last back to the first (src/lib/study.ts nextInLoop), so the
   studies form one loop. It replaced the old text-only previous/next pair.

   Light mode: a band in the next client's paper with a 4px rule in their
   accent; text stays in this site's own colours (checked on every client
   paper by src/lib/case-palettes.test.ts). Dark mode (ruling 8, no invented client
   dark palettes): this site's raised ink panel with only the client's dark
   mark as the rule, and this site's own text colours.

   The whole panel is one click target: the link sits on the heading and its
   ::after stretches over the panel, so a screen reader hears one link, named
   by the client, and keyboard focus draws a ring around the whole panel.

   Phase 3 (package 3.1) adds the View Transition morph from this frame into
   the next study's stage. Nothing here animates on its own.

   Props:
     slug, client, hook   the next study's id, name and one-line hook
     url                  its live site (shown as the host in the frame bar)
     shot                 its full-page homepage capture, cropped from the top
     style                its palette as --cs-* custom properties
                          (paletteStyle() in src/lib/study.ts)
   ============================================================================ */

import type { ImageMetadata } from 'astro';
import BrowserFrame from './BrowserFrame.astro';
import Media from './Media.astro';

interface Props {
  slug: string;
  client: string;
  hook?: string;
  url?: string;
  shot?: ImageMetadata;
  style?: string;
}

const { slug, client, hook, url, shot, style } = Astro.props;
---

<section class="up-next" style={style} aria-labelledby="up-next-title">
  <div class="ncs-container up-next-inner">
    <div class="up-next-copy">
      <p class="up-next-label">Up next</p>
      <h2 id="up-next-title" class="up-next-title">
        <a href={`/work/${slug}/`} class="up-next-link">
          <b>{client}</b>
        </a>
      </h2>
      {hook && <p class="up-next-hook">{hook}</p>}
      <p class="up-next-cue" aria-hidden="true">
        Read the case study →
      </p>
    </div>
    {shot && url && (
      <div class="up-next-shot">
        <BrowserFrame url={url}>
          <Media
            src={shot}
            alt=""
            ratio="16 / 10"
            position="top"
            widths={[480, 800]}
            sizes="(min-width: 82.5rem) 44rem, (min-width: 56rem) 55vw, calc(100vw - 3rem)"
          />
        </BrowserFrame>
      </div>
    )}
  </div>
</section>

<style>
  .up-next {
    position: relative;
    overflow: hidden;
    background-color: var(--cs-paper, var(--paper));
    color: var(--foreground);
    border-top: 4px solid var(--cs-accent, var(--accent));
  }

  /* Dark (ruling 8): this site's raised ink, the client's dark mark as the
     rule, and this site's own text. --ink-raised keeps the panel apart from
     the ink footer that follows it. */
  :global(.dark) .up-next {
    background-color: var(--ink-raised);
    color: var(--foreground);
    border-top-color: var(--cs-mark-dark, var(--accent));
  }

  .up-next-inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  @media (min-width: 56rem) {
    .up-next-inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
    }
  }

  .up-next-label,
  .up-next-cue {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .up-next-title {
    margin: 0.75rem 0 0;
    font-size: var(--text-h2);
    color: inherit;
  }

  .up-next-link {
    color: inherit;
    text-decoration: none;
  }

  /* One click target for the whole panel. */
  .up-next-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .up-next-link:hover,
  .up-next-link:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }

  .up-next-link:focus-visible {
    outline: none;
  }
  .up-next-link:focus-visible::after {
    outline: 3px solid var(--accent);
    outline-offset: -6px;
  }

  .up-next-hook {
    margin: 1rem 0 0;
    max-width: 32ch;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 300;
    line-height: 1.3;
  }

  .up-next-cue {
    margin-top: 1.5rem;
  }

  /* The capture, tilted like a card on the hero reel. Static: nothing moves. */
  .up-next-shot {
    transform: rotate(-2deg);
  }

  @media (min-width: 56rem) {
    .up-next-shot {
      transform: rotate(-3deg) translateY(1rem);
    }
  }

  @media (forced-colors: active) {
    .up-next {
      border-top: 4px solid CanvasText;
    }
  }

  @media print {
    .up-next {
      display: none;
    }
  }
</style>
