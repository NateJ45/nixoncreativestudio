---
// Safe to edit.
/* ============================================================================
   Showreel
   ============================================================================
   A directed walkthrough of a live client site: a camera over 2x stills with
   short live clips cut in (the d8 "hybrid", docs/redesign-2026/mockups/
   d8-showreel/RATIONALE.md). The player is src/scripts/showreel.ts, a small
   dependency-free custom element (<nx-reel>). Files: public/reel/<slug>/,
   which spec in src/data/workExtras.ts (SHOWREELS) says which studies have one.

   What the server sends, and why:
   - A <picture> with the POSTER, the page's LCP element on a case study:
     eager, fetchpriority high, explicit width and height, a 960 w and a full
     size for desktops, the 4:5 phone cut at 600px and below.
   - Under prefers-reduced-motion the <picture> shows a designed STILL of the
     best detail instead, and the player never builds.
   - Without JavaScript the poster is simply a picture.
   The player then waits for load, the poster's decode and an idle moment, and
   only near the viewport, before it fetches anything (about 0.6 to 0.9 MB).

   Props:
     slug    the case study slug (folder under public/reel/)
     spec    the ReelSpec from SHOWREELS
     url     the live address, for the frame's chrome bar
     eager   true when this is the page's first picture (the LCP)
   ============================================================================ */
import type { ReelSpec } from '../data/workExtras';

interface Props {
  slug: string;
  spec: ReelSpec;
  url?: string;
  eager?: boolean;
}

const { slug, spec, url, eager = true } = Astro.props;
const dir = `/reel/${slug}/${spec.prefix}`;
---

<figure class="reel">
  <div class="reel-print">
    <div class="reel-chrome" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
      {url && <span class="reel-url">{url}</span>}
    </div>
    <nx-reel data-d={`${dir}-d.json`} data-m={`${dir}-m.json`}>
      <picture>
        <source
          media="(prefers-reduced-motion: reduce) and (max-width: 600px)"
          srcset={`${dir}-m-still.webp`}
          width="780"
          height="976"
        />
        <source
          media="(prefers-reduced-motion: reduce)"
          srcset={`${dir}-d-still-960.webp 960w, ${dir}-d-still.webp 1920w`}
          sizes="(min-width: 82.5rem) 76rem, 92vw"
          width="1920"
          height="1080"
        />
        <source
          media="(max-width: 600px)"
          srcset={`${dir}-m-poster.webp`}
          width="780"
          height="976"
        />
        <img
          class="nxr-poster"
          src={`${dir}-d-poster.webp`}
          srcset={`${dir}-d-poster-960.webp 960w, ${dir}-d-poster.webp 1600w`}
          sizes="(min-width: 82.5rem) 76rem, 92vw"
          width="1600"
          height="900"
          alt={spec.alt}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding="async"
        />
      </picture>
    </nx-reel>
  </div>
  <figcaption class="type-caption reel-caption">{spec.caption}</figcaption>
</figure>

<script>
  import '../scripts/showreel';
</script>

<style>
  .reel {
    margin: 0;
  }
  .reel-print {
    box-shadow: var(--shadow-frame);
  }
  /* The same quiet chrome bar as Frame's browser print. */
  .reel-chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    height: 2rem;
    padding-inline: 0.75rem;
    background: var(--ink);
    color: var(--on-ink-muted);
    font-family: var(--font-ui);
  }
  .reel-chrome i {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.45;
  }
  .reel-url {
    flex: 0 1 22rem;
    min-width: 0;
    margin-left: 0.75rem;
    padding: 0.1rem 0.8rem;
    border-radius: 999px;
    background: var(--ink-raised);
    font-size: 0.75rem;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .reel-caption {
    margin-top: 0.75rem;
    max-width: 60ch;
  }

  /* ---- the player (elements it creates are not scoped, hence :global) ------ */
  nx-reel {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--ink);
    contain: paint;
    isolation: isolate;
  }
  @media (max-width: 600px) {
    nx-reel {
      aspect-ratio: 4 / 5;
    }
  }
  nx-reel picture,
  nx-reel :global(img.nxr-poster) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  nx-reel :global(img.nxr-poster) {
    object-fit: cover;
    object-position: top;
  }
  nx-reel :global(.nxr-fit),
  nx-reel :global(.nxr-w) {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
  }
  nx-reel :global(.nxr-w) {
    will-change: transform;
  }
  nx-reel :global(.nxr-w > *) {
    position: absolute;
    display: block;
    max-width: none;
  }
  nx-reel :global(.nxr-cur) {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    pointer-events: none;
    filter: drop-shadow(0 2px 3px color-mix(in oklab, var(--ink) 40%, transparent));
    will-change: transform, opacity;
  }
  nx-reel :global(.nxr-cur svg) {
    display: block;
    margin: -3px 0 0 -5px;
  }
  nx-reel :global(.nxr-cur path) {
    fill: var(--paper-raised);
    stroke: var(--ink);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  nx-reel :global(.nxr-touch i) {
    display: block;
    width: 40px;
    height: 40px;
    margin: -20px 0 0 -20px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--paper-raised) 55%, transparent);
    box-shadow:
      0 0 0 2px color-mix(in oklab, var(--paper-raised) 90%, transparent),
      0 2px 10px color-mix(in oklab, var(--ink) 30%, transparent);
  }
  nx-reel :global(.nxr-rip) {
    position: absolute;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    border-radius: 50%;
    border: 2px solid var(--paper-raised);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--ink) 25%, transparent);
    opacity: 0;
    pointer-events: none;
  }
  /* Play / Pause: an ink chip with a paper label (15.7:1), 44px tall. */
  nx-reel :global(.nxr-pp) {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 2;
    min-width: 44px;
    min-height: 44px;
    padding: 0 1rem;
    border: 0;
    border-radius: 2px;
    background: var(--ink);
    color: var(--paper);
    font: 600 0.875rem/44px var(--font-ui);
    cursor: pointer;
  }
  nx-reel :global(.nxr-pp:hover) {
    background: var(--marker);
  }
  /* The reel clips its overflow, so the ring is drawn as a shadow that fits in the gap. */
  nx-reel :global(.nxr-pp:focus-visible) {
    outline: none;
    box-shadow:
      0 0 0 3px var(--paper),
      0 0 0 6px var(--marker);
  }
</style>
