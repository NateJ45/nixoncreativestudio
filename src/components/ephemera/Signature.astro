/* Nathan's signature, "Nathan Nixon" in a quick, confident hand: a big looped N, joined
   lowercase, the t crossed and the i dotted after, and a sweeping line under it all. It is a
   design mark for this site, drawn for it as plain SVG strokes (Nathan asked for a made-up one,
   2026-11-16). It is not his legal signature and is not a scan of one.

   It writes itself: src/scripts/signature.js waits until it comes into view, then each stroke
   draws in pen order (src/styles/ephemera/signature.css). With no script, under reduced motion
   and on paper it is simply there, drawn.

   The drawing is aria-hidden. The name is in the markup as visually hidden text ("Signed,
   Nathan Nixon" by default, from site.ownerName); pass `said={false}` where the name is
   already said beside it or would muddle a link's name, and say it there instead.

   Size and ink come from the holder: --sig-w (width), --sig-ink (colour token, the studio blue
   by default) and --sig-pen (pen width in drawing units). Place it with `class`. `after` holds
   the pen a moment once it is in view (ms), for a signature on something still arriving. */
import '../../styles/ephemera/signature.css';
import { site } from '../../data/site';

interface Props {
  /** The visually hidden words that stand for the drawing, or false when they are said elsewhere. */
  said?: string | false;
  /** Extra classes, for placing it. */
  class?: string;
  /** Wait this many milliseconds after it comes into view before the pen starts. */
  after?: number;
}
const { said = `Signed, ${site.ownerName}`, class: extra, after } = Astro.props;

/* The strokes, in the order the pen makes them. Drawn on an upright grid (baseline at 70),
   slanted, and rounded to one decimal. dur and at are seconds: longer strokes run faster per
   unit of length, with a lift of the pen between the words and before each light stroke. */
