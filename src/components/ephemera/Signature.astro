<span class={['sig', extra].filter(Boolean).join(' ')} data-sig data-sig-after={after}>
  <svg viewBox="-6 -2 384 98" aria-hidden="true" focusable="false">
    {strokes.map((s) => (
      <path d={s.d} pathLength="1" class={s.cls} style={`--d:${s.dur}s;--at:${s.at}s`} />
    ))}
  </svg>
  {said && <span class="vh">{said}</span>}
</span>

<script>
  import '../../scripts/signature.js';
</script>
