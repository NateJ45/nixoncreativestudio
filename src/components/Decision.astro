---
/* "The easy version" against "what I did". Taken from the study's own approach
   text and designer note, in the MDX. */
import { inline } from '../lib/study-markup';

interface Props {
  title: string;
  easy: string;
  did: string;
}
const { title, easy, did } = Astro.props;
---

<article class="dec rv">
  <h3 set:html={inline(title)} />
  <dl>
    <div class="dec-easy">
      <dt>The easy version</dt>
      <dd set:html={inline(easy)} />
    </div>
    <div class="dec-did">
      <dt>What I did</dt>
      <dd set:html={inline(did)} />
    </div>
  </dl>
</article>
