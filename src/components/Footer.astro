---
// Foundation, edit with care. The "Currently" line is a field in Site settings
// (EmDash admin), so it changes whenever the season does with no code edit.
/* ============================================================================
   Site Footer
   ============================================================================
   Bottom of every page, on the deep ground (ink board, still: the lamp only
   moves in a page's own deep band, never in the footer). Redesigned
   2026-10-04 (DESIGN.md "Footer").

   Top: the white logo lockup and the "Currently" status with the Start a
   project button. Then three short columns: Explore (the footer menu),
   Contact, Connect. Bottom row: copyright, the legal links, the tagline.

   Contact details, social URLs, studio name, CTA label and tagline come from
   Site settings through getSite(); the nav is the "footer" menu. Everything
   inside is .on-ink (the Band sets it), so text-link is vermilion, headings
   are paper, and the brand button is a paper button with an ink label.
   ============================================================================ */

import Band from './Band.astro';
import Logo from './Logo.astro';
import { getSite } from '../data/site';
import { getMenuItems } from '../lib/cms';
import { hasJournalEntries } from '../lib/journal';
import { buttonVariants } from './ui/button';

const year = new Date().getFullYear();

const site = await getSite(Astro);
const menu = await getMenuItems('footer', { cache: Astro.cache });

// Journal appears only once the journal has a published entry, exactly as in
// Header.astro (the same memoised answer; a draft does not count).
const showJournal = await hasJournalEntries(Astro);
const navLinks = menu
  .filter((item) => showJournal || !item.url.startsWith('/journal'))
  .map((item) => ({ label: item.label, href: item.url, target: item.target }));

const social = [
  { label: 'Instagram', href: site.social.instagram },
  { label: 'LinkedIn', href: site.social.linkedin },
];

const legal = [
  { label: 'Colophon', href: '/colophon/' },
  { label: 'Privacy', href: '/privacy/' },
  { label: 'Accessibility', href: '/accessibility/' },
];
---

<Band ground="deep" still as="footer" class="site-footer">
  <div class="footer-top">
    <div class="footer-brand">
      <Logo tone="white" width={300} class="footer-logo" />
    </div>

    <!-- "Currently": availability, linking to the snapshot on /about, and the
         action itself. -->
    <div class="footer-now">
      <h2 class="footer-heading">Currently</h2>
      <a href="/about/#now" class="footer-status">
        <span class="status-dot" aria-hidden="true"></span>
        <span>Booking projects</span>
      </a>
      <p class="footer-currently">{site.footerCurrently}</p>
      <a href="/contact/" class={buttonVariants({ variant: 'brand', size: 'cta' })}>
        {site.headerCtaLabel}
        <span data-nudge aria-hidden="true">
          &rarr;
        </span>
      </a>
    </div>
  </div>

  <div class="footer-columns">
    <nav aria-label="Site pages">
      <h2 class="footer-heading">Explore</h2>
      <ul>
        {navLinks.map(({ label, href, target }) => (
          <li>
            <a
              class="footer-link"
              href={href}
              target={target}
              rel={target === '_blank' ? 'noopener noreferrer' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="footer-heading">Contact</h2>
      <ul>
        <!-- A plain mailto link: src/scripts/mailto-fallback.ts copies the
             address and says so when no mail app opens. -->
        <li>
          <a class="footer-link" href={site.emailHref}>
            {site.email}
          </a>
        </li>
        <li>
          <a class="footer-link" href={site.phoneHref}>
            {site.phone}
          </a>
        </li>
        <li class="footer-plain">{site.address}</li>
      </ul>
    </div>

    <div>
      <h2 class="footer-heading">Connect</h2>
      <ul>
        {social.map(({ label, href }) => (
          <li>
            <a class="footer-link" href={href} target="_blank" rel="noopener noreferrer">
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="footer-base">
    <p class="footer-meta">
      <small>
        &copy; {year} {site.studioName}
      </small>
    </p>
    <nav aria-label="Legal and accessibility" class="footer-legal">
      {legal.map(({ label, href }) => (
        <a class="footer-link" href={href}>
          {label}
        </a>
      ))}
    </nav>
    <p class="footer-tagline">
      <small>{site.tagline}</small>
    </p>
  </div>
</Band>

<style>
  :global(.site-footer) {
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    padding-bottom: calc(var(--spacing-l) + env(safe-area-inset-bottom));
  }
  .footer-top {
    display: grid;
    gap: var(--spacing-l);
    padding-bottom: var(--spacing-xl);
    border-bottom: 1px solid var(--border);
  }
  .footer-brand :global(.footer-logo) {
    width: min(300px, 78vw);
  }
  .footer-now {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 34rem;
  }
  .footer-currently {
    margin: 0 0 0.5rem;
    font-family: var(--font-serif);
    font-size: var(--text-lede);
    line-height: 1.35;
    color: var(--foreground);
  }
  @media (min-width: 64rem) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .footer-heading {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--heading);
  }

  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--tap);
    color: var(--foreground);
    text-decoration: none;
  }
  .footer-status:hover span:last-child {
    text-decoration: underline;
    text-decoration-color: var(--marker);
    text-underline-offset: 0.2em;
  }
  /* The live dot: vermilion, with one soft ring that pulses (reduced-motion
     safe). The only looping mark in the footer, and it carries information. */
  .status-dot {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--marker-hot);
  }
  @media (prefers-reduced-motion: no-preference) {
    .status-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--marker-hot);
      animation: status-ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
  }
  @keyframes status-ping {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    75%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--spacing-l);
    padding-block: var(--spacing-xl);
  }
  .footer-columns ul {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .footer-link {
    color: var(--link);
    text-decoration: none;
  }
  .footer-link:hover,
  .footer-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .footer-plain {
    color: var(--muted-foreground);
  }
  /* 44px tap rows on touch devices and narrow screens; a mouse on a wide
     screen keeps the compact density. */
  @media (pointer: coarse), (max-width: 47.99rem) {
    .footer-columns .footer-link,
    .footer-legal .footer-link {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap);
    }
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    padding-top: var(--spacing-m);
    border-top: 1px solid var(--border);
    color: var(--muted-foreground);
  }
  .footer-base p {
    margin: 0;
  }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }
  .footer-tagline {
    flex-basis: 100%;
  }
  @media (min-width: 64rem) {
    .footer-tagline {
      flex-basis: auto;
      margin-left: auto !important;
    }
  }
</style>
