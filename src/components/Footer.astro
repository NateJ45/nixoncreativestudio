---
// Foundation, edit with care. The "Currently" blurb below is content that is
// safe to edit by hand whenever the season changes.
/* ============================================================================
   Site Footer (overhaul package 2.1)
   ============================================================================
   Bottom of every page, and the page's last word. The whole footer is a
   .band-ink block, navy in BOTH themes (Nathan's decision 4), so every page
   ends on ink. .band-ink re-scopes the text roles to light-on-navy values
   that hold AA in both themes (src/lib/ncs-tokens.test.ts), so everything in
   here uses the normal tokens (text-heading, text-link, text-text-muted).

   1. The closer. One static H2 (300 lead, <b> at 800, never Heft) with an
      optional line, then the email and the CTA pill. Each page sets it with
      BaseLayout's `closer` prop (src/lib/closer.ts has the shape and the
      default). This replaced the old CtaBanner.
   2. A hairline, then four columns:
        Work       every case study, computed from the collection and grouped
                   by sector, so a new study shows up here on its own.
        Studio     the gated site nav from src/data/nav.ts. id="site-nav": the
                   mobile menu button links here, so the menu works with no
                   JavaScript (CLAUDE.md never-break rule 8). Keep the id.
        Contact    email (with copy), phone, Cincinnati, social, from site.ts.
        Currently  the booking dot (when site.bookingOpen) and the blurb.
   3. The utility row: copyright, Colophon, Privacy, Accessibility, and the
      Pause motion switch.

   The old ghost wordmark is gone, and nothing here fades in on scroll: on a
   short page the footer is in the first viewport, and it should simply be
   there.
   ============================================================================ */

import { getCollection } from 'astro:content';
import { getFooterNav } from '../data/nav';
import { site } from '../data/site';
import { DEFAULT_CLOSER, SECTOR_PLURAL, type Closer } from '../lib/closer';
import CopyEmail from './CopyEmail.astro';
import MotionToggle from './MotionToggle.astro';
import { buttonVariants } from './ui/button';
import { cn } from '@/lib/utils';

interface Props {
  /** The page's closer. Leave it out for the default. */
  closer?: Closer;
}

const { closer = DEFAULT_CLOSER } = Astro.props;
const {
  heading,
  emphasis,
  sub,
  href = '/contact/',
  label = 'Start a project',
  cta = true,
} = closer;

// Year stamp on the copyright, recomputed at build time.
const year = new Date().getFullYear();

// Studio column: the header's list plus Contact, gated in src/data/nav.ts.
const navLinks = await getFooterNav();

// Work column: every case study in loop order (the `order` field, which the
// /work page also follows), grouped by sector. Groups appear in the order
// their first study does, so nothing here is typed in by hand.
const studies = (await getCollection('case-studies')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);
const groups = new Map<string, { label: string; studies: typeof studies }>();
for (const study of studies) {
  const key = study.data.sector;
  if (!groups.has(key)) groups.set(key, { label: SECTOR_PLURAL[key] ?? key, studies: [] });
  groups.get(key)!.studies.push(study);
}

const social = [
  { label: 'Instagram', href: site.social.instagram },
  { label: 'LinkedIn', href: site.social.linkedin },
];

// "Currently" blurb. Short, present-tense, swappable per season.
const currently =
  'Booking small business and nonprofit web projects for the season ahead, with a few photography days mixed in.';

// Every text link in the columns. On a touch device each becomes a 44px row
// (pointer:coarse, so phones and tablets both get it while a mouse keeps the
// compact desktop density).
const linkClass =
  'text-link no-underline transition-colors duration-150 ' +
  'hover:underline hover:underline-offset-2 ' +
  'focus-visible:underline focus-visible:underline-offset-2 ' +
  'pointer-coarse:inline-flex pointer-coarse:min-h-11 pointer-coarse:min-w-11 pointer-coarse:items-center';

// Column headings: h2s at the h6 size so they read as labels.
const headingClass = 'text-h6 text-heading mb-s';
---

<footer class="band-ink site-footer" transition:name="site-footer">
  <div class="ncs-container">
    {/* 1. The closer. */}
    <section class="closer pt-section pb-xl" aria-labelledby="closer-title">
      <h2 id="closer-title" class="closer-title max-w-[20ch] text-heading">
        {heading}
        {emphasis && (
          <>
            {' '}
            <b>{emphasis}</b>
          </>
        )}
      </h2>
      {sub && <p class="mt-m max-w-[52ch] text-lg leading-[1.5] text-text">{sub}</p>}
      <div class="mt-l flex flex-wrap items-center gap-x-l gap-y-m">
        {cta && (
          <a
            href={href}
            class={cn(buttonVariants({ variant: 'brand', size: 'cta' }), 'rounded-full')}
          >
            {label}
          </a>
        )}
        <a href={site.emailHref} class="closer-email text-link">
          {site.email}
        </a>
      </div>
    </section>

    {/* 2. Hairline, then the columns: one on phones, two from sm, four from
        lg, with Contact widest so the email and its copy button fit. */}
    <div class="hairline grid gap-l pt-xl pb-xl sm:grid-cols-2 lg:grid-cols-[1.1fr_0.7fr_1.3fr_1fr]">
      <nav aria-label="Case studies">
        <h2 class={headingClass}>Work</h2>
        <div class="flex flex-col gap-m">
          {[...groups.values()].map((group) => (
            <div>
              <h3 class="footer-sector mb-xs font-mono text-xs tracking-[0.08em] text-text-muted uppercase">
                {group.label}
              </h3>
              <ul class="flex flex-col gap-xs">
                {group.studies.map((study) => (
                  <li>
                    <a class={linkClass} href={`/work/${study.id}/`}>
                      {study.data.client}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </nav>

      <nav id="site-nav" aria-label="Site pages">
        <h2 class={headingClass}>Studio</h2>
        <ul class="flex flex-col gap-xs">
          {navLinks.map(({ label, href }) => (
            <li>
              <a class={linkClass} href={href}>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class={headingClass}>Contact</h2>
        <ul class="flex flex-col gap-xs">
          <li>
            <CopyEmail email={site.email} tone="ink" />
          </li>
          <li>
            <a class={linkClass} href={site.phoneHref}>
              {site.phone}
            </a>
          </li>
          <li class="text-text">{site.address}</li>
          {social.map(({ label, href }) => (
            <li>
              <a class={linkClass} href={href} target="_blank" rel="noopener noreferrer">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class={headingClass}>Currently</h2>
        {site.bookingOpen && (
          <a
            href="/about/#now"
            class="booking-chip mb-s inline-flex items-center gap-s rounded-pill border border-line-strong px-3 py-1.5 text-sm text-text no-underline transition-colors duration-150 hover:border-text pointer-coarse:min-h-11"
          >
            <span class="relative flex h-2 w-2" aria-hidden="true" data-motion="loop">
              <span class="status-ping absolute inline-flex h-full w-full rounded-full bg-live opacity-75" />
              <span class="relative inline-flex h-2 w-2 rounded-full bg-live" />
            </span>
            <span>Booking projects</span>
            <span aria-hidden="true">→</span>
          </a>
        )}
        <p class="leading-[1.5] text-text-muted">{currently}</p>
      </div>
    </div>

    {/* 3. Utility row. */}
    <div class="hairline flex flex-col items-start gap-s pt-m pb-l text-sm text-text-muted sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-m">
      <div class="flex flex-wrap items-center gap-x-m gap-y-1">
        <small>
          © {year} {site.studioName}
        </small>
        <nav
          aria-label="Legal and accessibility"
          class="flex flex-wrap items-center gap-x-m gap-y-1"
        >
          <a class={linkClass} href="/colophon/">
            Colophon
          </a>
          <a class={linkClass} href="/privacy/">
            Privacy
          </a>
          <a class={linkClass} href="/accessibility/">
            Accessibility
          </a>
        </nav>
      </div>
      <MotionToggle />
    </div>
  </div>
</footer>

<style>
  /* In dark mode --paper and --ink are the same navy, so a paper section
     would run straight into the closer with no edge. A 1px hairline on top
     of the footer marks the change (overhaul 2.9). .band-ink re-scopes
     --line to its own navy hairline. Light mode keeps its look: white or
     paper against ink is already a clear edge. */
  :global(.dark) .site-footer {
    border-top: 1px solid var(--line);
  }

  /* The closer's H2 takes the global h2 size and weight (300, <b> at 800);
     this only keeps a long heading from crowding the pill. */
  .closer-title {
    text-wrap: balance;
  }

  /* The closer email: a link-coloured line beside the pill, 44px tall so it
     is a real tap target, and allowed to wrap at 320px. */
  .closer-email {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .closer-email:hover,
  .closer-email:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Booking dot pulse. Honours reduced motion, and holds still under Pause
     motion (data-motion="loop" on its wrapper). */
  @media (prefers-reduced-motion: no-preference) {
    .status-ping {
      animation: status-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
  }
  @keyframes status-ping {
    0% {
      transform: scale(1);
      opacity: 0.75;
    }
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
</style>
