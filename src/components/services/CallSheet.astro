---
// Safe to edit. The shot list is the Photography offering's "included" lines and
// the rate paragraph is the Photography add-on's note (both CMS content, passed
// in by the page). The sheet's row names and the "Where" line are code.
/* ============================================================================
   CallSheet | what a photo day is, set as a photographer's call sheet
   ============================================================================
   The Photography chapter on /services used to show an empty dotted panel with
   a camera icon (redesign 2026, A item 10: a placeholder on a photographer's
   site costs trust). There is no client photograph by Nathan in the repo yet,
   so instead of a stand-in this draws the document a photo day actually runs
   on: a call sheet with the rate, the area and the shot list, and a print of
   the photographer pinned to its corner (his real headshot, captioned as what
   it is, never presented as client work).

   When real client photographs exist (the `photos` collection), a frame of one
   belongs beside this sheet; see docs/PENDING.md.
   ============================================================================ */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  /** The Photography offering's starting price (USD), e.g. 900. */
  priceFrom?: number;
  /** The Photography add-on's note: what a half day and a full day cost. */
  rateNote?: string;
  /** The offering's included lines: the shot list. */
  shots: string[];
  headshot: ImageMetadata;
  headshotAlt: string;
}
const { priceFrom, rateNote, shots, headshot, headshotAlt } = Astro.props;
---

<figure class="call" aria-labelledby="call-caption">
  <div class="call-sheet">
    <p class="call-title">
      <span class="call-name">Call sheet</span>
      <span class="call-meta">Photo day</span>
    </p>
    <dl class="call-rows">
      {priceFrom !== undefined && (
        <div>
          <dt>Rate</dt>
          <dd>
            <span class="call-figure">
              <span class="call-from">from</span> ${priceFrom.toLocaleString('en-US')}
            </span>
            {rateNote && <span class="call-note">{rateNote}</span>}
          </dd>
        </div>
      )}
      <div>
        <dt>Where</dt>
        <dd>On site, across the greater Cincinnati region</dd>
      </div>
      <div>
        <dt>Shot list</dt>
        <dd>
          <ul role="list">
            {shots.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </dd>
      </div>
    </dl>
  </div>

  <div class="call-print">
    <Image
      src={headshot}
      alt={headshotAlt}
      widths={[240, 360, 480]}
      sizes="(min-width: 64rem) 13rem, 40vw"
      loading="lazy"
      class="call-img"
    />
  </div>
  <figcaption id="call-caption" class="type-caption call-caption">
    The photographer: Nathan, the same person who designs the site.
  </figcaption>
</figure>

<style>
  .call {
    position: relative;
    margin: 0;
    max-width: 34rem;
    padding-top: 1.75rem;
  }
  .call-sheet {
    background: var(--paper-raised);
    color: var(--foreground);
    border-radius: 2px;
    box-shadow: var(--shadow-print);
    padding: clamp(1.25rem, 3vw, 2rem);
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
  }
  .call-title {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin: 0 0 0.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 3px double var(--heading);
    /* leave room for the pinned print on the right */
    padding-right: min(36%, 10rem);
  }
  .call-name {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--heading);
  }
  .call-meta {
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    color: var(--muted-foreground);
  }
  .call-rows {
    margin: 0;
  }
  .call-rows > div {
    display: grid;
    gap: 0.35rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--border);
  }
  .call-rows > div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  @media (min-width: 40rem) {
    .call-rows > div {
      grid-template-columns: 6.5rem 1fr;
      gap: 1rem;
    }
  }
  .call-rows dt {
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--muted-foreground);
    padding-top: 0.2rem;
  }
  .call-rows dd {
    margin: 0;
    font-size: var(--text-body);
    line-height: 1.5;
  }
  .call-figure {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: 0.95;
    color: var(--heading);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .call-from {
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    color: var(--muted-foreground);
  }
  .call-note {
    display: block;
    margin-top: 0.5rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--muted-foreground);
  }
  .call-rows ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  .call-rows li {
    position: relative;
    padding-left: 1.1rem;
  }
  .call-rows li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.55rem;
    border-top: 1px solid var(--muted-foreground);
  }

  /* The print pinned over the top-right corner, a little off square. */
  .call-print {
    position: absolute;
    top: 0;
    right: clamp(-1rem, -2vw, 0rem);
    width: min(34%, 9.5rem);
    padding: 0.4rem 0.4rem 1.4rem;
    background: var(--paper-raised);
    box-shadow: var(--shadow-print);
    transform: rotate(3deg);
  }
  .call-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .call-caption {
    margin-top: 1rem;
  }
</style>
