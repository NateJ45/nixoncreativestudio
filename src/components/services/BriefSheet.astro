---
// Safe to edit. The lines on the sheet are code (no CMS field holds them); each
// one restates something the Strategy offering and the process steps already
// promise, so keep them in step with those entries if either changes.
/* ============================================================================
   BriefSheet | the one-page brief, drawn as the physical page it is
   ============================================================================
   The Strategy chapter on /services ends in "a one-page brief the rest of the
   project follows", and the first process step ends with both people signing
   it. This draws that page: a sheet of raised paper with six ruled lines, two
   signature lines and a red-pen note in the margin. It is a diagram of a real
   document, not a photograph and not a placeholder (redesign 2026, A item 10:
   no placeholder panels; d2 mock-up: "the brief as a physical document").

   Every line on it is sourced:
     who the site is for          Strategy: "Audience map"
     what each page is for        Strategy body: "decides what each page is for"
     how a visitor reaches you    Strategy: "conversion path"
     what you already have        Strategy: "Content inventory"
     the timeline                 FAQ: "The brief ... sets the real timeline"
     signatures                   Process step 1: "we both sign off"

   It is a <figure> with a caption; the list is real text (read in order by a
   screen reader), the signature lines are decorative.
   ============================================================================ */

const LINES: { title: string; detail: string }[] = [
  { title: 'Who the site is for', detail: 'Your visitors, in the order they matter.' },
  { title: 'What each page is for', detail: 'One job per page, in a sentence.' },
  {
    title: 'How a visitor reaches you',
    detail: 'The path from first visit to a call, a gift or a sign-up.',
  },
  { title: 'What you already have', detail: 'Words, photos and documents worth keeping.' },
  { title: 'The timeline', detail: 'Kickoff to launch, in weeks.' },
];
---

<figure class="brief" aria-labelledby="brief-caption">
  <div class="brief-page">
    <p class="brief-title">
      <span class="brief-name">The brief</span>
      <span class="brief-meta">One page</span>
    </p>
    <ol class="brief-lines" role="list">
      {LINES.map((line, i) => (
        <li>
          <span class="brief-num" aria-hidden="true">
            {i + 1}
          </span>
          <span>
            <strong>{line.title}</strong>
            <span class="brief-detail">{line.detail}</span>
          </span>
        </li>
      ))}
    </ol>
    <div class="brief-sign" aria-hidden="true">
      <span>You</span>
      <span>Nathan</span>
    </div>
    <p class="brief-pen">The rest of the project follows this page.</p>
  </div>
  <figcaption id="brief-caption" class="type-caption brief-caption">
    We write it together after the first conversation and both sign it. Every later decision is
    checked against it.
  </figcaption>
</figure>

<style>
  .brief {
    margin: 0;
    max-width: 30rem;
  }
  .brief-page {
    position: relative;
    background: var(--paper-raised);
    color: var(--foreground);
    border-radius: 2px;
    box-shadow: var(--shadow-print);
    padding: clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 3vw, 2.25rem) 1.75rem;
  }
  .brief-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 0.75rem;
    padding-bottom: 0.6rem;
    border-bottom: 3px double var(--heading);
  }
  .brief-name {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--heading);
  }
  .brief-meta {
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    color: var(--muted-foreground);
  }
  .brief-lines {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .brief-lines li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.5rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--border);
    line-height: 1.35;
  }
  .brief-num {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.1;
    color: var(--muted-foreground);
  }
  .brief-lines strong {
    display: block;
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    font-weight: 600;
    color: var(--heading);
  }
  .brief-detail {
    display: block;
    margin-top: 0.15rem;
    font-size: 1rem;
    color: var(--muted-foreground);
  }
  .brief-sign {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2.25rem;
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    color: var(--muted-foreground);
  }
  .brief-sign span {
    padding-top: 0.4rem;
    border-top: 1px solid var(--heading);
  }
  /* The red-pen note, written across the foot of the page. */
  .brief-pen {
    margin: 1.25rem 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.3;
    color: var(--marker);
    transform: rotate(-1.5deg);
    transform-origin: left center;
  }
  .brief-caption {
    margin-top: 1rem;
    max-width: 36ch;
  }
</style>
