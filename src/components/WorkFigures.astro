---
/* What changed, on /work: every sourced figure from the case studies, one card each in that client's
   color, stacked so each card slides up over the last as you scroll (position: sticky, styles in
   work.css). The figures are read out of each study's ResultsBlock (src/lib/work-figures.ts), so
   nothing here is typed and a figure only appears once it names its source.

   Beside each number is the thing it counts: a capture of the real page where the number lives, with
   a line saying what it is. A number that is part of a stated whole ("195 of 216") also gets a bar
   with that sentence beside it. work.js settles the capture and draws the bar as a card arrives;
   with no script or under reduced motion both are simply there. The figure itself is plain static
   text. (Until 2026-11-10 this was a grid of dots, one per so-many units, which said only "big".) */
import { getCollection } from 'astro:content';
import type { Client } from '../lib/clients';
import { inline, studyImage } from '../lib/study-markup';
import { share, sourcedFigures } from '../lib/work-figures';

interface Props {
  /** The clients in deck order, as /work already has them. */
  clients: Client[];
}
const { clients } = Astro.props;
const entries = await getCollection('case-studies');
const cards = clients.flatMap((client) => {
  const body = entries.find((e) => e.id === client.slug)?.body ?? '';
  return sourcedFigures(body).map((f) => {
    const img = f.shot ? studyImage(f.shot) : undefined;
    return { client, ...f, img, part: share(f), wide: img ? img.w / img.h > 2.4 : false };
  });
});
---

{cards.length > 0 && (
  <section class="wf" aria-labelledby="wf-h" data-figures>
    <div class="wf-head">
      <h2 id="wf-h">What changed</h2>
      <p>
        The numbers from the case studies, each beside the page it counts and with where it came
        from, so you can check it. They are counts and measurements, not promises.
      </p>
    </div>
    <ol class="wf-stack">
      {cards.map((c, i) => (
        <li
          class:list={['wf-card', { wide: c.wide, bare: !c.img }]}
          style={`--c:${c.client.accent};--p:${c.client.paper};--i:${i}`}
        >
          <div class="wf-say">
            <p class="wf-who">{c.client.name}</p>
            <p class="wf-num">{c.figure}</p>
            <p class="wf-text" set:html={inline(c.text)} />
            {c.part && (
              <p class="wf-part">
                <span class="wf-bar" aria-hidden="true" style={`--r:${c.part.ratio.toFixed(4)}`}>
                  <i />
                </span>
                <span class="wf-part-t">{c.part.words}</span>
              </p>
            )}
            <p class="wf-src" set:html={`Source: ${inline(c.source)}`} />
            <a href={c.client.study}>
              Read the case study<span class="vh">: {c.client.name}</span>
            </a>
          </div>
          {c.img && (
            <figure class="wf-shot">
              <img
                src={c.img.url}
                width={c.img.w}
                height={c.img.h}
                alt={c.shotAlt ?? ''}
                loading="lazy"
                decoding="async"
              />
              {c.shotNote && <figcaption>{c.shotNote}</figcaption>}
            </figure>
          )}
        </li>
      ))}
    </ol>
  </section>
)}
