---
// Safe to edit.
/* ============================================================================
   BackToTop
   ============================================================================
   Floating button bottom-right that fades in once the visitor has scrolled
   past 600px and scrolls smoothly back to the top when clicked. Hidden until
   then so it never covers the hero or a short page.

   While hidden it is also `inert`, so Tab never lands on an invisible button.
   Without JavaScript it simply stays hidden (the browser's own Home key and
   the skip link still work).

   Reduced motion: the scroll jumps instead of gliding, and the global rule in
   globals.css turns the fade into an instant swap.

   Rendered once in BaseLayout, so it is on every page.
   ============================================================================ */

import ChromeIcon from './ChromeIcon.astro';
import { buttonVariants } from './ui/button';
import { cn } from '@/lib/utils';
---

<button
  type="button"
  data-back-to-top
  inert
  aria-label="Back to top"
  title="Back to top"
  class={cn(
    buttonVariants({ variant: 'brand', size: 'icon-lg' }),
    // size-11 (44px) is the comfortable touch target; icon-lg alone is 36px.
    // The offsets hold a 1.5rem gap but grow to clear the home indicator or
    // notch under viewport-fit=cover (env() is 0 on other devices).
    'back-to-top fixed right-[max(1.5rem,env(safe-area-inset-right))] bottom-[max(1.5rem,env(safe-area-inset-bottom))] z-40 size-11 rounded-full shadow-lg transition-opacity duration-200',
  )}
>
  <ChromeIcon name="arrow-up" class="size-5" />
</button>

<style>
  .back-to-top[inert] {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  /** Pixels scrolled before the button appears: past the hero, into the read. */
  const SHOW_AFTER_PX = 600;

  const button = (): HTMLButtonElement | null =>
    document.querySelector<HTMLButtonElement>('[data-back-to-top]');

  function update(): void {
    button()?.toggleAttribute('inert', window.scrollY <= SHOW_AFTER_PX);
  }

  // One scroll listener for the tab's life (this module runs once); it looks
  // the button up each time because a navigation swaps the body.
  window.addEventListener('scroll', update, { passive: true });

  function init(): void {
    const el = button();
    if (el && !el.dataset.bound) {
      el.dataset.bound = 'true';
      el.addEventListener('click', () => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });
    }
    update();
  }
  document.addEventListener('astro:page-load', init);
</script>
