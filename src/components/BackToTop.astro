---
// Safe to edit.
/* ============================================================================
   BackToTop
   ============================================================================
   A small ink button, bottom right, that appears once the visitor has
   scrolled past 600px and takes them back to the top. Rendered once in
   BaseLayout. Plain HTML and a few lines of script: it replaced the React
   island of the same name in the 2026 redesign, so React is no longer
   downloaded on every page just for this.

   Hidden state uses visibility as well as opacity, so the button is out of
   the tab order until it shows. Under reduced motion the scroll jumps and the
   fade is instant (the global reduced-motion rule).
   ============================================================================ */
---

<button
  type="button"
  class="back-to-top"
  aria-label="Back to top"
  title="Back to top"
  data-back-to-top
>
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7"></path>
  </svg>
</button>

<script>
  const SHOW_AFTER_PX = 600;
  function bindBackToTop(): void {
    const btn = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = 'true';
    const update = () => btn.toggleAttribute('data-visible', window.scrollY > SHOW_AFTER_PX);
    update();
    window.addEventListener('scroll', update, { passive: true });
    btn.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
  document.addEventListener('astro:page-load', bindBackToTop);
</script>

<style>
  .back-to-top {
    position: fixed;
    z-index: 40;
    right: max(1.25rem, env(safe-area-inset-right));
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: var(--ink);
    color: var(--paper);
    box-shadow: var(--shadow-print);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      visibility 0s linear 0.2s,
      background-color 0.2s ease;
  }
  .back-to-top[data-visible] {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.2s ease,
      visibility 0s,
      background-color 0.2s ease;
  }
  .back-to-top:hover {
    background: var(--marker);
  }
  .back-to-top svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
