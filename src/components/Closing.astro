---
/* The closing panel every page ends on: the page's line, the way to reach me,
   the selected work beside its deck (a name pulls its card out), a last card
   that says in words "Your site could be next. Start a project", the site index
   (with the light and dark switch in its fine print), and the name at poster size,
   dealt up letter by letter. Everything here is real markup; kit.js only moves things. Keep a neutral
   section between this and a quote band, so the two colors never touch. */
import { site } from '../data/site';
import { getClients } from '../lib/clients';
import { getGatedNav } from '../data/nav';
import { webTiers } from '../data/pricing';
import ThemeFlip from './ThemeFlip.astro';

interface Props {
  /** The line, as HTML with the heavy words in <b>. */
  lead?: string;
}
const { lead = 'Tell me what you are <b>building.</b>' } = Astro.props;
const clients = await getClients();
const gated = await getGatedNav();
const [first, second, third] = site.studioName.split(' ');
const here = Astro.url.pathname;
const fromPrice = Math.min(...webTiers.map((t) => t.priceFrom)).toLocaleString('en-US');
const year = new Date().getFullYear();
/* The poster name, one span a letter, so each can be dealt up. The whole line is aria-hidden. */
const letters = (word: string) => [...word];
---

<section data-end class="end" aria-label="Start a project">
  <div class="end-top label">
    {site.bookingOpen && (
      <span class="end-live">
        <i />
        Taking new projects
      </span>
    )}
    <span>{site.address}</span>
  </div>
  <div class="end-main">
    <div class="end-say">
      <h2 set:html={lead} />
      <p>
        {site.firstConversation} {site.replyPromise}
      </p>
      <div class="end-links">
        <a class="chip" href="/contact/">
          Start a project
        </a>
        <a class="chip ghost" href={site.emailHref}>
          {site.email}
        </a>
        <a class="chip ghost" href={site.smsHref}>
          Text {site.phone}
        </a>
      </div>
    </div>
    <nav class="end-work" aria-label="Selected work">
      <span class="label">Selected work</span>
      <ul>
        {clients.map((s, i) => (
          <li>
            <a href={s.study} data-pull={i} aria-current={here === s.study ? 'page' : undefined}>
              <b>{s.name}</b>
              <span class="label">{s.sector}</span>
            </a>
          </li>
        ))}
        <li class="end-slide" data-pull-slide aria-hidden="true" />
      </ul>
      <a class="end-all" href="/work/">
        See all the work
      </a>
    </nav>
    <div class="gather" data-gather>
      <div class="gather-deck" aria-hidden="true">
        {clients.map((s) => (
          <span class="gc" style={`--c:${s.accent}`}>
            <img
              src={s.still}
              srcset={s.stillSet}
              sizes="(max-width: 52rem) min(36vw, 9.5rem), clamp(9.5rem, 13vw, 13.5rem)"
              alt=""
              loading="lazy"
              width="584"
              height="1138"
            />
          </span>
        ))}
      </div>
      <a class="nine" href="/contact/" data-nine>
        <span class="label">Your site could be next</span>
        <strong>Start a project</strong>
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="M4 10h11M11 5.5 15.5 10 11 14.5"></path>
        </svg>
      </a>
    </div>
  </div>
  <nav class="end-index" aria-label="Site">
    <div>
      <span class="label">Websites for</span>
      <a href="/churches/">Churches</a>
      <a href="/schools/">Schools</a>
      <a href="/nonprofits/">Nonprofits</a>
      <a href="/small-business/">Small businesses</a>
    </div>
    <div>
      <span class="label">The studio</span>
      <a href="/services/">Prices, from ${fromPrice}</a>
      <a href="/about/">About</a>
      <a href="/now/">What I'm doing now</a>
      <a href="/one-page/">The one-page summary</a>
      {gated.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </div>
    <div>
      <span class="label">Elsewhere</span>
      <a href={site.social.linkedin} rel="me noopener">
        LinkedIn
      </a>
      <a href={site.social.instagram} rel="me noopener">
        Instagram
      </a>
      <a href={site.social.facebook} rel="me noopener">
        Facebook
      </a>
    </div>
    <div>
      <span class="label">The fine print</span>
      <a href="/privacy/">Privacy</a>
      <a href="/accessibility/">Accessibility</a>
      <a href="/colophon/">How this site is built</a>
      <ThemeFlip where="end" />
    </div>
  </nav>
  <div class="end-name" data-name aria-hidden="true">
    <p>
      <b>
        {letters(first).map((c) => (
          <i>{c}</i>
        ))}
      </b>
      <span>
        {letters(second).map((c) => (
          <i>{c}</i>
        ))}
      </span>
      <span>
        {letters(third).map((c) => (
          <i>{c}</i>
        ))}
      </span>
    </p>
  </div>
  <div class="end-base">
    <span>
      &copy; {year} {site.studioName}
    </span>
    <a href="#main">Back to top</a>
  </div>
</section>
