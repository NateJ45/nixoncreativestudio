---
// Safe to edit.
/* ============================================================================
   DesignerNote
   ============================================================================
   A short, signed note from Nathan reflecting on a case study, rendered from the
   `designerNote` frontmatter string. It replaces the old prose "Reflections"
   section with a personal, signed aside: the human voice behind the work, which
   is a real differentiator for a one-person studio.

   The signature is a visual treatment (the owner name from Site settings in the
   display face), so the frontmatter only carries the note text. Keep the note
   honest and specific to the project; it was drafted from each study's existing
   "Reflections" prose and honesty-checked before wiring in.

   Rendered by src/pages/work/[slug].astro in its closing band. To edit, change the
   case study's Designer note field in the admin.
   ============================================================================ */
import { getSite } from '../data/site';

interface Props {
  /** The note body (1-3 sentences). The signature is added below it. */
  note: string;
}
const { note } = Astro.props;
// The signature name is the owner name in Site settings (CMS, with the fallback).
const site = await getSite(Astro);
---

<aside class="ncs-note" aria-labelledby="ncs-note-title">
  <h2 id="ncs-note-title" class="type-headline ncs-note-title">
    A note from <span class="voice">the designer</span>
  </h2>
  <p class="ncs-note-body">{note}</p>
  <p class="ncs-note-sign">{site.ownerName}</p>
</aside>

<style>
  /* No side-tab border (a known AI tell) and no mono eyebrow (DESIGN.md). The
     note reads as signed through type alone: a Bebas headline turning into the
     italic voice, the note in the reading serif italic at lede size, and the
     owner name set in the display face like a signature. */
  .ncs-note {
    display: grid;
    gap: var(--spacing-m);
    max-width: 44rem;
  }
  .ncs-note-title {
    margin: 0;
  }
  .ncs-note-body {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-lede);
    line-height: 1.45;
    color: var(--heading);
    text-wrap: pretty;
  }
  .ncs-note-sign {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--marker);
  }
</style>
