---
// Safe to edit. The four steps below are content; rewrite them in place when
// the process sharpens.
/* ============================================================================
   ProcessBand: "How I work" as a weighted timeline (overhaul package 2.2)
   ============================================================================
   The four steps hang off one vertical rule, top to bottom, with no numerals:
   the order is carried by the line itself. Each step title is static weight
   emphasis, a 300 lead with its key word in <b> at 800 (never Heft; the one
   weight animation per page is the H1, ruling 9).

   The rule fills from the top as the band scrolls through the viewport
   (scroll-driven CSS, only where supported, only with motion allowed and not
   under Pause motion). Everywhere else it is simply drawn in full, which is
   also what the markup renders.

   It has no CTA of its own any more: every page ends on the footer's ink
   closer, and the home sets its closer to this band's old line ("Tell me what
   you are building.") in src/pages/index.astro.

   Used on the home (tone paper) and on /services mid-page (tone white,
   headingId "process-heading").

   Props:
     tone       the Section surface ('white' | 'paper')
     headingId  id on the H2
   ============================================================================ */

import Section from './Section.astro';

interface Props {
  tone?: 'white' | 'paper';
  headingId?: string;
}

const { tone = 'paper', headingId = 'process-band-heading' } = Astro.props;

// lead (300) + key (800). Bodies are the studio's existing process copy.
const steps = [
  {
    lead: 'Start with a',
    key: 'conversation',
    body: 'It starts with an hour together, in person or on video, talking about what you actually need. No pitch deck, no agency theater. Just a working session that ends with a one-page brief you sign off on.',
  },
  {
    lead: 'Then the',
    key: 'strategy',
    body: 'I write the audience map, the page architecture, and the conversion path. You read it and push back, and I revise. The strategy doc is the source of truth for every design choice that follows.',
  },
  {
    lead: 'Then I',
    key: 'design and build',
    body: 'Components, content, and pages built in the open. Preview links land in your inbox at every milestone so you can react early instead of seeing the whole thing for the first time at launch.',
  },
  {
    lead: 'Launch, and',
    key: 'follow-through',
    body: 'I launch the site with you, then stay close for the first month to fix anything that surfaces. After that you own the site outright, with documentation and a simple way to reach me when something comes up.',
  },
];
---

<Section rail="Process" railMeta={`${steps.length} steps`} tone={tone} labelledby={headingId}>
  <h2 id={headingId} class="pb-heading">
    How I <b>work</b>
  </h2>

  <ol class="pb-steps" role="list">
    {steps.map((step) => (
      <li class="pb-step">
        <h3 class="pb-title">
          {step.lead} <b>{step.key}</b>
        </h3>
        <p class="pb-body">{step.body}</p>
      </li>
    ))}
  </ol>
</Section>

<style>
  .pb-heading {
    margin-bottom: 3rem;
  }

  .pb-steps {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4rem);
    max-width: 44rem;
    margin: 0;
    padding: 0 0 0 clamp(1.5rem, 4vw, 3rem);
    list-style: none;
  }

  /* The timeline: a 1px --line-strong rule (::before) with a 2px
     heading-coloured fill on top of it (::after). Pseudo-elements, so the <ol>
     holds only <li>s. Decorative; the list order carries the meaning. */
  .pb-steps::before,
  .pb-steps::after {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0;
    width: 1px;
    background: var(--line-strong);
  }
  .pb-steps::after {
    left: -0.5px;
    width: 2px;
    background: var(--heading);
    transform-origin: top;
  }

  /* A short tick ties each step to the rule. */
  .pb-step {
    position: relative;
  }
  .pb-step::before {
    content: '';
    position: absolute;
    top: 0.85rem;
    left: calc(-1 * clamp(1.5rem, 4vw, 3rem));
    width: clamp(0.75rem, 2vw, 1.5rem);
    height: 2px;
    background: var(--heading);
  }

  /* h3 normally sits at 650; here the title is a 300 lead with an 800 key
     word, the same weight grammar as the H2s. */
  .pb-title {
    font-size: var(--text-h3);
    font-weight: 300;
    margin-bottom: 0.5rem;
  }
  .pb-title b {
    font-weight: 800;
  }

  .pb-body {
    color: var(--muted-foreground);
    line-height: 1.6;
  }

  /* Scroll fill: progressive enhancement. Without support, under reduced
     motion or Pause motion the fill is simply drawn in full. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      :global(html:not([data-motion-paused])) .pb-steps::after {
        animation: pb-fill linear both;
        animation-timeline: view();
        animation-range: entry 30% cover 70%;
      }
    }
  }
  @keyframes pb-fill {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
</style>
