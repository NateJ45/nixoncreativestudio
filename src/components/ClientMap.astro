---
/* ClientMap: About's "Based in Cincinnati" section. A dot map of the lower 48
   (src/data/us-dots.json, from scripts/tools/us-dots.mjs) on a wide card, the
   table, with the states the selected clients are in (src/data/client-places.ts)
   picked out in the blue and an arc from Cincinnati to each. Along its foot lies
   a hand of playing cards, one a state, lettered with its postal code in two
   corners and holding its clients. The hand is the content: every name is a
   link to its case study, and the map is aria-hidden decoration that follows it.

   Motion lives in src/scripts/client-map.js and about.css: the map glides from
   the whole country to the East as the hand is dealt, a ripple runs out from
   Cincinnati, and the walk sends a point of light along an arc and lifts that
   state's card as it lands. It only runs on screen, has its own Pause button
   (WCAG 2.2.2), and stands down under reduced motion or with no script, where
   the map rests on the East and the hand is already fanned. */
import geo from '../data/us-dots.json';
import { PLACES } from '../data/client-places';
import { getClients } from '../lib/clients';

const all = await getClients();
const bySlug = new Map(all.map((c) => [c.slug, c]));
const places = PLACES.map((p) => ({
  ...p,
  people: p.clients.map((slug) => {
    const c = bySlug.get(slug);
    if (!c) throw new Error(`ClientMap: no case study "${slug}" (src/data/client-places.ts)`);
    return c;
  }),
}));

const r1 = (n: number) => Math.round(n * 10) / 10;
const ROW = (geo.step * Math.sqrt(3)) / 2;
const [hx, hy] = geo.hub;
const centers = geo.centers as Record<string, number[]>;
const outlines = geo.outlines as Record<string, string>;
const picked = new Set(places.map((p) => p.fips));

// Dots: the rest of the country is split into rings by distance from Cincinnati, so the ripple can
// light one ring after another; each picked state keeps its own dots. One path per group, each dot
// a zero-length line with a round cap, written relative to the last so the HTML stays small.
const RING = 64;
const rings: number[][][] = [];
const stateDots: Record<number, number[][]> = {};
for (const [c, r, f] of geo.dots) {
  const x = r1(c * geo.step + (r % 2 ? geo.step / 2 : 0));
  const y = r1(r * ROW);
  if (picked.has(f)) (stateDots[f] ??= []).push([x, y]);
  else {
    const i = Math.floor(Math.hypot(x - hx, y - hy) / RING);
    (rings[i] ??= []).push([x, y]);
  }
}
function dots(pts: number[][]) {
  let d = '';
  let px = 0;
  let py = 0;
  pts.forEach(([x, y], i) => {
    d += i ? `m${r1(x - px)} ${r1(y - py)}h0` : `M${x} ${y}h0`;
    px = x;
    py = y;
  });
  return d;
}
const ringPaths = rings.map((pts) => (pts ? dots(pts) : '')).filter(Boolean);

// Pins: the hub for the home state, the state's centre for the rest. Arcs bow up from the hub.
const pins = places.map((p) => {
  const [x, y] = p.home ? [hx, hy] : centers[p.fips];
  if (x === undefined) throw new Error(`ClientMap: no outline for FIPS ${p.fips}; see us-dots.mjs`);
  let arc = '';
  if (!p.home) {
    const dx = x - hx;
    const dy = y - hy;
    const len = Math.hypot(dx, dy);
    let nx = -dy / len;
    let ny = dx / len;
    if (ny > 0) [nx, ny] = [-nx, -ny];
    const bow = Math.max(18, len * 0.38);
    const qx = r1((hx + x) / 2 + nx * bow);
    const qy = r1((hy + y) / 2 + ny * bow);
    arc = `M${hx} ${hy}Q${qx} ${qy} ${x} ${y}`;
  }
  return { ...p, x, y, arc };
});

// The views. The map is a wide table on a big screen (WIDE) and nearer square on a phone (TALL),
// matching .cm-svg's aspect-ratio in about.css. Each has a resting view framed on the pins, which
// no script and reduced motion get, and a view of the whole country that the script opens on
// before it glides in. The hand of cards covers the table's foot on a big screen, so the resting
// view sits a little high there.
const W = geo.w;
const H = geo.h;
const WIDE = 2.1;
const TALL = 4 / 3;
const xs = pins.map((p) => p.x);
const ys = pins.map((p) => p.y);
const mx = (Math.min(...xs) + Math.max(...xs)) / 2;
const my = (Math.min(...ys) + Math.max(...ys)) / 2;
const clamp = (v: number, hi: number) => Math.min(Math.max(v, 0), hi);
const box = (x: number, y: number, w: number, h: number) =>
  [x, y, w, h].map((n) => Math.round(n * 10) / 10).join(' ');
function rest(width: number, aspect: number, drop: number) {
  const h = width / aspect;
  return box(clamp(mx - width / 2, W - width), clamp(my - h / 2 + drop, H - h), width, h);
}
function whole(aspect: number) {
  const w = Math.min(W, H * aspect);
  const h = w / aspect;
  return box((W - w) / 2, (H - h) / 2, w, h);
}
const crop = rest(W * 0.7, WIDE, 14);
const full = whole(WIDE);
const cropPhone = rest(W * 0.4, TALL, 4);
const fullPhone = whole(TALL);
const first = places[0].fips;
---

<section class="sec ab-sec cm-sec" aria-labelledby="mh">
  <div class="sec-head">
    <h2 id="mh">Based in Cincinnati, working anywhere</h2>
    <p>
      I meet clients in person around the region and work with everyone else by call, email and
      text. These are the states the selected case studies call home.
    </p>
  </div>
  <div class="cm" data-cm data-on={first}>
    <figure class="cm-map card">
      <svg
        class="cm-svg"
        viewBox={crop}
        data-full={full}
        data-crop={crop}
        data-crop-phone={cropPhone}
        data-full-phone={fullPhone}
        aria-hidden="true"
        focusable="false"
        preserveAspectRatio="xMidYMid slice"
      >
        <path class="cm-coast" d={geo.coast} />
        <path class="cm-border" d={geo.borders} />
        <g class="cm-land">
          {ringPaths.map((d, i) => (
            <path class="cm-r" style={`--i: ${i}`} d={d} />
          ))}
        </g>
        {pins.map((p) => (
          <g class="cm-st" data-st={p.fips}>
            <path class="cm-so" d={outlines[p.fips]} />
            <path class="cm-sd" d={dots(stateDots[p.fips] ?? [])} />
          </g>
        ))}
        <g class="cm-arcs">
          {pins
            .filter((p) => p.arc)
            .map((p, i) => (
              <g class="cm-arc" data-st={p.fips} style={`--i: ${i}`}>
                <path class="cm-trail" d={p.arc} pathLength="1" />
                <path class="cm-comet" d={p.arc} pathLength="1" />
              </g>
            ))}
        </g>
        {pins.map((p) => (
          <g class:list={['cm-pin', { 'cm-hub': p.home }]} data-st={p.fips}>
            <circle class="cm-ping" cx={p.x} cy={p.y} r="6" />
            <circle class="cm-ping cm-ping-2" cx={p.x} cy={p.y} r="6" />
            <circle class="cm-pt" cx={p.x} cy={p.y} r={p.home ? 5.5 : 4.5} />
            {p.home ? (
              <text class="cm-tag cm-tag-hub" x={p.x + 9} y={p.y + 17}>
                Cincinnati
              </text>
            ) : (
              <text class="cm-tag" x={p.x} y={p.y - 13} text-anchor="middle">
                {p.state}
              </text>
            )}
          </g>
        ))}
      </svg>
      <button type="button" class="cm-pause" data-cm-pause hidden>
        Pause the map
      </button>
    </figure>
    <ul class="sc-hand">
      {places.map((p, i) => {
        const off = i - (places.length - 1) / 2;
        return (
          <li
            class:list={['sc', { 'sc-home': p.home }]}
            data-st={p.fips}
            style={`--i: ${i}; --off: ${off}; --rot: ${off * 6}deg; --dip: ${Math.abs(off) * 9}px`}
          >
            <div class="sc-face">
              <span class="pip" aria-hidden="true">
                {p.abbr}
              </span>
              <span class="pip flip" aria-hidden="true">
                {p.abbr}
              </span>
              <h3 class="sc-state label">{p.home ? `${p.state}, home` : p.state}</h3>
              <ul class="sc-names">
                {p.people.map((c) => (
                  <li>
                    <a href={c.study}>{c.name}</a>
                    <span class="sc-kind">{c.sector}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>
