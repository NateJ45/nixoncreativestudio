---
// Safe to edit.
/* ============================================================================
   BeforeAfter  [revamp]
   ============================================================================
   A draggable before/after image comparison slider. Follows the standard
   convention so it reads left-to-right as a progression: the BEFORE (previous
   site) is on the LEFT, the AFTER (redesign) is on the RIGHT. Drag the handle
   (or arrow-key the focused slider) to wipe between them. The labels are
   color-coded for clarity: Before is a neutral pill, After is a brand-accent
   pill (the new one).

   IMPORTANT on sourcing the "before" image: the Wayback Machine is NOT a
   reliable source for these. Archived Squarespace / WordPress pages
   usually render broken (missing CSS and assets), which misrepresents the
   prior site. Use a real screenshot you captured when you started the
   project. For best results the before and after images should share the same
   aspect ratio (both hero/viewport crops, e.g. 1440x1080) so the wipe lines up.

   Usage inside a case study .mdx (imports go right under the frontmatter):

     import BeforeAfter from '../../components/BeforeAfter.astro';
     import before from '../../assets/case-studies/shots/<slug>-before.png';
     import after  from '../../assets/case-studies/<slug>.png';

     <BeforeAfter
       before={before}
       after={after}
       beforeAlt="The previous <Client> site"
       afterAlt="The redesigned <Client> site"
     />

   Platform labels (overhaul 2.4b): `beforePlatform` and `afterPlatform` add
   what each site was built on to its label ("Before · WordPress"). Take them
   from the study's own MDX or the beforeShot's notes, never from memory, and
   never add a year the study does not state (project timing is normally not
   shown; plan Part B section 7). Without them the labels stay "Before" and
   "After".

   2.4b look: the comparison sits in the shared .frame; the labels are paper
   chips with mono text and a --line-strong edge (no accent fill, no blur),
   because client and brand colours never carry text here.

   Accessibility: the control is a native range input (keyboard operable,
   labelled). No auto-motion, so there is nothing to gate for reduced motion.
   ============================================================================ */

import { Image } from 'astro:assets';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  beforeLabel?: string;
  afterLabel?: string;
  /** What the old site ran on, from the study's MDX ("WordPress"). Optional. */
  beforePlatform?: string;
  /** What the new site runs on, from the study's MDX ("Astro"). Optional. */
  afterPlatform?: string;
}

const {
  before,
  after,
  beforeAlt,
  afterAlt,
  beforeLabel = 'Before',
  afterLabel = 'After',
  beforePlatform,
  afterPlatform,
} = Astro.props;
---

<figure class="my-l">
  <div class="ba frame relative overflow-hidden select-none" data-beforeafter style="--pos: 50%;">
    <!-- Base layer: the AFTER (redesigned) image fills the frame. It shows on
         the RIGHT, wherever the clipped BEFORE layer doesn't cover it. -->
    <Image
      src={after}
      alt={afterAlt}
      widths={[640, 768, 1024, 1440]}
      sizes="(min-width: 56rem) 70vw, calc(100vw - 3rem)"
      class="block h-auto w-full"
    />

    <!-- Top layer: the BEFORE (previous) image, clipped from the left edge to
         --pos so it occupies the LEFT side. It carries beforeAlt (it used to be
         alt="" inside an aria-hidden wrapper, so screen readers only ever heard
         the after image and the beforeAlt prop went nowhere). -->
    <div class="ba-before pointer-events-none absolute inset-0">
      <Image
        src={before}
        alt={beforeAlt}
        widths={[640, 768, 1024, 1440]}
        sizes="(min-width: 56rem) 70vw, calc(100vw - 3rem)"
        class="block h-auto w-full"
      />
    </div>

    <!-- Corner labels: paper chips, mono text. Before (left), After (right),
         each with its platform when the study names one. -->
    <span class="ba-label ba-label-before">
      <span aria-hidden="true">←</span>
      {beforeLabel}
      {beforePlatform && <span class="ba-platform">· {beforePlatform}</span>}
    </span>
    <span class="ba-label ba-label-after">
      {afterLabel}
      {afterPlatform && <span class="ba-platform">· {afterPlatform}</span>}
      <span aria-hidden="true">→</span>
    </span>

    <!-- Divider line + handle, positioned at --pos. -->
    <div
      class="ba-divider pointer-events-none absolute inset-y-0 z-10"
      style="left: var(--pos);"
      aria-hidden="true"
    >
      <span class="absolute inset-y-0 -ml-px w-0.5 bg-white/90"></span>
      <span class="absolute top-1/2 -mt-[1.375rem] -ml-[1.375rem] flex h-11 w-11 items-center justify-center rounded-full border border-line-strong bg-paper text-heading shadow-md">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
          <path d="m9 6 6 6-6 6"></path>
        </svg>
      </span>
    </div>

    <!-- The actual control: a full-bleed range input. Visually hidden but
         keyboard operable and pointer-draggable; the script maps it to --pos. -->
    <input
      class="ba-range absolute inset-0 z-20 h-full w-full cursor-ew-resize opacity-0"
      type="range"
      min="0"
      max="100"
      value="50"
      aria-label={`Comparison slider: drag to reveal the previous site on the left and the redesigned site on the right`}
    />
  </div>
  <figcaption class="mt-xs text-center font-mono text-[0.75rem] text-text-muted">
    Drag the handle: the previous site is on the left, the redesign on the right.
  </figcaption>
</figure>

<style>
  /* Clip the BEFORE layer from the left edge to the slider position, so the
     left side shows "before" and the right side shows the base "after". */
  .ba-before {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .ba-label {
    position: absolute;
    top: 0.75rem;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    max-width: calc(50% - 1rem);
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background-color: var(--paper);
    color: var(--heading);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .ba-label-before {
    left: 0.75rem;
  }
  .ba-label-after {
    right: 0.75rem;
  }
  .ba-platform {
    color: var(--muted-foreground);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  /* At phone width the platform drops so the chips never collide. */
  @media (max-width: 30rem) {
    .ba-platform {
      display: none;
    }
  }
</style>

<script>
  // Wire every before/after slider: the range input writes its value to the
  // container's --pos custom property, which both clips the BEFORE image and
  // positions the divider. Runs on astro:page-load so it survives View
  // Transitions; a dataset guard prevents double-binding.
  function initBeforeAfter() {
    document
      .querySelectorAll<HTMLElement>('[data-beforeafter]:not([data-ba-bound])')
      .forEach((el) => {
        el.dataset.baBound = 'true';
        const range = el.querySelector<HTMLInputElement>('.ba-range');
        if (!range) return;
        const update = () => el.style.setProperty('--pos', `${range.value}%`);
        range.addEventListener('input', update);
        update();
      });
  }
  document.addEventListener('astro:page-load', initBeforeAfter);
</script>
