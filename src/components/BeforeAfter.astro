---
/* Old site and new, on a slider. A range input does the work, so arrows, Home,
   End and both ends come free. Only where a before was captured while still live. */
import { studyImage } from '../lib/study-markup';

interface Props {
  before: string;
  after: string;
  beforeAlt: string;
  afterAlt: string;
  beforePlatform?: string;
  afterPlatform?: string;
}
const { before, after, beforeAlt, afterAlt, beforePlatform, afterPlatform } = Astro.props;
const a = studyImage(after);
const b = studyImage(before);
const ratio = Math.max(a.w / a.h, 1.6).toFixed(3);
---

<figure class="ba rv" data-ba>
  <figcaption class="ba-l">
    <span>Before{beforePlatform ? `, on ${beforePlatform}` : ''}</span>
    <span>After{afterPlatform ? `, on ${afterPlatform}` : ''}</span>
  </figcaption>
  <div class="ba-f" style={`aspect-ratio:${ratio};--v:50`}>
    <div class="ba-i">
      <img
        class="ba-a"
        src={a.url}
        width={a.w}
        height={a.h}
        alt={afterAlt}
        loading="lazy"
        decoding="async"
      />
      <img
        class="ba-b"
        src={b.url}
        width={b.w}
        height={b.h}
        alt={beforeAlt}
        loading="lazy"
        decoding="async"
      />
    </div>
    <input
      type="range"
      min="0"
      max="100"
      step="1"
      value="50"
      aria-label="Slide between the old site and the new one"
      aria-valuetext="50 percent of the old site showing"
    />
    <span class="ba-h" aria-hidden="true">
      <i></i>
    </span>
  </div>
</figure>
