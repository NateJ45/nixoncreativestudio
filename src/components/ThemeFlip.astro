---
/* The light and dark switch: a small playing card. The light side is its paper face, with the blue
   N; the dark side is its back. Turning it turns the whole page over (src/scripts/theme.js). It does
   nothing without script, so it is hidden without script too. */
---

<button class="turn" type="button" data-theme-flip aria-pressed="false" aria-label="Dark mode">
  <span class="turn-card" aria-hidden="true">
    <span class="fc-face">N</span>
    <span class="fc-back"></span>
  </span>
</button>
