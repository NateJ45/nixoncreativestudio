---
/* The light and dark switch. It says in words what it will do: "Dark mode" with a moon on the light
   side, "Light mode" with a sun on the dark side. Both labels are in the markup and CSS shows the
   right one from the theme on <html>, so the name is right from the first paint and needs no script
   to change. Turning it turns the whole page over (src/scripts/theme.js). It does nothing without
   script, so it is hidden without script too.

   Two copies: one in the dock (wide screens, where the dock has room for the words) and one in the
   closing band's fine print (every width, and the only one on a phone). */
interface Props {
  /** 'dock' sits in the floating menu; 'end' sits in the closing band's fine print. */
  where?: 'dock' | 'end';
}
const { where = 'dock' } = Astro.props;
---

<button class:list={['turn', `turn-${where}`]} type="button" data-theme-flip>
  <span class="turn-to-dark">
    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <path d="M15.5 12.6A6.5 6.5 0 0 1 7.4 4.5a6.5 6.5 0 1 0 8.1 8.1Z"></path>
    </svg>
    Dark mode
  </span>
  <span class="turn-to-light">
    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <circle cx="10" cy="10" r="3.4"></circle>
      <path d="M10 1.8v2.1M10 16.1v2.1M1.8 10h2.1M16.1 10h2.1M4.2 4.2l1.5 1.5M14.3 14.3l1.5 1.5M4.2 15.8l1.5-1.5M14.3 5.7l1.5-1.5"></path>
    </svg>
    Light mode
  </span>
</button>
