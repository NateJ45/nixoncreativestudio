---
// Safe to edit.
/* ============================================================================
   ReadingProgress
   ============================================================================
   Thin bar fixed to the top of the viewport that fills left to right as the
   visitor scrolls a long page (case study and journal detail pages). 0% at
   the top, 100% when the bottom of the viewport reaches the end.

   No React: a small script sets a --progress custom property on scroll; the
   bar's transform reads it. Decorative, so aria-hidden. Without JavaScript the
   bar stays empty (scaleX(0)), which is invisible.

   Overhaul package 2.4a replaces this on both templates.
   ============================================================================ */
---

<div
  aria-hidden="true"
  data-reading-progress
  class="pointer-events-none fixed inset-x-0 top-0 z-50 h-[3px] bg-transparent"
>
  <div class="reading-progress-bar h-full origin-left"></div>
</div>

<style>
  .reading-progress-bar {
    /* scaleX is cheap to animate; a width change would relayout every tick. */
    transform: scaleX(var(--progress, 0));
    transition: transform 80ms linear;
    /* A flat accent fill. The old navy-blue-amber gradient and its glow went in
       package 2.1 (gradients and glows are retired, plan Part B section 1). */
    background-color: var(--color-accent);
  }
</style>

<script>
  function update(): void {
    const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
    if (!bar) return;
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    // Guard divide-by-zero on pages too short to scroll.
    const value = max > 0 ? window.scrollY / max : 0;
    bar.style.setProperty('--progress', String(Math.min(1, Math.max(0, value))));
  }
  // One pair of listeners for the tab's life (this module runs once); the bar
  // is looked up each time because a navigation swaps the page.
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  document.addEventListener('astro:page-load', update);
</script>
