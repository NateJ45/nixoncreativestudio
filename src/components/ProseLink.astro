---
/* MDX's `a` in journal posts and case studies. A link to another site opens in
   a new tab with rel="noopener noreferrer"; internal links render unchanged.
   Astro 7's default Markdown engine takes no rehype plugins without an extra
   package, so the mapping lives here instead.

   The link text is rendered to a string and trimmed. Prettier puts a line break
   either side of a <slot />, and Astro keeps that break as a space inside the
   link, so "Wix plans, Squarespace" read "Wix plans , Squarespace". Rendering
   the slot here keeps the text hugging both tags whatever the formatter does. */
import { externalRel, isExternalHref } from '../lib/external';

const { href, rel, target, ...rest } = Astro.props;
const external = isExternalHref(href);
const text = (await Astro.slots.render('default')).trim();
---

<a
  href={href}
  target={external ? '_blank' : target}
  rel={external ? externalRel(rel) : rel}
  {...rest}
  set:html={text}
/>
