---
// Safe to edit. Reads testimonials from the EmDash CMS, so any page that
// renders it (/about) must be server-rendered (prerender = false).
/* ============================================================================
   Testimonials
   ============================================================================
   A "What clients say" band that reads real testimonials from the EmDash
   case_studies collection (the optional testimonial_quote / testimonial_name /
   testimonial_title fields) and rotates them in
   an Embla carousel (TestimonialCarousel island).

   It is collection-driven so quotes stay tied to the client they came from and
   nothing is fabricated: a case study only contributes a quote when it
   actually carries one. If no case study has a testimonial, this
   whole section renders nothing, so it is safe to place anywhere and it lights
   up as real quotes are added.

   To add a testimonial: fill the three testimonial fields on a case study in
   the EmDash admin, e.g.

     testimonial_quote: "Nathan rebuilt our site and visit-planning got far simpler."
     testimonial_name:  "Jane Doe"
     testimonial_title: "Office Administrator, First Presbyterian"

   The band uses .band-themed (light in light mode, navy aurora in dark) so it
   reads as a deliberate beat in both themes. Used on /about before the CTA.
   ============================================================================ */

import TestimonialCarousel from './TestimonialCarousel';
import { getCaseStudies } from '../lib/caseStudies';

// Already sorted newest first by project date.
const studies = await getCaseStudies();

const items = studies
  .filter((s) => s.testimonial)
  .map((s) => ({
    quote: s.testimonial!.quote,
    name: s.testimonial!.name,
    title: s.testimonial!.title ?? s.client,
    href: `/work/${s.id}/`,
    hrefLabel: 'Read the case study',
  }));
---

{items.length > 0 && (
  <section class="band-themed py-2xl" aria-labelledby="testimonials-heading">
    <div class="ncs-container">
      <header class="mb-xl flex max-w-[60ch] flex-col gap-xs" data-reveal>
        <h2 id="testimonials-heading" class="text-heading">
          What clients say
        </h2>
        <p class="text-lg leading-[1.55] text-text-muted">
          Real words from the churches, schools, and businesses I've built for.
        </p>
      </header>

      {/* client:visible: the carousel hydrates when scrolled near, so the
           Embla + autoplay JS never blocks initial load. */}
      <div data-reveal style="--reveal-delay: 100ms;">
        <TestimonialCarousel client:visible items={items} />
      </div>
    </div>
  </section>
)}
