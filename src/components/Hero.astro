---
// Safe to edit.
/* ============================================================================
   Hero (Act 1 of the homepage): "The Reel"
   ============================================================================
   Left: the headline, one line of positioning, two CTAs and a "Now showing"
   ticker. Right: HeroReel, a tilted wall of real client sites drifting in
   columns (desktop and phone captures mixed). Below lg the wall drops under
   the copy as a tilted band.

   The one orchestrated moment: "pull their weight." starts in a hairline
   weight and fills out to heavy as the page loads, so the words literally
   gain weight. Each of those three words sits in a small grid that also holds
   an invisible heavy copy of itself, so the space is reserved at full weight
   from the first frame and the growing letters never push anything around
   (no layout shift, and the line breaks never change mid-animation). The
   headline is visible from the first frame: only its weight animates, never
   its opacity, so it stays a clean LCP element.

   The hero surface follows the theme like the header expects: the light
   bg-soft surface in light mode, navy in dark (the header's data-over-hero
   state paints the same two colours, so bar and hero read as one block).

   Motion that runs longer than five seconds (the reel and the ticker) has a
   Pause button (WCAG 2.2.2). It sets data-paused on the section; the reel's
   CSS and the ticker script both respect it. Reduced motion: no drift, no
   ticker cycling, and the headline is heavy from the start.

   Content is hardcoded here on purpose. The hero is bespoke. The ticker and
   the wall read their sites and feature lines from src/data/reel.ts.
   ============================================================================ */

import '@fontsource-variable/bricolage-grotesque/wght.css';
import { buttonVariants } from './ui/button';
import { cn } from '../lib/utils';
import HeroReel from './HeroReel.astro';
import { reelSites } from '../data/reel';

// "I build websites that" stays light; the three words after it gain weight.
const statementLead = 'I build websites that';
const heavyWords = ['pull', 'their', 'weight.'];
---

<section
  class="hero relative isolate overflow-hidden bg-bg-soft dark:bg-primary"
  aria-labelledby="hero-statement"
  data-hero-dark
  data-hero-reel
>
  <HeroReel />

  <div class="hero-wrap ncs-container pointer-events-none relative z-10 flex flex-col justify-center">
    <div class="hero-copy pointer-events-auto flex max-w-[38rem] flex-col gap-l">
      <h1 id="hero-statement" class="hero-headline text-heading">
        {statementLead}{' '}
        {heavyWords.map((word, i) => (
          <>
            <span class="heft-word">
              <span class="heft-reserve" aria-hidden="true">
                {word}
              </span>
              <span class="heft" style={`--heft-delay: ${350 + i * 90}ms;`}>
                {word}
              </span>
            </span>
            {i < heavyWords.length - 1 && ' '}
          </>
        ))}
      </h1>

      <p class="hero-sub max-w-[30rem] text-lg leading-[1.55] text-text sm:text-xl">
        For churches, schools, nonprofits and small businesses, wherever you are. Designed, built
        and photographed by{' '}
        <a href="/about/" class="hero-person font-semibold text-link">
          one person
        </a>{' '}
        in Cincinnati, start to finish.
      </p>

      <div class="flex flex-wrap items-center gap-m">
        <a
          href="/contact/"
          class={cn(buttonVariants({ variant: 'brand', size: 'cta' }), 'shine rounded-full')}
        >
          Start a project
        </a>
        <a
          class="hero-secondary inline-flex items-center gap-s font-body text-lg font-semibold text-heading no-underline pointer-coarse:min-h-11"
          href="/work/"
        >
          <span>See the work</span>
          <span aria-hidden="true" class="hero-secondary-arrow">
            →
          </span>
        </a>
      </div>

      <!-- "Now showing": one site's standout feature at a time. Decorative,
           so hidden from assistive tech; the same lines live on each case
           study. The lines show on desktop; the Pause button shows everywhere. -->
      <div class="hero-ticker flex max-w-[30rem] items-center gap-m border-t pt-m">
        <span class="ticker-label hidden shrink-0 font-mono lg:inline text-xs tracking-[0.12em] text-text-muted uppercase">
          Now showing
        </span>
        <div class="ticker-window relative hidden min-w-0 flex-1 lg:block" aria-hidden="true">
          {reelSites.map((site, i) => (
            <p class:list={['ticker-item', i === 0 && 'is-active']}>
              <strong class="font-semibold text-heading">{site.name}</strong>
              <span class="block text-text-muted">{site.feature}</span>
            </p>
          ))}
        </div>
        <button
          type="button"
          class="hero-pause shrink-0"
          aria-pressed="false"
          aria-label="Pause the moving work reel"
          data-hero-pause
        >
          <svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true">
            <rect x="3.5" y="2.5" width="3" height="11" rx="1"></rect>
            <rect x="9.5" y="2.5" width="3" height="11" rx="1"></rect>
          </svg>
          <svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M4.5 2.8v10.4a.6.6 0 0 0 .9.5l8.3-5.2a.6.6 0 0 0 0-1L5.4 2.3a.6.6 0 0 0-.9.5z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  /* Tall enough for the wall to read as a scene, capped so big screens do
     not get an empty band. The copy sits in the vertical middle. */
  .hero-wrap {
    min-height: clamp(38rem, 86svh, 54rem);
    padding-block: 4rem;
  }

  /* ----------------------------------------------------------------------
     Headline. Bricolage Grotesque (variable weight) for the hero only; the
     rest of the site keeps Bebas for headings. Light weight for the lead-in,
     heavy for the three words that "pull their weight".
     ---------------------------------------------------------------------- */
  .hero-headline {
    font-family: 'Bricolage Grotesque Variable', var(--font-body);
    font-weight: 300;
    font-size: clamp(3rem, min(6.2vw, 10.5vh), 6.25rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    text-transform: none;
    text-wrap: balance;
  }

  /* Each heavy word is a one-cell grid holding an invisible heavy copy (which
     sets the cell's size) and the visible animating copy on top of it. */
  .heft-word {
    display: inline-grid;
  }
  .heft-reserve,
  .heft {
    grid-area: 1 / 1;
    font-weight: 800;
  }
  .heft-reserve {
    visibility: hidden;
  }
  @media (prefers-reduced-motion: no-preference) {
    .heft {
      animation: heft 1.8s cubic-bezier(0.65, 0, 0.25, 1) var(--heft-delay, 350ms) both;
    }
  }
  @keyframes heft {
    from {
      font-weight: 200;
    }
    to {
      font-weight: 800;
    }
  }

  /* "one person" links to About: underline on hover and focus. */
  .hero-person {
    text-decoration: none;
  }
  .hero-person:hover,
  .hero-person:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Secondary CTA: the arrow nudges right. */
  .hero-secondary-arrow {
    display: inline-block;
    transition: transform 150ms ease;
  }
  .hero-secondary:hover .hero-secondary-arrow,
  .hero-secondary:focus-visible .hero-secondary-arrow {
    transform: translateX(0.25rem);
  }
  .hero-secondary:focus-visible,
  .hero-person:focus-visible,
  .hero-pause:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* ----------------------------------------------------------------------
     Ticker. All lines are stacked in one box; only the active one shows.
     ---------------------------------------------------------------------- */
  .hero-ticker {
    border-color: color-mix(in oklab, var(--color-heading) 14%, transparent);
  }
  .ticker-window {
    height: 3rem;
  }
  .ticker-item {
    position: absolute;
    inset: 0;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.45;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }
  .ticker-item.is-active {
    opacity: 1;
    transform: none;
  }

  /* Pause / play toggle for the moving reel. 44px target on touch. */
  .hero-pause {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid color-mix(in oklab, var(--color-heading) 20%, transparent);
    border-radius: 999px;
    color: var(--color-heading);
    background: transparent;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .hero-pause:hover {
    background: color-mix(in oklab, var(--color-heading) 8%, transparent);
  }
  .hero-pause svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: currentColor;
  }
  .hero-pause .icon-play,
  .hero-pause[aria-pressed='true'] .icon-pause {
    display: none;
  }
  .hero-pause[aria-pressed='true'] .icon-play {
    display: block;
  }
  @media (pointer: coarse) {
    .hero-pause {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
  /* Nothing moves under reduced motion, so the control has nothing to do. */
  @media (prefers-reduced-motion: reduce) {
    .hero-pause {
      display: none;
    }
  }

  /* Below lg the copy comes first and the wall sits under it as a band. */
  @media (max-width: 63.99rem) {
    .hero {
      display: flex;
      flex-direction: column;
    }
    .hero-wrap {
      order: 1;
      min-height: 0;
      padding-block: 2.5rem 0.5rem;
    }
    .hero :global(.reel-stage) {
      order: 2;
    }
  }
</style>

<script>
  /* The ticker and the Pause button. Registered on astro:page-load (View
     Transitions) with a re-bind guard on the section. */
  function initHero(): void {
    const hero = document.querySelector<HTMLElement>('[data-hero-reel]');
    if (!hero || hero.dataset.heroBound) return;
    hero.dataset.heroBound = '1';

    const pause = hero.querySelector<HTMLButtonElement>('[data-hero-pause]');
    pause?.addEventListener('click', () => {
      const paused = pause.getAttribute('aria-pressed') !== 'true';
      pause.setAttribute('aria-pressed', String(paused));
      pause.setAttribute(
        'aria-label',
        paused ? 'Play the moving work reel' : 'Pause the moving work reel',
      );
      hero.toggleAttribute('data-paused', paused);
    });

    // Cycle the ticker every few seconds, unless motion is reduced, the
    // visitor paused it, or the tab is hidden.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const items = hero.querySelectorAll<HTMLElement>('.ticker-item');
    if (items.length < 2) return;
    let active = 0;
    const timer = window.setInterval(() => {
      if (!document.body.contains(hero)) return window.clearInterval(timer);
      if (hero.hasAttribute('data-paused') || document.hidden) return;
      items[active].classList.remove('is-active');
      active = (active + 1) % items.length;
      items[active].classList.add('is-active');
    }, 3800);
  }
  document.addEventListener('astro:page-load', initHero);
</script>
