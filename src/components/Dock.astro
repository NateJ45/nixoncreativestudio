---
/* The floating menu. Always there, on every page and every width, so it is the
   one nav: no drawer, no hamburger, and it works with no script at all.

   Each link can also deal a small hand of real shortcuts out of the pill: what
   the studio does from Home, the client phones from Work, seven selected prints
   from Photos, the three prices from Prices, me from About, a way to reach me
   from Start a project, and both themes from the theme switch. A hand is plain markup,
   `hidden` until kit.js opens it on a wide screen with a mouse, or from the
   keyboard with the up arrow. Nothing in a
   hand is the only way to reach anything: each link's page has it all.

   On a page with chapters (a case study) kit.js puts one tick a chapter on the
   progress rail and shows the chapter's name in `.dk-spy` for a moment as you
   reach it. Both are aria-hidden: the chapters are real headings on the page. */
import { site } from '../data/site';
import { countWord, getClients } from '../lib/clients';
import { webTiers } from '../data/pricing';
import { money } from '../lib/money';
import ThemeFlip from './ThemeFlip.astro';
import SoundSwitch from './SoundSwitch.astro';
import TierPicker from './TierPicker.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { photoCount } from '../data/nav';
import { photographyOpen } from '../data/photography-gate';

const path = Astro.url.pathname;
const current = (href: string) =>
  path === href ? 'page' : path.startsWith(href) ? 'true' : undefined;
const clients = await getClients();
const faces = ['paper', 'blue', 'ink'];
/* The hand's caption spells the real count, the way the home page's giant line does. */
const deck = `${countWord(clients.length)} selected case studies`;
// Photos sits in the dock only while /photography/ is open, by the same rule the page and the
// sitemap read (src/data/photography-gate.ts), so the link never points at a noindex page.
const photosOpen = photographyOpen(await photoCount());
// The Photos hand: seven selects, church and people in turn, each opening its own print on the
// light table (?print=<slug>). A slug that stops being a select simply drops out of the hand.
const PRINTS = [
  'farm-field',
  'engagement-hug',
  'ash-candle',
  'wedding-mountain-lift',
  'vbs-song',
  'portrait-autumn',
  'choir-sing',
];
const selects = photosOpen
  ? await getCollection('photos', ({ id, data }) => data.select === true && PRINTS.includes(id))
  : [];
const prints = await Promise.all(
  selects
    .sort((a, b) => PRINTS.indexOf(a.id) - PRINTS.indexOf(b.id))
    .map(async (p) => ({
      slug: p.id,
      title: p.data.title,
      thumb: await getImage({
        src: p.data.image,
        width: 240,
        height: 300,
        fit: 'cover',
        format: 'webp',
      }),
    })),
);
---

{/* The dock rises in on arrival, not on every page: a page reached from this site
    finds it already there, so the view transition can hold it still. */}
<script is:inline>
  if (document.referrer.indexOf(location.origin + '/') === 0) {
    document.documentElement.classList.add('dock-here');
  }
</script>
{/* A soft blur that fades the page out under the dock (elevate.css, .pblur). It has to sit OUTSIDE
    the nav: the dock holds a view-transition-name, and a backdrop-filter inside a named element
    can only blur what that element paints, which is nothing
    (_vault/gotchas/view-transition-name-kills-backdrop-blur-inside-it.md). */}
<div class="pblur pblur-b" aria-hidden="true">
  <i></i>
  <i></i>
  <i></i>
</div>
<span class="dock-scrim" data-dock-scrim aria-hidden="true"></span>
<nav class="dock" aria-label="Primary">
  <span class="slide" data-slide></span>
  <svg class="dk-rail" data-rail aria-hidden="true">
    <path pathLength="1"></path>
  </svg>
  {/* A div, not a span: the dock's own spans are counted as tap targets (tests/chrome.spec.ts). */}
  <div class="dk-spy" data-spy aria-hidden="true">
    <span class="dk-spy-n" data-spy-n></span>
    <span data-spy-t></span>
  </div>

  <a class="home" href="/" aria-current={path === '/' ? 'page' : undefined}>
    Home
  </a>
  <div class="dk-hand" data-fan hidden>
    <a class="fc fc-home" href="/">
      <span class="fc-in">
        <strong>I build websites that pull their weight.</strong>
        <span>{site.tagline}</span>
      </span>
    </a>
  </div>

  <a href="/work/" aria-current={current('/work/')}>
    Work
  </a>
  <div class="dk-hand" data-fan hidden>
    <p class="dk-cap" aria-hidden="true" data-fan-cap data-rest={deck}>
      {deck}
    </p>
    {clients.map((s) => (
      <a
        class="fc fc-phone"
        href={s.study}
        style={`--c:${s.accent}`}
        aria-label={`${s.name}, ${s.sector}`}
        data-cap={`${s.name}, ${s.sector}`}
      >
        <span class="fc-in">
          <img
            src={s.still}
            srcset={s.stillSet}
            sizes="6rem"
            alt=""
            loading="lazy"
            width="584"
            height="1138"
          />
        </span>
      </a>
    ))}
  </div>

  {photosOpen && (
    <a href="/photography/" aria-current={current('/photography/')}>
      Photos
    </a>
  )}
  {prints.length > 0 && (
    <div class="dk-hand" data-fan hidden>
      <p class="dk-cap" aria-hidden="true" data-fan-cap data-rest="Selected photographs">
        Selected photographs
      </p>
      {prints.map((p) => (
        <a
          class="fc fc-print"
          href={`/photography/?print=${p.slug}`}
          aria-label={p.title}
          data-cap={p.title}
        >
          <span class="fc-in">
            <img src={p.thumb.src} alt="" loading="lazy" width="240" height="300" />
          </span>
        </a>
      ))}
    </div>
  )}

  <a href="/services/" aria-current={current('/services/')}>
    Prices
  </a>
  <div class="dk-hand" data-fan hidden>
    <p class="dk-cap" aria-hidden="true" data-fan-cap data-rest="Starting prices">
      Starting prices
    </p>
    {webTiers.map((t, i) => (
      <a
        class={`fc fc-price fc-${faces[i]}`}
        href={`/services/#${t.name.toLowerCase()}`}
        data-cap={t.who}
      >
        <span class="fc-in">
          <span class="pip" aria-hidden="true">
            {t.name.charAt(0)}
          </span>
          <span class="pip flip" aria-hidden="true">
            {t.name.charAt(0)}
          </span>
          <span class="label">{t.name}</span>
          <strong>{money(t.priceFrom)}</strong>
        </span>
      </a>
    ))}
    <TierPicker part="card" />
  </div>

  <a href="/about/" aria-current={current('/about/')}>
    About
  </a>
  <div class="dk-hand" data-fan hidden>
    <a class="fc fc-me" href="/about/#sh">
      <span class="fc-in">
        <img src="/assets/portrait.webp" alt="" loading="lazy" />
        <span class="fc-text">
          <strong>{site.ownerName}</strong>
          <span>One person does the design, the build and, when needed, the photos.</span>
        </span>
      </span>
    </a>
  </div>

  <a href="/contact/" class="go" aria-current={current('/contact/')}>
    Start<span class="dk-more"> a project</span>
  </a>
  <div class="dk-hand" data-fan hidden>
    <div class="fc fc-yours">
      <span class="fc-in">
        <strong>Text or email</strong>
        <span class="fc-say">{site.firstConversation}</span>
        <a href={site.emailHref}>{site.email}</a>
        <a href={site.smsHref}>Text {site.phone}</a>
      </span>
    </div>
  </div>

  <ThemeFlip where="dock" />
  {/* The theme hand: the two sides of the site as small pages, painted in their own colors
      whatever side you are on, so you can pick one rather than flip blind (src/scripts/theme.js). */}
  <div class="dk-hand" data-fan hidden>
    <p class="dk-cap" aria-hidden="true" data-fan-cap data-rest="Light or dark">
      Light or dark
    </p>
    {[
      { set: 'light', name: 'Light', cap: 'Light: paper and ink' },
      { set: 'dark', name: 'Dark', cap: 'Dark: the studio navy' },
    ].map((t) => (
      <button
        class={`fc fc-theme fc-theme-${t.set}`}
        type="button"
        data-theme-set={t.set}
        aria-pressed="false"
        data-cap={t.cap}
      >
        <span class="fc-in">
          <span class="fc-mini" aria-hidden="true">
            <i class="m-h" />
            <i class="m-l" />
            <i class="m-l m-s" />
            <i class="m-b" />
            <i class="m-d" />
          </span>
          <span class="label">{t.name}</span>
        </span>
      </button>
    ))}
    <SoundSwitch where="dock" />
  </div>
</nav>
