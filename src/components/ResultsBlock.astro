---
/* What changed: sourced figures at display size, then plain lines. A figure
   without a real source is not allowed (src/lib/case-results.test.ts). */
import { inline } from '../lib/study-markup';

/* shot, shotAlt, shotNote, of and ofLabel are for the What changed cards on /work
   (WorkFigures.astro); a study already shows those captures further down its own page. */
type Row =
  | string
  | {
      figure: string;
      text: string;
      source?: string;
      shot?: string;
      shotAlt?: string;
      shotNote?: string;
      of?: string;
      ofLabel?: string;
    };

interface Props {
  items: Row[];
}
const { items } = Astro.props;
const figures = items.filter(
  (x): x is { figure: string; text: string; source: string } =>
    typeof x !== 'string' && Boolean(x.source),
);
const lines = items
  .map((x) => (typeof x === 'string' ? x : x.source ? null : `${x.figure} ${x.text}`))
  .filter((x): x is string => Boolean(x));
---

{figures.length > 0 && (
  <dl class="figs rv">
    {figures.map((f) => (
      <div class="fig card">
        <dt>{f.figure}</dt>
        <dd set:html={inline(f.text)} />
        <dd class="src" set:html={`Source: ${inline(f.source)}`} />
      </div>
    ))}
  </dl>
)}
{lines.length > 0 && (
  <ul class="changes rv">
    {lines.map((l) => (
      <li set:html={inline(l)} />
    ))}
  </ul>
)}
