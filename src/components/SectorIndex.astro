---
// Safe to edit. Rows and counts come from the case-studies collection; the
// only words authored here are the heading.
/* ============================================================================
   SectorIndex: "Who I build for" on the home (overhaul package 2.2)
   ============================================================================
   One hairline row per sector that has at least one study: the sector's
   plural name in Bricolage and how many sites I have built for it in mono.
   Each row links to /work/?sector={key}, using the same keys as the
   collection's `sector` enum and the /work filter (church, school,
   nonprofit, small-business), in the /work display order.

   Counts are counted, never typed (CLAUDE.md never-break rule 9). A sector
   with no study yet simply has no row.

   Hover and focus: the arrow slides right and the name underlines, so the
   state is never colour alone.
   ============================================================================ */

import { getCollection } from 'astro:content';
import Section from './Section.astro';
import { SECTOR_PLURAL } from '../lib/closer';

interface Props {
  /** Section surface; the home alternates white and paper. */
  tone?: 'white' | 'paper';
}

const { tone = 'paper' } = Astro.props;

const studies = await getCollection('case-studies');

// Same order as the /work filter chips (src/pages/work/index.astro).
const ORDER = ['church', 'school', 'nonprofit', 'small-business'] as const;

const rows = ORDER.map((key) => ({
  key,
  name: SECTOR_PLURAL[key],
  count: studies.filter((s) => s.data.sector === key).length,
})).filter((row) => row.count > 0);
---

<Section
  rail="Sectors"
  railMeta={`${rows.length} kinds of organization`}
  tone={tone}
  labelledby="sector-index-heading"
>
  <h2 id="sector-index-heading" class="si-heading">
    Who I <b>build for</b>
  </h2>
  <ul class="si-list" role="list">
    {rows.map((row) => (
      <li>
        <a class="si-row" href={`/work/?sector=${row.key}`}>
          <span class="si-name">{row.name}</span>
          <span class="si-count">
            {row.count} {row.count === 1 ? 'site' : 'sites'}
            <span class="si-arrow" aria-hidden="true">
              →
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Section>

<style>
  .si-heading {
    margin-bottom: 2.5rem;
  }

  .si-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  .si-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding-block: clamp(1rem, 2vw, 1.5rem);
    border-top: 1px solid var(--line);
    color: var(--heading);
    text-decoration: none;
  }

  .si-name {
    min-width: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 300;
  }

  .si-count {
    flex: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    color: var(--muted-foreground);
  }

  .si-arrow {
    color: var(--color-link);
    transition: transform var(--dur-quick) var(--ease-glide);
  }

  .si-row:hover .si-name,
  .si-row:focus-visible .si-name {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }
  .si-row:hover .si-arrow,
  .si-row:focus-visible .si-arrow {
    transform: translateX(0.375rem);
  }
</style>
