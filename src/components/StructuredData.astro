---
/* ============================================================================
   StructuredData
   ============================================================================
   Foundation, edit with care.

   Prints one schema.org JSON-LD block per page: a single connected @graph.
   Search engines (Google, Bing, DuckDuckGo) and AI answer tools read it to
   understand who the studio is, what it sells and what each page is about.

   Every page carries the studio (ProfessionalService + LocalBusiness), the
   WebSite, Nathan (Person) and a WebPage for itself. Nested pages (case
   studies, journal entries) add a BreadcrumbList. Page-specific nodes
   (CreativeWork on a case study, Service and FAQPage on /services) come in
   through `extra`. The builders, and the ids that link the nodes together,
   live in src/lib/schema.ts, which is unit-tested (schema.test.ts).

   Usage (BaseLayout passes these through from each page):
     <StructuredData url={canonical} title={title} description={description} />
     <StructuredData ... breadcrumbs={[{ name: 'Work', path: '/work/' }]} extra={[node]} />

   Rich Results test after a deploy: https://search.google.com/test/rich-results
   ============================================================================ */

import { buildGraph, type Crumb, type Node } from '../lib/schema';
import { webTiers } from '../data/pricing';

interface Props {
  /** The page's canonical URL. */
  url: string;
  title: string;
  description: string;
  /** Crumbs after Home, for nested pages. */
  breadcrumbs?: Crumb[];
  /** Page-specific nodes appended to the graph. */
  extra?: Node[];
  /** The page node's type (WebPage unless the page says otherwise). */
  pageType?: 'WebPage' | 'CollectionPage';
}

const { url, title, description, breadcrumbs = [], extra = [], pageType } = Astro.props;

const graph = buildGraph({
  url,
  title,
  description,
  breadcrumbs,
  extra,
  pageType,
  lowestPrice: Math.min(...webTiers.map((t) => t.priceFrom)),
});
---

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
