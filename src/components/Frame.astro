---
// Foundation, edit with care.
/* ============================================================================
   Frame
   ============================================================================
   How a real client screenshot sits on the page. Two variants, from the
   contact-sheet idea (DESIGN.md "Components"):

     browser  a quiet browser chrome bar (three dots, the live address, an
              optional tag like "Launching soon") over the screenshot, like a
              print of the screen laid on the table.
     film     a frame on a strip of film: ink rebate, sprocket rows, edge print
              carrying real facts only (client, place, year, address). No drawn
              marks over the picture: Nathan asked for the red loops to go.

   Both take a real screenshot. Never a mock-up, never a site that is not live
   presented as live (the honesty rule in docs/redesign-2026/00-synthesis.md).

   Props:
     variant     'browser' (default) | 'film'
     src         ImageMetadata (an import from src/assets) or a URL string
                 (a CMS /_image?... URL; then width and height are required).
                 Leave it out and pass the picture as the default slot instead
                 (a CMS image rendered by emdash/ui Image, or a <picture>).
     alt         what the screenshot shows ("Stone Steps 50K home page")
     width/height intrinsic size (required for a string src)
     widths, sizes  responsive sizes for an ImageMetadata src
     eager       true only for the LCP frame: eager + fetchpriority high
     url         the address shown in the chrome bar (host only, no https://)
     tag         short label in the chrome bar, e.g. "Launching soon"
     edge        film variant: facts printed on the rebate, e.g.
                 ['Stone Steps 50K', 'Cincinnati', '2025', 'stonesteps50k.com']
     caption     what the frame shows; rendered as <figcaption>
     class       passed to the <figure>

   Captions are the type-caption role; edge print is UI sans at 0.72rem with
   real tracking because it imitates real edge print (the one place caps are
   used for small text, and only for facts).
   ============================================================================ */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  variant?: 'browser' | 'film';
  src?: ImageMetadata | string;
  alt: string;
  width?: number;
  height?: number;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  url?: string;
  tag?: string;
  edge?: string[];
  caption?: string;
  class?: string;
}

const {
  variant = 'browser',
  src,
  alt,
  width,
  height,
  widths = [480, 800, 1200, 1600],
  sizes = '(min-width: 64rem) 50vw, 92vw',
  eager = false,
  url,
  tag,
  edge = [],
  caption,
  class: className,
} = Astro.props;

const isMeta = !!src && typeof src !== 'string';
const loading = eager ? 'eager' : 'lazy';
const fetchpriority = eager ? 'high' : undefined;
---

<figure class:list={['frame', `frame--${variant}`, className]}>
  {variant === 'film' && edge.length > 0 && (
    <p class="frame-edge" aria-hidden="true">
      {edge.map((fact) => (
        <span>{fact}</span>
      ))}
    </p>
  )}
  <div class="frame-print">
    {variant === 'browser' && (
      <div class="frame-chrome" aria-hidden="true">
        <i />
        <i />
        <i />
        {url && <span class="frame-url">{url}</span>}
        {tag && <span class="frame-tag">{tag}</span>}
      </div>
    )}
    {!src ? (
      <slot />
    ) : isMeta ? (
      <Image
        src={src as ImageMetadata}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={loading}
        fetchpriority={fetchpriority}
        class="frame-img"
      />
    ) : (
      <img
        src={src as string}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding="async"
        class="frame-img"
      />
    )}
  </div>
  {caption && <figcaption class="frame-caption type-caption">{caption}</figcaption>}
</figure>

<style>
  .frame {
    margin: 0;
    min-width: 0;
  }
  .frame-print {
    position: relative;
  }
  .frame-img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--paper-deep);
  }
  /* A slotted picture (no src prop) gets the same treatment as .frame-img. */
  .frame-print > :global(img),
  .frame-print > :global(picture),
  .frame-print > :global(picture img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--paper-deep);
  }
  .frame-caption {
    margin-top: 0.75rem;
  }

  /* ---- browser ----------------------------------------------------------- */
  .frame--browser .frame-print {
    box-shadow: var(--shadow-frame);
  }
  .frame-chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    height: 2rem;
    padding-inline: 0.75rem;
    background: var(--ink);
    color: var(--on-ink-muted);
    font-family: var(--font-ui);
  }
  .frame-chrome i {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.45;
  }
  .frame-url {
    flex: 0 1 22rem;
    min-width: 0;
    margin-left: 0.75rem;
    padding: 0.1rem 0.8rem;
    border-radius: 999px;
    background: var(--ink-raised);
    font-size: 0.75rem;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .frame-tag {
    margin-left: auto;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    background: var(--marker-hot);
    color: var(--ink);
    font-size: 0.6875rem;
    font-weight: 700;
    white-space: nowrap;
  }

  /* ---- film -------------------------------------------------------------- */
  .frame--film {
    --hole: 8px;
    position: relative;
    padding: calc(var(--hole) * 2 + 1.75rem) clamp(10px, 1.6vw, 20px)
      calc(var(--hole) * 2 + 0.75rem);
    background: var(--ink);
    color: var(--on-ink-muted);
  }
  /* Sprocket rows: a repeating run of rounded holes punched in the rebate. */
  .frame--film::before,
  .frame--film::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: var(--hole);
    background: repeating-linear-gradient(
      90deg,
      transparent 0 10px,
      var(--paper-deep) 10px 22px,
      transparent 22px 30px
    );
    opacity: 0.16;
  }
  .frame--film::before {
    top: 8px;
  }
  .frame--film::after {
    bottom: 8px;
  }
  .frame-edge {
    position: absolute;
    top: calc(var(--hole) + 14px);
    left: clamp(10px, 1.6vw, 20px);
    right: clamp(10px, 1.6vw, 20px);
    display: flex;
    gap: 2em;
    margin: 0;
    overflow: hidden;
    white-space: nowrap;
    font: 600 0.72rem/1 var(--font-ui);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
    -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
    mask-image: linear-gradient(90deg, #000 85%, transparent);
  }
  .frame--film .frame-caption {
    color: var(--on-ink-muted);
  }
</style>
