---
// Safe to edit. Collection-driven: which studies show here is set by each
// case study's `order` frontmatter (the three lowest), not by a list in this
// file.
/* ============================================================================
   Selected work (overhaul package 2.2)
   ============================================================================
   The home's proof of craft: three client sites, each a FramePair (the desktop
   capture with the phone hanging off its corner), alternating sides down the
   page. Beside each pair:

     H2      static 300 lead + the client's name at 800 (never Heft; the one
             weight animation per page is the hero H1, ruling 9). The name is
             the link to the case study.
     hook    the study's one-line `hook` from its frontmatter
     meta    mono: sector and year
     host ↗  the live site, in a new tab

   Peek: hovering a study, or tabbing to its links, pans the desktop frame
   down the real homepage capture (FramePair's `peek`, CSS only, still under
   reduced motion and Pause motion). The frame itself is also a mouse-only
   link to the study (tabindex -1, aria-hidden), the same pattern as the hero
   reel's cards, so a keyboard user meets one link per study, not two.

   Ends with "All {n} sites" to /work/, n counted from the collection.

   Data: getCollection('case-studies') sorted by `order` (the same order /work
   and the Up next loop use), first three. Captures are the full-page
   shots/{slug}-home.png and {slug}-mobile.png; a study missing either is
   skipped rather than shown with a hole.
   ============================================================================ */

import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Section from './Section.astro';
import FramePair from './FramePair.astro';
import { SECTOR_PHRASE } from '../lib/closer';

const studies = await getCollection('case-studies');
const total = studies.length;

const shots = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/case-studies/shots/*-{home,mobile}.png',
  { eager: true },
);
const shot = (id: string, kind: 'home' | 'mobile'): ImageMetadata | undefined =>
  Object.entries(shots).find(([path]) => path.endsWith(`/${id}-${kind}.png`))?.[1].default;

const byOrder = [...studies].sort(
  (a, b) => (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER),
);

const selected = byOrder
  .map((entry) => ({
    entry,
    desktop: shot(entry.id, 'home'),
    phone: shot(entry.id, 'mobile'),
  }))
  .filter(
    (s): s is { entry: (typeof studies)[number]; desktop: ImageMetadata; phone: ImageMetadata } =>
      Boolean(s.desktop && s.phone && s.entry.data.liveUrl),
  )
  .slice(0, 3);

// "Small Business" style label for the mono meta row.
const sectorLabel = (sector: string) =>
  sector.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const host = (url: string) => new URL(url).hostname.replace(/^www\./, '');

// "A nonprofit site for", "An ... site for": the article follows the sector.
const lead = (sector: string) => {
  const phrase = SECTOR_PHRASE[sector] ?? sector.replace(/-/g, ' ');
  return `${/^[aeiou]/i.test(phrase) ? 'An' : 'A'} ${phrase} site for`;
};
---

{selected.length > 0 && (
  <Section rail="Selected work" railMeta={`${total} studies`} label="Selected work">
    <ol class="sw-list" role="list">
      {selected.map(({ entry, desktop, phone }, i) => (
        <li class:list={['sw-study', i % 2 === 1 && 'sw-study--flip']} data-peek-trigger>
          <a
            class="sw-frame"
            href={`/work/${entry.id}/`}
            tabindex="-1"
            aria-hidden="true"
            transition:name={`cover-${entry.id}`}
          >
            <FramePair
              url={entry.data.liveUrl!}
              desktop={desktop}
              phone={phone}
              alt=""
              peek
              sizes="(min-width: 82.5rem) 459px, (min-width: 64rem) calc(36.5vw - 22px), (min-width: 48rem) calc(49.6vw - 28px), calc(88vw - 43px)"
              phoneSizes="(min-width: 82.5rem) 136px, (min-width: 64rem) calc(10.4vw - 2px), (min-width: 48rem) calc(15vw - 11px), calc(26vw - 12px)"
            />
          </a>

          <div class="sw-copy">
            <h2 class="sw-title">
              <a href={`/work/${entry.id}/`}>
                {lead(entry.data.sector)} <b>{entry.data.client}</b>
              </a>
            </h2>
            {entry.data.hook && <p class="sw-hook">{entry.data.hook}</p>}
            <p class="sw-meta">
              <span>{sectorLabel(entry.data.sector)}</span>
              <span aria-hidden="true">·</span>
              <span>{entry.data.year}</span>
            </p>
            <a class="sw-host" href={entry.data.liveUrl} target="_blank" rel="noopener noreferrer">
              {host(entry.data.liveUrl!)}
              <span aria-hidden="true">↗</span>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </div>
        </li>
      ))}
    </ol>

    <p class="sw-all">
      <a href="/work/">
        All {total} sites <span aria-hidden="true">→</span>
      </a>
    </p>
  </Section>
)}

<style>
  .sw-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-section);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Stacked on small screens: frame, then copy. From md the pair takes about
     seven twelfths and the copy the rest, swapping sides every other study. */
  .sw-study {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 48rem) {
    .sw-study {
      grid-template-columns: 7fr 5fr;
      gap: clamp(2rem, 4vw, 4rem);
    }
    .sw-study--flip {
      grid-template-columns: 5fr 7fr;
    }
    .sw-study--flip .sw-frame {
      order: 2;
    }
  }

  .sw-frame {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .sw-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  /* h2 is 300 with <b> at 800 (globals.css section 4). The link takes the
     heading's colour; the underline comes in on hover and focus. */
  .sw-title {
    overflow-wrap: anywhere;
  }
  .sw-title a {
    color: var(--heading);
    text-decoration: none;
  }
  .sw-title a:hover,
  .sw-title a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }

  .sw-hook {
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--color-text);
    max-width: 32ch;
  }

  .sw-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .sw-host {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-link);
  }

  .sw-all {
    margin-top: var(--space-section);
    font-size: 1.25rem;
  }
  .sw-all a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--color-link);
    font-weight: 650;
  }
  .sw-all a span {
    transition: transform var(--dur-quick) var(--ease-glide);
  }
  .sw-all a:hover span,
  .sw-all a:focus-visible span {
    transform: translateX(0.25rem);
  }
</style>
