---
// Safe to edit.
/* ============================================================================
   HomePrices ("What it costs" on the homepage)
   ============================================================================
   ONE idea: the floor. The lowest published price is printed as a numeral the
   size of the band ("$4,000", Bebas, up to 30vw), with the italic "from" and
   the tier's name beside it, so the first thing a visitor learns here is
   where a site starts. Under it, the three tiers as a lab price list:
   hairline-ruled rows on the ink board, not a slab of three cards. Each row is the tier's name and who it
   is for, the floor in Bebas numerals, and what grows at that tier. The
   tier ticked "Recommended" in the admin shows its badge in place of the who
   line. Under the list: what every build includes, the reassurance line
   (free first conversation, monthly payments) and the link to /services/.

   Ground: deep (the ink board, still). Numbers: getPricingTiers() (the same
   source as /services, committed fallback cms/content/pricing_tiers.json).
   Words: the Home page CMS entry. The prices are static text: no count-up
   (motion is spent once, at the top of the page).
   ============================================================================ */
import Band from '../Band.astro';
import { getHomePage } from '../../lib/homePage';
import { getPricingTiers } from '../../lib/pricing';
import { splitVoice } from '../../lib/homeWork';

const { pricing } = await getHomePage(Astro);
const tiers = await getPricingTiers(Astro);
const heading = splitVoice(pricing.heading);
// The floor: the cheapest tier (getPricingTiers sorts by the admin's order, so find it).
const floorTier = tiers.length
  ? tiers.reduce((a, b) => (b.priceFrom < a.priceFrom ? b : a))
  : undefined;
---

<Band ground="deep" still id="prices" labelledby="home-pricing-heading" class="home-prices">
  <header class="prices-head">
    <h2 id="home-pricing-heading" class="type-headline">
      {heading.lead} {heading.voice && <span class="voice">{heading.voice}</span>}
    </h2>
    <p class="prices-sub">{pricing.sub}</p>
  </header>

  {floorTier && (
    <p class="floor">
      <span class="floor-from">from</span>
      <span class="floor-figure">{`$${floorTier.priceFrom.toLocaleString('en-US')}`}</span>{' '}
      <span class="floor-what">
        for a {floorTier.name} site. <span>{floorTier.who}.</span>
      </span>
    </p>
  )}

  <ul class="tiers" role="list">
    {tiers.map((tier) => (
      <li class:list={['tier', { 'tier--anchor': tier.highlighted }]}>
        <div class="tier-name">
          <h3>{tier.name}</h3>
          <span class:list={['tier-who', { 'tier-badge': tier.highlighted && tier.badge }]}>
            {tier.highlighted && tier.badge ? tier.badge : tier.who}
          </span>
        </div>
        <p class="tier-price">
          <span class="tier-from">from</span>
          <span class="type-numeral tier-figure">
            {[
              `$${tier.priceFrom.toLocaleString('en-US')}`,
              tier.priceSuffix && <span class="tier-suffix">{tier.priceSuffix}</span>,
            ]}
          </span>
        </p>
        <ul class="tier-points" role="list">
          {tier.features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>
      </li>
    ))}
  </ul>

  <div class="every">
    <div>
      <h3 class="every-lead">{pricing.includesLead}</h3>
      <ul class="every-list" role="list">
        {pricing.includes.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
    <div class="every-side">
      <p>{pricing.reassurance}</p>
      <a href="/services/" class="card-link every-link">
        {pricing.linkLabel}
      </a>
    </div>
  </div>
</Band>

<style>
  /* One long line with the voice running on, the sub as a lede beneath: a different
     cut from the proof sheet's split head, so the bands do not repeat a scaffold. */
  .prices-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 1.25rem 3rem;
    align-items: end;
  }
  .prices-head h2 {
    font-size: clamp(2.75rem, 1.4rem + 4.6vw, 5.5rem);
  }
  .prices-sub {
    max-width: 34ch;
    font-family: var(--font-serif);
    font-size: var(--text-lede);
    line-height: 1.4;
    color: var(--foreground);
  }

  /* ---- the floor: the band's one big figure ---------------------------- */
  .floor {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: clamp(1rem, 2.5vw, 2.5rem);
    align-items: end;
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(2.5rem, 5vw, 4.5rem);
  }
  .floor-from {
    grid-column: 1;
    font: italic 400 clamp(1.75rem, 1rem + 3vw, 4rem) / 1 var(--font-serif);
    color: var(--marker);
    margin-bottom: 0.15em;
    padding-left: 0.08em;
  }
  .floor-figure {
    grid-column: 1;
    grid-row: 2;
    margin-left: -0.04em;
    font: 400 clamp(8rem, 1rem + 27vw, 25rem) / 0.8 var(--font-display);
    letter-spacing: -0.01em;
    font-variant-numeric: lining-nums;
    color: var(--heading);
  }
  .floor-what {
    grid-column: 2;
    grid-row: 2;
    align-self: end;
    max-width: 16ch;
    padding-bottom: 0.4em;
    font: 400 clamp(1.5rem, 1rem + 1.6vw, 2.5rem) / 1.15 var(--font-serif);
    color: var(--heading);
    text-wrap: balance;
  }
  .floor-what span {
    display: block;
    margin-top: 0.4em;
    font-style: italic;
    font-size: 0.7em;
    color: var(--muted-foreground);
  }

  .tiers {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--foreground);
  }
  .tier {
    display: grid;
    grid-template-columns: minmax(0, 3.2fr) minmax(0, 3.8fr) minmax(0, 5fr);
    gap: 1rem clamp(1rem, 3vw, 3rem);
    align-items: baseline;
    padding-block: clamp(1.6rem, 3vw, 2.4rem);
    border-bottom: 1px solid var(--border);
  }
  .tier-name h3 {
    font: 400 clamp(2rem, 1.5rem + 1.4vw, 2.75rem) / 0.95 var(--font-display);
    letter-spacing: 0.02em;
    color: var(--heading);
  }
  .tier-who {
    display: block;
    margin-top: 0.45rem;
    font: italic 400 1.1875rem/1.3 var(--font-serif);
    color: var(--muted-foreground);
  }
  .tier-badge {
    color: var(--marker);
  }
  .tier-price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
  }
  .tier-from {
    font: italic 400 clamp(1.05rem, 0.9rem + 0.5vw, 1.4rem) / 1 var(--font-serif);
    color: var(--muted-foreground);
  }
  .tier-figure {
    font-size: clamp(2.75rem, 2rem + 2.6vw, 4.25rem);
    color: var(--heading);
  }
  .tier--anchor .tier-figure {
    color: var(--marker);
  }
  .tier-suffix {
    font-size: 0.5em;
    vertical-align: 0.8em;
  }
  .tier-points,
  .every-list {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.45;
  }
  .tier-points li,
  .every-list li {
    position: relative;
    padding-left: 1.2rem;
  }
  .tier-points li::before,
  .every-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.6rem;
    height: 1px;
    background: var(--marker);
  }

  .every {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2rem clamp(1rem, 3vw, 3rem);
    margin-top: clamp(2.25rem, 4vw, 3.25rem);
  }
  .every-lead {
    margin-bottom: 0.75rem;
    font: 600 1rem/1.3 var(--font-ui);
    color: var(--heading);
  }
  .every-side {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--foreground);
  }
  .every-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    justify-self: start;
    font: 600 1.0625rem/1.3 var(--font-ui);
    color: var(--heading);
  }

  @media (max-width: 820px) {
    .prices-head,
    .floor {
      grid-template-columns: 1fr;
    }
    .floor-figure {
      font-size: 42vw;
    }
    .floor-what {
      grid-column: 1;
      grid-row: auto;
      max-width: 24ch;
      padding: 0.75rem 0 0;
    }
  }
  @media (max-width: 820px) {
    .tier,
    .every {
      grid-template-columns: 1fr;
    }
    .tier {
      gap: 0.9rem;
    }
  }
</style>
