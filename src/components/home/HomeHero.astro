---
// Safe to edit.
/* ============================================================================
   HomeHero (the first band of the homepage)
   ============================================================================
   Nathan's tagline set as a poster: "I MAKE WEBSITES THAT" in Bebas across
   the full measure, the italic turn "pull their weight." at the same size on
   the line below, pushed right; in the space it leaves on the left, a calm
   column with who it is for, the volunteer promise, one button and the
   published price floor. Then the reel of his sites (HeroReel), whose centre
   frame plays a short live clip of the site.

   Ground (HERO_GROUND in src/lib/homeWork.ts, DESIGN.md "Hero ground"): two designed options,
   one switch.
     'ink'    the deep ground under the header (the header turns to its on-ink
              face: white logo, paper nav), the lamp crossing it, and the
              Ohio's contours drawn light on the ink with the river in
              vermilion. The page's one moving ground.
     'paper'  the survey sheet turned up: larger contours in river slate at a
              visible weight, drifting. The page's one moving ground.
   Both draw the contours with ContourLayers: three CSS masks of the
   foundation's contour sheet over token colours (src/lib/heroGround.ts),
   attached only after the load event; a mask is never an LCP candidate (a
   background image was: it took the LCP to 2.6 s on 2026-10-04).

   Words: the Home page CMS entry (getHomePage; fallback cms/content/
   page_home.json). The price floor is the lowest published tier
   (getPricingTiers), so the link can never quote a stale number.

   LCP: the start frame of the reel or the headline, whichever is larger at
   that width; both paint without waiting on a script. Nothing here starts at
   opacity 0 (CLAUDE.md rule 2); the headline has no reveal and no entrance.
   Its measure is set in em so a late web font cannot re-break it (DESIGN.md
   "Loading and CLS").
   ============================================================================ */
import Band from '../Band.astro';
import HeroReel from './HeroReel.astro';
import ContourLayers from './ContourLayers.astro';
import { buttonVariants } from '../ui/button';
import { getHomePage } from '../../lib/homePage';
import { getPricingTiers } from '../../lib/pricing';
import { REEL, REEL_START_ID, HERO_GROUND, gateReel, type StudyGate } from '../../lib/homeWork';

interface Props {
  /** The case studies' gate fields (empty when the CMS has none). */
  studies: StudyGate[];
}
const { studies } = Astro.props;

const { hero } = await getHomePage(Astro);
const tiers = await getPricingTiers(Astro);
const floor = tiers.length ? Math.min(...tiers.map((t) => t.priceFrom)) : undefined;
// One string, so a formatter can never put a space before the comma.
const priceLabel =
  floor === undefined
    ? hero.secondaryLabel
    : `${hero.secondaryLabel}, from $${floor.toLocaleString('en-US')}`;

const slides = gateReel(REEL, studies);
const start = Math.max(
  0,
  slides.findIndex((s) => s.id === REEL_START_ID),
);
const ink = HERO_GROUND === 'ink';
---

<Band
  ground={ink ? 'deep' : 'paper-contours'}
  underHeader
  labelledby="hero-statement"
  class:list={['home-hero', ink ? 'home-hero--ink' : 'home-hero--paper']}
  container={false}
>
  <ContourLayers variant={HERO_GROUND} moving />
  <div class="ncs-container hero-copy">
    <h1 id="hero-statement" class="hero-title">
      <span class="hero-caps">{hero.heading}</span> <span class="voice">{hero.headingAccent}</span>
    </h1>
    <div class="hero-side">
      <p class="hero-sub">
        <span class="hero-positioning">{hero.positioning}</span>{' '}
        <span class="hero-proof">
          {/* One expression: the link and the text after it must touch (no space before the comma). */}
          {[hero.proof.before, ' ', <a href="/about/">{hero.proof.linkText}</a>, hero.proof.after]}
        </span>
      </p>
      <div class="hero-actions">
        <a
          href="/contact/"
          class:list={[buttonVariants({ variant: 'brand', size: 'cta' }), 'nudge']}
        >
          {hero.primaryLabel}
          <svg viewBox="0 0 20 20" aria-hidden="true" class="hero-arrow" data-nudge>
            <path d="M3 10h13M11 5l5 5-5 5"></path>
          </svg>
        </a>
        <a class="hero-price" href="#prices">
          {priceLabel}
        </a>
      </div>
    </div>
  </div>

  {slides.length > 0 && <HeroReel slides={slides} start={start} />}
</Band>

<style>
  :global(.home-hero) {
    /* Caption words in the reel sit over contour lines: heading colour, not the red
       (src/lib/heroContours.test.ts). */
    --reel-page: var(--heading);
    overflow: clip;
    padding-bottom: calc(var(--band-y) * 0.55);
  }
  /* The ink hero keeps the lamp crossing the board but not its vignette (it greyed the
     reel's side frames). */
  :global(.home-hero--ink .g-vignette) {
    display: none;
  }
  /* The reel's furniture one step up from the board, so it reads on ink. */
  :global(.home-hero--ink) {
    --reel-chrome: var(--ink-raised);
    --reel-url: var(--ink);
    --reel-strip: var(--ink-raised);
    --reel-btn: var(--paper);
    --reel-btn-fg: var(--ink);
  }

  /* The paper ground's own baked sheet gives way to the turned-up layers. */
  :global(.home-hero--paper .g-contours) {
    display: none;
  }

  /* ---- the poster ----------------------------------------------------------- */
  /* --caps sizes the Bebas line so it fills the measure on ONE line at desktop (the
     phrase is 7.15em of Bebas); the italic turn is 0.76 of it, which sets its x-height
     level with the caps' visual weight. Sizes in vw and em only (DESIGN.md "Loading and
     CLS"): a late font never re-breaks the lines. */
  .hero-copy {
    --caps: min(12.2vw, 11.25rem);
    --voice: calc(var(--caps) * 0.76);
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.4vw, 2.5rem);
    padding-top: 0;
  }
  .hero-title {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    font-weight: 400;
  }
  .hero-caps {
    grid-column: 1 / -1;
    display: block;
    margin-left: -0.035em;
    font: 400 var(--caps) / 0.86 var(--font-display);
    letter-spacing: 0.004em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--heading);
  }
  .hero-title .voice {
    grid-column: 5 / -1;
    justify-self: end;
    display: block;
    margin-top: 0.02em;
    font-size: var(--voice);
    line-height: 0.95;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  /* The calm column sits under the caps, beside the italic turn. */
  .hero-side {
    grid-column: 1 / span 4;
    margin-top: calc(var(--voice) * -0.95 + 0.6rem);
    max-width: 22rem;
  }
  .hero-sub {
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1rem + 0.35vw, 1.3rem);
    line-height: 1.45;
    color: var(--foreground);
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
  }
  .hero-arrow {
    width: 1.1em;
    height: 1.1em;
  }
  .hero-arrow path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }
  .hero-price {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font: 600 1.0625rem/1.3 var(--font-ui);
    color: var(--heading);
    text-decoration: underline;
    text-decoration-color: var(--marker);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  .hero-price:hover {
    color: var(--marker);
  }
  .hero-proof a {
    color: inherit;
    text-decoration-color: var(--marker);
    text-underline-offset: 0.2em;
  }

  /* Below 64rem the column goes under the poster lines; the italic turn stays pushed
     right of the caps' start, so the lockup is never a centred block. */
  @media (max-width: 64rem) {
    .hero-copy {
      --caps: 12.4vw;
      --voice: calc(var(--caps) * 0.86);
    }
    .hero-title .voice {
      grid-column: 1 / -1;
    }
    .hero-side {
      grid-column: 1 / span 9;
      margin-top: clamp(1.25rem, 3vw, 2rem);
      max-width: 34rem;
    }
  }
  /* Phone: the caps break after "MAKE" and fill the width on two lines; the turn takes
     two lines under them, indented. The proof sentence returns at tablet width (About
     carries it too), so the work comes up sooner. */
  @media (max-width: 40rem) {
    .hero-copy {
      --caps: 19vw;
      --voice: 15.4vw;
    }
    .hero-caps {
      white-space: normal;
      line-height: 0.84;
    }
    .hero-title .voice {
      justify-self: start;
      margin: 0.08em 0 0 0.9em;
      white-space: normal;
      line-height: 0.9;
    }
    .hero-side {
      grid-column: 1 / -1;
    }
    .hero-proof {
      display: none;
    }
  }
  :global(.home-hero .show) {
    margin-top: clamp(1.5rem, 3vw, 2.75rem);
  }
</style>
