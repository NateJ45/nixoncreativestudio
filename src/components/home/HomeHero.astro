---
// Safe to edit.
/* ============================================================================
   HomeHero (the first band of the homepage)
   ============================================================================
   Nathan's tagline in Bebas with its italic turn ("I MAKE WEBSITES THAT /
   pull their weight."), who it is for and the volunteer promise, one button,
   the published price floor, then the reel of his sites (HeroReel).

   Ground: paper-contours, the page's one moving ground (the survey sheet of
   the Ohio's bend drifts slowly). It runs up under the transparent header.

   Words: the Home page CMS entry (getHomePage; fallback cms/content/
   page_home.json). The price floor is the lowest published tier
   (getPricingTiers), so the link can never quote a stale number.

   LCP: the start frame of the reel (a real <img>, eager, fetchpriority high).
   Everything here is server-rendered and nothing starts at opacity 0
   (CLAUDE.md rule 2); the headline has no reveal and no entrance.
   ============================================================================ */
import Band from '../Band.astro';
import HeroReel from './HeroReel.astro';
import { buttonVariants } from '../ui/button';
import { getHomePage } from '../../lib/homePage';
import { getPricingTiers } from '../../lib/pricing';
import { REEL, REEL_START_ID, gateReel, type StudyGate } from '../../lib/homeWork';

interface Props {
  /** The case studies' gate fields (empty when the CMS has none). */
  studies: StudyGate[];
}
const { studies } = Astro.props;

const { hero } = await getHomePage(Astro);
const tiers = await getPricingTiers(Astro);
const floor = tiers.length ? Math.min(...tiers.map((t) => t.priceFrom)) : undefined;
// One string, so a formatter can never put a space before the comma.
const priceLabel =
  floor === undefined
    ? hero.secondaryLabel
    : `${hero.secondaryLabel}, from $${floor.toLocaleString('en-US')}`;

const slides = gateReel(REEL, studies);
const start = Math.max(
  0,
  slides.findIndex((s) => s.id === REEL_START_ID),
);
---

<Band
  ground="paper-contours"
  underHeader
  labelledby="hero-statement"
  class="home-hero"
  container={false}
>
  <div class="ncs-container hero-copy">
    <h1 id="hero-statement" class="type-display hero-title">
      {hero.heading} <span class="voice">{hero.headingAccent}</span>
    </h1>
    <p class="hero-sub">
      <span class="hero-positioning">{hero.positioning}</span>{' '}
      <span class="hero-proof">
        {/* One expression: the link and the text after it must touch (no space before the comma). */}
        {[hero.proof.before, ' ', <a href="/about/">{hero.proof.linkText}</a>, hero.proof.after]}
      </span>
    </p>
    <div class="hero-actions">
      <a href="/contact/" class:list={[buttonVariants({ variant: 'brand', size: 'cta' }), 'nudge']}>
        {hero.primaryLabel}
        <svg viewBox="0 0 20 20" aria-hidden="true" class="hero-arrow" data-nudge>
          <path d="M3 10h13M11 5l5 5-5 5"></path>
        </svg>
      </a>
      <a class="hero-price" href="#prices">
        {priceLabel}
      </a>
    </div>
  </div>

  {slides.length > 0 && <HeroReel slides={slides} start={start} />}
</Band>

<style>
  :global(.home-hero) {
    overflow: clip;
    padding-bottom: calc(var(--band-y) * 0.6);
  }
  .hero-copy {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .hero-title {
    max-width: 20ch;
    font-size: clamp(3.1rem, 1rem + 6.6vw, 6.4rem);
  }
  .hero-title .voice {
    display: block;
    font-size: 0.92em;
    line-height: 1.05;
  }
  .hero-sub {
    margin-top: 1.1rem;
    max-width: 62ch;
    font-family: var(--font-serif);
    font-size: clamp(1.0625rem, 0.98rem + 0.35vw, 1.25rem);
    line-height: 1.5;
    color: var(--foreground);
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    margin-top: 1.4rem;
  }
  .hero-arrow {
    width: 1.1em;
    height: 1.1em;
  }
  .hero-arrow path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }
  .hero-price {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font: 600 1rem/1.3 var(--font-ui);
    color: var(--heading);
    text-decoration: underline;
    text-decoration-color: var(--marker);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  .hero-price:hover {
    color: var(--marker);
  }
  /* On a phone the hero keeps to who it is for and the promise, so the work comes up
     sooner; the proof sentence returns at tablet width (About carries it too). */
  @media (max-width: 40rem) {
    .hero-proof {
      display: none;
    }
  }
  .hero-proof a {
    color: inherit;
    text-decoration-color: var(--marker);
    text-underline-offset: 0.2em;
  }
  :global(.home-hero .show) {
    margin-top: clamp(1.25rem, 2.6vw, 2.25rem);
  }
</style>
