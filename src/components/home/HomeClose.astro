---
// Safe to edit.
/* ============================================================================
   HomeClose (the closing call on the homepage)
   ============================================================================
   "Let's build a site you won't have to redo." (the line the copy audit kept),
   one sentence on what to send, the button and the email address.

   Ground: paper-contours, still, with the sheet turned up (the hero's
   'paper' tokens through ContourLayers): the survey sheet of
   the Ohio's bend at a weight you can see, where "Cincinnati" belongs,
   closing the page the way the hero opened it (the river), with the ink
   footer below it. The headline is set at poster scale, the hero's echo.

   Words: the Home page CMS entry (process_cta_title / _sub / _label, the
   fields the old Process Band's call used). The address: getSite(); the
   mailto keeps its copy-to-clipboard fallback (src/scripts/mailto-fallback.ts
   binds every mailto link on the page).
   ============================================================================ */
import Band from '../Band.astro';
import ContourLayers from './ContourLayers.astro';
import { buttonVariants } from '../ui/button';
import { getHomePage } from '../../lib/homePage';
import { getSite } from '../../data/site';
import { splitVoice } from '../../lib/homeWork';
import { LANDING_LINKS } from '../../lib/landingPage';

const { process } = await getHomePage(Astro);
const site = await getSite(Astro);
const heading = splitVoice(process.ctaTitle);
---

<Band
  ground="paper-contours"
  still
  container={false}
  id="start"
  labelledby="close-heading"
  class="home-close"
>
  <ContourLayers variant="paper" label={false} class="close-contours" />
  <div class="ncs-container close-grid">
    <h2 id="close-heading" class="type-headline">
      {heading.lead} {heading.voice && <span class="voice">{heading.voice}</span>}
    </h2>
    <div class="close-side">
      <p>{process.ctaSub}</p>
      <a href="/contact/" class:list={[buttonVariants({ variant: 'brand', size: 'cta' }), 'nudge']}>
        {process.ctaLabel}
        <svg viewBox="0 0 20 20" aria-hidden="true" class="close-arrow" data-nudge>
          <path d="M3 10h13M11 5l5 5-5 5"></path>
        </svg>
      </a>
      <a class="close-mail" href={`mailto:${site.email}`}>
        {site.email}
      </a>
      {/* The four search landing pages (src/lib/landingPage.ts), for a visitor
           who wants the page written for their kind of organization. */}
      <p class="close-more">
        The page for your kind of work:{' '}
        {LANDING_LINKS.map((l, i) => (
          <>
            <a href={l.href}>{l.label}</a>
            {i < LANDING_LINKS.length - 1 ? ', ' : '.'}
          </>
        ))}
      </p>
    </div>
  </div>
</Band>

<style>
  .close-grid {
    display: grid;
    grid-template-columns: minmax(0, 8.5fr) minmax(0, 3.5fr);
    gap: 2rem clamp(2rem, 4vw, 4rem);
    align-items: end;
  }
  .close-grid h2 {
    max-width: 12ch;
    font-size: clamp(3.4rem, 1rem + 8.4vw, 9.5rem);
    line-height: 0.86;
  }
  /* The turned-up sheet (ContourLayers, the hero's 'paper' tokens, without the river's
     name, which would sit under the headline) replaces the band's baked one. Every word
     on it is ink or ink-body: muted grey would fall under AA on a full line. */
  :global(.grounds-ready .home-close.ground-paper-contours:not(.has-layers)) {
    background-image: none;
  }
  :global(.home-close .contours.close-contours) {
    --c-pos: 40% 60%;
    --c-size: max(120%, 1500px) auto;
  }
  .close-grid {
    position: relative;
    z-index: 1;
  }
  .close-side {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--foreground);
  }
  .close-arrow {
    width: 1.1em;
    height: 1.1em;
  }
  .close-arrow path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }
  .close-mail {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font: 600 1rem/1.3 var(--font-ui);
    color: var(--heading);
    text-decoration: underline;
    text-decoration-color: var(--marker);
    text-underline-offset: 0.22em;
    overflow-wrap: anywhere;
  }
  .close-more {
    margin: 0;
    font: 400 1rem/1.9 var(--font-ui);
    color: var(--foreground);
  }
  .close-more a {
    color: var(--heading);
    text-decoration: underline;
    text-decoration-color: var(--marker);
    text-underline-offset: 0.2em;
  }
  @media (max-width: 820px) {
    .close-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
