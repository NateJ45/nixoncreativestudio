---
// Safe to edit.
/* ============================================================================
   HomeClose (the closing call on the homepage)
   ============================================================================
   "Let's build a site you won't have to redo." (the line the copy audit kept),
   one sentence on what to send, the button and the email address.

   Ground: paper-contours, still: the survey sheet of the Ohio's bend again,
   where "Cincinnati" belongs, closing the page the way the hero opened it,
   with the ink footer below it.

   Words: the Home page CMS entry (process_cta_title / _sub / _label, the
   fields the old Process Band's call used). The address: getSite(); the
   mailto keeps its copy-to-clipboard fallback (src/scripts/mailto-fallback.ts
   binds every mailto link on the page).
   ============================================================================ */
import Band from '../Band.astro';
import { buttonVariants } from '../ui/button';
import { getHomePage } from '../../lib/homePage';
import { getSite } from '../../data/site';
import { splitVoice } from '../../lib/homeWork';
import { LANDING_LINKS } from '../../lib/landingPage';

const { process } = await getHomePage(Astro);
const site = await getSite(Astro);
const heading = splitVoice(process.ctaTitle);
---

<Band ground="paper-contours" still id="start" labelledby="close-heading" class="home-close">
  <div class="close-grid">
    <h2 id="close-heading" class="type-headline">
      {heading.lead} {heading.voice && <span class="voice">{heading.voice}</span>}
    </h2>
    <div class="close-side">
      <p>{process.ctaSub}</p>
      <a href="/contact/" class:list={[buttonVariants({ variant: 'brand', size: 'cta' }), 'nudge']}>
        {process.ctaLabel}
        <svg viewBox="0 0 20 20" aria-hidden="true" class="close-arrow" data-nudge>
          <path d="M3 10h13M11 5l5 5-5 5"></path>
        </svg>
      </a>
      <a class="close-mail" href={`mailto:${site.email}`}>
        {site.email}
      </a>
      {/* The four search landing pages (src/lib/landingPage.ts), for a visitor
           who wants the page written for their kind of organization. */}
      <p class="close-more">
        The page for your kind of work:{' '}
        {LANDING_LINKS.map((l, i) => (
          <>
            <a href={l.href}>{l.label}</a>
            {i < LANDING_LINKS.length - 1 ? ', ' : '.'}
          </>
        ))}
      </p>
    </div>
  </div>
</Band>

<style>
  .close-grid {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: 2rem clamp(2rem, 4vw, 4rem);
    align-items: end;
  }
  .close-grid h2 {
    max-width: 13ch;
    font-size: clamp(3rem, 1.3rem + 5.4vw, 6.25rem);
  }
  .close-grid .voice {
    display: block;
  }
  .close-side {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--foreground);
  }
  .close-arrow {
    width: 1.1em;
    height: 1.1em;
  }
  .close-arrow path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }
  .close-mail {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font: 600 1rem/1.3 var(--font-ui);
    color: var(--heading);
    text-decoration: underline;
    text-decoration-color: var(--marker);
    text-underline-offset: 0.22em;
    overflow-wrap: anywhere;
  }
  .close-more {
    margin: 0;
    font: 400 0.9375rem/1.9 var(--font-ui);
    color: var(--muted-foreground);
  }
  .close-more a {
    color: var(--heading);
    text-decoration: underline;
    text-decoration-color: var(--marker);
    text-underline-offset: 0.2em;
  }
  @media (max-width: 820px) {
    .close-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
