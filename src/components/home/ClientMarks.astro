---
/* Home, the client marks: one quiet wall of the real logos of the organizations in the grid, each a
   link to its case study. It sits between the grid and What changed, so the names you just saw as
   phones come back as the marks their own people know them by (added 2026-11-15, after a look at
   another designer's client strip).

   The marks are set in one ink so the wall reads as one thing, and each one takes its own colours
   back when you point at it or land on it with the keyboard. As the wall scrolls into view, the
   marks rise in one after another (a CSS scroll-driven animation, home.css). Nothing moves on its
   own, so there is no pause button to give: under reduced motion, or in a browser without
   scroll-driven animations, the wall is simply there.

   The files are the clients' own (their repos and live sites), in src/assets/clients/ named by the
   study slug. The Presbyterian Academy's brand is a text wordmark set in Instrument Serif, so it
   is set as text here too. A client with no file is set as text, never drawn or invented. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Client } from '../../lib/clients';
import { countWord } from '../../lib/clients';

interface Props {
  clients: Client[];
}
const { clients } = Astro.props;

/* Every file in the folder, keyed by slug. A new client only needs its file dropped in. */
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/clients/*.{svg,png,webp}',
  { eager: true },
);
const bySlug = new Map(
  Object.entries(files).map(([path, mod]) => [
    path
      .split('/')
      .pop()!
      .replace(/\.\w+$/, ''),
    mod.default,
  ]),
);

/* How tall each mark is set, in rem, so wide wordmarks and tall seals carry the same weight.
   Anything not listed gets the default. `own: true` keeps the mark's own colours at rest: the
   Stone Steps sign is a hand-painted picture, and one ink would turn it into a block. */
const FIT: Record<string, { h?: number; own?: boolean }> = {
  'stone-steps-50k': { h: 4.4, own: true },
  'mas-monograms': { h: 1.9 },
  'reid-design': { h: 1.35 },
  'foundation-for-reformed-theology': { h: 1.5 },
  'first-presbyterian-orangeburg': { h: 3.4 },
  'west-chester-preschool': { h: 4 },
  'first-baptist-muncie': { h: 3.4 },
};
const BASE = 2.4;

const marks = clients.map((c) => ({
  ...c,
  file: bySlug.get(c.slug),
  h: FIT[c.slug]?.h ?? BASE,
  own: FIT[c.slug]?.own ?? false,
}));
---

<section class="logowall" aria-labelledby="lw-h">
  <h2 id="lw-h" class="label">
    {countWord(clients.length)} organizations, one person
  </h2>
  <ul class="lw-row">
    {marks.map((m, i) => (
      <li style={`--i:${i}`}>
        <a href={m.study} class:list={['lw', { own: m.own }]}>
          {m.file ? (
            <Image
              src={m.file}
              alt={m.name}
              height={Math.round(m.h * 16 * 2)}
              style={`height:${m.h}rem`}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <span class="lw-type">{m.name}</span>
          )}
        </a>
      </li>
    ))}
  </ul>
</section>
