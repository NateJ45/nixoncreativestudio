---
// Safe to edit.
/* ============================================================================
   LiveClip (a still that plays a short muted loop of the live page in view)
   ============================================================================
   Used by the proof sheet for a frame of a client site that moves on the real
   page (the Stone Steps course map). The still is a DeferredPicture (parked
   until near the viewport, Gotcha 14) and stays underneath as the poster. The
   clip is attached only after the load event and an idle beat, and only while
   the frame is on screen; it plays muted, inline, looping, fades in once
   playing and pauses off screen. A visible Pause button sits on the frame
   (WCAG 2.2.2). No clip under reduced motion, Save-Data or
   prefers-reduced-data, or without JavaScript: the still is the frame.
   ============================================================================ */
import type { ImageMetadata } from 'astro';
import DeferredPicture from './DeferredPicture.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  /** Public path of the WebM, e.g. /reel/stone-steps-50k/ss-d-clip-map.webm */
  clip: string;
}
const { src, alt, widths, sizes, clip } = Astro.props;
---

<div class="live" data-live-clip={clip}>
  <DeferredPicture src={src} alt={alt} widths={widths} sizes={sizes} />
  <button class="live-btn" type="button" aria-pressed="false" hidden>
    <svg viewBox="0 0 16 16" aria-hidden="true" class="i-pause">
      <path d="M5 3v10M11 3v10"></path>
    </svg>
    <svg viewBox="0 0 16 16" aria-hidden="true" class="i-play">
      <path d="M5 3l8 5-8 5z"></path>
    </svg>
    <span class="live-label">Pause the clip</span>
  </button>
</div>

<script>
  // Bound on astro:page-load with a dataset guard; listeners dropped on swap.
  function bind(box: HTMLElement) {
    if (box.dataset.bound) return;
    box.dataset.bound = '1';
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (
      matchMedia('(prefers-reduced-motion: reduce)').matches ||
      matchMedia('(prefers-reduced-data: reduce)').matches ||
      conn?.saveData ||
      !('IntersectionObserver' in window)
    )
      return;
    const btn = box.querySelector<HTMLButtonElement>('.live-btn')!;
    const label = btn.querySelector('.live-label')!;
    let v: HTMLVideoElement | null = null;
    let held = false;
    let seen = false;
    const sync = () => {
      if (!v) return;
      if (seen && !held && !document.hidden) v.play().catch(() => {});
      else v.pause();
    };
    const make = () => {
      v = document.createElement('video');
      v.className = 'live-video';
      v.muted = true;
      v.loop = true;
      v.playsInline = true;
      v.preload = 'auto';
      v.setAttribute('playsinline', '');
      v.setAttribute('aria-hidden', 'true');
      v.setAttribute('disablepictureinpicture', '');
      v.addEventListener('playing', () => v!.classList.add('is-on'), { once: true });
      v.src = box.dataset.liveClip!;
      box.insertBefore(v, btn);
      btn.hidden = false;
    };
    btn.addEventListener('click', () => {
      held = !held;
      btn.setAttribute('aria-pressed', String(held));
      label.textContent = held ? 'Play the clip' : 'Pause the clip';
      box.classList.toggle('is-held', held);
      sync();
    });
    const io = new IntersectionObserver(
      ([e]) => {
        seen = e.isIntersecting;
        if (seen && !v) make();
        sync();
      },
      { threshold: 0.4 },
    );
    io.observe(box);
    const off = () => (io.disconnect(), v?.pause());
    document.addEventListener('astro:before-swap', off, { once: true });
    document.addEventListener('visibilitychange', sync);
  }
  document.addEventListener('astro:page-load', () => {
    const run = () => document.querySelectorAll<HTMLElement>('[data-live-clip]').forEach(bind);
    const idle = () =>
      'requestIdleCallback' in window
        ? requestIdleCallback(run, { timeout: 1500 })
        : setTimeout(run, 300);
    if (document.readyState === 'complete') idle();
    else addEventListener('load', idle, { once: true });
  });
</script>

<style>
  .live {
    position: relative;
  }
  .live :global(video.live-video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.45s var(--ease-settle);
    pointer-events: none;
  }
  .live :global(video.live-video.is-on) {
    opacity: 1;
  }
  .live-btn {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 1;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    box-shadow: var(--shadow-print);
    cursor: pointer;
  }
  .live-btn[hidden] {
    display: none;
  }
  .live-btn svg {
    width: 16px;
    height: 16px;
  }
  .live-btn path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .live-btn .i-play path {
    fill: currentColor;
  }
  .live-btn .i-play,
  .live.is-held .live-btn .i-pause {
    display: none;
  }
  .live.is-held .live-btn .i-play {
    display: block;
  }
  .live-btn:hover {
    background: var(--marker);
  }
  .live-btn:focus-visible {
    outline: 3px solid var(--marker-hot);
    outline-offset: 2px;
  }
  .live-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
