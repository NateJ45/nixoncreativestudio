---
/* Home, "How it works" as a deck of four cards (the Details Vault "Card Unfold" section).

   The four steps are the four steps of "How it works" on the Prices page (src/pages/services.astro,
   #how), with the same headings. Each line under a heading is that step's own first sentence,
   shortened only by cutting, so nothing here says more than the Prices page does. Change a step
   there and here together.

   On a wide screen (1000px and up) the section is a tall scroll track with a sticky stage: one of
   my photographs fills the screen, shrinks into a deck of four cards cut from it, the deck fans
   out, and the cards turn over (two and four first, then one and three) to show the numbered
   steps. Under 1000px it is a column of the card backs that stack on top of each other as you
   scroll. src/scripts/card-unfold.js drives both from the scroll position (no motion library).

   With no script, or with reduced motion, the deck is simply finished: fanned and turned over on a
   wide screen, the stacking column on a phone. The photo and its four slices are decoration, so
   their alt is empty and their wrappers are aria-hidden; the steps are a real ordered list.
   No dates and no years on the photograph (the photography rule). */
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';

const beats = [
  {
    title: 'Start with a conversation',
    line: "The first conversation is free: text me about what you actually need, and I'll come back with an honest ballpark before anyone is committed.",
  },
  {
    title: 'Then the plan',
    line: 'I write down who the site is for, how the pages fit together, and what you want visitors to do next.',
  },
  {
    title: 'Then I design and build',
    line: 'I design and build the pages where you can see them. A link to the work so far lands in your inbox at each step.',
  },
  {
    title: 'Launch, and follow-through',
    line: 'I launch the site with you, then stay close for the first month to fix anything that surfaces.',
  },
];

/* A graduation service in a vaulted chapel (2026-11-20, replacing a farm landscape: the homepage
   leads with church work). Wide, with something in each quarter, so the four slices each read as
   a picture of their own: the organ, the window, the lanterns and the crowd. */
const photo = await getEntry('photos', 'grad-chapel');
if (!photo) throw new Error('Card unfold: no photo called grad-chapel');
const pic = await getImage({
  src: photo.data.image,
  widths: [960, 1280, 1800],
  format: 'webp',
});
/* The photo covers the stage at up to 1.2 times its size. It is 3:2, so on a screen narrower than
   3:2 its height sets the width (150svh, times 1.2); on a wider one the width does (120vw). */
const sizes = '(max-aspect-ratio: 3/2) 180svh, 120vw';
const img = {
  src: pic.src,
  srcset: pic.srcSet.attribute,
  sizes,
  width: photo.data.image.width,
  height: photo.data.image.height,
  alt: '',
  /* Lazy rather than eager: the section is far down the page, and on a phone (where the photo is
     never shown) a lazy image that is display: none is never fetched. */
  loading: 'lazy' as const,
  decoding: 'async' as const,
};
---

<section class="unfold" id="process" aria-labelledby="beats-h" data-fan-split>
  <div class="uf-stage" data-stage>
    <div class="uf-head">
      <h2 id="beats-h" data-rise="off">
        How it works
      </h2>
      <a href="/services/#how">The whole process, with timelines</a>
    </div>
    <ol class="uf-cards" data-cards>
      {beats.map((b, i) => (
        <li class="uf-card" data-card style={`--i: ${i}`}>
          <div class="uf-turn" data-turn>
            <div class="uf-face uf-front" aria-hidden="true">
              <img {...img} />
            </div>
            <div class="uf-face uf-back">
              <span class="uf-number" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="uf-text">
                <h3>{b.title}</h3>
                <p>{b.line}</p>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ol>
    <div class="uf-cover" data-cover aria-hidden="true">
      <img {...img} />
    </div>
  </div>
</section>
