---
// Safe to edit.
/* ============================================================================
   HomeProcess ("How it works, and how long it takes" on the homepage)
   ============================================================================
   The four steps as a timing sheet: one ruled line with a mark per step, each
   step's duration in Bebas above its name, and a china-marker bracket over the
   middle two steps for the six to ten weeks they share.

   Ground: paper (between the ink price list and the ink about band).

   Words: the Home page CMS entry (heading, sub, the four steps). The duration
   labels stay in code because the CMS schema has no field for them; they
   restate what the copy already says (the first step's "an hour", the last
   step's "first month", and the six to ten weeks from the sub and the
   /services FAQ). Change them here if those words change.

   /services still uses ProcessBand.astro for its recap of the same steps.
   ============================================================================ */
import Band from '../Band.astro';
import { getHomePage } from '../../lib/homePage';
import { splitVoice } from '../../lib/homeWork';

const { process } = await getHomePage(Astro);
const heading = splitVoice(process.heading);

/** The time each step takes, in order (see the note above). Steps two and three share one
    span, so they carry one label: the bracket over them at desktop, a red run of the line
    beside them on a phone. The same words at every width (2026-10-04 review). */
const SHARED = '6 to 10 weeks, kickoff to launch';
const DURATIONS = ['1 hour', SHARED, '', 'First month'];
---

<Band ground="paper" id="how" labelledby="process-heading" class="home-process">
  <h2 id="process-heading" class="type-headline">
    {heading.lead} {heading.voice && <span class="voice">{heading.voice}</span>}
  </h2>
  <p class="process-sub">{process.sub}</p>

  <div class="timeline-wrap">
    <div class="bracket" aria-hidden="true">
      <span>{SHARED}</span>
    </div>
    <ol class="process-steps" role="list">
      {process.steps.map((step, i) => (
        <li class:list={['step', { 'step--in': i === 1 || i === 2 }]}>
          <span class:list={['step-time', { 'step-time--in': i === 1 || i === 2 }]}>
            {DURATIONS[i] || ' '}
          </span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</Band>

<style>
  #process-heading {
    max-width: 14ch;
    font-size: clamp(2.75rem, 1.4rem + 4.6vw, 5.5rem);
  }
  #process-heading .voice {
    display: block;
  }
  .process-sub {
    margin-top: 1.4rem;
    max-width: 48ch;
    font-family: var(--font-serif);
    font-size: var(--text-lede);
    line-height: 1.4;
    color: var(--foreground);
    text-wrap: pretty;
  }
  .timeline-wrap {
    position: relative;
    margin-top: clamp(5rem, 8vw, 6.5rem);
  }
  .process-steps {
    display: grid;
    grid-template-columns: 1fr 1.5fr 1.5fr 1.2fr;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--heading);
  }
  .step {
    position: relative;
    padding: 1.6rem clamp(1rem, 2vw, 1.75rem) 0 0;
  }
  .step::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 0;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--heading);
  }
  .step-time {
    display: block;
    font: 400 clamp(1.75rem, 1.3rem + 1.3vw, 2.5rem) / 1 var(--font-display);
    letter-spacing: 0.02em;
    color: var(--marker);
  }
  .step h3 {
    margin: 0.85rem 0 0.6rem;
    font: 400 1.35rem/1.2 var(--font-serif);
    color: var(--heading);
  }
  .step p {
    max-width: 32ch;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--muted-foreground);
  }
  /* The bracket over steps two and three: they share the six to ten weeks. Its label
     replaces their own labels at desktop widths. */
  .bracket {
    position: absolute;
    top: -3.4rem;
    left: calc(100% * 1 / 5.2);
    width: calc(100% * 3 / 5.2);
    height: 1.4rem;
    border: 2px solid var(--marker);
    border-bottom: 0;
    pointer-events: none;
  }
  .bracket span {
    position: absolute;
    left: 0;
    top: -1.9rem;
    font: 400 1.35rem/1 var(--font-display);
    letter-spacing: 0.03em;
    color: var(--marker);
    white-space: nowrap;
  }
  /* At desktop the bracket carries the shared label, so the two steps' own label lines
     stay empty (kept for alignment, hidden from screen readers by being blank). */
  @media (min-width: 821px) {
    .step-time--in {
      visibility: hidden;
      height: 1em;
      overflow: hidden;
    }
  }
  @media (max-width: 820px) {
    .bracket {
      display: none;
    }
    .timeline-wrap {
      margin-top: 2.5rem;
    }
    .process-steps {
      grid-template-columns: 1fr;
      border-top: 0;
      border-left: 2px solid var(--heading);
      margin-left: 7px;
    }
    .step {
      padding: 0 0 2.2rem 1.6rem;
    }
    .step:last-child {
      padding-bottom: 0;
    }
    .step::before {
      top: 4px;
      left: -9px;
    }
    /* The shared weeks: the line runs red beside steps two and three, and step three
       carries no label of its own (step two's names the span). */
    .step--in::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: -2px;
      width: 2px;
      background: var(--marker);
    }
    .step--in + .step--in .step-time {
      display: none;
    }
    .step--in::before {
      z-index: 1;
      border-color: var(--marker);
    }
  }
</style>
