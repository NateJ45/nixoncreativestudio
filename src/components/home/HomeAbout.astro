---
// Safe to edit.
/* ============================================================================
   HomeAbout ("Who you work with" on the homepage)
   ============================================================================
   The page's one full-bleed moment. Nathan's black-and-white studio portrait
   runs edge to edge down the left half of the band, top to bottom, with no
   frame; on the right, the line the copy audit kept ("The person you meet on
   day one is the same person who hands you the finished site.") at headline
   size, a short bio and a link to /about/. On a phone the portrait spans the
   width above the words. (Round 2, 2026-10-04: the two small snapshots moved
   to /about only, so the band has one idea: the person.)

   Ground: deep (the ink board, still).

   The words here are in code: the Home page entry has no field for this band
   (and the CMS schema is not this page's to change). They restate the About
   page's own story (cms/content/page_about.json), so change both together.
   Pictures: the bundled portrait and two of the About photos, native lazy
   loading. The band sits several screens below the fold at every width, far
   outside Chrome's lazy-load distance at load, so they never compete with the
   LCP (Gotcha 14) and need no parking script.
   ============================================================================ */
import { Picture } from 'astro:assets';
import Band from '../Band.astro';
import portrait from '../../assets/about/portrait-bw.jpg';
import { getSite } from '../../data/site';

const site = await getSite(Astro);
---

<Band
  ground="deep"
  still
  flush
  container={false}
  id="about"
  labelledby="about-heading"
  class="home-about"
>
  <div class="about-grid">
    <figure class="portrait" data-reveal="fade">
      <Picture
        src={portrait}
        formats={['avif', 'webp']}
        alt={`A black-and-white studio portrait of ${site.ownerName} looking off to the side.`}
        widths={[480, 720, 960, 1280]}
        sizes="(max-width: 820px) 100vw, 50vw"
        loading="lazy"
        decoding="async"
      />
      <figcaption>{site.ownerName}, Cincinnati</figcaption>
    </figure>
    <div class="about-text">
      <h2 id="about-heading" class="sr-only">
        Who you work with
      </h2>
      <blockquote class="about-line">
        <p>
          The person you meet on day one is the same person who{' '}
          <span>hands you the finished site.</span>
        </p>
      </blockquote>
      <div class="bio">
        <p>
          <strong>I'm {site.ownerName}.</strong> I came to this work through a camera: years of
          portraits, families and weddings, then websites from 2020 for some of those same clients.
          It turned out to be the same job: work out what someone is trying to say, then make it
          clear.
        </p>
        <p>
          Before that I studied mechanical engineering at the University of Edinburgh, back home in
          Scotland. It taught me to build things so the person who inherits them can keep them
          running.
        </p>
      </div>
      <a class="card-link about-more" href="/about/">
        More about me
      </a>
    </div>
  </div>
</Band>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
  }
  .portrait {
    position: relative;
    margin: 0;
    min-height: 100%;
  }
  .portrait :global(picture),
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .portrait :global(img) {
    min-height: min(56rem, 62vw);
    object-fit: cover;
    object-position: 42% 28%;
  }
  .portrait figcaption {
    position: absolute;
    left: var(--gutter);
    bottom: 1.25rem;
    padding: 0.35rem 0.6rem;
    border-radius: 2px;
    background: var(--ink);
    font: 500 0.9375rem/1.3 var(--font-ui);
    color: var(--paper);
  }
  .about-text {
    align-self: center;
    max-width: 40rem;
    padding: var(--band-y) var(--gutter);
  }
  .about-line {
    margin: 0;
    font: italic 400 clamp(2.25rem, 1rem + 3.6vw, 4.75rem) / 1.02 var(--font-serif);
    letter-spacing: -0.025em;
    color: var(--heading);
    text-wrap: balance;
  }
  .about-line span {
    color: var(--marker);
  }
  .bio {
    display: grid;
    gap: 1rem;
    margin-top: 2.25rem;
    max-width: 44ch;
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1.02rem + 0.35vw, 1.3rem);
    line-height: 1.55;
    color: var(--foreground);
  }
  .bio strong {
    font-weight: 400;
    color: var(--heading);
  }
  .about-more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 1.75rem;
    font: 600 1.0625rem/1.3 var(--font-ui);
    color: var(--heading);
  }
  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .portrait :global(img) {
      min-height: 0;
      height: auto;
      aspect-ratio: 4 / 4.4;
    }
  }
</style>
