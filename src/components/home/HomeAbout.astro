---
// Safe to edit.
/* ============================================================================
   HomeAbout ("Who you work with" on the homepage)
   ============================================================================
   Nathan's portrait beside the line the copy audit kept ("The person you meet
   on day one is the same person who hands you the finished site."), a short
   bio and two real snapshots, then a link to /about/.

   Ground: deep (the ink board, still), so the portrait sits like a print on
   a dark table.

   The words here are in code: the Home page entry has no field for this band
   (and the CMS schema is not this page's to change). They restate the About
   page's own story (cms/content/page_about.json), so change both together.
   Pictures: the bundled headshot and two of the About photos, parked until
   needed (DeferredPicture: Gotcha 14).
   ============================================================================ */
import DeferredPicture from './DeferredPicture.astro';
import Band from '../Band.astro';
import headshot from '../../assets/brand/headshot.jpg';
import running from '../../assets/about/running.jpg';
import exploring from '../../assets/about/exploring.jpg';
import { getSite } from '../../data/site';

const site = await getSite(Astro);
---

<Band ground="deep" still id="about" labelledby="about-heading" class="home-about">
  <div class="about-grid">
    <figure class="portrait" data-reveal="fade">
      <DeferredPicture
        src={headshot}
        alt={`${site.ownerName}, smiling, outdoors in summer light`}
        widths={[400, 640, 900, 1200]}
        sizes="(max-width: 820px) 92vw, 40vw"
      />
      <figcaption>{site.ownerName}, Cincinnati</figcaption>
    </figure>
    <div class="about-text">
      <h2 id="about-heading" class="sr-only">
        Who you work with
      </h2>
      <blockquote class="about-line">
        <p>
          The person you meet on day one is the same person who{' '}
          <span>hands you the finished site.</span>
        </p>
      </blockquote>
      <div class="bio">
        <p>
          <strong>I'm {site.ownerName}.</strong> I came to this work through a camera: years of
          portraits, families and weddings, then websites from 2020 for some of those same clients.
          It turned out to be the same job: work out what someone is trying to say, then make it
          clear.
        </p>
        <p>
          Before that I studied mechanical engineering at the University of Edinburgh, back home in
          Scotland. It taught me to build things so the person who inherits them can keep them
          running.
        </p>
      </div>
      <div class="mini">
        <figure>
          <DeferredPicture
            src={running}
            alt="Nathan and a friend at the end of a charity 5K, race bibs on."
            widths={[200, 300]}
            sizes="140px"
          />
          <figcaption>Race day</figcaption>
        </figure>
        <figure>
          <DeferredPicture
            src={exploring}
            alt="Nathan carrying a small child in front of old railroad cars."
            widths={[200, 300]}
            sizes="140px"
          />
          <figcaption>Out exploring</figcaption>
        </figure>
      </div>
      <a class="card-link about-more" href="/about/">
        More about me
      </a>
    </div>
  </div>
</Band>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .portrait {
    margin: 0;
    max-width: 34rem;
  }
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
    box-shadow: var(--shadow-frame);
  }
  .portrait figcaption,
  .mini figcaption {
    margin-top: 0.75rem;
    font: 500 0.8125rem/1.3 var(--font-ui);
    color: var(--muted-foreground);
  }
  .about-line {
    margin: 0;
    font: italic 400 clamp(2rem, 1.2rem + 2.6vw, 3.5rem) / 1.08 var(--font-serif);
    letter-spacing: -0.02em;
    color: var(--heading);
    text-wrap: balance;
  }
  .about-line span {
    color: var(--marker);
  }
  .bio {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
    max-width: 48ch;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--muted-foreground);
  }
  .bio strong {
    font-weight: 400;
    color: var(--heading);
  }
  .mini {
    display: flex;
    gap: 12px;
    margin-top: 2rem;
  }
  .mini figure {
    margin: 0;
    width: 140px;
  }
  .mini :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 2px;
  }
  .about-more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 1.5rem;
    font: 600 1.0625rem/1.3 var(--font-ui);
    color: var(--heading);
  }
  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
