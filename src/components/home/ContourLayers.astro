---
// Safe to edit.
/* ============================================================================
   ContourLayers (the Ohio's contours, turned up, for the home hero and close)
   ============================================================================
   Three CSS mask layers over token colours (src/lib/heroGround.ts, DESIGN.md
   "Hero ground"): the contour lines, the river and creek beds, the river's
   banks and its name. The masks (src/assets/home/contours-*.svg, baked by
   scripts/brand/build-hero-contours.mjs) attach only after the load event
   (html.grounds-ready), like every ground texture, and a mask is never an LCP
   candidate. Place it as the first child of a <Band> (it fills the band,
   behind the content). The lines drift with the foundation's contour motion
   when `moving` is set (the page's one moving ground), and hold still off
   screen and under reduced motion.
   ============================================================================ */
import { HERO_GROUNDS, heroGroundStyle } from '../../lib/heroGround';

interface Props {
  variant: 'ink' | 'paper';
  /** Drift (only the page's one moving ground). */
  moving?: boolean;
  /** Show the river's name at desktop widths (it never shows on a phone). */
  label?: boolean;
  class?: string;
}
const { variant, moving = false, label = true, class: className } = Astro.props;
---

<div
  class:list={['contours', { 'contours--moving': moving, 'contours--nolabel': !label }, className]}
  style={heroGroundStyle(HERO_GROUNDS[variant])}
  aria-hidden="true"
>
  <i class="c-bed"></i>
  <i class="c-lines"></i>
  <i class="c-edge"></i>
</div>

<style>
  .contours {
    position: absolute;
    inset: -24px;
    z-index: 0;
    pointer-events: none;
    --c-pos: left 18vw top 7.5rem;
    --c-size: max(132%, 1500px) auto;
  }
  .contours > i {
    position: absolute;
    inset: 0;
    visibility: hidden;
    -webkit-mask: none;
    mask: none;
  }
  /* Each fill is a one-colour gradient, not a background colour: axe cannot see a mask
     and would score the text against the whole layer as a solid wash; as an image it
     leaves the pixels to src/lib/heroContours.test.ts, which checks the real ones. */
  .c-bed {
    background: linear-gradient(var(--hg-bed), var(--hg-bed));
  }
  .c-lines {
    background: linear-gradient(var(--hg-line), var(--hg-line));
    opacity: var(--hg-line-o);
  }
  .c-edge {
    background: linear-gradient(var(--hg-edge), var(--hg-edge));
    opacity: var(--hg-edge-o);
  }
  :global(.grounds-ready) .contours > i {
    visibility: visible;
    -webkit-mask: var(--c-mask) var(--c-pos) / var(--c-size) no-repeat;
    mask: var(--c-mask) var(--c-pos) / var(--c-size) no-repeat;
  }
  .c-bed {
    --c-mask: url('../../assets/home/contours-bed.svg');
  }
  .c-lines {
    --c-mask: url('../../assets/home/contours-lines.svg');
  }
  .c-edge {
    --c-mask: url('../../assets/home/contours-edge.svg');
  }
  .contours--nolabel .c-edge {
    --c-mask: url('../../assets/home/contours-edge-phone.svg');
  }
  @media (max-width: 40rem) {
    .contours {
      --c-pos: 30% 30%;
      --c-size: 1100px auto;
    }
    .c-edge {
      --c-mask: url('../../assets/home/contours-edge-phone.svg');
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .contours--moving {
      animation: ground-contours 18s ease-in-out infinite alternate;
      will-change: transform;
    }
    :global(.is-off) .contours--moving {
      animation-play-state: paused;
    }
  }
</style>
