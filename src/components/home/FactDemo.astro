---
// Safe to edit.
/* ============================================================================
   FactDemo ("Change the service time once" on the homepage)
   ============================================================================
   Nathan's real difference, shown instead of described: on his sites a fact
   is typed once and every page that mentions it reads it from there, so the
   site stays right without a webmaster. Here the visitor does it. A made-up
   church (Larkspur Street Church, labelled as made up in the band) keeps its
   Sunday service time in one field; six small pieces of its website (header,
   home banner, visit page, contact page, search listing, footer) are drawn
   as matted prints on the ink board, wired to that one field.

   Productionised from the round 1 prototype (design archive, mockups/
   d5-one-fact, RATIONALE.md).

   Ground: deep, still (the ink board; the prints and the settings sheet are
   paper on it, so they re-scope the paper tokens below).

   Behaviour (src/scripts/factDemo.ts; the pure parts, time reading and the
   derived coffee time, are src/lib/factDemo.ts with unit tests):
   - A typed time publishes once typing pauses (so "10:45" never flashes
     1:00 PM on the way), or at once on Enter, Update, a quick pick or blur.
   - Anything that is not a time is refused, and the alert says so; the old
     time stays everywhere.
   - "Edit page by page" switches to the way most small sites are kept: it
     changes the visit page only (and makes that edit at once, so the drift
     shows), the other places keep the old time struck through in red, and
     their wires are cut.
   - The visit page's coffee time is worked out from the service time (15
     minutes earlier), like Stone Steps' records are worked out from finishes.

   Without JavaScript the band shows the before state: the field as a static
   value, the six places at 10:30 AM, the wiring, and one sentence saying what
   would happen. The controls are hidden (html.js gates them, set inline in
   the head before the first paint, so nothing appears late).

   No layout shift: every place has a fixed box, each time sits at the end of
   its line with nowrap, the chips and footer line have fixed widths, and the
   hint, error and status lines reserve their height. The band never changes
   height when a value changes.

   Words: in code, not the admin (the home entry has no fields for them).
   docs/EDITING-GUIDE.md says so.
   ============================================================================ */
import Band from '../Band.astro';
import { START_MINUTES, coffeeFrom, formatTime } from '../../lib/factDemo';

const start = formatTime(START_MINUTES);
const coffee = formatTime(coffeeFrom(START_MINUTES));
const picks = ['9:00 AM', '11:15 AM', '6:00 PM'];

/* The collage (48rem and up): each place is placed on a 100 by 86 sheet, in
   units of 1% of the sheet's width (x, w) and 1/86 of its height (y, h). The
   wiring SVG uses the same units, so the wires land on the prints at any width.
   r is the print's tilt in degrees. `edit` marks the visit page, the one page
   that page-by-page mode changes. */
const SHEET_H = 86;
/** Where the trunk wire runs, between the two rows of prints (the sheet's middle). */
const TRUNK = 43;
const places = [
  { id: 'header', cap: 'Header, on every page', x: 8, y: 0, w: 90, h: 12, r: 0 },
  { id: 'banner', cap: 'Home page banner', x: 4, y: 14, w: 52, h: 27, r: -0.8 },
  { id: 'visit', cap: 'Plan your visit page', x: 60, y: 16, w: 40, h: 25, r: 1, edit: true },
  { id: 'contact', cap: 'Contact page', x: 10, y: 45, w: 42, h: 17, r: 0.6 },
  {
    id: 'search',
    cap: "Search listing, after Google's next visit",
    x: 56,
    y: 45,
    w: 44,
    h: 21,
    r: -0.6,
  },
  { id: 'footer', cap: 'Footer, on every page', x: 6, y: 72, w: 92, h: 12, r: 0.3 },
] as const;

/** Each place's own wire, from the trunk (or the bus at x 2) into the print's edge. */
const BUS_X = 2;
const wires: Record<(typeof places)[number]['id'], string> = {
  header: `M${BUS_X} 6H9`,
  footer: `M${BUS_X} 78H7`,
  banner: `M30 ${TRUNK}V40`,
  visit: `M80 ${TRUNK}V40`,
  contact: `M20 ${TRUNK}V46`,
  search: `M74 ${TRUNK}V46`,
};
/** Where each wire meets its print: a solder dot. */
const ends: Record<(typeof places)[number]['id'], [number, number]> = {
  header: [8.6, 6],
  footer: [6.6, 78],
  banner: [30, 40.6],
  visit: [80, 40.6],
  contact: [20, 45.4],
  search: [74, 45.4],
};
const geometry = (p: (typeof places)[number]) =>
  `--x:${p.x};--y:${p.y};--w:${p.w};--h:${p.h};--r:${p.r}deg`;
---

<Band ground="deep" still id="one-place" labelledby="fact-heading" class="fact-demo">
  <div class="fd" data-fact-demo>
    <header class="fd-head">
      <h2 id="fact-heading" class="type-headline fd-title">
        Change the service time once. <span class="voice">Watch every page keep up.</span>
      </h2>
      <p class="fd-lede">
        On the sites I build, a fact like a service time, office hours or a race date is typed in
        one place, and every page that mentions it reads it from there, so nobody has to hunt down
        the old one in the footer.
      </p>
    </header>

    <div class="fd-rig">
      {/* The one place the time is stored, drawn as the site's settings sheet. */}
      <form class="fd-sheet" data-fd-form novalidate aria-labelledby="fd-sheet-title">
        <p class="fd-sheet-title" id="fd-sheet-title">
          Larkspur Street Church: service times
        </p>
        <p class="fd-note voice">Larkspur Street Church is made up for this demo.</p>

        <label for="fd-time" class="fd-label">
          Sunday worship starts at
        </label>
        <p class="fd-static" aria-hidden="true">
          {start}
        </p>
        <div class="fd-entry">
          <input
            id="fd-time"
            class="fd-input"
            name="service-time"
            value={start}
            autocomplete="off"
            spellcheck="false"
            inputmode="text"
            enterkeyhint="done"
            maxlength="16"
            aria-describedby="fd-hint fd-err"
            data-fd-input
          />
          <button type="submit" class="fd-go">
            Update
          </button>
        </div>
        <div class="fd-picks" role="group" aria-labelledby="fd-picks-label">
          <span id="fd-picks-label" class="fd-picks-label">
            Or try
          </span>
          {picks.map((p) => (
            <button type="button" class="fd-pick" data-fd-pick={p}>
              {p}
            </button>
          ))}
        </div>
        <div class="fd-msg">
          <p id="fd-hint" class="fd-hint" data-fd-hint>
            This is the only place the time is stored. Every page reads it from here.
          </p>
          <p id="fd-err" class="fd-err" role="alert" data-fd-err></p>
          <p class="fd-nojs">
            On a real site, changing this one field changes all six places with it. Turn on
            JavaScript to try it here.
          </p>
        </div>
      </form>

      <div class="fd-places" data-fd-places>
        <ol
          class="fd-list"
          aria-label="Six places on Larkspur Street Church's site that show the time"
        >
          {places.map((p) => (
            <li
              class="fd-place"
              data-fd-place={p.id}
              data-fd-edit={'edit' in p ? '' : undefined}
              style={geometry(p)}
            >
              <div class="fd-print">
                {p.id === 'header' && (
                  <div class="fd-site s-header">
                    <span class="sh-name">Larkspur Street Church</span>
                    <span class="sh-nav" aria-hidden="true">
                      Visit &nbsp; About &nbsp; Give
                    </span>
                    <span class="sh-chip">
                      Sundays <span class="fd-v" data-fd-v="service" set:text={start} />
                    </span>
                  </div>
                )}
                {p.id === 'banner' && (
                  <div class="fd-site s-banner">
                    <span class="sb-kicker">Welcome home</span>
                    <span class="sb-line">Join us this Sunday at</span>
                    <span class="sb-time">
                      <span class="fd-v" data-fd-v="service" set:text={start} />
                    </span>
                  </div>
                )}
                {p.id === 'visit' && (
                  <div class="fd-site s-visit">
                    <span class="sv-title">Plan your visit</span>
                    <span class="sv-row">
                      <span class="sv-k">Coffee</span>
                      <span>
                        from <span class="fd-v" data-fd-v="coffee" set:text={coffee} />
                      </span>
                    </span>
                    <span class="sv-row">
                      <span class="sv-k">Worship</span>
                      <span class="fd-v" data-fd-v="service" set:text={start} />
                    </span>
                    <span class="sv-row">
                      <span class="sv-k">Children</span>
                      <span>Nursery all morning</span>
                    </span>
                  </div>
                )}
                {p.id === 'contact' && (
                  <div class="fd-site s-contact">
                    <span class="sc-text">
                      Questions before Sunday? Call the office, or just come.
                    </span>
                    <span class="sc-line">
                      Worship starts at <span class="fd-v" data-fd-v="service" set:text={start} />
                    </span>
                  </div>
                )}
                {p.id === 'search' && (
                  <div class="fd-site s-search">
                    <span class="ss-url">larkspur-street.example &rsaquo; visit</span>
                    <span class="ss-title">Visit us | Larkspur Street Church</span>
                    <span class="ss-line">
                      Worship Sundays at <span class="fd-v" data-fd-v="service" set:text={start} />
                    </span>
                    <span class="ss-line">
                      Everyone welcome. Coffee from{' '}
                      <span class="fd-v" data-fd-v="coffee" set:text={coffee} />
                    </span>
                  </div>
                )}
                {p.id === 'footer' && (
                  <div class="fd-site s-footer">
                    <span class="sf-name">Larkspur Street Church</span>
                    <span class="sf-line">
                      Sunday worship <span class="fd-v" data-fd-v="service" set:text={start} />
                    </span>
                  </div>
                )}
                <span class="fd-cap">{p.cap}</span>
              </div>
            </li>
          ))}
        </ol>
        {/* The wiring for the collage (48rem and up): one trunk from the settings sheet, a
            bus down the left, and one wire per place. Phones draw a plain spine in CSS. */}
        <svg
          class="fd-wiring"
          viewBox={`0 0 100 ${SHEET_H}`}
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
        >
          <path class="fd-entry-side" d={`M0 ${TRUNK}H${BUS_X}`}></path>
          <path class="fd-entry-top" d={`M${BUS_X} 0V6`}></path>
          <path class="fd-trunk" d={`M${BUS_X} 6V78M${BUS_X} ${TRUNK}H80`}></path>
          {places.map((p) => (
            <path class="fd-wire" data-fd-wire={p.id} d={wires[p.id]} />
          ))}
          {places.map((p) => (
            <circle
              class="fd-dot"
              data-fd-wire={p.id}
              cx={ends[p.id][0]}
              cy={ends[p.id][1]}
              r="0.55"
            />
          ))}
        </svg>
      </div>

      {/* The other way: the same site kept page by page. Its own slip, so on a phone it sits
          under the six places it changes. */}
      <div class="fd-break" aria-labelledby="fd-break-title" role="group">
        <p class="fd-break-intro">
          <strong id="fd-break-title">Now try to break it.</strong> Type something that isn&rsquo;t
          a time, or switch to editing page by page, the way most small sites are still kept up.
        </p>
        <label class="fd-switch">
          <input type="checkbox" role="switch" data-fd-mode />
          <span class="fd-track" aria-hidden="true"></span>
          Edit the old way, page by page
        </label>
        <p class="fd-status" role="status" data-fd-status>
          All six places say {start}.
        </p>
      </div>
    </div>
  </div>
</Band>

<script>
  import '../../scripts/factDemo';
</script>

<style>
  /* ---- The head: a big two-voice headline beside one plain sentence ------------------ */
  .fd-head {
    display: grid;
    gap: 1.5rem 4rem;
  }
  @media (min-width: 64rem) {
    .fd-head {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      align-items: end;
    }
  }
  .fd-title {
    max-width: 11em;
    font-size: clamp(2.75rem, 1.3rem + 4.9vw, 6rem);
  }
  .fd-title .voice {
    display: block;
  }
  .fd-lede {
    max-width: 30em;
    font-family: var(--font-serif);
    font-size: var(--text-lede);
    line-height: 1.4;
    color: var(--foreground);
    text-wrap: pretty;
  }

  /* ---- The rig: the settings sheet and the six places --------------------------------
     Phones: one column, the places as a list on a spine. 48rem: the sheet above the
     collage. 80rem: the sheet on the left as the hero control, the collage on the right,
     wired across the gap at the collage's middle (the sheet is centred on it). */
  .fd-rig {
    --fd-gap: 2.25rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--fd-gap);
    margin-top: clamp(2.75rem, 6vw, 5rem);
  }
  @media (min-width: 48rem) {
    .fd-rig {
      --fd-gap: 3rem;
    }
    .fd-sheet,
    .fd-break {
      max-width: 30rem;
    }
    .fd-places {
      max-width: 54rem;
    }
  }
  /* Side by side: the sheet and the "break it" slip stack in the left column (the slip
     below), the collage spans both rows. Spare height goes above the sheet, so the
     collage's middle, where the wire crosses, always lands on the sheet. */
  @media (min-width: 80rem) {
    .fd-rig {
      --fd-gap: 4.5rem;
      grid-template-columns: minmax(21rem, 26rem) minmax(0, 1fr);
      grid-template-rows: 1fr auto;
      grid-template-areas:
        'sheet places'
        'break places';
      row-gap: 1.25rem;
    }
    .fd-sheet {
      grid-area: sheet;
      align-self: end;
      max-width: none;
    }
    .fd-break {
      grid-area: break;
      max-width: none;
    }
    .fd-places {
      grid-area: places;
      align-self: center;
      max-width: none;
    }
    /* Without JavaScript there is no slip, so the sheet centres on the collage. */
    :global(html:not(.js)) .fd-sheet {
      grid-row: 1 / -1;
      align-self: center;
    }
  }
  /* The narrowest phones: a slightly smaller drawing unit, so the longest line in a print
     (the search listing) fits whole. */
  @media (max-width: 22rem) {
    .fd-rig .fd-places {
      --u: 0.4rem;
    }
  }

  /* ---- The settings sheet (a document on the board: paper, double rule, red pen) ----- */
  .fd-sheet,
  .fd-break {
    /* Paper tokens inside the ink band: the sheet is a piece of paper. */
    --foreground: var(--ink-body);
    --heading: var(--ink);
    --muted-foreground: var(--ink-muted);
    --marker: var(--brick);
    --link: var(--brick);
    --ring: var(--brick);
    position: relative;
    z-index: 1;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--paper-raised);
    color: var(--foreground);
    border-radius: var(--radius);
    box-shadow: var(--shadow-print);
  }
  .fd-sheet-title {
    padding-bottom: 0.55rem;
    border-bottom: 3px double var(--heading);
    font: 400 clamp(1.45rem, 1.2rem + 0.8vw, 1.85rem) / 1 var(--font-display);
    letter-spacing: 0.02em;
    color: var(--heading);
  }
  .fd-note {
    margin-top: 0.6rem;
    font-size: 1.05rem;
    line-height: 1.35;
  }
  .fd-label {
    display: block;
    margin-top: 1.4rem;
    font: 600 var(--text-ui) / 1.3 var(--font-ui);
    color: var(--heading);
  }
  /* The value, as big as the headline's numerals. The static copy (no JavaScript) and the
     input share one box size, so swapping them moves nothing. */
  .fd-static,
  .fd-input {
    font: 400 clamp(3rem, 2.2rem + 2.6vw, 4.5rem) / 1 var(--font-display);
    letter-spacing: 0.02em;
    color: var(--heading);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .fd-static {
    margin-top: 0.35rem;
    padding: 0.2rem 0 0.25rem;
    border-bottom: 2px solid var(--ink-muted);
  }
  .fd-entry {
    display: flex;
    align-items: stretch;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }
  .fd-input {
    flex: 1;
    min-width: 0;
    width: 100%;
    padding: 0.2rem 0.1rem 0.25rem;
    background: transparent;
    border: 0;
    border-bottom: 2px solid var(--ink-muted);
    border-radius: 0;
  }
  .fd-input:focus-visible {
    border-bottom-color: var(--brick);
  }
  .fd-input[aria-invalid='true'] {
    border-bottom-color: var(--brick);
    color: var(--brick);
  }
  .fd-go,
  .fd-pick {
    min-height: 44px;
    font: 600 var(--text-ui) / 1 var(--font-ui);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .fd-go {
    align-self: center;
    min-height: 48px;
    padding: 0 1.1rem;
    background: var(--ink);
    color: var(--paper);
    border: 0;
  }
  .fd-go:hover {
    background: var(--brick);
  }
  .fd-picks {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .fd-picks-label {
    margin-right: 0.15rem;
    font: 400 var(--text-caption) / 1 var(--font-ui);
    color: var(--muted-foreground);
  }
  /* On a phone the label takes its own line, so the three times sit on one row. */
  @media (max-width: 29.99rem) {
    .fd-picks-label {
      flex-basis: 100%;
    }
  }
  .fd-pick {
    padding: 0 0.8rem;
    background: transparent;
    color: var(--heading);
    border: 1px solid var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .fd-pick:hover {
    background: var(--paper-deep);
  }
  /* Hint, error and the no-JS sentence share one slot of fixed height, so an error never
     pushes anything down. */
  .fd-msg {
    display: grid;
    margin-top: 0.9rem;
    min-height: 4.1em;
    font: 400 var(--text-caption) / 1.4 var(--font-ui);
  }
  .fd-msg > * {
    grid-area: 1 / 1;
  }
  .fd-hint,
  .fd-nojs {
    color: var(--muted-foreground);
  }
  .fd-err {
    color: var(--brick);
    font-weight: 600;
  }
  .fd-msg.has-error .fd-hint {
    visibility: hidden;
  }

  .fd-break-intro {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.45;
  }
  .fd-break-intro strong {
    color: var(--heading);
  }
  .fd-switch {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    margin-top: 0.6rem;
    font: 600 var(--text-ui) / 1.2 var(--font-ui);
    color: var(--heading);
    cursor: pointer;
  }
  /* The real checkbox, invisible, covers the whole label (a 44px target); the track
     beside the words draws its state and its focus ring. */
  .fd-switch input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .fd-track {
    position: relative;
    flex: none;
    width: 46px;
    height: 28px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
  }
  .fd-track::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--ink);
  }
  .fd-switch input:checked + .fd-track {
    background: var(--brick);
    border-color: var(--brick);
  }
  .fd-switch input:checked + .fd-track::after {
    background: var(--paper);
    transform: translateX(18px);
  }
  .fd-switch input:focus-visible + .fd-track {
    outline: 3px solid var(--ring);
    outline-offset: 3px;
  }
  .fd-status {
    /* Room for the longest message (the drift), so the sheet never grows. */
    min-height: 5.8em;
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--foreground);
  }
  @media (min-width: 30rem) {
    .fd-status {
      min-height: 4.4em;
    }
  }
  .fd-status :global(.fd-bad) {
    color: var(--brick);
    font-weight: 600;
  }

  /* Without JavaScript: the before state and one sentence; no controls. */
  :global(html.js) .fd-static,
  :global(html.js) .fd-nojs,
  :global(html:not(.js)) .fd-entry,
  :global(html:not(.js)) .fd-picks,
  :global(html:not(.js)) .fd-hint,
  :global(html:not(.js)) .fd-err,
  :global(html:not(.js)) .fd-break {
    display: none;
  }

  /* ---- The six places ------------------------------------------------------------------
     --u is the drawing unit inside a print. On phones it is a fixed length; in the
     collage it is 1% of the collage's width (cqi), so a print scales like a picture and
     its words always fit their fixed box. */
  .fd-places {
    --u: 0.43rem;
    --wire: var(--on-ink-muted);
    position: relative;
    padding-left: 1.75rem;
  }
  .fd-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fd-place {
    position: relative;
    margin-bottom: 1.25rem;
  }
  .fd-place:last-of-type {
    margin-bottom: 0;
  }
  .fd-print {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: calc(var(--u) * 1.1) calc(var(--u) * 1.1) 0;
    background: var(--paper-raised);
    border-radius: var(--radius);
    box-shadow: var(--shadow-frame);
    color: var(--ink-body);
  }
  .fd-cap {
    padding: calc(var(--u) * 0.8) 0 calc(var(--u) * 0.85);
    font: 400 max(0.75rem, calc(var(--u) * 1.7)) / 1.1 var(--font-ui);
    color: var(--ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .fd-site {
    --fd-mark: var(--brick);
    --fd-fresh: var(--ink);
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    background: var(--paper);
    font-family: Georgia, 'Times New Roman', serif;
    line-height: 1.25;
  }
  .fd-site > * {
    white-space: nowrap;
  }

  /* The phone spine: a vertical wire down the left with a tick into each print, joined
     to the settings sheet above. */
  .fd-places::before {
    content: '';
    position: absolute;
    top: calc(var(--fd-gap) * -1);
    left: 0.45rem;
    height: var(--fd-gap);
    border-left: 2px solid var(--wire);
  }
  .fd-place::before {
    content: '';
    position: absolute;
