---
// Safe to edit.
/* ============================================================================
   ProofSheet (the homepage work band: "The proof sheet.")
   ============================================================================
   Real details from each live site printed as frames on a strip of film, the
   keeper circled in china marker, the facts on the film edge (DESIGN.md
   "Frame", the contact-sheet idea; d7a mock-up). Stone Steps leads, larger,
   the strip on the left and the note on the right; the next jobs alternate
   their composition so no two read the same (a full-width strip with the note
   below, the note left of the strip, a three-frame strip).

   Ground: window-light, still (the room the work is made in, without the
   moving sun: one moving ground per page, and that is the hero's).

   What shows: src/lib/homeWork.ts (SHEET, gated by gateSheet: a site whose
   case study is not live or not featured drops out; "Read the case study"
   appears only when the study exists). Heading and intro: the Home page CMS
   entry. Pictures: src/assets/home/sheet/, AVIF and WebP through the image
   pipeline, parked until needed (DeferredPicture: Gotcha 14).
   ============================================================================ */
import DeferredPicture from './DeferredPicture.astro';
import type { ImageMetadata } from 'astro';
import Band from '../Band.astro';
import { getHomePage } from '../../lib/homePage';
import { SHEET, gateSheet, splitVoice, type StudyGate } from '../../lib/homeWork';

interface Props {
  studies: StudyGate[];
}
const { studies } = Astro.props;

const { work } = await getHomePage(Astro);
const heading = splitVoice(work.heading);
const jobs = gateSheet(SHEET, studies);

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/home/sheet/*.webp', {
  eager: true,
});
const asset = (name: string): ImageMetadata => {
  const file = files[`../../assets/home/sheet/${name}.webp`];
  if (!file) throw new Error(`ProofSheet: missing src/assets/home/sheet/${name}.webp`);
  return file.default;
};

// The pick: a hand-drawn china-marker loop (shared shape with the hero's loop).
const PICK =
  'M5 2.6 C 30 0.6, 70 1.4, 98.4 3 C 99.6 32, 99.2 68, 98.2 97 C 66 99.6, 28 99, 1.8 97.6 C 0.6 66, 0.8 30, 1.6 2.2 C 10 1.2, 20 1.6, 30 2.4';
// Layout per position: the lead job, then three different compositions.
const LAYOUTS = ['lead', 'wide', 'left', 'wide'] as const;
---

{jobs.length > 0 && (
  <Band ground="window-light" still id="work" labelledby="work-heading" class="proof-sheet">
    <header class="work-head">
      <h2 id="work-heading" class="type-headline">
        {heading.lead} {heading.voice && <span class="voice">{heading.voice}</span>}
      </h2>
      <p class="work-sub">{work.sub}</p>
    </header>

    {jobs.map((job, i) => {
      const layout = LAYOUTS[Math.min(i, LAYOUTS.length - 1)];
      const id = `job-${job.study}`;
      return (
        <article
          class:list={['job', `job--${layout}`, `job--n${job.frames.length}`]}
          aria-labelledby={id}
        >
          <div class="film">
            <p class="edge" aria-hidden="true">
              {job.edge.map((fact) => (
                <span>{fact}</span>
              ))}
            </p>
            <div class="frames">
              {job.frames.map((frame) => (
                <figure class="frame" style={`--grow: ${frame.grow ?? 1}`} data-reveal="fade">
                  <div class="frame-print">
                    <DeferredPicture
                      src={asset(frame.img)}
                      alt={frame.alt}
                      widths={[480, 800, 1200, 1600]}
                      sizes={
                        layout === 'lead'
                          ? '(max-width: 1080px) 92vw, 60vw'
                          : '(max-width: 820px) 92vw, 50vw'
                      }
                    />
                    {frame.pick && (
                      <svg
                        class="pick"
                        viewBox="0 0 100 100"
                        preserveAspectRatio="none"
                        aria-hidden="true"
                      >
                        <path d={PICK} />
                      </svg>
                    )}
                  </div>
                  <figcaption>{frame.caption}</figcaption>
                </figure>
              ))}
            </div>
          </div>
          <div class="note">
            <h3 id={id} class="job-name">
              {job.name} <span class="job-kind">{job.kind}</span>
            </h3>
            <div class="note-body">
              <p>{job.note}</p>
              <p class="fact">{job.fact}</p>
              <p class="go">
                <a href={job.url}>
                  {job.host}
                  <span class="sr-only"> (the live site)</span>
                </a>
                {job.caseStudyHref && (
                  <a href={job.caseStudyHref} class="card-link">
                    Read the case study
                  </a>
                )}
              </p>
            </div>
          </div>
        </article>
      );
    })}

    <p class="work-more">
      <a href="/work/" class="card-link">
        {work.linkLabel}
      </a>
    </p>
  </Band>
)}

<style>
  .work-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 1.5rem 3rem;
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 5.5rem);
  }
  .work-head h2 {
    font-size: clamp(2.75rem, 1.4rem + 4.6vw, 5.5rem);
  }
  .work-head .voice {
    display: block;
  }
  .work-sub {
    max-width: 40ch;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--muted-foreground);
  }

  /* ---- a job: the film strip and its note -------------------------------- */
  .job {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 3rem);
    align-items: start;
  }
  .job + .job {
    margin-top: clamp(4rem, 8vw, 7rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--border);
  }
  .job--lead .film {
    grid-column: 1 / span 8;
  }
  .job--lead .note {
    grid-column: 9 / span 4;
    padding-top: 2.5rem;
  }
  .job--lead .frames {
    flex-direction: column;
  }
  .job--wide .film,
  .job--wide .note {
    grid-column: 1 / -1;
  }
  .job--wide .note {
    margin-top: clamp(1rem, 2vw, 1.75rem);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(1.25rem, 3vw, 3rem);
  }
  .job--left .note {
    grid-column: 1 / span 4;
    grid-row: 1;
    padding-top: 2.5rem;
  }
  .job--left .film {
    grid-column: 5 / span 8;
    grid-row: 1;
  }

  /* ---- the film ---------------------------------------------------------- */
  .film {
    --hole: 9px;
    position: relative;
    padding: calc(var(--hole) * 2 + 26px) clamp(10px, 1.6vw, 22px);
    background: var(--ink);
    color: var(--on-ink-muted);
    box-shadow: var(--shadow-frame);
    border-radius: 2px;
  }
  /* sprocket rows */
  .film::before,
  .film::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: var(--hole);
    background: repeating-linear-gradient(
      90deg,
      transparent 0 11px,
      var(--paper-deep) 11px 25px,
      transparent 25px 34px
    );
    opacity: 0.16;
  }
  .film::before {
    top: 10px;
  }
  .film::after {
    bottom: 10px;
  }
  .edge {
    position: absolute;
    left: clamp(10px, 1.6vw, 22px);
    right: clamp(10px, 1.6vw, 22px);
    top: calc(var(--hole) + 16px);
    display: flex;
    gap: 2.4em;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    font: 600 0.72rem/1 var(--font-ui);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
    -webkit-mask-image: linear-gradient(90deg, #000 82%, transparent);
    mask-image: linear-gradient(90deg, #000 82%, transparent);
  }
  .frames {
    display: flex;
    gap: clamp(8px, 1.1vw, 16px);
    align-items: flex-end;
  }
  .frame {
    flex: var(--grow) 1 0;
    min-width: 0;
    margin: 0;
  }
  .frame-print {
    position: relative;
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--ink-raised);
  }
  .frame figcaption {
    margin-top: 10px;
    font: 500 0.8125rem/1.3 var(--font-ui);
    color: var(--on-ink-muted);
  }
  .frame:has(.pick) figcaption {
    padding-left: 14px;
  }
  .pick {
    position: absolute;
    inset: -9px;
    width: calc(100% + 18px);
    height: calc(100% + 18px);
    overflow: visible;
    pointer-events: none;
  }
  .pick path {
    fill: none;
    stroke: var(--marker-hot);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* ---- the note ---------------------------------------------------------- */
  .job-name {
    font: 400 clamp(2rem, 1.4rem + 1.8vw, 3rem) / 0.95 var(--font-display);
    letter-spacing: 0.01em;
    color: var(--heading);
  }
  .job-kind {
    display: block;
    margin-top: 0.5rem;
    font: italic 400 clamp(1.1rem, 1rem + 0.4vw, 1.35rem) / 1.2 var(--font-serif);
    letter-spacing: 0;
    color: var(--marker);
  }
  .note-body {
    display: grid;
    gap: 1rem;
    align-content: start;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.55;
  }
  .job--lead .note-body,
  .job--left .note-body {
    margin-top: 1.25rem;
  }
  .note-body p {
    max-width: 42ch;
  }
  /* The story first, in ink and larger; the checkable fact under a hairline, quieter. */
  .note-body p:first-child {
    font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.375rem);
    line-height: 1.45;
    color: var(--heading);
  }
  .note-body .fact {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 1rem;
    color: var(--muted-foreground);
  }
  .go {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.5rem;
    font: 600 1rem/1.3 var(--font-ui);
  }
  .go a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .go a:first-child {
    color: var(--heading);
    text-decoration: underline;
    text-decoration-color: var(--marker);
    text-underline-offset: 0.22em;
  }
  .work-more {
    margin-top: clamp(3rem, 6vw, 5rem);
    font: 600 1.0625rem/1.3 var(--font-ui);
  }
  .work-more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  /* ---- smaller screens --------------------------------------------------- */
  @media (max-width: 1080px) {
    .job--lead .film,
    .job--lead .note,
    .job--left .film,
    .job--left .note {
      grid-column: 1 / -1;
      grid-row: auto;
      padding-top: 0;
    }
    .job--left .film {
      order: -1;
    }
  }
  @media (max-width: 820px) {
    .work-head,
    .job--wide .note {
      grid-template-columns: 1fr;
    }
    .frames {
      flex-wrap: wrap;
    }
    .job--n2:not(.job--lead) .frame {
      flex-basis: 100%;
    }
    .job--n3 .frame:last-child {
      flex-basis: 100%;
    }
  }
  @media (max-width: 480px) {
    .film {
      --hole: 7px;
    }
    .edge {
      gap: 1.6em;
      font-size: 0.7rem;
      letter-spacing: 0.1em;
    }
  }
</style>
