---
// Safe to edit.
/* ============================================================================
   ProofSheet (the homepage work band: "The proof sheet.")
   ============================================================================
   A detail from each live site, one the hero reel above does not show (the
   reel prints each site's first screen; this prints a section further in),
   with the fact it proves. Four jobs, three compositions, so the sheet has a
   rhythm instead of one card stamped four times (review of 2026-10-04):

     lead   Stone Steps. A strip of film (ink rebate, sprocket rows, the facts
            on the edge) with two frames stacked, the keeper circled in china
            marker: the one pick on the sheet. The note sits to the right.
     pair   The next two, side by side, as plain prints laid on the wall (a
            paper mat and a shadow, no film, no loop), the second set lower.
            The words sit under each print: the name, one sentence, the fact.
     strip  The last job, a wide strip of film across the whole band with its
            frames in a row; the words run above it in three short columns.

   Ground: window-light, still (the room the work is made in, without the
   moving sun: one moving ground per page, and that is the hero's).

   What shows: src/lib/homeWork.ts (SHEET, gated by gateSheet: a site whose
   case study is not live or not featured drops out; "Read the case study"
   appears only when the study exists). Heading and intro: the Home page CMS
   entry. Pictures: src/assets/home/sheet/ (scripts/brand/capture-home-sheet.mjs),
   AVIF and WebP through the image pipeline, parked until needed
   (DeferredPicture: Gotcha 14).
   ============================================================================ */
import DeferredPicture from './DeferredPicture.astro';
import type { ImageMetadata } from 'astro';
import Band from '../Band.astro';
import { getHomePage } from '../../lib/homePage';
import { SHEET, gateSheet, splitVoice, type GatedJob, type StudyGate } from '../../lib/homeWork';

interface Props {
  studies: StudyGate[];
}
const { studies } = Astro.props;

const { work } = await getHomePage(Astro);
const heading = splitVoice(work.heading);
const jobs = gateSheet(SHEET, studies);

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/home/sheet/*.webp', {
  eager: true,
});
const asset = (name: string): ImageMetadata => {
  const file = files[`../../assets/home/sheet/${name}.webp`];
  if (!file) throw new Error(`ProofSheet: missing src/assets/home/sheet/${name}.webp`);
  return file.default;
};

// The pick: a hand-drawn china-marker loop (shared shape with the hero's loop).
const PICK =
  'M5 2.6 C 30 0.6, 70 1.4, 98.4 3 C 99.6 32, 99.2 68, 98.2 97 C 66 99.6, 28 99, 1.8 97.6 C 0.6 66, 0.8 30, 1.6 2.2 C 10 1.2, 20 1.6, 30 2.4';

// First job leads; the last of four or more is the wide strip; the ones between pair up.
const lead = jobs[0];
const strip = jobs.length >= 4 ? jobs[jobs.length - 1] : undefined;
const pair = jobs.slice(1, strip ? -1 : undefined);
const idOf = (job: GatedJob) => `job-${job.study}`;
---

{lead && (
  <Band ground="window-light" still id="work" labelledby="work-heading" class="proof-sheet">
    <header class="work-head">
      <h2 id="work-heading" class="type-headline">
        {heading.lead} {heading.voice && <span class="voice">{heading.voice}</span>}
      </h2>
      <p class="work-sub">{work.sub}</p>
    </header>

    {/* The lead: film, stacked frames, the one pick; the note to the right. */}
    <article class="job job--lead" aria-labelledby={idOf(lead)}>
      <div class="film">
        <p class="edge" aria-hidden="true">
          {lead.edge.map((fact) => (
            <span>{fact}</span>
          ))}
        </p>
        <div class="frames">
          {lead.frames.map((frame) => (
            <figure class="frame" data-reveal="fade">
              <div class="frame-print">
                <DeferredPicture
                  src={asset(frame.img)}
                  alt={frame.alt}
                  widths={[480, 800, 1200, 1600]}
                  sizes="(max-width: 1080px) 92vw, 60vw"
                />
                {frame.pick && (
                  <svg
                    class="pick"
                    viewBox="0 0 100 100"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                  >
                    <path d={PICK} />
                  </svg>
                )}
              </div>
              <figcaption>{frame.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
      <div class="note">
        <h3 id={idOf(lead)} class="job-name">
          {lead.name} <span class="job-kind">{lead.kind}</span>
        </h3>
        <p class="note-story">{lead.note}</p>
        <p class="note-fact">{lead.fact}</p>
        <p class="go">
          <a href={lead.url}>
            {lead.host}
            <span class="sr-only"> (the live site)</span>
          </a>
          {lead.caseStudyHref && (
            <a href={lead.caseStudyHref} class="card-link">
              Read the case study
            </a>
          )}
        </p>
      </div>
    </article>

    {/* The pair: plain prints on the wall, words under each, the second set lower. */}
    {pair.length > 0 && (
      <div class:list={['pair', { 'pair--one': pair.length === 1 }]}>
        {pair.map((job) => (
          <article class="job job--print" aria-labelledby={idOf(job)}>
            {job.frames.map((frame) => (
              <figure class="mat" data-reveal="fade">
                <DeferredPicture
                  src={asset(frame.img)}
                  alt={frame.alt}
                  widths={[480, 800, 1200]}
                  sizes="(max-width: 820px) 92vw, 44vw"
                />
                <figcaption>{frame.caption}</figcaption>
              </figure>
            ))}
            <h3 id={idOf(job)} class="print-name">
              {job.name}
              <span class="print-kind">
                <span class="sr-only">, </span>
                {job.kind}
              </span>
            </h3>
            <p class="print-story">{job.note}</p>
            <p class="print-fact">{job.fact}</p>
            <p class="go">
              <a href={job.url}>
                {job.host}
                <span class="sr-only"> (the live site)</span>
              </a>
              {job.caseStudyHref && (
                <a href={job.caseStudyHref} class="card-link">
                  Read the case study
                </a>
              )}
            </p>
          </article>
        ))}
      </div>
    )}

    {/* The strip: the words above in three columns, then the film across the band. */}
    {strip && (
      <article class="job job--strip" aria-labelledby={idOf(strip)}>
        <div class="strip-words">
          <h3 id={idOf(strip)} class="job-name">
            {strip.name} <span class="job-kind job-kind--quiet">{strip.kind}</span>
          </h3>
          <p class="note-story">{strip.note}</p>
          <div>
            <p class="note-fact">{strip.fact}</p>
            <p class="go">
              <a href={strip.url}>
                {strip.host}
                <span class="sr-only"> (the live site)</span>
              </a>
              {strip.caseStudyHref && (
                <a href={strip.caseStudyHref} class="card-link">
                  Read the case study
                </a>
              )}
            </p>
          </div>
        </div>
        <div class="film film--row">
          <p class="edge" aria-hidden="true">
            {strip.edge.map((fact) => (
              <span>{fact}</span>
            ))}
          </p>
          <div class="frames">
            {strip.frames.map((frame) => (
              <figure class="frame" style={`--grow: ${frame.grow ?? 1}`} data-reveal="fade">
                <div class="frame-print">
                  <DeferredPicture
                    src={asset(frame.img)}
                    alt={frame.alt}
                    widths={[480, 800, 1200, 1600]}
                    sizes="(max-width: 820px) 92vw, 50vw"
                  />
                </div>
                <figcaption>{frame.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </article>
    )}

    <p class="work-more">
      <a href="/work/" class="card-link">
        {work.linkLabel}
      </a>
    </p>
  </Band>
)}

<style>
  .work-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 1.5rem 3rem;
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 5.5rem);
  }
  .work-head h2 {
    font-size: clamp(2.75rem, 1.4rem + 4.6vw, 5.5rem);
  }
  .work-head .voice {
    display: block;
  }
  .work-sub {
    max-width: 40ch;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--muted-foreground);
  }

  /* ---- shared words ------------------------------------------------------- */
  .job-name {
    font: 400 clamp(2rem, 1.4rem + 1.8vw, 3rem) / 0.95 var(--font-display);
    letter-spacing: 0.01em;
    color: var(--heading);
  }
  .job-kind {
    display: block;
    margin-top: 0.5rem;
    font: italic 400 clamp(1.1rem, 1rem + 0.4vw, 1.35rem) / 1.2 var(--font-serif);
    letter-spacing: 0;
    color: var(--marker);
  }
  /* The strip's line under the name is plain, not the red voice: one red turn per job
     is enough, and the lead already has it. */
  .job-kind--quiet {
    font-style: normal;
    font-size: 1.0625rem;
    color: var(--muted-foreground);
  }
  .note-story,
  .print-story {
    max-width: 42ch;
    font-family: var(--font-serif);
    font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.375rem);
    line-height: 1.45;
    color: var(--heading);
  }
  .note-fact {
    max-width: 42ch;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--muted-foreground);
  }
  .go {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.5rem;
    font: 600 1rem/1.3 var(--font-ui);
  }
  .go a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .go a:first-child {
    color: var(--heading);
    text-decoration: underline;
    text-decoration-color: var(--marker);
    text-underline-offset: 0.22em;
  }

  /* ---- the lead ----------------------------------------------------------- */
  .job--lead {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 3rem);
    align-items: start;
  }
  .job--lead .film {
    grid-column: 1 / span 8;
  }
  .job--lead .note {
    grid-column: 9 / span 4;
    display: grid;
    gap: 1rem;
    padding-top: 2.5rem;
  }
  .job--lead .job-name {
    margin-bottom: 0.5rem;
  }
  .job--lead .frames {
    flex-direction: column;
  }

  /* ---- the film (lead and strip only) -------------------------------------- */
  .film {
    --hole: 9px;
    position: relative;
    padding: calc(var(--hole) * 2 + 8px) clamp(10px, 1.6vw, 22px) calc(var(--hole) * 2 + 14px);
    background: var(--ink);
    color: var(--on-ink-muted);
    box-shadow: var(--shadow-frame);
    border-radius: 2px;
  }
  /* sprocket rows */
  .film::before,
  .film::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: var(--hole);
    background: repeating-linear-gradient(
      90deg,
      transparent 0 11px,
      var(--paper-deep) 11px 25px,
      transparent 25px 34px
    );
    opacity: 0.16;
  }
  .film::before {
    top: 10px;
  }
  .film::after {
    bottom: 10px;
  }
  /* Edge print: in the flow and allowed to wrap, so every fact reads whole at any
     width (it was clipped on phones: "FOUNDATI", "MAS-MONO"). */
  .edge {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 2.4em;
    margin: 0 0 14px;
    font: 600 0.72rem/1.2 var(--font-ui);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
  }
  .frames {
    display: flex;
    gap: clamp(8px, 1.1vw, 16px);
    align-items: flex-end;
  }
  .frame {
    flex: var(--grow, 1) 1 0;
    min-width: 0;
    margin: 0;
  }
  .frame-print {
    position: relative;
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--ink-raised);
  }
  .frame figcaption {
    margin-top: 10px;
    font: 500 0.8125rem/1.3 var(--font-ui);
    color: var(--on-ink-muted);
  }
  .frame:has(.pick) figcaption {
    padding-left: 14px;
  }
  .pick {
    position: absolute;
    inset: -9px;
    width: calc(100% + 18px);
    height: calc(100% + 18px);
    overflow: visible;
    pointer-events: none;
  }
  .pick path {
    fill: none;
    stroke: var(--marker-hot);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* ---- the pair: plain prints on the wall ---------------------------------- */
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
    margin-top: clamp(5rem, 9vw, 8rem);
  }
  .pair--one {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }
  /* The second print hangs lower, as prints laid by hand do. */
  .pair > .job:nth-child(2) {
    margin-top: clamp(3rem, 7vw, 7rem);
  }
  .job--print {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }
  .mat {
    margin: 0 0 0.75rem;
    padding: clamp(0.4rem, 0.3rem + 0.4vw, 0.75rem);
    background: var(--paper-raised);
    border-radius: 2px;
    box-shadow: var(--shadow-frame);
  }
  .mat :global(img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--paper-deep);
  }
  .mat figcaption {
    margin-top: 0.6rem;
    font: 500 0.8125rem/1.3 var(--font-ui);
    color: var(--muted-foreground);
  }
  .print-name {
    font: 400 clamp(1.75rem, 1.3rem + 1.2vw, 2.4rem) / 0.95 var(--font-display);
    letter-spacing: 0.01em;
    color: var(--heading);
  }
  .print-kind {
    display: block;
    margin-top: 0.4rem;
    font: 400 1rem/1.3 var(--font-ui);
    letter-spacing: 0;
    color: var(--muted-foreground);
  }
  .print-story {
    font-size: clamp(1.125rem, 1.02rem + 0.4vw, 1.25rem);
  }
  .print-fact {
    max-width: 42ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--muted-foreground);
  }

  /* ---- the strip: words above, film across ---------------------------------- */
  .job--strip {
    margin-top: clamp(5rem, 9vw, 8rem);
  }
  .strip-words {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 4fr) minmax(0, 4fr);
    gap: 1.25rem clamp(1.25rem, 3vw, 3rem);
    align-items: start;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .strip-words .note-fact {
    padding-top: 0;
    border-top: 0;
  }

  .work-more {
    margin-top: clamp(3rem, 6vw, 5rem);
    font: 600 1.0625rem/1.3 var(--font-ui);
  }
  .work-more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  /* ---- smaller screens --------------------------------------------------- */
  @media (max-width: 1080px) {
    .job--lead .film,
    .job--lead .note {
      grid-column: 1 / -1;
      padding-top: 0;
    }
    .strip-words {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .strip-words .job-name {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 820px) {
    .work-head,
    .pair,
    .strip-words {
      grid-template-columns: 1fr;
    }
    .pair > .job:nth-child(2) {
      margin-top: 0;
    }
    .frames {
      flex-wrap: wrap;
    }
    .film--row .frame {
      flex: 1 1 0;
    }
    .film--row .frame:first-child {
      flex: 0 0 34%;
    }
    .film--row .frame:nth-child(2) {
      order: -1;
      flex-basis: 100%;
    }
  }
  @media (max-width: 480px) {
    .film {
      --hole: 7px;
    }
    .edge {
      gap: 0.3em 1.6em;
      font-size: 0.7rem;
      letter-spacing: 0.1em;
    }
  }
</style>
