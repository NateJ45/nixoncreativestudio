---
// Safe to edit. The heading, the paragraph and which tiers show are
// LANDING_SEGMENTS[slug].cost (src/lib/landingPage.ts); every price, range and
// "who it fits" line is the Pricing tier itself (CMS), never typed here.
/* ============================================================================
   LandingCost | what it costs, for this kind of organization
   ============================================================================
   NOT the price sheet. /services/ carries the whole sheet (three tiers, the
   add-ons, the circled price); repeating it on three landing pages made them
   read as clones. Here: a short paragraph in the organization's terms, the
   one or two tiers that fit it as small price slips (a Bebas name over a
   double rule, the floor as a numeral, the typical range, the short "who" line;
   the long tier description stays on /services), a
   link to the full sheet and the call to action with the contact preset.

     layout="side"   paragraph left, slips right (church, school)
     layout="below"  paragraph across the top, slips in a row under it (nonprofit)
   ============================================================================ */
import { buttonVariants } from '../ui/button';
import type { PricingTier } from '../../lib/pricing';
import { fillPrices, money } from '../../lib/landingPage';
import { voiceSplit } from '../../lib/voiceSplit';

interface Props {
  cost: { heading: string; note: string; tiers: string[] };
  tiers: PricingTier[];
  href: string;
  ctaLabel: string;
  layout?: 'side' | 'below';
}
const { cost, tiers, href, ctaLabel, layout = 'side' } = Astro.props;
const h = voiceSplit(cost.heading);
const note = fillPrices(cost.note, tiers);
const shown = cost.tiers
  .map((name) => tiers.find((t) => t.name.toLowerCase() === name.toLowerCase()))
  .filter((t): t is PricingTier => !!t);
---

<div class:list={['cost', `cost--${layout}`]}>
  <div class="cost-copy">
    <h2 id="prices-heading" class="type-headline">
      {h.head}
      {h.tail && ' '}
      {h.tail && <span class="voice">{h.tail}</span>}
    </h2>
    <p class="type-lede">{note}</p>
    <div class="cost-actions">
      <a href={href} class={buttonVariants({ variant: 'brand', size: 'cta' })}>
        {ctaLabel}
        <span data-nudge aria-hidden="true">
          →
        </span>
      </a>
      <a href="/services/#prices" class="cost-link">
        Every tier and add-on, on the full price sheet
      </a>
    </div>
  </div>
  {shown.length > 0 && (
    <ul class="cost-slips" role="list">
      {shown.map((t) => (
        <li class="cost-slip">
          <h3 class="cost-name">{t.name}</h3>
          <p class="cost-price">
            <span class="cost-from">from</span>
            <span class="type-numeral">
              {money(t.priceFrom)}
              {t.priceSuffix}
            </span>
          </p>
          <p class="cost-range">{t.range}</p>
          <p class="cost-note">{t.who}</p>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  .cost {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 64rem) {
    .cost--side {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
  }
  .cost-copy {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .cost-copy > * {
    margin: 0;
  }
  .cost-copy h2 {
    max-width: 16ch;
  }
  .cost-copy .type-lede {
    max-width: 48ch;
  }
  .cost--below .cost-copy {
    max-width: 56rem;
  }
  .cost-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 0.5rem;
  }
  .cost-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--link) 40%, transparent);
    text-underline-offset: 0.2em;
  }
  .cost-link:hover {
    text-decoration-color: currentColor;
  }

  .cost-slips {
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
  }
  @media (min-width: 40rem) {
    .cost-slips {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .cost--below .cost-slips {
    max-width: 52rem;
  }
  /* A price slip: a small document (DESIGN.md "Documents"). */
  .cost-slip {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--paper-raised);
    color: var(--foreground);
    border-radius: 2px;
    box-shadow: var(--shadow-print);
  }
  .cost-slip > * {
    margin: 0;
  }
  .cost-name {
    padding-bottom: 0.4rem;
    border-bottom: 3px double var(--heading);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-h4);
    line-height: 1;
    color: var(--heading);
  }
  .cost-price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--heading);
  }
  /* A step under the page numeral: two slips side by side must hold "$12,000+". */
  .cost-price .type-numeral {
    font-size: clamp(2.25rem, 1.5rem + 2vw, 3.25rem);
  }
  .cost-from {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.125rem;
    color: var(--marker);
  }
  .cost-range {
    font-family: var(--font-ui);
    font-size: var(--text-caption);
    color: var(--muted-foreground);
  }
  .cost-note {
    padding-top: 0.6rem;
    border-top: 1px solid var(--border);
    font-size: var(--text-body);
    line-height: 1.5;
  }
</style>
