---
// Safe to edit. The step titles are the Home page entry's process steps (CMS);
// the "your side" lines are LANDING_SEGMENTS[slug].steps in src/lib/landingPage.ts;
// the durations are PROCESS_DURATIONS (shared with /services' timeline).
/* ============================================================================
   LandingSteps | how a project goes, told from the organization's side
   ============================================================================
   /services draws the four steps to scale (ProjectTimeline). A landing page
   does not repeat that: it says what a church board, a nonprofit director or
   a school office actually does in each step, in a shape of its own:

     ledger   (church, on the deep band) ruled rows: number and step on the
              left, the duration in the red-pen italic, the church's part
     pairs    (nonprofit) a two by two of notes, a large numeral on each
     rail     (school) one vertical rail with a stop per step, like a term
              calendar read down the page

   The numbers are a real sequence (DESIGN.md allows numbering there). A link
   under the steps goes to the scale drawing on /services.
   ============================================================================ */
import type { ProcessStep } from '../../lib/homePage';
import { PROCESS_DURATIONS } from '../../lib/processDurations';
import { voiceSplit } from '../../lib/voiceSplit';

interface Props {
  heading: string;
  steps: ProcessStep[];
  yours: readonly string[];
  variant: 'ledger' | 'pairs' | 'rail';
}
const { heading, steps, yours, variant } = Astro.props;
const h = voiceSplit(heading);
const rows = steps.slice(0, 4).map((s, i) => ({
  n: String(i + 1).padStart(2, '0'),
  title: s.title,
  duration: PROCESS_DURATIONS[i],
  yours: yours[i],
}));
---

<div class:list={['st', `st--${variant}`]}>
  <div class="st-head">
    <h2 id="steps-heading" class="type-headline">
      {h.head}
      {h.tail && ' '}
      {h.tail && <span class="voice">{h.tail}</span>}
    </h2>
    <a href="/services/#process" class="st-link nudge">
      The timeline, drawn to scale{' '}
      <span data-nudge aria-hidden="true">
        →
      </span>
    </a>
  </div>
  <ol class="st-list" role="list">
    {rows.map((r) => (
      <li class="st-step">
        <span class="st-n" aria-hidden="true">
          {r.n}
        </span>
        <h3 class="st-title">{r.title}</h3>
        {r.duration && <p class="st-dur">{r.duration}</p>}
        {r.yours && <p class="st-yours">{r.yours}</p>}
      </li>
    ))}
  </ol>
</div>

<style>
  .st-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .st-head h2 {
    margin: 0;
    max-width: 18ch;
  }
  .st-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: var(--tap);
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--link) 40%, transparent);
    text-underline-offset: 0.2em;
  }
  .st-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .st-step > * {
    margin: 0;
  }
  .st-n {
    font-family: var(--font-display);
    line-height: 1;
    color: var(--heading);
  }
  .st-title {
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    font-weight: 600;
    color: var(--heading);
  }
  .st-dur {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.125rem;
    color: var(--marker);
  }
  .st-yours {
    font-size: var(--text-body);
    line-height: 1.55;
    max-width: 52ch;
  }

  /* ---- ledger: ruled rows (church, on ink) ---------------------------------- */
  .st--ledger .st-list {
    border-top: 3px double var(--heading);
  }
  .st--ledger .st-step {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: 0.35rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid color-mix(in oklab, var(--foreground) 22%, transparent);
  }
  .st--ledger .st-n {
    grid-row: 1 / span 3;
    font-size: 2rem;
  }
  @media (min-width: 64rem) {
    .st--ledger .st-step {
      grid-template-columns: 4rem minmax(0, 0.7fr) minmax(0, 0.7fr) minmax(0, 1.6fr);
      column-gap: 2rem;
      align-items: baseline;
    }
    .st--ledger .st-n {
      grid-row: auto;
    }
  }

  /* ---- pairs: four notes, two by two (nonprofit) ----------------------------- */
  .st--pairs .st-list {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
  }
  @media (min-width: 48rem) {
    .st--pairs .st-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .st--pairs .st-step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 1.25rem;
    row-gap: 0.4rem;
    align-content: start;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--paper-raised);
    border-radius: 2px;
    box-shadow: var(--shadow-print);
  }
  .st--pairs .st-n {
    grid-row: 1 / span 3;
    font-size: var(--text-numeral);
    color: var(--marker);
  }

  /* ---- rail: one vertical line with a stop per step (school) ----------------- */
  .st--rail .st-list {
    position: relative;
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.5rem);
    padding-left: 3.25rem;
    max-width: 48rem;
  }
  .st--rail .st-list::before {
    content: '';
    position: absolute;
    left: 1rem;
    top: 0.5rem;
    bottom: 0.5rem;
    border-left: 2px solid var(--heading);
  }
  .st--rail .st-step {
    position: relative;
    display: grid;
    row-gap: 0.35rem;
  }
  .st--rail .st-n {
    position: absolute;
    left: -3.25rem;
    top: -0.15rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    font-size: 1.1rem;
    /* The rail sits on a sunk band (bg-muted): the stop covers the line in that colour. */
    background: var(--muted);
    border: 2px solid var(--heading);
    border-radius: 50%;
  }
  @media (min-width: 48rem) {
    .st--rail .st-step {
      grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
      column-gap: 2rem;
    }
    .st--rail .st-title,
    .st--rail .st-dur {
      grid-column: 1;
    }
    .st--rail .st-yours {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
