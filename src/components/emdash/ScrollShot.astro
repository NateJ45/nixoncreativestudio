---
// Safe to edit.
// ScrollShot: a tall full-page screenshot from the CMS, resized by WIDTH ONLY.
//
// Why this exists (found 2026-10-02 with Lighthouse CI): EmDash's own <Image>
// asks the resizer for a width AND a height (the image's natural proportions).
// For a full-page capture that height is thousands of pixels, and Cloudflare's
// image resizer refuses any request 4096px or taller: it silently returns the
// untouched original instead (a 6.9 MB PNG for the Stone Steps capture, which
// made the homepage 10.9 MB and pushed its Lighthouse performance score down).
// Width-only requests for the same file work and come back as 240 to 380 KB
// WebP. These screenshots are scrolled inside a fixed frame, never shown at
// their true height, so a width-only request is exactly what is needed.
//
// It builds the same /_image URL Astro's image service builds for EmDash
// media (observed shape: /_image?href=<absolute media URL>&w=<px>&f=webp), so the
// host must be listed in `image.remotePatterns` (astro.config.mjs).
//
// Use this only for the tall captures (showcase desktop / phone). Ordinary
// images keep using `Image` from emdash/ui.
import type { ImageValue } from 'emdash';

interface Props {
  image: ImageValue;
  alt?: string;
  sizes?: string;
  class?: string;
  /** Widths to offer in the srcset. The browser picks by `sizes`. */
  widths?: number[];
  loading?: 'lazy' | 'eager';
  /** Hold the download until the visitor scrolls the image into view, or until
      the page has been idle for a few seconds (script below). See the note on
      the defer branch. Off by default so the /work and case-study uses keep
      the plain native lazy behaviour. */
  defer?: boolean;
}

const {
  image,
  alt = '',
  sizes = '100vw',
  class: className,
  widths = [420, 750, 1080],
  loading = 'lazy',
  defer = false,
} = Astro.props;

// Defer mode (added 2026-10-03, homepage LCP). A native loading="lazy" image is
// NOT held back when it sits within Chrome's lazy-load distance of the viewport
// (1250px+, and a phone's first screen plus the hero reaches that), so the six
// Selected Work screenshots (~850 KB) all started right after first paint and
// competed with the hero image. Lighthouse's simulated throttling counts every
// request that starts before the observed LCP, so they inflated LCP from ~3.5s
// to 4.3-6.3s (blocking just those requests: median 6297 -> 3586ms, same method).
// Deferred images ship a 1x1 placeholder src plus data-* attributes, and the
// script at the foot of this file promotes them when scrolled into view or
// after the page has settled. No-JS visitors get the real image in <noscript>.
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';

// ImageValue fields can be absent on an image-field value, so read defensively.
const media = image as unknown as {
  id?: string;
  width?: number;
  height?: number;
  meta?: { storageKey?: string };
};
const file = media.meta?.storageKey ?? media.id;

// Absolute URL of the original, on this site's own origin (the resizer only
// fetches absolute URLs from hosts that image.remotePatterns trusts).
const mediaUrl = file ? new URL(`/_emdash/api/media/file/${file}`, Astro.url.origin).href : '';
const resized = (w: number) => `/_image?href=${encodeURIComponent(mediaUrl)}&w=${w}&f=webp`;

const sorted = [...widths].sort((a, b) => a - b);
const srcset = sorted.map((w) => `${resized(w)} ${w}w`).join(', ');
const fallbackWidth = sorted[Math.min(1, sorted.length - 1)] ?? 750;

// Intrinsic size attributes keep the layout stable (no shift). Scale the real
// proportions to the fallback width.
const ratio = media.width && media.height ? media.height / media.width : undefined;
const attrWidth = fallbackWidth;
const attrHeight = ratio ? Math.round(fallbackWidth * ratio) : undefined;
---

{mediaUrl && defer && (
  <>
    <img
      src={BLANK}
      data-defer-src={resized(fallbackWidth)}
      data-defer-srcset={srcset}
      sizes={sizes}
      alt={alt}
      width={attrWidth}
      height={attrHeight}
      decoding="async"
      class={className}
    />
    <noscript>
      <img
        src={resized(fallbackWidth)}
        srcset={srcset}
        sizes={sizes}
        alt={alt}
        width={attrWidth}
        height={attrHeight}
        loading="lazy"
        decoding="async"
        class={className}
      />
    </noscript>
  </>
)}
{mediaUrl && !defer && (
  <img
    src={resized(fallbackWidth)}
    srcset={srcset}
    sizes={sizes}
    alt={alt}
    width={attrWidth}
    height={attrHeight}
    loading={loading}
    decoding="async"
    class={className}
  />
)}

<script>
  // Promote deferred screenshots (see the defer note in the frontmatter). Runs on
  // astro:page-load so it survives View Transitions; each image is promoted once
  // (the data attributes are removed), so re-running is harmless.
  function initDeferredShots() {
    const pending = () =>
      Array.from(document.querySelectorAll<HTMLImageElement>('img[data-defer-src]'));
    if (!pending().length) return;

    const promote = (img: HTMLImageElement) => {
      if (!img.dataset.deferSrc) return;
      if (img.dataset.deferSrcset) img.srcset = img.dataset.deferSrcset;
      img.src = img.dataset.deferSrc;
      delete img.dataset.deferSrc;
      delete img.dataset.deferSrcset;
    };

    // 1. Scrolled to (or already on screen): load now. No rootMargin on purpose, a
    //    margin would pull the first card's images back into the LCP window.
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          promote(e.target as HTMLImageElement);
          io.unobserve(e.target);
        });
      });
      pending().forEach((img) => io.observe(img));
    }

    // 2. Everyone else: once the page has loaded and had a few quiet seconds, warm
    //    the rest so a visitor who scrolls later finds them ready.
    const warm = () => setTimeout(() => pending().forEach(promote), 3500);
    if (document.readyState === 'complete') warm();
    else window.addEventListener('load', warm, { once: true });
  }
  document.addEventListener('astro:page-load', initDeferredShots);
</script>
