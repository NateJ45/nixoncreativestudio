---
// Foundation, edit with care.
/* ============================================================================
   EmDashPhoto
   ============================================================================
   An ordinary photo from the CMS (an `image` field value), served as a resized
   WebP through the site's /_image resizer. Built for the About headshot and the
   "Outside the studio" photos (CMS-DESIGN PR 8).

   Why not EmDash's own `Image` from emdash/ui? Two reasons, both found while
   building the About page:
   - Importing it makes Astro add its tiny stylesheet (a separate render-blocking
     <link>) to every page that imports it, even on the fallback path where it
     is never rendered. A bare <img> adds no CSS and no script.
   - It always sends a width AND a height. Cloudflare's resizer silently returns
     the untouched original for any request 4096 px tall or more (docs/EMDASH.md,
     "The 4096px resizer limit"), so a width-only request is the safe shape. These
     photos are far under that, but one rule is easier to remember than two.

   It builds the same /_image URL ScrollShot does (/_image?href=<absolute media
   URL>&w=<px>&f=webp), so the host must be listed in `image.remotePatterns`
   (astro.config.mjs): a host that is not listed gets the full-size original
   instead of a WebP, with no error. Check any new host with
   `curl -s -D - -o /dev/null <the /_image URL>` (GET, not HEAD) and look for
   `content-type: image/webp`.

   Props:
     - image     the stored image value
     - alt       required text; the caller decides what the picture shows
     - sizes     sizes attribute
     - widths    widths for the srcset (the browser picks by `sizes`)
     - priority  eager + high fetch priority (the LCP image only)
     - class     classes on the <img>
   ============================================================================ */
import type { ImageValue } from 'emdash';

interface Props {
  image: ImageValue;
  alt: string;
  sizes: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
}

const {
  image,
  alt,
  sizes,
  widths = [320, 560, 840, 1200],
  priority = false,
  class: className,
} = Astro.props;

// ImageValue fields can be absent on an image-field value, so read defensively.
const media = (image ?? {}) as unknown as {
  id?: string;
  width?: number;
  height?: number;
  dominantColor?: string;
  meta?: { storageKey?: string; dominantColor?: string };
};
const file = media.meta?.storageKey ?? media.id;

// Absolute URL of the original, on this site's own origin (the resizer only
// fetches absolute URLs from hosts that image.remotePatterns trusts).
const mediaUrl = file ? new URL(`/_emdash/api/media/file/${file}`, Astro.url.origin).href : '';
const resized = (w: number) => `/_image?href=${encodeURIComponent(mediaUrl)}&w=${w}&f=webp`;

const sorted = [...widths].sort((a, b) => a - b);
const srcset = sorted.map((w) => `${resized(w)} ${w}w`).join(', ');
const fallbackWidth = sorted[Math.min(1, sorted.length - 1)] ?? 560;

// Intrinsic size attributes keep the layout stable (no shift): the real
// proportions scaled to the fallback width.
const ratio = media.width && media.height ? media.height / media.width : undefined;
const attrHeight = ratio ? Math.round(fallbackWidth * ratio) : undefined;

// A flat colour under the image while it loads (the media item's dominant colour).
const dominant = media.dominantColor ?? media.meta?.dominantColor;
const style = dominant ? `background-color: ${dominant};` : undefined;
---

{mediaUrl && (
  <img
    src={resized(fallbackWidth)}
    srcset={srcset}
    sizes={sizes}
    alt={alt}
    width={fallbackWidth}
    height={attrHeight}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
    class={className}
    style={style}
  />
)}
