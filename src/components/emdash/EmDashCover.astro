---
// Foundation, edit with care.
/* ============================================================================
   EmDashCover
   ============================================================================
   The EmDash counterpart of CaseStudyCover. Same wrapper and the same props
   shape (alt, class, rounded, fit) so the /work cards, the homepage Selected
   Work fallback and the case study hero keep their look; the image itself comes
   from the CMS (an image field value) and renders through the Image component
   from emdash/ui.

   What changed versus CaseStudyCover, and why:
   - No separate blur layer and no fade-in script. EmDash's Image paints the
     media item's blurhash as the <img>'s own background, which is the same
     "blurred preview until the real image lands" effect with no extra JS. The
     wrapper only carries the cover's dominant colour as a flat fallback.
   - No widths prop: EmDash builds the srcset itself. The sizes prop is still
     passed through.
   - priority marks the LCP image (eager + fetchpriority=high). Leave it off
     for everything below the fold.

   Props:
     - cover     the stored image value (case study cover field)
     - alt       "" when a heading next to the image names the same thing
     - sizes     sizes attribute
     - class     extra classes on the wrapper
     - rounded   "lg" | "md" | "none"
     - fit       "natural" (true aspect ratio) | "cover" (crop to the wrapper box)
     - priority  eager + high fetch priority (LCP image only)
   ============================================================================ */

import { Image } from 'emdash/ui';
import type { ImageValue } from 'emdash';

interface Props {
  cover?: ImageValue;
  alt: string;
  sizes: string;
  class?: string;
  rounded?: 'lg' | 'md' | 'none';
  fit?: 'natural' | 'cover';
  priority?: boolean;
}

const {
  cover,
  alt,
  sizes,
  class: className = '',
  rounded = 'lg',
  fit = 'natural',
  priority = false,
} = Astro.props;

const radiusClass = rounded === 'lg' ? 'rounded-lg' : rounded === 'md' ? 'rounded-md' : '';
const imgFitClass = fit === 'cover' ? 'h-full w-full object-cover' : 'h-auto w-full';

// Flat colour under the image while it loads (falls back to the bg-soft class).
const dominant = typeof cover === 'object' ? cover?.dominantColor : undefined;
const wrapperStyle = dominant ? `background-color: ${dominant};` : undefined;
---

<div class={`relative overflow-hidden bg-bg-soft ${radiusClass} ${className}`} style={wrapperStyle}>
  {
    cover && (
      <Image
        image={cover}
        alt={alt}
        sizes={sizes}
        priority={priority}
        class={`relative block ${imgFitClass}`}
      />
    )
  }
</div>
