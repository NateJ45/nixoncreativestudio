---
// Foundation, edit with care.
/* ============================================================================
   Site Header
   ============================================================================
   Top of every page, sticky. Nathan's logo on the left, the primary nav and
   the "Start a project" button on the right. Renders inside BaseLayout above
   the <main> slot. Redesigned 2026-10-04 (DESIGN.md "Header").

   Surface: transparent at the top of the page, so the first band's ground
   (paper, window light, contours) runs up under it when that band is a
   <Band underHeader>. Once the page scrolls past 8px (enhance.ts sets
   data-scrolled) it becomes a paper bar with a hairline. The header always
   sits on a light ground, with one exception: a page whose first band is
   the deep ground passes onInk (BaseLayout headerOnInk; the home hero), and
   until the page scrolls the header shows its on-ink face: the white logo,
   paper nav, a paper button with an ink label. Scrolled, it is the paper bar
   with the navy logo as everywhere else.

   The "Start a project" button shows at EVERY width, phones included, so
   every page has a visible call to action without opening the menu (E
   found inner pages had none on mobile). Below 48rem the nav moves into the
   MobileMenu dialog and the logo becomes its top line only.

   The nav carries no numerals: it is a flat set of destinations.
   ============================================================================ */

import { getSite } from '../data/site';
import { getMenuItems } from '../lib/cms';
import { hasJournalEntries } from '../lib/journal';
import Logo from './Logo.astro';
import MobileMenu from './MobileMenu.astro';
import { buttonVariants } from './ui/button';
import { cn } from '@/lib/utils';

// Hide the Journal nav link until the journal has something to show: true only
// when at least one PUBLISHED journal entry exists in the CMS (a draft does not
// count). The read is memoised per request (the Footer asks too) and tagged for
// the route cache, so publishing the first entry purges every page.
const showJournal = await hasJournalEntries(Astro);

interface Props {
  /** The first band is the deep ground: show the on-ink face until scrolled. */
  onInk?: boolean;
}
const { onInk = false } = Astro.props;

// Site settings and the "primary" menu both come from the EmDash admin, each
// falling back to the committed copy in cms/content/. Menu URLs already carry
// their trailing slash (getMenuItems runs withTrailingSlash).
const site = await getSite(Astro);
const menu = await getMenuItems('primary', { cache: Astro.cache });

// Active-route detection: a link is active when the path matches it or sits
// beneath it (e.g. /work/foo).
const path = Astro.url.pathname.replace(/\/+$/, '');
const isActive = (href: string): boolean => {
  const h = href.replace(/\/+$/, '');
  if (h === '') return path === '';
  return path === h || path.startsWith(`${h}/`);
};

// One nav model for both menus. `descriptor` is the item's "Title attribute"
// in the menu editor, shown under the label in the phone menu only. Contact is
// not in this menu: it is the "Start a project" button.
const navLinks = menu
  .filter((item) => showJournal || !item.url.startsWith('/journal'))
  .map((item) => ({
    label: item.label,
    href: item.url,
    descriptor: item.titleAttr,
    target: item.target,
    active: isActive(item.url),
  }));
---

<header data-header class="ncs-header" data-on-ink={onInk ? '' : undefined}>
  <div class="ncs-container header-row">
    <!-- The logo is the home link; its alt text (the studio name) names the
         link. transition:name keeps it in place across View Transitions. -->
    <a class="header-logo" href="/" transition:name="site-logo">
      <Logo lockup="responsive" width={236} topWidth={160} eager class="logo-navy" />
      {onInk && (
        <Logo
          tone="white"
          lockup="responsive"
          width={236}
          topWidth={160}
          eager
          class="logo-white"
        />
      )}
    </a>

    <nav aria-label="Primary" class="header-nav">
      <ul>
        {navLinks.map(({ label, href, target, active }) => (
          <li>
            <a
              href={href}
              target={target}
              rel={target === '_blank' ? 'noopener noreferrer' : undefined}
              class:list={['nav-link', { 'is-active': active }]}
              aria-current={active ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/contact/" class={cn(buttonVariants({ variant: 'brand' }), 'header-cta')}>
        {site.headerCtaLabel}
      </a>
      <div class="header-menu">
        <MobileMenu links={navLinks} />
      </div>
    </div>
  </div>
</header>

<style>
  .ncs-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* The notch inset joins the bar's height when the page runs edge to edge
       under viewport-fit=cover; env() is 0 everywhere else. */
    height: calc(var(--header-h) + env(safe-area-inset-top));
    padding-top: env(safe-area-inset-top);
    background-color: transparent;
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .ncs-header[data-scrolled] {
    background-color: color-mix(in oklab, var(--paper) 94%, transparent);
    box-shadow: 0 1px 0 var(--border);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .header-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
  }
  .header-logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    margin-right: auto;
    text-decoration: none;
  }
  /* Phone: the top line, sized to leave room for the button and the menu at
     320px. Tablet: the full lockup at 180px. Desktop: 236px. */
  .header-logo :global(img) {
    width: clamp(96px, calc(100vw - 228px), 160px);
  }
  @media (min-width: 48rem) {
    .header-logo :global(img) {
      width: 180px;
    }
  }
  @media (min-width: 64rem) {
    .header-logo :global(img) {
      width: 236px;
    }
  }

  .header-nav {
    display: none;
  }
  .header-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.75rem);
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44 by 44 at least: "Work" is 37px of text, so the box grows sideways. */
    min-height: var(--tap);
    min-width: var(--tap);
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    font-weight: 500;
    color: var(--heading);
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
    text-decoration-color: transparent;
    transition: text-decoration-color 0.2s ease;
  }
  .nav-link:hover {
    text-decoration-color: color-mix(in oklab, var(--marker) 55%, transparent);
  }
  /* Current page: a solid marker underline, plus aria-current for assistive
     tech, so the state is never colour alone. */
  .nav-link.is-active {
    text-decoration-color: var(--marker);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .header-cta {
    min-height: var(--tap);
    padding-inline: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  @media (min-width: 48rem) {
    .header-nav {
      display: block;
      margin-right: 0.5rem;
    }
    .header-menu {
      display: none;
    }
    .header-cta {
      padding-inline: 1.15rem;
      font-size: var(--text-ui);
    }
  }

  /* The on-ink face (onInk, until scrolled): only these four elements re-colour, so the
     phone menu's dialog keeps its own paper tokens. */
  .header-logo :global(.logo-white) {
    display: none;
  }
  .ncs-header[data-on-ink]:not([data-scrolled]) .header-logo :global(.logo-navy) {
    display: none;
  }
  .ncs-header[data-on-ink]:not([data-scrolled]) .header-logo :global(.logo-white) {
    display: block;
  }
  .ncs-header[data-on-ink]:not([data-scrolled]) .nav-link,
  .ncs-header[data-on-ink]:not([data-scrolled]) .header-menu > :global(.menu-trigger) {
    color: var(--paper);
  }
  .ncs-header[data-on-ink]:not([data-scrolled]) .nav-link:hover,
  .ncs-header[data-on-ink]:not([data-scrolled]) .nav-link.is-active {
    text-decoration-color: var(--marker-hot);
  }
  .ncs-header[data-on-ink]:not([data-scrolled]) .header-cta {
    --primary: var(--paper);
    --primary-foreground: var(--ink);
    --accent: var(--marker-hot);
    --accent-foreground: var(--ink);
    --background: var(--ink);
    --ring: var(--marker-hot);
  }

  @media (prefers-reduced-motion: reduce) {
    .ncs-header {
      transition: none;
    }
  }
</style>
