---
// Foundation, edit with care. The default props handle the homepage-style CTA;
// inner pages tune the copy by passing title, sub, ctaLabel, ctaHref.
/* ============================================================================
   CTA Banner  [revamp]
   ============================================================================
   Reusable call-to-action band that closes most inner pages and sits above the
   footer. Sits on the paper-contours ground (the Ohio River's contours: the
   close of a page is where "Cincinnati" belongs, DESIGN.md "Grounds"), so it
   reads as a deliberate change of ground before the ink footer. Text uses the
   semantic tokens (text-heading / text-text-muted), which that ground
   re-scopes to stay AA over its worst pixel.

   All motion is reduced-motion safe (see globals.css section 6).
   ============================================================================ */

import { buttonVariants } from './ui/button';
import { getSite } from '../data/site';

interface Props {
  title?: string;
  sub?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

// The defaults (title, sub, button text) are the "closing banner" fields in Site
// settings in the CMS, with the committed fallback. The button's link stays in code.
const site = await getSite(Astro);

const {
  title = site.ctaDefault.title,
  sub = site.ctaDefault.sub,
  ctaLabel = site.ctaDefault.label,
  ctaHref = '/contact/',
} = Astro.props;
---

<section class="ground ground-paper-contours cta-band py-2xl" aria-labelledby="cta-banner-title">
  <!-- Copy on the left, button on the right. flex-wrap so the button drops
       below the copy on narrow screens. -->
  <div
    class="ncs-container relative z-10 flex flex-wrap items-center justify-between gap-l"
    data-reveal
  >
    <div class="flex max-w-[50ch] flex-col gap-s">
      <h2 id="cta-banner-title" class="text-heading">
        {title}
      </h2>
      <p class="text-lg leading-[1.5] text-text-muted">{sub}</p>
    </div>

    <span class="inline-block">
      <a href={ctaHref} class={buttonVariants({ variant: 'brand', size: 'cta' })}>
        {ctaLabel}
      </a>
    </span>
  </div>
</section>
