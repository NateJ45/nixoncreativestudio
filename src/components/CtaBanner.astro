---
// Foundation, edit with care. The default props handle the homepage-style CTA;
// inner pages tune the copy by passing title, sub, ctaLabel, ctaHref.
/* ============================================================================
   CTA Banner  [revamp]
   ============================================================================
   Reusable call-to-action band that closes most inner pages and sits above the
   footer. Uses the theme-aware `.band-themed` surface: flat bg-soft in light
   mode, flat navy in dark mode. So in
   light mode it reads light (not a dark block before the footer), while in dark
   mode it still flows into the navy footer. Text uses theme-aware tokens
   (text-heading / text-text-muted) so it stays legible on either surface.
   Scroll-reveal on the copy carries the motion.

   All motion is reduced-motion safe (see globals.css section 6).
   ============================================================================ */

import { buttonVariants } from './ui/button';

interface Props {
  title?: string;
  sub?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title = "Let's build a site you won't have to redo.",
  sub = 'I take a small number of projects each quarter. The earlier we talk, the better we can pace it together.',
  ctaLabel = 'Start a project',
  ctaHref = '/contact/',
} = Astro.props;
---

<section class="band-themed cta-band py-2xl" aria-labelledby="cta-banner-title">
  <!-- Copy on the left, button on the right. flex-wrap so the button drops
       below the copy on narrow screens. -->
  <div
    class="ncs-container relative z-10 flex flex-wrap items-center justify-between gap-l"
    data-reveal
  >
    <div class="flex max-w-[50ch] flex-col gap-s">
      <h2 id="cta-banner-title" class="text-heading">
        {title}
      </h2>
      <p class="text-lg leading-[1.5] text-text-muted">{sub}</p>
    </div>

    <span class="inline-block">
      <a href={ctaHref} class={buttonVariants({ variant: 'brand', size: 'cta' })}>
        {ctaLabel}
      </a>
    </span>
  </div>
</section>
