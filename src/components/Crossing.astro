---
/* Crossing: About's postcard under "One person.". Two photographs crossfade into each other:
   Edinburgh by day from Calton Hill (Nathan's own) on the left, Cincinnati by night across the
   Ohio on the right (Tim Thorn, Unsplash License, credited on /colophon/). Over the sky, the
   Saltire turns into the Stars and Stripes, and the 2017 flight arcs from the monument to the
   Great American Tower. The words are all in the HTML below the pictures. Styles in
   src/styles/pages/about.css under "The postcard". */
import { Image } from 'astro:assets';
import edinburgh from '../assets/photography/canvas/edinburgh-skyline.jpg';
import cincinnati from '../assets/about/cincinnati-skyline.jpg';

interface Stamp {
  word: string;
  under: string;
}
interface Props {
  stamps: Stamp[];
}
const { stamps } = Astro.props;

/* The art box is 1200 x 560 at every width (aspect-ratio in about.css), so the drawing over the
   photos lines up with them: each photo covers 62% of the width, overlapping in the middle. */
const W = 1200;
const H = 560;
// From the Dugald Stewart monument's dome (left photo) to the Great American Tower's (right).
const FLIGHT = 'M262 92Q700 -40 1138 96';

/* The US flag on the right: 13 stripes, a canton of seven, 50 stars in rows of 6 and 5. */
const US = { x: 480, w: 720 };
const stripe = H / 13;
const canton = { w: US.w * 0.4, h: stripe * 7 };
const sizes = '(max-width: 60rem) 62vw, 34rem';

/* The flags as two small SVG images (data URIs), 1200 x 640: the sky box plus 40 units above and
   below, so a strip that rises or falls never shows an edge. Only the characters a data URI needs
   escaped are escaped, which keeps the page light. */
const SALTIRE_END = US.x + 320;
const r = (n: number) => +n.toFixed(2);
const svg = (body: string) =>
  `url("data:image/svg+xml,${`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 -40 ${W} ${H + 80}' preserveAspectRatio='none'>${body}</svg>`.replace(/[%#<>"]/g, encodeURIComponent)}")`;
const saltire = svg(
  `<rect y='-40' width='${SALTIRE_END}' height='${H + 80}' fill='#005eb8'/>` +
    `<path d='M0 0 ${SALTIRE_END} ${H}M0 ${H} ${SALTIRE_END} 0' stroke='#fff' stroke-width='80'/>`,
);
/* Stripes and stars as two patterns. The stars: rows of 6 and 5 interleave, so one tile a sixth
   of the canton wide and two rows tall holds a star at its middle and one at its corner. The
   filled box stops 10 units inside the canton's edges, which keeps the 50 stars whole and leaves
   out the corner stars that would fall on the edge. */
const tile = { w: canton.w / 6, h: (canton.h / 10) * 2 };
const STAR =
  'm0-7.5 1.76 5.08 5.37.1-4.28 3.24 1.56 5.15-4.41-3.07-4.41 3.07 1.56-5.15-4.28-3.24 5.37-.1z';
const usFlag = svg(
  `<defs><pattern id='t' width='${W}' height='${r(stripe * 2)}' patternUnits='userSpaceOnUse'>` +
    `<rect y='${r(stripe)}' width='${W}' height='${r(stripe)}' fill='#fff'/></pattern>` +
    `<pattern id='s' x='${US.x}' width='${r(tile.w)}' height='${r(tile.h)}' patternUnits='userSpaceOnUse'>` +
    `<path fill='#fff' d='M${r(tile.w / 2)} ${r(tile.h / 2)}${STAR}M0 0${STAR}M${r(tile.w)} 0${STAR}M0 ${r(tile.h)}${STAR}M${r(tile.w)} ${r(tile.h)}${STAR}'/></pattern></defs>` +
    `<rect x='${US.x}' y='-40' width='${US.w}' height='${H + 80}' fill='#b22234'/>` +
    `<rect x='${US.x}' width='${US.w}' height='${H}' fill='url(#t)'/>` +
    `<rect x='${US.x}' y='-40' width='${r(canton.w)}' height='${r(canton.h + 40)}' fill='#4d5cc4'/>` +
    `<rect x='${US.x + 10}' y='10' width='${r(canton.w - 20)}' height='${r(canton.h - 20)}' fill='url(#s)'/>`,
);

/* The wave: 80 strips, one ripple every 480 units (32 strips). The swing grows towards the right,
   where the cloth is free; about.css works it out from each strip's --i. */
const N = 80;
const strips = Array.from({ length: N }, (_, i) => ({ i, x: (i * W) / N }));
---

<figure class="crossing">
  <div
    class="cx-art"
    role="img"
    aria-label="Edinburgh's skyline by day from Calton Hill, fading into Cincinnati's by night across the Ohio River, under a sky that turns from the Scottish flag into the American one. A dotted flight path joins the two."
  >
    <Image
      class="cx-photo cx-from"
      src={edinburgh}
      alt=""
      widths={[480, 800, 1200]}
      {sizes}
      loading="lazy"
      decoding="async"
    />
    <Image
      class="cx-photo cx-to"
      src={cincinnati}
      alt=""
      widths={[480, 800, 1200]}
      {sizes}
      loading="lazy"
      decoding="async"
    />
    {/* The flags wave: each is cut into 80 thin strips, every strip showing its own slice of the
        flag and rising and falling a beat after the one to its left (about.css, "The flags
        wave"), so a ripple runs towards the free end. A band of light and shade slides with it
        for the folds. Strips move by transform alone, so the browser only shifts layers. Still
        with reduced motion, and paused while the card is off screen (about.js). */}
    <div class="cx-flags cx-saltire" aria-hidden="true" style={`--flag:${saltire}`}>
      <div class="cx-cloth">
        {strips
          .filter((s) => s.x < SALTIRE_END)
          .map((s) => (
            <i style={`--i:${s.i}`} />
          ))}
        <i class="cx-folds" />
      </div>
    </div>
    {/* The Stars and Stripes on a layer of its own: the night sky is near black, which an overlay
        cannot lift, so this one is screened on, faint, like a flag lit against the dark. */}
    <div class="cx-flags cx-us" aria-hidden="true" style={`--flag:${usFlag}`}>
      <div class="cx-cloth">
        {strips
          .filter((s) => s.x + W / N > US.x)
          .map((s) => (
            <i style={`--i:${s.i}`} />
          ))}
        <i class="cx-folds" />
      </div>
    </div>
    <svg class="cx-trip" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
      <defs>
        <mask id="cx-fly" maskUnits="userSpaceOnUse" x="0" y="-60" width={W} height={H + 60}>
          <path
            class="cx-reveal"
            d={FLIGHT}
            fill="none"
            stroke="#fff"
            stroke-width="14"
            pathLength="1"
          ></path>
        </mask>
      </defs>
      <path class="cx-flight" d={FLIGHT} fill="none" pathLength="1" mask="url(#cx-fly)"></path>
      <circle cx="262" cy="92" r="6" class="cx-end"></circle>
      <circle cx="1138" cy="96" r="6" class="cx-end"></circle>
      <text x="700" y="58" class="cx-year">
        2017
      </text>
    </svg>
    <p class="cx-place cx-place-from">Edinburgh</p>
    <p class="cx-place cx-place-to">Cincinnati</p>
  </div>
  <figcaption class="cx-copy">
    <div>
      <p class="label">Based in Cincinnati</p>
      <h3>From Scotland, here since 2017</h3>
      <p>A U.S. citizen since 2022. In person around the region, anywhere for web work.</p>
    </div>
    <ul class="cx-stamps" aria-label="Stamped">
      {stamps.map((s) => (
        <li>
          <button
            type="button"
            class="stamp peel"
            data-peel
            data-cursor="Lift"
            aria-pressed="false"
          >
            <span class="stamp-face">
              <span class="stamp-word">{s.word}</span>
            </span>
            <span class="stamp-under">{s.under}</span>
          </button>
        </li>
      ))}
    </ul>
  </figcaption>
</figure>
