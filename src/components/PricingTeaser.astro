---
// Safe to edit. Every number comes from src/data/pricing.ts (the one place a
// price lives); the copy below (the value floor and the reassurance line) is
// the only content authored here.
/* ============================================================================
   PricingTeaser: "What it costs", ruled (overhaul package 2.2)
   ============================================================================
   The three web tiers as a ruled progression: no cards, no raised middle
   card, no count-ups. Each tier hangs off a 1px hairline; Signature (the
   `highlighted` tier) is marked with a 2px accent top rule and its badge in
   mono ("Where most projects land"). The prices are plain static text, so
   no-JS readers, crawlers and the JSON-LD on /services all see the same
   number.

   Two variants, one component, so the prices can never be styled two ways:

     teaser (default)  the home. Name, who it is for (or the badge), the
                       floor and the typical range, then a reassurance line
                       and a link to /services.
     full              /services (package 2.5). Adds each tier's paragraph
                       and scope points, a "Start with {tier}" link to
                       /contact/?tier={name} under each tier, and the
                       add-ons (photography, brand and strategy) folded into
                       a native <details>. Its summary line carries the
                       add-on prices, so they stay visible (and match the
                       JSON-LD offers) while it is closed. It drops the link
                       to /services, which would point at itself.

   Props:
     variant    'teaser' | 'full'
     tone       the Section surface ('white' | 'paper')
     headingId  id on the H2, for in-page links (the /services sub-nav)
   ============================================================================ */

import Section from './Section.astro';
import { webTiers, addOns } from '../data/pricing';
import { money } from '../lib/money';

interface Props {
  variant?: 'teaser' | 'full';
  tone?: 'white' | 'paper';
  headingId?: string;
}

const { variant = 'teaser', tone = 'white', headingId = 'pricing-heading' } = Astro.props;
const full = variant === 'full';

// The value floor: what every build includes, whatever the tier. Stated once,
// above the prices, so the cost is read against the value.
const includes = [
  'A custom design, yours to keep',
  '100 / 100 accessibility',
  'Strategy and a content system, included',
  'One person, start to finish',
];

const lowest = Math.min(...webTiers.map((t) => t.priceFrom));

// /contact/?tier=signature: the lower-case tier name, so the form can preselect
// the matching budget once it reads the parameter.
const tierHref = (name: string) => `/contact/?tier=${encodeURIComponent(name.toLowerCase())}`;
---

<Section rail="Pricing" railMeta={`From ${money(lowest)}`} tone={tone} labelledby={headingId}>
  <h2 id={headingId} class="pt-heading">
    {full ? 'What a website' : 'What it'} <b>costs</b>
  </h2>

  <p class="pt-includes">
    <span class="pt-includes-lead">Every build includes:</span>
    {includes.map((item, i) => (
      <>
        <span>{item}</span>
        {i < includes.length - 1 && (
          <span class="pt-dot" aria-hidden="true">
            ·
          </span>
        )}
      </>
    ))}
  </p>

  <ul class="pt-tiers" role="list">
    {webTiers.map((tier) => (
      <li class:list={['pt-tier', tier.highlighted && 'pt-tier--anchor']}>
        <h3 class="pt-name">{tier.name}</h3>
        <p class:list={['pt-who', tier.highlighted && 'pt-who--anchor']}>
          {tier.highlighted && tier.badge ? tier.badge : tier.who}
        </p>
        <p class="pt-price">
          <span class="pt-from">from</span>
          <span class="pt-amount">
            {money(tier.priceFrom)}
            {tier.priceSuffix}
          </span>
        </p>
        <p class="pt-range">{tier.range}</p>
        {full && (
          <>
            <p class="pt-note">{tier.note}</p>
            <ul class="pt-features">
              {tier.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
            <a class="pt-start" href={tierHref(tier.name)}>
              Start with {tier.name} <span aria-hidden="true">→</span>
            </a>
          </>
        )}
      </li>
    ))}
  </ul>

  {full && (
    <details class="pt-addons">
      <summary>
        <span class="pt-addons-lead">Add to any project:</span>
        {addOns.map((addOn, i) => (
          <>
            <span class="pt-addon-sum">
              {addOn.name} {addOn.price}
            </span>
            {i < addOns.length - 1 && (
              <span class="pt-dot" aria-hidden="true">
                ·
              </span>
            )}
          </>
        ))}
      </summary>
      <ul class="pt-addon-list">
        {addOns.map((addOn) => (
          <li>
            <h3 class="pt-addon-name">{addOn.name}</h3>
            <p class="pt-addon-price">{addOn.price}</p>
            <p class="pt-addon-note">{addOn.note}</p>
          </li>
        ))}
      </ul>
    </details>
  )}

  <p class="pt-reassure">
    Every number is a starting point. The first conversation is free and ends with an honest
    ballpark, and larger projects can split into monthly payments.
  </p>
  {!full && (
    <p class="pt-more">
      <a href="/services/">
        See full pricing and services <span aria-hidden="true">→</span>
      </a>
    </p>
  )}
</Section>

<style>
  .pt-heading {
    margin-bottom: 1.5rem;
  }

  .pt-includes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.625rem;
    max-width: 60rem;
    margin-bottom: 3rem;
    color: var(--muted-foreground);
    line-height: 1.5;
  }
  .pt-includes-lead {
    color: var(--color-text);
    font-weight: 600;
  }

  /* The ruled row: three columns from md, each on a 1px hairline. */
  .pt-tiers {
    display: grid;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .pt-tiers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }
  }

  .pt-tier {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-strong);
  }

  /* Signature: the same hairline, drawn as a 2px accent rule. The 1px margin
     difference keeps the three names on one baseline. */
  .pt-tier--anchor {
    border-top: 2px solid var(--color-accent);
    margin-top: -1px;
  }

  .pt-name {
    font-size: var(--text-h4);
  }

  .pt-who {
    font-size: 0.9375rem;
    color: var(--muted-foreground);
  }
  .pt-who--anchor {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--heading);
  }

  .pt-price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .pt-from {
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
  .pt-amount {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: 1;
    letter-spacing: -0.03em;
    font-weight: 300;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
  }
  .pt-tier--anchor .pt-amount {
    font-weight: 800;
  }

  .pt-range {
    font-size: 0.9375rem;
    color: var(--muted-foreground);
  }

  .pt-note {
    margin-top: 0.5rem;
    line-height: 1.55;
  }
  .pt-features {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0.5rem 0 0;
    padding-left: 1.1rem;
    line-height: 1.45;
  }

  /* Full variant: the tier's link to /contact, pinned to the foot of the
     column (margin-top: auto) so the three line up whatever their copy. */
  .pt-start {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    min-height: 2.75rem;
    margin-top: auto;
    padding-top: 0.75rem;
    color: var(--color-link);
    font-weight: 650;
  }
  .pt-start span {
    transition: transform var(--dur-quick) var(--ease-glide);
  }
  .pt-start:hover span,
  .pt-start:focus-visible span {
    transform: translateX(0.25rem);
  }

  /* Full variant: the add-ons, ruled like the tiers, folded into a native
     <details>. The summary is the whole line (name and price for each), with
     a + that turns to x when open, so the state never rests on colour. */
  .pt-addons {
    margin-top: 3rem;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line);
  }
  .pt-addons summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.625rem;
    min-height: 2.75rem;
    padding: 1rem 2rem 1rem 0;
    position: relative;
    cursor: pointer;
    list-style: none;
    line-height: 1.5;
    color: var(--muted-foreground);
  }
  .pt-addons summary::-webkit-details-marker {
    display: none;
  }
  .pt-addons summary::after {
    content: '+';
    position: absolute;
    right: 0.25rem;
    top: 0.85rem;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    line-height: 1;
    color: var(--heading);
    transition: transform var(--dur-quick) var(--ease-glide);
  }
  .pt-addons[open] summary::after {
    transform: rotate(45deg);
  }
  .pt-addons-lead {
    color: var(--color-text);
    font-weight: 600;
  }
  .pt-addon-sum {
    color: var(--color-text);
  }
  .pt-addons summary:hover .pt-addons-lead {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .pt-addon-list {
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0.5rem 0 2rem;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .pt-addon-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }
  }
  .pt-addon-list li {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .pt-addon-name {
    font-size: var(--text-h5, 1.25rem);
  }
  .pt-addon-price {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--heading);
  }
  .pt-addon-note {
    max-width: 52ch;
    line-height: 1.55;
    color: var(--muted-foreground);
  }

  @media (prefers-reduced-motion: reduce) {
    .pt-start span,
    .pt-addons summary::after {
      transition: none;
    }
  }

  .pt-reassure {
    max-width: 62ch;
    margin-top: 3rem;
    color: var(--muted-foreground);
    line-height: 1.6;
  }

  .pt-more {
    margin-top: 1rem;
    font-size: 1.125rem;
  }
  .pt-more a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--color-link);
    font-weight: 650;
  }
  .pt-more a span {
    transition: transform var(--dur-quick) var(--ease-glide);
  }
  .pt-more a:hover span,
  .pt-more a:focus-visible span {
    transform: translateX(0.25rem);
  }

  @media (forced-colors: active) {
    .pt-tier--anchor {
      border-top-color: Highlight;
    }
  }
</style>
