---
/* Facts: the two cards beside About's postcard (Crossing.astro), under "One person.". Each states
   something the page already says in the story, and each wears a peeling stamp.
   - The crew list: every role on a project, and the same name against each one.
   - The film strip: frames of my own photographs that become client websites at a splice marked
     2020, drifting sideways as the page scrolls (still without support or with reduced motion).
     The frames are decoration, so the strip is hidden from screen readers and the sentence under
     it says the same thing in words.
   The crew list, the film strip and the stamps come from the drawer (src/components/ephemera/,
   looks in src/styles/ephemera.css and stamp.css). Where they sit on the cards is in
   src/styles/pages/about.css under "The facts". No photograph carries a date. */
import type { ImageMetadata } from 'astro';
import CrewList from './ephemera/CrewList.astro';
import FilmStrip from './ephemera/FilmStrip.astro';
import Stamp from './ephemera/Stamp.astro';
import stream from '../assets/photography/canvas/fall-stream.jpg';
import stones from '../assets/photography/canvas/old-stones.jpg';
import crossing from '../assets/photography/canvas/river-crossing.jpg';
import forest from '../assets/photography/canvas/ig-snowy-forest-path.jpg';
import tm from '../assets/case-studies/shots/theology-matters-home.png';
import mas from '../assets/case-studies/shots/mas-monograms-home.png';
import pa from '../assets/case-studies/shots/presbyterian-academy-home.png';
import fbcm from '../assets/case-studies/shots/first-baptist-muncie-home.png';

const crew = ['Strategy', 'Design', 'The build', 'Photos, when needed'];
const film: { src: ImageMetadata; web?: boolean }[] = [
  { src: stream },
  { src: forest },
  { src: stones },
  { src: crossing },
  { src: tm, web: true },
  { src: mas, web: true },
  { src: pa, web: true },
  { src: fbcm, web: true },
];
---

<ul class="facts">
  <li class="fact crew">
    <CrewList roles={crew} />
    <Stamp word="One person" under="Start to finish" />
  </li>
  <li class="fact reel-fact">
    <div class="film-wrap">
      <FilmStrip frames={film} splice="2020" />
      <Stamp word="Since 2020" under="Building websites" />
    </div>
    <p class="label">Building websites since 2020</p>
    <p class="fact-line">After years behind a camera.</p>
  </li>
</ul>
