---
// Safe to edit.
/* ============================================================================
   FeatureHighlight (restyled in overhaul 2.4b)
   ============================================================================
   One row of "What I built": a framed, click-to-zoom screenshot of a REAL
   shipped feature beside a short title and caption.

   2.4b look: a wide row on a 12-column grid, the screenshot across 7 columns
   and the words across 5, with the rows alternating paper and white so a run
   of them reads as a sequence of panels. The screenshot sits in the shared
   .frame (ring, shadow, --radius-frame), the one treatment for a real
   artifact. Below md the row stacks, screenshot first.

   The tone follows `side` unless you set it: left rows are paper, right rows
   are white, so the usual left, right, left run alternates on its own.

   Pairs with <Lightbox /> for the zoom (render Lightbox once on the page; the
   screenshot is a [data-zoom] button that opens it full size).

   Honesty rule: only ever screenshot a feature that is actually live on the
   site. A captioned screenshot of a feature that does not exist is a
   fabrication and a client-facing liability (CLAUDE.md never-break rule 9).

   Usage in a case study .mdx (imports under the frontmatter):

     import FeatureHighlight from '../../components/FeatureHighlight.astro';
     import Lightbox from '../../components/Lightbox.astro';
     import visitShot from '../../assets/case-studies/shots/<slug>-feature-visit.png';

     <FeatureHighlight
       src={visitShot}
       alt="The <Client> visit page"
       title="A front door for first-time guests"
       body="One short sentence on what the feature does and why it matters."
       side="left"
     />
     ... more, alternating side ...
     <Lightbox />

   Props: src, alt, title, body, side ('left' | 'right'), eyebrow (a small
   mono label above the title), tone ('paper' | 'white', new in 2.4b).
   ============================================================================ */

import { Picture } from 'astro:assets';
import { ladder, PICTURE } from '../lib/picture';

interface Props {
  /** Real feature screenshot, imported so Astro optimizes it. */
  src: ImageMetadata;
  alt: string;
  title: string;
  body: string;
  /** Image side at >= md. Alternate ('left' then 'right') down the page. */
  side?: 'left' | 'right';
  /** Optional small label above the title. */
  eyebrow?: string;
  /** Row surface. Defaults to paper for left rows, white for right rows. */
  tone?: 'paper' | 'white';
}

const { src, alt, title, body, side = 'left', eyebrow, tone } = Astro.props;
const surface = tone ?? (side === 'left' ? 'paper' : 'white');
---

<div class="feature-highlight" data-side={side} data-tone={surface} data-reveal>
  <figure class="feature-figure">
    <button
      type="button"
      class="feature-zoom frame"
      data-zoom
      aria-label={`View ${title} full size`}
    >
      <Picture
        src={src}
        alt={alt}
        widths={ladder([480, 640, 800, 1200])}
        sizes="(min-width: 82.5rem) 501px, (min-width: 64rem) calc(43vw - 66px), (min-width: 48rem) calc(54.7vw - 40px), calc(100vw - 4.5rem)"
        loading="lazy"
        decoding="async"
        {...PICTURE}
      />
      <span class="feature-zoom-hint" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m21 21-4.3-4.3"></path>
          <path d="M11 8v6M8 11h6"></path>
        </svg>
      </span>
    </button>
  </figure>

  <div class="feature-copy">
    {eyebrow && <p class="feature-eyebrow">{eyebrow}</p>}
    <h3 class="feature-title">{title}</h3>
    <p class="feature-body">{body}</p>
  </div>
</div>

<style>
  /* The row. A padded panel on its surface, so paper rows show against a
     white page (and white rows against a paper one). */
  .feature-highlight {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    margin-block: 1.5rem;
    padding: clamp(1rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
  }
  .feature-highlight[data-tone='paper'] {
    background-color: var(--paper);
  }
  .feature-highlight[data-tone='white'] {
    background-color: var(--background);
  }

  /* 7 / 5 from md. A right-side row puts the screenshot in columns 6 to 12. */
  @media (min-width: 48rem) {
    .feature-highlight {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 2rem;
    }
    .feature-figure {
      grid-column: 1 / span 7;
      grid-row: 1;
    }
    .feature-copy {
      grid-column: 8 / span 5;
      grid-row: 1;
    }
    .feature-highlight[data-side='right'] .feature-figure {
      grid-column: 6 / span 7;
    }
    .feature-highlight[data-side='right'] .feature-copy {
      grid-column: 1 / span 5;
    }
  }

  .feature-figure {
    margin: 0;
    min-width: 0;
  }

  /* The screenshot is a real button (keyboard focusable) that opens the
     lightbox. .frame (globals.css) gives the radius, ring and shadow. */
  .feature-zoom {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background-color: var(--paper);
    cursor: zoom-in;
  }
  .feature-zoom :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .feature-zoom:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  /* Zoom affordance: a small paper chip with a magnifier, shown on hover
     and focus. Only its visibility changes, no movement. */
  .feature-zoom-hint {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    background-color: var(--paper);
    color: var(--heading);
    opacity: 0;
    transition: opacity var(--dur-quick) var(--ease-settle);
  }
  .feature-zoom:focus-visible .feature-zoom-hint {
    opacity: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .feature-zoom:hover .feature-zoom-hint {
      opacity: 1;
    }
  }

  .feature-copy {
    min-width: 0;
  }
  .feature-eyebrow {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .feature-title {
    margin: 0;
    color: var(--heading);
  }
  .feature-body {
    margin: 0.75rem 0 0;
    max-width: 44ch;
    line-height: 1.6;
    color: var(--foreground);
  }

  @media (forced-colors: active) {
    .feature-highlight {
      border-top-color: CanvasText;
    }
  }
</style>
