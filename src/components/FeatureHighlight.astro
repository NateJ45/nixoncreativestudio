---
/* One real, live feature: a capture you can open, and a line about it. */
import ZoomImage from './study/ZoomImage.astro';
import { inline, studyImage } from '../lib/study-markup';

interface Props {
  /** The capture's file name in public/assets/study/, without the extension. */
  src: string;
  alt: string;
  title: string;
  body: string;
  side?: 'left' | 'right';
}
const { src, alt, title, body, side } = Astro.props;
---

<article class:list={['feat rv', { flip: side === 'right' }]}>
  <div class="feat-m">
    <ZoomImage img={studyImage(src)} alt={alt} />
  </div>
  <div class="feat-t">
    <h3 set:html={inline(title)} />
    <p set:html={inline(body)} />
  </div>
</article>
