---
/* In their words: the client's own words from the frontmatter, character for character. Never
   edit, tidy or paraphrase one here. A quote that is a public review (it has a `source`) also
   shows the person's face, the stars and a link to the review on Google (ReviewCite); an emailed
   quote with a face shows the face, name and role through ReviewCite too, without stars or link
   (2026-11-20, as in the home band). Every
   quote's key phrase (`highlight`) is marked (src/lib/highlight.ts; on all quotes since
   2026-11-16, not just reviews). Chapter gives the section id="in-their-words", which the
   review line in the study's opening jumps to.

   One card per person (added 2026-11-16): when the same person wrote more than once (Richard
   Burnett's 2025 email quote and his 2026 Google review), their words share a card, oldest first,
   each under a small dated note, with their name, face, stars and Google link once at the foot.
   That shows a client who came back. People are matched by samePerson (src/lib/study-quotes.ts).
   Each card has an id, q-<their name> (2026-11-20), so the home results line can link a quote to
   the card it comes from. */
import Chapter from './Chapter.astro';
import ReviewCite from '../ReviewCite.astro';
import { markedQuote } from '../../lib/highlight';
import { byPerson, monthYear, personId } from '../../lib/study-quotes';

interface Quote {
  quote: string;
  name: string;
  title: string;
  date: Date;
  context?: string;
  highlight?: string;
  photo?: string;
  source?: { platform: 'google'; url: string; rating: number };
}
const { study } = Astro.props;
const cards: Quote[][] = byPerson(study.testimonials as Quote[]);
/* The cite goes with the newest words: their title as it is now, and the review link if any. */
const footOf = (card: Quote[]) =>
  [...card].reverse().find((t) => t.source) ?? card[card.length - 1];
---

<Chapter title="In their words">
  {cards.map((card) => {
    const foot = footOf(card);
    const many = card.length > 1;
    return (
      <figure
        class:list={['q rv', { 'q-review': foot.source, 'q-thread': many }]}
        id={personId(foot.name)}
      >
        {card.map((t) =>
          many ? (
            <div class="q-part">
              <p class="q-when">
                <time datetime={t.date.toISOString().slice(0, 10)}>{monthYear(t.date)}</time>
                {t.context && <span>{t.context}</span>}
              </p>
              <blockquote set:html={markedQuote(t.quote, t.highlight)} />
            </div>
          ) : (
            <blockquote set:html={markedQuote(t.quote, t.highlight)} />
          ),
        )}
        <figcaption>
          {foot.source || foot.photo ? (
            <ReviewCite
              name={foot.name}
              title={foot.title}
              photo={foot.photo}
              url={foot.source?.url}
              rating={foot.source?.rating}
              context={many ? undefined : foot.context}
            />
          ) : (
            <>
              <b>{foot.name}</b>
              {foot.title}
              {!many && foot.context && <span class="q-ctx">{foot.context}</span>}
            </>
          )}
        </figcaption>
      </figure>
    );
  })}
</Chapter>
