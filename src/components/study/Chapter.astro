---
/* One chapter of a case study: a heading and its blocks. Used from the MDX. */
import { inline, slugify } from '../../lib/study-markup';

interface Props {
  title: string;
  class?: string;
}
const { title, class: cls } = Astro.props;
const id = slugify(title);
---

<section class:list={['chap', cls]} id={id} aria-labelledby={`c-${id}`}>
  <h2 id={`c-${id}`} set:html={inline(title)} />
  <slot />
</section>
