---
/* One chapter of a case study: a heading and its blocks. Used from the MDX.
   The Decisions chapter also carries two switches (study.js shows them): one lays the page's own
   columns over the story, one draws the measurements on every decision card. Both print only
   what the browser measures on this page. */
import { inline, slugify } from '../../lib/study-markup';

interface Props {
  title: string;
  class?: string;
}
const { title, class: cls } = Astro.props;
const id = slugify(title);
---

<section class:list={['chap', cls]} id={id} aria-labelledby={`c-${id}`}>
  <h2 id={`c-${id}`} set:html={inline(title)} />
  {id === 'decisions' && (
    <div class="insp" data-insp hidden>
      <button type="button" class="tbtn" aria-pressed="false" data-insp-grid>
        Show the grid
      </button>
      <button type="button" class="tbtn" aria-pressed="false" data-insp-spec>
        Show the measurements
      </button>
      <p class="sr" role="status" data-insp-out />
    </div>
  )}
  <slot />
</section>
