---
// Safe to edit.
/* ============================================================================
   SiteShowcase: "Walk the homepage" (overhaul package 2.4b)
   ============================================================================
   The client's real homepage in a BrowserFrame, walked top to bottom as you
   scroll the case study. Two ways it can behave, both from the same markup:

   1. The walk (scroll-driven). Where the browser supports
      `animation-timeline: view()`, the visitor has not asked for less motion,
      and Pause motion is off (`html[data-motion-paused]` is not set), the
      frame sticks under the header inside a tall track, and the capture
      slides up (translateY) in step with the page scroll. Page scroll is the
      only input: no timer, no loop, no script.

   2. The scroll box (the fallback). Under `prefers-reduced-motion: reduce`,
      under Pause motion, or without scroll-driven CSS, the frame's screen is a
      plain native scroll box. It is a focusable region named "Scroll the
      {client} homepage", so a keyboard user can Tab to it and use the arrow
      keys, Page Down or Space (tests/walk.spec.ts).

   Weight (overhaul ruling 4): the capture is cropped at build time to its
   first 4,000px (Media.astro crops when the box's ratio differs from the
   image's), so a 10,824px full-page capture never ships whole. It is lazy, in
   a fixed-ratio box, so nothing shifts while it loads. Measured on Stone Steps
   on 2026-10-31: the old full-length showcase image was 504 KB; see
   tests/page-weight.config.json for the number after.

   The phone that used to float in the corner is gone: the case-study stage
   (FramePair) already shows the phone capture, so it would be the same
   picture twice.

   Captures are found by slug, as before:
     src/assets/case-studies/shots/<slug>-home.png   (1440 wide, full page)
   Re-shoot with `npm run capture:study <slug>`.

   Usage inside a case study .mdx (the props the eight studies already pass):

     import SiteShowcase from '../../components/SiteShowcase.astro';

     <SiteShowcase
       slug="<slug>"
       alt="The <Client> homepage, top to bottom"
       href="https://example.com"
       label="example.com"
     />

   New, optional: `client` (the name in the scroll box's label; defaults to
   the study's `client` from the collection), `sizes` (when a template sets
   the walk wider or narrower than the default column) and `caption`.
   ============================================================================ */

import { getEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BrowserFrame from './BrowserFrame.astro';
import Media from './Media.astro';

interface Props {
  /** Case study slug. Resolves <slug>-home.png. */
  slug: string;
  /** Alt text for the capture. */
  alt: string;
  /** The live site's URL. The frame shows its host; the caption links to it. */
  href: string;
  /** Host as shown in the caption. Defaults to the href without protocol. */
  label?: string;
  /** Client name for the scroll box label. Defaults to the study's `client`. */
  client?: string;
  /** The real rendered width of the frame, so a phone picks a small file. */
  sizes?: string;
  /** Optional line under the frame, before the live link. */
  caption?: string;
  /**
   * @deprecated The old 'zoom' variant (a slow Ken Burns loop) was retired in
   * 2.4b; every walk is scroll-driven now. Kept so older MDX still renders.
   */
  variant?: 'scroll' | 'zoom';
}

const {
  slug,
  alt,
  href,
  label,
  client: clientProp,
  sizes = '(min-width: 64rem) 46rem, calc(100vw - 2.5rem)',
  caption,
} = Astro.props;

// Resolve the capture by slug (eager glob, the same pattern as SelectedWork).
const homeShots = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/case-studies/shots/*-home.png',
  { eager: true },
);
const src = Object.entries(homeShots).find(([p]) => p.endsWith(`/${slug}-home.png`))?.[1].default;
if (!src) {
  throw new Error(
    `SiteShowcase: no desktop capture for slug "${slug}" (expected ${slug}-home.png)`,
  );
}

// The client's name, for "Scroll the {client} homepage". Taken from the
// study itself so it can never disagree with the title card.
const study = await getEntry('case-studies', slug);
const client = clientProp ?? study?.data.client ?? label ?? new URL(href).hostname;

// Ruling 4: walk the first 4,000px of the capture at most. The captures are
// about 1440px wide, so this is a little under three screens of the site.
const MAX_DEPTH = 4000;
const depth = Math.min(src.height, MAX_DEPTH);
const ratio = `${src.width} / ${depth}`;

const shown = (label ?? href).replace(/^https?:\/\//, '').replace(/\/$/, '');
const labelId = `walk-${slug}-label`;
---

<figure class="walk" data-walk>
  <div class="walk-track">
    <div class="walk-sticky">
      <BrowserFrame url={href}>
        {/* The screen. A focusable, named region so the fallback scroll box is
            keyboard reachable (axe: scrollable-region-focusable). In walk
            mode it clips instead, and the page scroll moves the capture. */}
        <div class="walk-screen" tabindex="0" role="region" aria-labelledby={labelId}>
          <Media
            src={src}
            alt={alt}
            ratio={ratio}
            position="top"
            widths={[480, 800, 1200]}
            sizes={sizes}
            class="walk-capture"
          />
        </div>
      </BrowserFrame>
    </div>
  </div>
  <figcaption class="walk-caption">
    <span id={labelId} class="sr-only">
      Scroll the {client} homepage
    </span>
    {caption && <span class="walk-caption-line">{caption}</span>}
    <span class="walk-hint walk-hint-box" aria-hidden="true">
      Scroll inside the frame.
    </span>
    <span class="walk-hint walk-hint-scrub" aria-hidden="true">
      Keep scrolling to walk it.
    </span>
    <a href={href} target="_blank" rel="noopener noreferrer" class="walk-live">
      Live at {shown}
      <span aria-hidden="true"> ↗</span>
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
  </figcaption>
</figure>

<style>
  /* ---- The scroll box: the default, and the fallback ---------------------
     A fixed-ratio screen (16:10, never taller than the window allows) that
     scrolls natively. Every browser, every motion setting gets this first;
     the walk below only takes over when all three conditions hold. */
  .walk {
    margin-block: var(--spacing-l, 2.5rem);
  }

  .walk-screen {
    aspect-ratio: 16 / 10;
    max-height: calc(100svh - 10rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    background-color: var(--paper);
  }
  .walk-screen:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: -2px;
  }

  .walk-caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--muted-foreground);
  }
  .walk-live {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .walk-hint-scrub {
    display: none;
  }

  /* ---- The walk ----------------------------------------------------------
     Only with motion allowed, Pause motion off and scroll-driven CSS. The
     track is the scroll distance; the frame sticks while the track passes,
     and the capture moves from its top to its bottom over the track's
     `contain` range (track top at the viewport top, to track bottom at the
     viewport bottom), which ends while the frame is still stuck.

     The timeline is NAMED on the track: an anonymous view() on the capture
     would bind to its nearest scroll container, the clipped screen, which
     never scrolls (the bug the old showcase hit). The screen is a size
     container, so 100cqh is its height and the capture's last frame lines
     its bottom up with the screen's bottom, whatever height the screen has. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      :global(html:not([data-motion-paused])) .walk-track {
        height: 220vh;
        view-timeline-name: --ncs-walk;
        view-timeline-axis: block;
      }
      :global(html:not([data-motion-paused])) .walk-sticky {
        position: sticky;
        top: 6.5rem;
      }
      :global(html:not([data-motion-paused])) .walk-screen {
        overflow: hidden;
        container-type: size;
      }
      :global(html:not([data-motion-paused])) .walk-screen :global(.walk-capture) {
        animation: ncs-walk linear both;
        animation-timeline: --ncs-walk;
        animation-range: contain 0% contain 100%;
      }
      :global(html:not([data-motion-paused])) .walk-hint-box {
        display: none;
      }
      :global(html:not([data-motion-paused])) .walk-hint-scrub {
        display: inline;
      }
    }
  }

  @keyframes ncs-walk {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(calc(-100% + 100cqh));
    }
  }

  /* On paper the frame prints its URL; the capture prints from its top. */
  @media print {
    .walk-track {
      height: auto;
    }
    .walk-screen {
      overflow: hidden;
    }
    .walk-hint {
      display: none;
    }
  }
</style>
