---
/* Walk the homepage: the real capture in a desktop window beside a phone. The
   capture moves with page scroll (study.js), and without that the window is a
   plain keyboard-scrollable box. Cropped to 4,000px where a page runs longer.
   A line above says what it is and what it does, and a phone shows the phone
   capture instead of a shrunken desktop window (study.css). */
import LongPhone from './study/LongPhone.astro';
import { LOCK } from '../lib/window-chrome';
import { studyHome } from '../lib/study-markup';
import { hostOf } from '../lib/clients';

const { study, label, href, alt } = Astro.props;
const slug = study.slug;
const shot = studyHome(slug);
const host = study.facts?.host ?? hostOf(study.liveUrl);
---

<figure class="walk rv">
  <p class="walk-intro">
    The real homepage, top to bottom. It scrolls along as you scroll this page.
  </p>
  <div class="win">
    <div class="win-bar" aria-hidden="true">
      <span class="url">
        <span data-lock set:html={LOCK} />
        <span>{label}</span>
      </span>
    </div>
    <div class="walk-s" data-walk tabindex="0" role="group" aria-label={alt}>
      <img
        class="long"
        src={shot.url}
        width={shot.w}
        height={shot.h}
        alt={alt}
        loading="lazy"
        decoding="async"
      />
      <i class="thumb"></i>
    </div>
  </div>
  <div class="walk-ph" role="img" aria-label={alt}>
    <LongPhone slug={slug} host={host} variant="wp" />
  </div>
  <figcaption>
    <a
      class="tlink"
      href={href}
      target="_blank"
      rel="noopener"
      data-cta="visit_client_site"
      data-cta-location="walk"
    >
      Visit {label}
      <span class="sr"> (opens in a new tab)</span>
    </a>
  </figcaption>
</figure>
