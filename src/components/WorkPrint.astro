---
// Safe to edit.
/* ============================================================================
   WorkPrint
   ============================================================================
   One case study on /work, printed as a picture on the table: the site's cover
   in a Frame (a browser print or a film frame with its facts on the edge),
   then the sector, the title, the outcome and the two ways in (the case study,
   and the site itself). Used for the lead and for the rest of the live work;
   the page decides the size and the placement, so the composition varies.

   Honesty: the visit link appears only when the study has one, and a study
   that is not live is labelled with launchStatusLabel() and its link names the
   preview (src/lib/launchStatus.ts already dropped any "live" URL).

   Props:
     cs        the case study
     variant   'browser' | 'film'
     eager     the page's LCP picture (the lead)
     sizes     the image sizes attribute for this placement
     headingLevel  2 for the lead, 3 for the rest
     place     the ledger place (src/data/workExtras.ts), printed on the film edge
   ============================================================================ */
import { Image as EmDashImage } from 'emdash/ui';
import ScrollShot from './emdash/ScrollShot.astro';
import Frame from './Frame.astro';
import type { CaseStudy } from '../lib/caseStudies';
import { launchStatusLabel } from '../lib/launchStatus';
import { prettyDomain, sectorLabel } from '../lib/workIndex';
import { BUNDLED_MEDIA, SHOWREELS } from '../data/workExtras';

interface Props {
  cs: CaseStudy;
  variant?: 'browser' | 'film';
  eager?: boolean;
  sizes: string;
  headingLevel?: 2 | 3;
  place?: string;
  class?: string;
}

const {
  cs,
  variant = 'browser',
  eager = false,
  sizes,
  headingLevel = 3,
  place,
  class: className,
} = Astro.props;
const status = launchStatusLabel(cs.launchStatus);
const host = cs.liveUrl ? prettyDomain(cs.liveUrl) : undefined;
const href = `/work/${cs.id}/`;
const bundled = BUNDLED_MEDIA[cs.id]?.cover;
// For the page's LCP print, a study with a showreel uses the reel's poster (a same-origin,
// pre-sized WebP of the live home page, 57 KB at 960 w) instead of a request-time resize of
// the CMS cover: measured on /work, the resize put LCP at about 2.7 s on a simulated phone.
const reel = eager && cs.launchStatus === 'live' ? SHOWREELS[cs.id] : undefined;
const reelDir = reel ? `/reel/${cs.id}/${reel.prefix}` : undefined;
const edge = [cs.client, place, cs.year ? String(cs.year) : undefined, host].filter(
  Boolean,
) as string[];
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const titleId = `wp-${cs.id}`;
---

<article
  class:list={['wp', `wp--${variant}`, className]}
  aria-labelledby={titleId}
  data-work-item
  data-status={cs.launchStatus}
>
  <a href={href} class="wp-pic" tabindex="-1" aria-hidden="true">
    {reelDir ? (
      <Frame variant={variant} alt="" tag={status} edge={edge}>
        <img
          src={`${reelDir}-d-poster-960.webp`}
          srcset={`${reelDir}-d-poster-640.webp 640w, ${reelDir}-d-poster-960.webp 960w, ${reelDir}-d-poster.webp 1600w`}
          sizes={sizes}
          width="1600"
          height="900"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </Frame>
    ) : bundled ? (
      <Frame
        variant={variant}
        src={bundled.src}
        alt=""
        eager={eager}
        url={variant === 'browser' ? host : undefined}
        tag={status}
        edge={edge}
        widths={[480, 800, 1200, 1600]}
        sizes={sizes}
      />
    ) : (
      cs.cover && (
        <Frame
          variant={variant}
          alt=""
          url={variant === 'browser' ? host : undefined}
          tag={status}
          edge={edge}
        >
          {eager ? (
            <EmDashImage image={cs.cover} alt="" sizes={sizes} priority />
          ) : (
            /* Below the lead, covers are deferred (ScrollShot's defer mode, Gotcha 14):
               measured on /work, five covers inside Chrome's lazy-load distance started
               before the LCP and held it at about 2.65 s on a simulated phone. */
            <ScrollShot image={cs.cover} alt="" sizes={sizes} widths={[480, 750, 1080]} defer />
          )}
        </Frame>
      )
    )}
  </a>
  <div class="wp-text">
    <p class="type-caption wp-kind">
      {sectorLabel(cs.sector)}
      {place && <span> / {place}</span>}
    </p>
    <Heading id={titleId} class:list={['wp-title', headingLevel === 2 && 'wp-title--lead']}>
      <a href={href}>{cs.title}</a>
    </Heading>
    {(cs.outcome || cs.summary) && <p class="wp-outcome">{cs.outcome ?? cs.summary}</p>}
    <p class="wp-links type-ui">
      <a href={href} class="card-link" aria-describedby={titleId}>
        Read the case study
      </a>
      {host && (
        <a href={cs.liveUrl} target="_blank" rel="noopener noreferrer" class="wp-visit">
          {status ? `See the finished build` : host}
          <span aria-hidden="true"> ↗</span>
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      )}
    </p>
  </div>
</article>

<style>
  .wp {
    display: grid;
    gap: var(--spacing-m);
    align-content: start;
    min-width: 0;
  }
  .wp-pic {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .wp-pic :global(.frame-print) {
    transition: transform 0.5s var(--ease-settle);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .wp:hover .wp-pic :global(.frame-print) {
      transform: translateY(-4px);
    }
  }
  .wp-text {
    display: grid;
    gap: 0.5rem;
    max-width: 38rem;
  }
  .wp-kind {
    margin: 0;
  }
  .wp-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-h3);
    line-height: 0.95;
    letter-spacing: 0.01em;
  }
  .wp-title--lead {
    font-size: var(--text-h2);
  }
  .wp-title a {
    color: var(--heading);
    text-decoration: none;
  }
  .wp-title a:hover,
  .wp-title a:focus-visible {
    color: var(--link);
  }
  .wp-outcome {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--foreground);
    text-wrap: pretty;
  }
  .wp-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--spacing-m);
    margin: 0;
  }
  .wp-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .wp-visit {
    color: var(--muted-foreground);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 0.2em;
  }
  .wp-visit:hover,
  .wp-visit:focus-visible {
    color: var(--link);
    text-decoration-color: currentColor;
  }
</style>
