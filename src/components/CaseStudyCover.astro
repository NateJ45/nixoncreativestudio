---
/* ============================================================================
   CaseStudyCover
   ============================================================================
   Foundation, edit with care.

   A case study's cover, drawn through Media.astro (overhaul package 1.8).
   The blur placeholder from src/lib/coverPlaceholders.json is painted BEHIND
   the image, and the image paints over it the moment it loads.

   History: until 2026-10-31 this wrapper rendered its <img> at opacity 0 and
   faded it in from a script on load. That broke CLAUDE.md never-break rule 3:
   the /work cards and the case-study cover (the page's LCP image) started
   invisible, waited on JavaScript, and never showed at all with JavaScript
   off. tests/first-viewport.spec.ts caught it. Do not bring a fade back.

   Props:
     - cover       ImageMetadata (from a content-collection image() field)
     - placeholder base64 data URL (typically from getCoverPlaceholder())
     - alt         accessibility text (use "" for decorative covers next
                   to a heading carrying the same name)
     - widths      array of widths Astro should emit srcset entries for
     - sizes       sizes attribute for srcset selection
     - class       optional extra classes on the box
     - rounded     "lg" | "md" | "none", a convenience for the corner radius
     - fit         "natural" keeps the cover's true shape (the case-study
                   page); "cover" puts it in a uniform 4:3 box (/work cards)
     - lcp         true for the one cover that is the page's LCP image (the
                   case-study page): loads eagerly with fetchpriority high
   ============================================================================ */

import type { ImageMetadata } from 'astro';
import Media from './Media.astro';

interface Props {
  cover: ImageMetadata;
  placeholder?: string;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
  rounded?: 'lg' | 'md' | 'none';
  fit?: 'natural' | 'cover';
  lcp?: boolean;
}

const {
  cover,
  placeholder,
  alt,
  widths,
  sizes,
  class: className = '',
  rounded = 'lg',
  fit = 'natural',
  lcp = false,
} = Astro.props;

const radiusClass = rounded === 'lg' ? 'rounded-lg' : rounded === 'md' ? 'rounded-md' : '';
---

<Media
  src={cover}
  alt={alt}
  widths={widths}
  sizes={sizes}
  ratio={fit === 'cover' ? '4 / 3' : undefined}
  placeholder={placeholder}
  lcp={lcp}
  class={`${radiusClass} ${className}`.trim()}
/>
