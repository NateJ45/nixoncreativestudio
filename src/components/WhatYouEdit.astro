---
/* What the staff edit: the site's own editor. Only on a study with a cmsShot, and
   cmsShotAlt is required then (cmsShotProblem in src/lib/study.ts fails the build
   without it). The people named are the ones who really run these sites. */
import Chapter from './study/Chapter.astro';
import ZoomImage from './study/ZoomImage.astro';
import { LOCK } from '../lib/window-chrome';
import { inline } from '../lib/study-markup';

const EDITOR: Record<string, string> = {
  'mas-monograms': 'Mary Ann',
  'reid-design': 'Staci',
  'stone-steps-50k': 'Dave',
};

const { study } = Astro.props;
const who = EDITOR[study.slug];
const u = new URL(study.cmsName === 'WordPress' ? '/wp-admin/' : '/studio/', study.liveUrl);
const label = u.hostname.replace(/^www\./, '') + u.pathname.replace(/\/+$/, '');
const img = { url: `/assets/${study.slug}-cms.webp`, w: 1440, h: 900 };
---

<Chapter title={who ? `What ${who} edits` : 'What the staff edit'} class="edit">
  <p
    class="para rv"
    set:html={`Where ${who ?? 'the staff'} ${who ? 'makes' : 'make'} changes, on the first screen after signing in. ${inline(study.cmsShotAlt)}.`}
  />
  <figure class="cms rv">
    <div class="win">
      <div class="win-bar" aria-hidden="true">
        <span class="url">
          <span data-lock set:html={LOCK} />
          <span>{label}</span>
        </span>
      </div>
      <ZoomImage
        img={img}
        alt={`The ${study.cmsName === 'WordPress' ? 'WordPress ' : ''}editing home screen for ${study.client}`}
        flat
      />
    </div>
  </figure>
</Chapter>
