---
/* The Stone Steps course: the plan and the elevation drawn from the real trace
   in src/data/stone-steps-course.ts, with a slider to walk it a tenth of a mile
   at a time. study.js reads the same paths back to place the dot. Without
   JavaScript both lines are there and the slider stays hidden.

   Every part is labelled for a reader who has never seen an elevation chart: a
   title over each drawing, the heights in feet, what the grey lines are, and
   what the steepness percentage means. */
import {
  courseBounds as B,
  courseElevation as E,
  courseLoops as L,
  courseMiles as M,
  coursePoints as P,
} from '../data/stone-steps-course';

const PLAN_W = 3000;
const PAD = 80;
const midLat = ((B.north + B.south) / 2) * (Math.PI / 180);
const scale = (PLAN_W - PAD * 2) / ((B.east - B.west) * Math.cos(midLat));
const PLAN_H = Math.round((B.north - B.south) * scale + PAD * 2);
const px = (lon: number) => Math.round(PAD + (lon - B.west) * Math.cos(midLat) * scale);
const py = (lat: number) => Math.round(PAD + (B.north - lat) * scale);
const W = 6000;
const H = 2000;
const TOP = 100;
const BOT = 100;
const ex = (mi: number) => Math.round((mi / M) * W);
const ey = (ft: number) =>
  Math.round(TOP + (1 - (ft - E.lowFt) / (E.highFt - E.lowFt)) * (H - TOP - BOT));
const toPath = (pts: number[][]) =>
  pts
    .map(([x, y], i) => (i ? `l${x - pts[i - 1][0]} ${y - pts[i - 1][1]}` : `M${x} ${y}`))
    .join('');
const plan = P.map((p) => [px(p[0]), py(p[1])]);
const prof = P.map((p) => [ex(p[3]), ey(p[2])]);
const ft = (n: number) => n.toLocaleString('en-US');
const starts = L.map((l) => P.findIndex((p) => p[5] === l.loop));
---

<figure
  class="course rv"
  data-course
  data-total={M}
  data-low={E.lowFt}
  data-high={E.highFt}
  data-prof={`${W} ${H} ${TOP} ${BOT}`}
  data-starts={starts.join(' ')}
  data-grades={P.map((p) => p[4]).join(' ')}
>
  <div class="course-d">
    <p class="course-t course-t-plan" aria-hidden="true">
      The course from above
    </p>
    <p class="course-t course-t-prof" aria-hidden="true">
      Height above sea level along the course, in feet
    </p>
    <svg
      class="course-plan"
      viewBox={`0 0 ${PLAN_W} ${PLAN_H}`}
      role="img"
      aria-label={`The Stone Steps course from above: ${L.length} loops through Mt. Airy Forest`}
    >
      <path class="cl" d={toPath(plan)} data-plan></path>
      <circle class="cd" data-plan-dot cx={plan[0][0]} cy={plan[0][1]} r="70"></circle>
    </svg>
    <div class="course-p">
      <svg
        class="course-prof"
        viewBox={`0 0 ${W} ${H}`}
        preserveAspectRatio="none"
        role="img"
        aria-label={`Elevation along the course: ${ft(E.lowFt)} to ${ft(E.highFt)} feet over ${M} miles, ${L.length} loops`}
        data-profile
      >
        {L.slice(1).map((l) => (
          <line class="cv" x1={ex(l.startMile)} x2={ex(l.startMile)} y1="0" y2={H} />
        ))}
        <path class="cl" d={toPath(prof)} data-prof-path></path>
        <line class="cc" data-cursor x1="0" x2="0" y1="0" y2={H}></line>
      </svg>
      <span class="cdot" data-prof-dot style={`left:0;top:${(prof[0][1] / H) * 100}%`}></span>
      <div class="course-ax">
        <span>Mile 0</span>
        <span>
          Highest point {ft(E.highFt)} feet, lowest {ft(E.lowFt)} feet
        </span>
        <span>Mile {M}</span>
      </div>
    </div>
  </div>
  <div class="course-s" data-scrub hidden>
    <label for="course-range">Walk the course, a tenth of a mile at a time</label>
    <input
      id="course-range"
      type="range"
      min="0"
      max={Math.floor(M * 10) / 10}
      step="0.1"
      value="0"
      data-range
    />
    <output for="course-range" data-readout></output>
  </div>
  <figcaption>
    <p>
      {L.length} loops, {M} miles as recorded on David's own run of the course, between{' '}
      {ft(E.lowFt)} and {ft(E.highFt)} feet above sea level. Each grey line marks the end of a loop,
      back at the aid station.
    </p>
    <p>
      When you walk the course, the percentage is how steep the trail is there: 10% means it climbs
      (or drops) 10 feet for every 100 feet you move forward. Heights come from government
      laser-mapped elevation data (USGS LiDAR).
    </p>
  </figcaption>
</figure>
