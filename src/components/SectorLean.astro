---
/* A lean sector page: the job in this buyer's language, the proof there actually
   is, which tier usually fits, and the call to action. /schools/, /nonprofits/ and
   /small-business/ are one line each around this; the copy is in
   src/data/sector-pages.ts, the situations in SITUATIONS, the prices in pricing.ts.
   No client is tied to a tier here: proof and tiers are separate sections on purpose.
   Between the job and the proof sits "Try it": a few questions asked of one client's real
   phone page, which scrolls to each answer (src/scripts/ask.js, shared with /churches/; the
   questions, the answers and their stops are `page.ask` in sector-pages.ts).
   /churches/ is its own, larger build. */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/sector.css';
import Tile from './Tile.astro';
import Closing from './Closing.astro';
import SectorReading from './SectorReading.astro';
import ReviewCite from './ReviewCite.astro';
import RatingChip from './RatingChip.astro';
import { webTiers } from '../data/pricing';
import { SITUATIONS, type LeanSector, type Rich } from '../data/sector-pages';
import { site } from '../data/site';
import { getClients } from '../lib/clients';
import { money } from '../lib/money';
import { excerpt, markedQuote } from '../lib/highlight';
import { plainText, wordSpans } from '../lib/words';

interface Props {
  page: LeanSector;
}
const { page } = Astro.props;

const everyClient = await getClients();
const clients = everyClient.filter((c) => c.sectorKey === page.sector);
// "Try it": the client whose real phone page answers the questions, and its long capture.
const asked = everyClient.find((c) => c.slug === page.ask.slug);
if (!asked) throw new Error(`SectorLean: no client "${page.ask.slug}" for the Try it tool`);
const askLong = `/assets/study/${asked.slug}-mobile.webp`;
const entries = await getCollection('case-studies');
/* Public Google reviews lead (2026-11-20): every one a study has, newest first, up to two, so a
   second review from the same client (Lisa Cortez's, West Chester Preschool) shows here too. A
   study with none keeps its first quote.
   Each one reads like the home band (2026-11-20): the sentence that holds its key phrase, in
   bigger type with the phrase marked, then the full review behind "Read the whole review", then
   the face, stars and Google link (ReviewCite). Nothing is reworded: the sentence is cut out of
   the quote word for word (lib/highlight.ts), and a quote that is one sentence shows whole. */
const studies = clients.map((s) => {
  const all = entries.find((e) => e.id === s.slug)?.data.testimonials ?? [];
  const google = all
    .filter((t) => t.source)
    .sort((x, y) => y.date.valueOf() - x.date.valueOf())
    .slice(0, 2);
  const quotes = (google.length ? google : all.slice(0, 1)).map((t) => {
    const key = excerpt(t.quote, t.highlight);
    return {
      ...t,
      key: markedQuote(key, t.highlight),
      whole: key === t.quote ? '' : markedQuote(t.quote, t.highlight),
    };
  });
  return { s, quotes };
});

const situation = SITUATIONS.find((row) => row.sector === page.sector);
const fits = situation
  ? webTiers.map((tier, i) => ({
      tier,
      text: [situation.launch, situation.signature, situation.flagship][i],
    }))
  : [];

const path = `/${page.path}/`;
const canonical = new URL(path, site.url).toString();
const contact = `/contact/?org_type=${page.sector}`;
const schemas = [
  {
    '@type': 'ItemList',
    '@id': `${canonical}#studies`,
    name: `${page.title}: case studies`,
    numberOfItems: studies.length,
    itemListElement: studies.map(({ s }, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(s.study, site.url).toString(),
      name: s.name,
    })),
  },
];
const rich = (copy: Rich) => copy;
---

<BaseLayout
  title={`${page.title} | ${site.studioName}`}
  description={page.description}
  breadcrumbs={[{ name: page.label, path }]}
  pageType="CollectionPage"
  schemas={schemas}
>
  <header class="page-head sl-head">
    <h1 aria-label={plainText(page.heading)} set:html={wordSpans(page.heading)} />
    <p class="lede">{page.lede}</p>
    <div class="sl-links">
      <a class="chip go" href={contact}>
        Tell me about your site
      </a>
      <a class="chip" href="/one-page/">
        One-page summary to forward
      </a>
    </div>
  </header>

  <section class="sec tight" aria-labelledby="sl-job">
    <div class="wrap">
      <h2 id="sl-job" class="sl-h">
        What the site has to do
      </h2>
      <ul class="sl-points">
        {page.points.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec sun sl-sun" aria-labelledby="sun-h" data-sun>
    <div class="sun-in">
      <div class="sun-say">
        <p class="label">Try it</p>
        <h2 id="sun-h">
          Ask what <b>{page.ask.who}</b> asks.
        </h2>
        <p class="sun-lede">
          This is the real {asked.name} homepage on a phone. Tap a question and the page scrolls to
          its answer, so you can see how far a visitor would have to look.
        </p>
      </div>
      {/* On a phone the picture comes before the questions (the grid areas in sector.css), so a
          tap never changes something hidden below the fold or behind the dock. */}
      <div class="sun-ask">
        <p class="label sun-hint" id="sun-hint">
          Tap a question
        </p>
        <ul class="sun-qs" aria-labelledby="sun-hint">
          {page.ask.questions.map((q, i) => (
            <li>
              <button type="button" data-sun-q={q.stop} aria-pressed={i === 0 ? 'true' : 'false'}>
                <span>{q.q}</span>
                <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                  <path d="M7.5 4.5 13 10l-5.5 5.5" />
                </svg>
              </button>
              <p class="sun-a" data-sun-a>
                <b>{q.where}</b> {q.a}
              </p>
            </li>
          ))}
        </ul>
      </div>
      <div class="sun-w" data-sun-w>
        <Tile client={asked} long={askLong} lazy />
      </div>
    </div>
  </section>

  <section class="sec tight" aria-labelledby="sl-proof">
    <div class="wrap">
      <h2 id="sl-proof" class="sl-h">
        What I can show you
      </h2>
      <p class="sl-note">
        {rich(page.proofNote).map((part) =>
          typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>,
        )}
      </p>
      <RatingChip cta="google_reviews_sector" />
      <ul class="sl-studies" data-sl-studies>
        {studies.map(({ s, quotes }) => (
          <li>
            <div class="sl-w">
              <Tile client={s} lazy desk />
            </div>
            <div class="sl-t">
              <h3>{s.name}</h3>
              <p class="label">{s.sector}</p>
              <p class="sl-out">{s.outcome}</p>
              {quotes.map((quote) => (
                <figure class="sl-rv">
                  <blockquote set:html={quote.key} />
                  {quote.whole && (
                    <details class="sl-more" data-copy-ignore>
                      <summary>Read the whole review</summary>
                      <p set:html={quote.whole} />
                    </details>
                  )}
                  <figcaption>
                    <ReviewCite
                      name={quote.name}
                      title={quote.title}
                      context={quote.context}
                      photo={quote.photo}
                      url={quote.source?.url}
                      rating={quote.source?.rating}
                    />
                  </figcaption>
                </figure>
              ))}
              <p class="sl-go">
                <a href={s.study}>
                  Read the case study<span class="vh">: {s.name}</span>
                </a>
                {s.live && (
                  <a href={s.live} target="_blank" rel="noopener" data-cta="visit_client_site">
                    Visit the site<span class="vh">: {s.name} (opens in a new tab)</span>
                  </a>
                )}
              </p>
            </div>
          </li>
        ))}
      </ul>
      {page.closest && (
        <p class="sl-note sl-closest">
          {rich(page.closest).map((part) =>
            typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>,
          )}
        </p>
      )}
    </div>
  </section>

  <section class="sec tight" aria-labelledby="sl-tier">
    <div class="wrap">
      <h2 id="sl-tier" class="sl-h">
        Which tier usually fits
      </h2>
      <ul class="sl-tiers">
        {fits.map(({ tier, text }) => (
          <li>
            <h3>
              <a href={`/services/#${tier.name.toLowerCase()}`}>{tier.name}</a>
            </h3>
            <p>{text}</p>
            <p class="sl-from">From {money(tier.priceFrom)}</p>
          </li>
        ))}
      </ul>
      <div class="sl-after">
        {page.tierNotes.map((note) => (
          <p>{note}</p>
        ))}
        <p>
          See <a href="/services/#costs">what each tier costs over five years</a>, or forward
          <a href="/one-page/">a one-page summary</a> to whoever has to say yes.
        </p>
      </div>
    </div>
  </section>

  <SectorReading sector={page.sector} />

  <Closing slot="end" lead="I'll tell you which tier fits, <b>including if none does.</b>" />
</BaseLayout>

<script>
  import '../scripts/sector.js';
</script>
