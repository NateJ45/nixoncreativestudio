---
/* ============================================================================
   ChromeIcon
   ============================================================================
   Safe to edit.

   The handful of line icons the site chrome uses (theme toggle, mobile menu,
   back-to-top, copy email), inlined as SVG so no icon library ships to the
   browser. The shapes are copied from Lucide (ISC licence, v1.62), the set the
   old React islands drew with lucide-react, so nothing changed visually.

   Every icon is decorative (aria-hidden): the control around it carries the
   accessible name. Size it with a class, e.g. class="size-5".

   To add one: copy the SVG's child elements from lucide.dev (the icon's
   "Copy SVG" button) into the map below. lucide-react itself was removed.
   ============================================================================ */

export type ChromeIconName =
  'sun' | 'moon' | 'monitor' | 'menu' | 'x' | 'arrow-up' | 'copy' | 'check';

interface Props {
  name: ChromeIconName;
  class?: string;
  /** Extra attributes for the <svg>, e.g. a data-* hook a script toggles. */
  [key: `data-${string}`]: string | boolean | undefined;
}

const { name, class: className, ...rest } = Astro.props;

// Inner markup per icon, verbatim from Lucide's icon nodes.
const ICONS: Record<ChromeIconName, string> = {
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>',
  moon: '<path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/>',
  monitor:
    '<rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>',
  menu: '<path d="M4 5h16"/><path d="M4 12h16"/><path d="M4 19h16"/>',
  x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  'arrow-up': '<path d="m5 12 7-7 7 7"/><path d="M12 19V5"/>',
  copy: '<rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  {...rest}
  set:html={ICONS[name]}
/>
