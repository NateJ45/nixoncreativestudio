---
// Safe to edit.
/* ============================================================================
   HeroReel: the tilted wall of client sites behind the homepage hero
   ============================================================================
   Five columns of real client homepages (desktop and phone captures mixed),
   tilted in 3D and drifting up or down at different speeds, so the hero reads
   as a slow reel of shipped work. Hovering a column (mouse only) stops it and
   lifts the card under the cursor to show that site's one standout feature.

   Content lives in src/data/reel.ts (which sites, which columns; the feature
   lines are each study's `hook`). Images live in src/assets/reel/ and are re-shot from the live sites
   with `node scripts/capture-reel.mjs`.

   How the loop works: each column renders its cards twice, then a CSS
   animation moves it by exactly half its height (-50%), so the second copy
   lands where the first began and the loop has no seam. Every card carries
   its own bottom padding (not a flex gap), so both halves are the same height.

   Motion rules:
   - Reduced motion: no drift at all, the wall is a still image.
   - The stage is data-motion="loop" (src/scripts/motion.ts and globals.css
     section 6), so it holds still off-screen, in a hidden tab, and while the
     visitor has paused motion with the hero's Pause button or the footer
     switch (WCAG 2.2.2: moving content longer than five seconds needs a way
     to stop it).

   Accessibility: the whole wall is decorative and aria-hidden. The cards are
   mouse-only links to each case study (tabindex -1, so they stay out of the
   tab order); the real navigation is the hero's "See the work" CTA and the
   Selected Work section below.
   ============================================================================ */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getReelSites, reelColumns } from '../data/reel';

// Pull in every capture in src/assets/reel/ once, keyed by file name, so a
// column can ask for "{slug}-desktop" without a long list of imports.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/reel/*.jpg', {
  eager: true,
});
const capture = (slug: string, kind: 'desktop' | 'phone'): ImageMetadata => {
  const file = files[`../assets/reel/${slug}-${kind}.jpg`];
  if (!file) throw new Error(`HeroReel: missing src/assets/reel/${slug}-${kind}.jpg`);
  return file.default;
};
const reelSites = await getReelSites();
const siteBySlug = new Map(reelSites.map((s) => [s.slug, s]));

// Card sizes in CSS pixels. The captures are exactly 2x these.
const size = {
  desktop: { width: 300, height: 620 },
  phone: { width: 150, height: 420 },
};
---

<div class="reel-stage" aria-hidden="true" data-motion="loop">
  <div class="reel-plane">
    {reelColumns.map((col, colIndex) => {
      const cards = col.slugs.map((slug) => siteBySlug.get(slug)!).filter(Boolean);
      return (
        <div
          class:list={['reel-col', col.direction === 'down' && 'is-down']}
          data-reel-col={colIndex}
          style={`--reel-seconds: ${col.seconds}s; margin-top: ${col.offset}rem;`}
        >
          {[0, 1].map((copy) =>
            cards.map((site) => (
              <a class="reel-card" href={`/work/${site.slug}/`} tabindex="-1" data-copy={copy}>
                <span class="reel-frame" style={`width: ${size[col.kind].width}px;`}>
                  <span class="reel-chrome">
                    <span class="reel-dot" />
                    <span class="reel-dot" />
                    <span class="reel-dot" />
                    <span class="reel-host">{site.host}</span>
                  </span>
                  <Image
                    src={capture(site.slug, col.kind)}
                    alt=""
                    width={size[col.kind].width}
                    height={size[col.kind].height}
                    densities={[1, 2]}
                    quality={68}
                    loading={colIndex < 4 && copy === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    fetchpriority="low"
                    class="reel-shot"
                  />
                  <span class="reel-tag">{site.feature}</span>
                </span>
              </a>
            )),
          )}
        </div>
      );
    })}
  </div>
</div>

<style>
  /* The stage hangs off the hero's right edge and runs past its top and
     bottom, so the tilted columns never show a hard end. Two masks fade it:
     out to the left (where the headline sits) and out at the top and bottom.
     Masks work on any background, so this reads the same in both themes. */
  .reel-stage {
    position: absolute;
    top: -10%;
    right: -12%;
    width: 76%;
    height: 125%;
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0%, #000 24%, #000 100%),
      linear-gradient(180deg, transparent 0%, #000 14%, #000 84%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent 0%, #000 24%, #000 100%),
      linear-gradient(180deg, transparent 0%, #000 14%, #000 84%, transparent 100%);
    mask-composite: intersect;
  }

  /* The tilt. Perspective plus a small X/Y rotation gives depth; the Z
     rotation sets the diagonal. */
  .reel-plane {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    gap: 22px;
    transform: perspective(2200px) rotateX(18deg) rotateY(-14deg) rotateZ(-16deg);
    transform-origin: 50% 40%;
  }

  .reel-col {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    will-change: transform;
  }
  @media (prefers-reduced-motion: no-preference) {
    .reel-col {
      animation: reel-up var(--reel-seconds, 70s) linear infinite;
    }
    .reel-col.is-down {
      animation-name: reel-down;
    }
    /* Mouse users can stop a column to look at a card. */
    @media (hover: hover) {
      .reel-col:hover {
        animation-play-state: paused;
      }
    }
  }
  @keyframes reel-up {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-50%);
    }
  }
  @keyframes reel-down {
    from {
      transform: translateY(-50%);
    }
    to {
      transform: translateY(0);
    }
  }

  .reel-card {
    display: block;
    padding-bottom: 22px;
    text-decoration: none;
  }

  /* One card: a browser-window frame around a capture. */
  .reel-frame {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 10px;
    background: var(--card);
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--color-heading) 10%, transparent),
      var(--shadow-frame);
    transition:
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.5s ease;
  }
  :global(.dark) .reel-frame {
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 40px 60px -30px rgba(0, 0, 0, 0.8);
  }
  .reel-chrome {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 22px;
    padding: 0 9px;
    border-bottom: 1px solid color-mix(in oklab, var(--color-heading) 10%, transparent);
  }
  .reel-dot {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: color-mix(in oklab, var(--color-heading) 22%, transparent);
  }
  .reel-host {
    margin-left: 8px;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--color-text-muted);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .reel-shot {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The feature line slides up over the card on hover. */
  .reel-tag {
    position: absolute;
    right: 10px;
    bottom: 10px;
    left: 10px;
    padding: 8px 10px;
    border-radius: 6px;
    background: color-mix(in oklab, var(--color-primary) 90%, transparent);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.3;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }
  @media (hover: hover) {
    .reel-card:hover .reel-frame {
      transform: translateY(-6px) scale(1.03);
    }
    .reel-card:hover .reel-tag {
      opacity: 1;
      transform: none;
    }
  }

  /* Below lg the wall moves under the copy as a tilted band instead of
     sitting behind it. Smaller, flatter, four columns. */
  @media (max-width: 63.99rem) {
    .reel-stage {
      position: relative;
      top: auto;
      right: auto;
      width: 150%;
      height: 26rem;
      margin-left: -25%;
      -webkit-mask-image: linear-gradient(
        180deg,
        transparent 0%,
        #000 18%,
        #000 82%,
        transparent 100%
      );
      mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
    }
    .reel-plane {
      transform: rotateZ(-14deg) scale(0.7);
      transform-origin: 50% 30%;
    }
    .reel-col[data-reel-col='4'] {
      display: none;
    }
  }
</style>
