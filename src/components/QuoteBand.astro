---
/* A client's words on their own color, with their phone breaking out of the
   band. Only real quotes, word for word: pass `slug` and it reads the quote from
   that study's frontmatter. kit.js opens the band out as it reaches you.

   With `cycle` the band carries every quote on file, starting with `slug`'s and
   then in deck order. Previous and Next step through them, and the band takes
   each client's color and phone as it goes (scripts/quote-cycle.js). The buttons
   share the label's line at the top. On a phone the band shows each client's
   desktop window instead of their phone, so it stays short and adds the one view
   the grid above does not have. Without
   JavaScript only the first quote shows and the buttons stay hidden.

   A quote can name its key phrase (`highlight` in the study's frontmatter, copied
   exactly out of the quote). The band then draws a marker across those words as
   it arrives: the client's paper sweeping in behind them in a few hard steps
   (`.hl` in kit.css, `hl-on` from kit.js). The words themselves never change, and
   a quote with no phrase set is simply the quote.

   The cycle also carries the quotes that are not about a website (src/data/quotes.ts): those take
   their own colours, and where a website quote shows the client's site they show one of my
   photographs from that client, as a print. */
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { QUOTES } from '../data/quotes';
import Tile from './Tile.astro';
import ReviewCite from './ReviewCite.astro';
import { markedQuote } from '../lib/highlight';
import { getClient, getClients, type Client } from '../lib/clients';

interface Props {
  slug: string;
  /** Whose quote, when the study has more than one: part of their name. */
  by?: string;
  /** The small line above the quote. */
  label?: string;
  flip?: boolean;
  as?: 'section' | 'article';
  class?: string;
  ariaLabel?: string;
  /** Carry every quote on file, with Previous and Next. */
  cycle?: boolean;
}
const {
  slug,
  by,
  label,
  flip = false,
  as: Tag = 'section',
  class: cls,
  ariaLabel,
  cycle = false,
} = Astro.props;

type Quote = {
  quote: string;
  name: string;
  title: string;
  context?: string;
  highlight?: string;
  photo?: string;
  source?: { platform: 'google'; url: string; rating: number };
};
type Shot = { src: ImageMetadata; alt: string };
type Slide = {
  t: Quote;
  client: Pick<Client, 'slug' | 'accent' | 'paper'> & Partial<Client>;
  tile: boolean;
  /** A photograph instead of the client's site (a standalone quote). */
  shot?: Shot;
};

let slides: Slide[];
if (cycle) {
  const clients = await getClients();
  const start = clients.findIndex((c) => c.slug === slug);
  const order = start === -1 ? clients : [...clients.slice(start), ...clients.slice(0, start)];
  slides = [];
  for (const client of order) {
    const entry = await getEntry('case-studies', client.slug);
    (entry?.data.testimonials ?? []).forEach((t, i) => slides.push({ t, client, tile: i === 0 }));
  }
  if (!slides.length) throw new Error('No quotes on file');
  // Public reviews lead (added 2026-11-15): a stranger can check those on Google, so they do the
  // most for trust. Then the quotes that are not about a website, then the rest in deck order.
  const standalone: Slide[] = [];
  for (const q of QUOTES) {
    const shot = await getEntry('photos', q.shot);
    if (!shot) throw new Error(`quotes.ts: no photograph ${q.shot}`);
    standalone.push({
      t: q,
      client: { slug: q.id, accent: q.accent, paper: q.paper },
      tile: true,
      shot: { src: shot.data.image, alt: shot.data.alt },
    });
  }
  slides = [
    ...slides.filter((x) => x.t.source),
    ...standalone,
    ...slides.filter((x) => !x.t.source),
  ];
} else {
  const entry = await getEntry('case-studies', slug);
  const quotes = entry?.data.testimonials ?? [];
  const t = by ? quotes.find((q) => q.name.includes(by)) : quotes[0];
  if (!t) throw new Error(`No quote${by ? ` by ${by}` : ''} on ${slug}`);
  slides = [{ t, client: await getClient(slug), tile: true }];
}
/* The quote as HTML, the key phrase marked (src/lib/highlight.ts). */
const marked = (t: Quote) => markedQuote(t.quote, t.highlight);
const first = slides[0].client;
const many = slides.length > 1;
---

<Tag
  class:list={['band', { 'band-flip': flip, 'band-cycle': many }, cls]}
  aria-label={ariaLabel}
  style={`--c:${first.accent};--p:${first.paper}`}
  data-cycle={many ? '' : undefined}
>
  {/* The band's colour, opening out as it arrives (kit.css .band-bg). */}
  <span class="band-bg" aria-hidden="true"></span>
  <div class="band-t">
    {(label || many) && (
      <div class="band-head">
        {label && <p class="label">{label}</p>}
        {many && (
          <div class="band-nav" data-q-nav hidden>
            <button type="button" data-q-prev aria-label="Previous quote">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.25" />
              </svg>
            </button>
            <span class="band-n" data-q-count>
              1 / {slides.length}
            </span>
            <button type="button" data-q-next aria-label="Next quote">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.25" />
              </svg>
            </button>
          </div>
        )}
      </div>
    )}
    <div class="band-q" aria-live={many ? 'polite' : undefined}>
      {slides.map((s, i) => (
        <div
          class="band-s"
          data-q={i}
          data-c={s.client.accent}
          data-p={s.client.paper}
          data-slug={s.client.slug}
          inert={i ? true : undefined}
        >
          <blockquote set:html={marked(s.t)} />
          {s.t.source || s.t.photo ? (
            <ReviewCite
              name={s.t.name}
              title={s.t.title}
              photo={s.t.photo}
              url={s.t.source?.url}
              rating={s.t.source?.rating}
              context={s.t.context}
            />
          ) : (
            <p class="cite">
              <b>{s.t.name}</b>
              {s.t.title}
              {s.t.context && <span class="ctx">{s.t.context}</span>}
            </p>
          )}
        </div>
      ))}
    </div>
  </div>
  <div class="band-w">
    {slides
      .filter((s) => s.tile)
      .map((s, i) => (
        <div class="band-tw" data-tw={s.client.slug} inert={i ? true : undefined}>
          {s.shot ? (
            <>
              <span class="band-ph">
                <Image
                  class="band-print band-print-tall"
                  src={s.shot.src}
                  alt={s.shot.alt}
                  widths={[336, 672]}
                  sizes="(max-width: 60rem) min(60vw, 224px), min(23vw, 336px)"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              {many && (
                <span class="band-dk">
                  <Image
                    class="band-print"
                    src={s.shot.src}
                    alt=""
                    widths={[512, 1024]}
                    sizes="min(100vw, 32rem)"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              )}
            </>
          ) : (
            <>
              <span class="band-ph">
                <Tile
                  client={s.client as Client}
                  lazy
                  sizes="(max-width: 60rem) min(60vw, 224px), min(23vw, 336px)"
                />
              </span>
              {many && (
                <span class="band-dk">
                  <Tile client={s.client as Client} desk lazy />
                </span>
              )}
            </>
          )}
        </div>
      ))}
  </div>
</Tag>
