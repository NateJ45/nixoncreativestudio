---
/* About's "Off the clock": four cards from the rest of my week, each one turned over by a real
   button to show its back (src/scripts/off-the-clock.js). The front is a paper card lettered in
   two corners; the back is the studio blue, like the back of the deck. Turning a card moves
   focus to its back, and "Turn back" returns it. Without JavaScript nothing turns: the back sits
   under the front, so every word and link is still there. Reduced motion swaps the faces with no
   turn.

   Links that point at other pages only appear once that page is real: /photography/ while its
   gate is open, a journal post once it is published (src/data/nav.ts). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { journalPath, photoCount } from '../data/nav';
import { photographyOpen } from '../data/photography-gate';
import picnic from '../assets/about/family-picnic.jpg';
import raceBibs from '../assets/about/running-race-bibs.jpg';

interface Card {
  id: string;
  /** The corner letter. */
  pip: string;
  kicker: string;
  title: string;
  line: string;
  back: string;
  /** `position` overrides the crop focus (object-position) for a photo that needs it. */
  photo?: { src: ImageMetadata; alt: string; position?: string };
  link?: { href: string; text: string } | null;
}

const [photosOpen, avPost, serverPost] = await Promise.all([
  photoCount().then(photographyOpen),
  journalPath('church-av-rota-that-fills-its-own-gaps'),
  journalPath('minecraft-server-for-my-family-and-your-website'),
]);

const cards: Card[] = [
  {
    id: 'photo',
    pip: 'P',
    kicker: 'Behind the camera',
    title: 'Photography',
    line: 'Where all of this started.',
    back: 'I still carry a camera for myself, mostly chasing landscapes around the region.',
    link: photosOpen ? { href: '/photography/', text: 'See the photographs' } : null,
  },
  {
    id: 'av',
    pip: 'A',
    kicker: 'At church',
    title: 'Sunday AV',
    line: 'On the media team at Crestview.',
    back: "I'm one of the volunteers on the media team at Crestview Presbyterian Church. I run the weekly livestream and help plan the equipment upgrades.",
    link: avPost ? { href: avPost, text: 'How the rota fills its own gaps' } : null,
  },
  {
    id: 'family',
    pip: 'F',
    kicker: 'At home',
    title: 'Family',
    line: 'Cincinnati, with my wife and family.',
    back: 'Cincinnati has been home since 2017. I also run a small Minecraft server for my siblings.',
    photo: {
      src: picnic,
      alt: 'Nathan and his wife with their little one on a picnic blanket in a park.',
    },
    link: serverPost ? { href: serverPost, text: 'How the server works' } : null,
  },
  {
    id: 'run',
    pip: 'R',
    kicker: 'On foot',
    title: 'Running',
    line: 'Long runs, and a race now and then.',
    back: 'Mostly long runs around Cincinnati, and now and then I pin on a number for a local race.',
    photo: {
      src: raceBibs,
      alt: 'Nathan and a friend in race bibs before a local race.',
      // Taller frame than the others: 30% keeps both heads in the 4:3 crop.
      position: '50% 30%',
    },
    link: null,
  },
];
---

<section class="sec ab-sec otc-sec" aria-labelledby="oh">
  <div class="sec-head">
    <h2 id="oh">Off the clock</h2>
    <p>
      What I'm working on this month is on <a href="/now/">my now page</a>.
    </p>
  </div>
  <ul class="otc-grid">
    {cards.map((c) => (
      <li class="otc" data-otc>
        <div class="otc-card">
          <div class="otc-face otc-front card keyed">
            <span class="pip" aria-hidden="true">
              {c.pip}
            </span>
            <span class="pip flip" aria-hidden="true">
              {c.pip}
            </span>
            <p class="label">{c.kicker}</p>
            <h3>{c.title}</h3>
            <p class="otc-line">{c.line}</p>
            <button
              type="button"
              class="otc-turn"
              aria-expanded="false"
              aria-controls={`otc-${c.id}`}
              data-otc-turn
            >
              Turn over <span class="otc-vh">the {c.title} card</span>
            </button>
          </div>
          <div
            class="otc-face otc-back keyed"
            id={`otc-${c.id}`}
            role="group"
            aria-label={`${c.title}, the back of the card`}
            tabindex="-1"
          >
            {c.photo && (
              <Image
                class="otc-ph"
                src={c.photo.src}
                alt={c.photo.alt}
                style={c.photo.position ? `object-position: ${c.photo.position}` : undefined}
                widths={[360, 720]}
                sizes="(max-width: 36rem) 90vw, (max-width: 64rem) 45vw, 18rem"
                loading="lazy"
                decoding="async"
              />
            )}
            <p>{c.back}</p>
            {c.link && <a href={c.link.href}>{c.link.text}</a>}
            <button type="button" class="otc-turn" data-otc-back>
              Turn back
            </button>
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>
