---
/* About's "Off the clock": four open cards from the rest of my week, everything on the face, no
   turning. Each leads with its own picture, then its words:
   - Photography: a camera roll, six of my own prints from the photos collection in one frame.
     Step through with the two buttons or the arrow keys, or swipe. With no script it is a row
     you scroll sideways.
   - Sunday AV: a program monitor showing a Sunday at Crestview (my photograph), with the tally
     light, a lower third and the audio meters moving while it is on screen.
   - Family: a family album, sixteen of our own photos as prints on a paper mat, each whole (no
     crop, so no one loses their head) and turned a little. It steps exactly like the camera roll
     (the same script), with a caption per print and never a date.
   - Running: my Flying Pig 10K as an activity log (header, stats, map, elevation, splits), from
     my own watch export in src/data/flying-pig-10k.ts (scripts/build-run-trace.mjs), over real
     Cincinnati streets from OpenStreetMap (public/assets/about/flying-pig-map.svg, baked by
     scripts/build-run-map.mjs; the card credits OSM). The route draws itself as the card comes into view, and "Draw it again" replays it. No date on it. The
     note still points at the Stone Steps 50K, the race site I built.
   No photograph shows a date or a year. Script: src/scripts/off-the-clock.js. Styles: about.css
   under "Off the clock".

   Links that point at other pages only appear once that page is real: /photography/ while its
   gate is open, a journal post once it is published (src/data/nav.ts). */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { journalPath, photoCount } from '../data/nav';
import { photographyOpen } from '../data/photography-gate';
import picnic from '../assets/about/family-picnic.jpg';
import aquarium from '../assets/about/family/aquarium.jpg';
import ballpark from '../assets/about/family/ballpark.jpg';
import baptism from '../assets/about/family/baptism.jpg';
import churchWedding from '../assets/about/family/church-wedding.jpg';
import couchSelfie from '../assets/about/family/couch-selfie.jpg';
import eveningOut from '../assets/about/family/evening-out.jpg';
import firstDay from '../assets/about/family/first-day.jpg';
import livingRoom from '../assets/about/family/living-room.jpg';
import orchard from '../assets/about/family/orchard.jpg';
import raceMorning from '../assets/about/family/race-morning.jpg';
import rhododendrons from '../assets/about/family/rhododendrons.jpg';
import shoulders from '../assets/about/family/shoulders.jpg';
import sleigh from '../assets/about/family/sleigh.jpg';
import turkeyTrot from '../assets/about/family/turkey-trot.jpg';
import weddingLake from '../assets/about/family/wedding-lake.jpg';
import sanctuary from '../assets/photography/canvas/sanctuary-band.jpg';
import {
  runBounds as B,
  runElevation as E,
  runPoints as P,
  runSplits,
  runStats,
} from '../data/flying-pig-10k';

interface Frame {
  src: ImageMetadata;
  alt: string;
  title: string;
  sub?: string;
}

interface Card {
  id: string;
  /** The corner letter. */
  pip: string;
  kicker: string;
  title: string;
  /** The words under the picture. */
  back: string;
  /** `position` overrides the crop focus (object-position) for a photo that needs it. */
  photo?: { src: ImageMetadata; alt: string; position?: string };
  /** The prints for a camera roll or the family album: a caption (never a date) and its alt text. */
  frames?: Frame[];
  /** The picture that leads the card, when it is not a plain photo. */
  toy?: 'reel' | 'album' | 'log' | 'air';
  /** A second, smaller sentence under the first. */
  note?: string;
  link?: { href: string; text: string } | null;
}

/* The camera roll: six prints from the photos collection, by id, in this order. Places only in
   the captions, never a date. A print that leaves the collection simply drops out of the roll. */
const REEL = [
  'ig-little-miami-river',
  'ig-calm-river',
  'ig-farmland-clouds',
  'ig-hiker-ridge-view',
  'ig-canal-footbridge',
  'ig-edinburgh-clock-tower',
];
const prints = await getCollection('photos');
const reel = REEL.flatMap((id) => prints.filter((p) => p.id === id));

/* The family album, in this order. Captions say what is happening, never when. */
const ALBUM: Frame[] = [
  {
    src: picnic,
    title: 'Picnic in the park',
    alt: 'Nathan and his wife on a picnic blanket in a park, their little one eating watermelon.',
  },
  {
    src: weddingLake,
    title: 'Wedding day',
    alt: 'Nathan in a dark suit hugging his bride from behind by a lake, both laughing.',
  },
  {
    src: rhododendrons,
    title: 'Under the rhododendrons',
    alt: 'Nathan and his wife sharing a kiss beside a flowering rhododendron.',
  },
  {
    src: eveningOut,
    title: 'An evening out',
    alt: 'A selfie of a young Nathan and his wife at dusk, a bright light behind them.',
  },
  {
    src: ballpark,
    title: 'At the ballpark',
    alt: 'A selfie of Nathan, his wife and their baby son in the stands at a baseball game.',
  },
  {
    src: aquarium,
    title: 'At the aquarium',
    alt: 'Nathan, his wife and their baby son in a carrier, in front of an aquarium tank.',
  },
  {
    src: shoulders,
    title: 'Shoulder rides',
    alt: 'Nathan in sunglasses carrying his son on his shoulders on a sunny street.',
  },
  {
    src: firstDay,
    title: 'First day of school',
    alt: 'Nathan, his wife and their son in front of a first day of school backdrop.',
  },
  {
    src: sleigh,
    title: 'A red sleigh in the snow',
    alt: 'Nathan, his wife, their son and baby daughter in a red sleigh on a snowy lawn.',
  },
  {
    src: baptism,
    title: 'Baptism Sunday',
    alt: 'Nathan and his wife holding their baby in a christening gown at the front of a church, their son beside them.',
  },
  {
    src: orchard,
    title: 'A day at the farm',
    alt: 'Family on hay bales by an old tractor at a farm, Nathan with a camera round his neck.',
  },
  {
    src: couchSelfie,
    title: 'Couch selfie',
    alt: 'A selfie on the couch: Nathan, his wife, their son and family.',
  },
  {
    src: livingRoom,
    title: 'The whole family',
    alt: 'Nathan and his wife with their wider family in a bright living room.',
  },
  {
    src: churchWedding,
    title: 'A family wedding',
    alt: 'Nathan and his wife with the wedding party outside a stone church.',
  },
  {
    src: raceMorning,
    title: 'Race morning',
    alt: 'Nathan in a race bib and compression socks before a 5K, next to another runner.',
  },
  {
    src: turkeyTrot,
    title: 'Turkey Trot',
    alt: 'Nathan and two others in race bibs before a Thanksgiving Turkey Trot.',
  },
];

/* The route from above, in an equirectangular projection (fine at city scale), sized for the card. */
const CW = 280;
const PAD = 10;
const midLat = ((B.north + B.south) / 2) * (Math.PI / 180);
const scale = (CW - PAD * 2) / ((B.east - B.west) * Math.cos(midLat));
const CH = Math.round((B.north - B.south) * scale + PAD * 2);
const cx = (lon: number) => Math.round(PAD + (lon - B.west) * Math.cos(midLat) * scale);
const cy = (lat: number) => Math.round(PAD + (B.north - lat) * scale);
const trace = P.map((p) => [cx(p[0]), cy(p[1])]);
/* Whole units and relative moves ("l3-2") keep both paths short: the page has an HTML budget, and
   at this size a unit is about one screen pixel. */
const rel = (pts: number[][]) =>
  pts
    .map(([x, y], i) => {
      if (!i) return `M${x} ${y}`;
      const dy = y - pts[i - 1][1];
      return `l${x - pts[i - 1][0]}${dy < 0 ? '' : ' '}${dy}`;
    })
    .join('');
const routeD = rel(trace);
const runLabel = `Map of my Flying Pig 10K through downtown Cincinnati: ${runStats.miles} miles in ${runStats.time}.`;

/* The elevation profile: miles across, feet up, with a little headroom so the line never touches
   the top. The fill closes the line down to the baseline. */
const EW = 280;
const EH = 44;
const lastMile = P[P.length - 1][3];
const lo = E.lowFt - 10;
const hi = E.highFt + 10;
const ex = (mile: number) => Math.round((mile / lastMile) * EW);
const ey = (ft: number) => Math.round(EH - ((ft - lo) / (hi - lo)) * EH);
// Every third point (about 120 m apart) is plenty for a strip this small.
const elevPts = P.filter((_, i) => i % 3 === 0 || i === P.length - 1).map((p) => [
  ex(p[3]),
  ey(p[2]),
]);
const elevLine = rel(elevPts);
const elevFill = `${elevLine}L${EW} ${EH}L0 ${EH}Z`;

/* Splits: one bar per lap, taller for faster, so the strong last mile stands out. */
const secs = (pace: string) => {
  const [m, s] = pace.split(':').map(Number);
  return m * 60 + s;
};
const paces = runSplits.map((l) => secs(l.pace));
const slow = Math.max(...paces);
const fast = Math.min(...paces);
const splits = runSplits.map((l, i) => ({
  ...l,
  label: l.miles === 1 ? String(i + 1) : String(l.miles).replace(/^0/, ''),
  h: Math.round(30 + (70 * (slow - paces[i])) / (slow - fast || 1)),
}));

const [photosOpen, avPost, serverPost] = await Promise.all([
  photoCount().then(photographyOpen),
  journalPath('church-av-rota-that-fills-its-own-gaps'),
  journalPath('minecraft-server-for-my-family-and-your-website'),
]);

const cards: Card[] = [
  {
    id: 'photo',
    pip: 'P',
    kicker: 'Behind the camera',
    title: 'Photography',
    back: 'I still carry a camera for myself, mostly chasing landscapes around the region.',
    toy: reel.length >= 3 ? 'reel' : undefined,
    frames: reel.map((p) => ({
      src: p.data.image,
      alt: p.data.alt,
      title: p.data.title,
      sub: p.data.location,
    })),
    link: photosOpen ? { href: '/photography/', text: 'See the photographs' } : null,
  },
  {
    id: 'av',
    pip: 'A',
    kicker: 'At church',
    title: 'Sunday AV',
    back: 'I lead the media team at Crestview Presbyterian Church. I run the schedule, recruit and train the volunteers, plan the hardware and software upgrades, and work with church staff to set up events.',
    toy: 'air',
    link: avPost ? { href: avPost, text: 'How the rota fills its own gaps' } : null,
  },
  {
    id: 'family',
    pip: 'F',
    kicker: 'At home',
    title: 'Family',
    back: 'Cincinnati has been home since 2022. I also run a small Minecraft server for my siblings.',
    toy: 'album',
    frames: ALBUM,
    link: serverPost ? { href: serverPost, text: 'How the server works' } : null,
  },
  {
    id: 'run',
    pip: 'R',
    kicker: 'On foot',
    title: 'Running',
    back: 'Mostly long runs around Cincinnati, and now and then I pin on a number for a local race.',
    toy: 'log',
    note: "That's my Flying Pig 10K, straight off my watch, and my longest race so far. I know, I'm a slow runner. Luckily I'm much quicker at making fast websites, like the one for the Stone Steps 50K, a race I won't be running any time soon.",
    link: { href: '/work/stone-steps-50k/', text: 'Read the Stone Steps case study' },
  },
];
---

<section class="sec ab-sec otc-sec" aria-labelledby="oh">
  <div class="sec-head">
    <h2 id="oh">Off the clock</h2>
  </div>
  <ul class="otc-grid">
    {cards.map((c) => (
      <li class={`otc otc-${c.id} keyed`} data-otc>
        <div class="otc-media">
          {c.photo && (
            <Image
              class="otc-ph"
              src={c.photo.src}
              alt={c.photo.alt}
              style={c.photo.position ? `object-position: ${c.photo.position}` : undefined}
              widths={[480, 960]}
              sizes="(max-width: 36rem) 90vw, (max-width: 64rem) 45vw, 32rem"
              loading="lazy"
              decoding="async"
            />
          )}
          {(c.toy === 'reel' || c.toy === 'album') && c.frames && (
            <div class={c.toy === 'album' ? 'otc-reel otc-album' : 'otc-reel'} data-reel>
              <div
                class="reel-strip"
                data-reel-strip
                role="group"
                aria-label={`${c.toy === 'album' ? 'Family album' : 'Camera roll'}: ${c.frames.length} photographs. Use the arrow keys or the buttons to step through.`}
                tabindex="0"
              >
                {c.frames.map((p) => (
                  <figure class="reel-f">
                    <Image
                      src={p.src}
                      alt={p.alt}
                      widths={c.toy === 'album' ? [400, 800] : [560, 1120]}
                      sizes={
                        c.toy === 'album'
                          ? '(max-width: 36rem) 80vw, (max-width: 64rem) 40vw, 26rem'
                          : '(max-width: 36rem) 90vw, (max-width: 64rem) 45vw, 44rem'
                      }
                      loading="lazy"
                      decoding="async"
                    />
                    <figcaption>
                      <b>{p.title}</b>
                      {p.sub && <span>{p.sub}</span>}
                    </figcaption>
                  </figure>
                ))}
              </div>
              <div class="reel-bar">
                <button
                  type="button"
                  class="reel-b"
                  data-reel-prev
                  aria-label="Previous photograph"
                >
                  <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <path d="M12.5 4.5 7 10l5.5 5.5" />
                  </svg>
                </button>
                <p class="reel-n" data-reel-n aria-live="polite">
                  1 of {c.frames.length}
                </p>
                <button type="button" class="reel-b" data-reel-next aria-label="Next photograph">
                  <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <path d="M7.5 4.5 13 10l-5.5 5.5" />
                  </svg>
                </button>
              </div>
            </div>
          )}
          {c.toy === 'air' && (
            <div class="otc-air" data-otc-air>
              <Image
                src={sanctuary}
                alt="A Sunday morning at Crestview: the congregation in a white sanctuary as the band leads worship."
                widths={[480, 960]}
                sizes="(max-width: 36rem) 90vw, (max-width: 64rem) 45vw, 32rem"
                loading="lazy"
                decoding="async"
              />
              <span class="air-tally" aria-hidden="true">
                <i></i>Live
              </span>
              <span class="air-pgm" aria-hidden="true">
                PGM 1
              </span>
              <span class="air-third" aria-hidden="true">
                <b>Sunday worship</b>
                <span>Crestview Presbyterian</span>
              </span>
              <span class="air-meters" aria-hidden="true">
                <i></i>
                <i></i>
              </span>
            </div>
          )}
          {c.toy === 'log' && (
            <div class="otc-log" data-otc-course>
              <div class="log-head">
                <span class="log-av" aria-hidden="true">
                  N
                </span>
                <p>
                  <b>Nathan Nixon</b>
                  <span>Race · Cincinnati, Ohio</span>
                </p>
              </div>
              <p class="log-title">Flying Pig 10K</p>
              <dl class="log-stats">
                <div>
                  <dt>Distance</dt>
                  <dd>
                    {runStats.miles} <small>mi</small>
                  </dd>
                </div>
                <div>
                  <dt>Pace</dt>
                  <dd>
                    {runStats.pace} <small>/mi</small>
                  </dd>
                </div>
                <div>
                  <dt>Time</dt>
                  <dd>{runStats.time}</dd>
                </div>
              </dl>
              <div class="log-map">
                <svg viewBox={`0 0 ${CW} ${CH}`} role="img" aria-label={runLabel}>
                  {/* The streets underneath: OpenStreetMap roads and rivers baked to a cached file by
                      scripts/build-run-map.mjs in this same projection, so they sit exactly under
                      the route and cost the HTML nothing. */}
                  <use class="oc-map" href="/assets/about/flying-pig-map.svg#map" />
                  {/* The route once, drawn three times: <use> keeps the page light (the HTML budget). */}
                  <defs>
                    <path id="oc-trace" d={routeD} pathLength="1" />
                  </defs>
                  <use class="oc-casing" href="#oc-trace" />
                  <use class="oc-ghost" href="#oc-trace" />
                  <use class="oc-line" href="#oc-trace" />
                  <circle
                    class="oc-end"
                    cx={trace[trace.length - 1][0]}
                    cy={trace[trace.length - 1][1]}
                    r="4.5"
                  />
                  <circle class="oc-dot" cx={trace[0][0]} cy={trace[0][1]} r="4.5" />
                </svg>
                <a class="oc-osm" href="https://www.openstreetmap.org/copyright" rel="noopener">
                  © OpenStreetMap
                </a>
                <button type="button" class="oc-again" data-otc-again>
                  Draw it again
                </button>
              </div>
              <div class="log-elev">
                <p>
                  <span>Elevation</span>
                  <span>{runStats.climbFt} ft climb</span>
                </p>
                <svg viewBox={`0 0 ${EW} ${EH}`} preserveAspectRatio="none" aria-hidden="true">
                  <path class="le-fill" d={elevFill} />
                  <path class="le-line" d={elevLine} pathLength="1" />
                </svg>
              </div>
              <div class="log-splits">
                <p>
                  <span>Splits</span>
                  <span>min/mi</span>
                </p>
                <ol>
                  {splits.map((l) => (
                    <li style={`--h: ${l.h}%`}>
                      <span class="ls-pace">{l.pace}</span>
                      <i aria-hidden="true"></i>
                      <span class="ls-mi">
                        <span class="vh">Mile </span>
                        {l.label}
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          )}
        </div>
        <div class="otc-words">
          <span class="pip" aria-hidden="true">
            {c.pip}
          </span>
          <p class="label">{c.kicker}</p>
          <h3>{c.title}</h3>
          <p>{c.back}</p>
          {c.note && <p class="otc-note">{c.note}</p>}
          {c.link && <a href={c.link.href}>{c.link.text}</a>}
        </div>
      </li>
    ))}
  </ul>
</section>
