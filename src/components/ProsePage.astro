---
// Foundation, edit with care. Draws /privacy, /accessibility and /colophon from
// one CMS entry each (docs/CMS-DESIGN.md 1.10), on the redesign's grounds.
/* ============================================================================
   ProsePage
   ============================================================================
   One template for the long-text pages. The route (src/pages/privacy.astro and
   its two siblings) reads its `pages` entry with getProsePage() and hands the
   result here; this component wraps it in BaseLayout and picks a layout. Both
   start with the same top band: window-light (moving, under the header) holding
   a plain headline, the lead paragraph(s) and, on the document layout, the
   "Last updated" line. There is no eyebrow label: the entry's `eyebrow` field is
   no longer drawn (the headline says what the page is).

   DOCUMENT (page.showToc true: Privacy, Accessibility)
     A paper band with two columns on wide screens: a sticky "On this page" list
     (built from the body's Heading 2s, so it can never drift from the headings)
     beside the prose. A tiny scroll-spy script marks the section in view with
     aria-current. It is purely additive: without JS the list is plain anchor
     links. The first section and the list are visible at once (they sit in the
     first screen); later sections reveal on scroll through the global data-reveal
     system (reduced-motion safe, `.js`-gated).

   LEDGER (page.showToc false: Colophon)
     A paper band holding the label/detail rows, then a short paper-contours band
     closing on the "Start a project / See the work" links. `extraRows` are
     appended after the CMS rows (the Colophon's computed "Last built" row lives
     in code).

   The body arrives as trusted HTML strings (src/lib/prosePage.ts builds them
   from restricted Portable Text), so paragraphs and list items are set with
   set:html. Headings use the site's heading roles (Bebas), body the reading
   serif, furniture the system sans; no mono labels.

   Page script: registers on astro:page-load with the dataset re-bind guard so it
   survives View Transitions navigations (the footer links are the usual way in).
   ============================================================================ */

import BaseLayout from '../layouts/BaseLayout.astro';
import Band from './Band.astro';
import { buttonVariants } from './ui/button';
import { getSite } from '../data/site';
import { lastUpdatedLabel, proseTitle, type ProsePage, type ProseRow } from '../lib/prosePage';

interface Props {
  page: ProsePage;
  /** Rows added after the CMS rows (ledger layout only). */
  extraRows?: ProseRow[];
}

const { page, extraRows = [] } = Astro.props;
const site = await getSite(Astro);

// The on-this-page list: only sections that have a heading (text before the first
// Heading 2 forms a heading-less section and gets no entry).
const tocSections = page.sections.filter((s) => s.heading);
const headingId = `${page.slug}-heading`;
const allRows = [...page.rows, ...extraRows];
const updated = page.lastUpdated ? lastUpdatedLabel(page.lastUpdated) : undefined;
---

<BaseLayout title={proseTitle(page.title, site.studioName)} description={page.summary}>
  <Band ground="window-light" underHeader tight labelledby={headingId}>
    <header class="prose-head">
      <h1 id={headingId}>{page.heading}</h1>
      {page.intro.map((html) => (
        <p class="type-lede" set:html={html} />
      ))}
      {updated && page.showToc && <p class="type-caption">Last updated {updated}</p>}
    </header>
  </Band>

  {page.showToc ? (
    <Band>
      <div class="prose-layout">
        {tocSections.length > 0 && (
          <nav class="prose-toc" aria-label="On this page" data-prose-toc>
            <p class="type-caption prose-toc-label">On this page</p>
            <ul>
              {tocSections.map((s) => (
                <li>
                  <a href={`#${s.id}`} data-toc-link={s.id}>
                    {s.heading}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <div class="prose-body">
          {page.sections.map((s, index) => (
            <section class="prose-section" data-reveal={index === 0 ? undefined : ''}>
              {s.heading && (
                <h2 id={s.id} class="prose-h2">
                  {s.heading}
                </h2>
              )}
              {s.blocks.map((b) => {
                if (b.kind === 'h3') {
                  return (
                    <h3 id={b.id} class="prose-h3">
                      {b.text}
                    </h3>
                  );
                }
                if (b.kind === 'list' && b.ordered) {
                  return (
                    <ol class="prose-list prose-list--ordered">
                      {b.items.map((item) => (
                        <li set:html={item} />
                      ))}
                    </ol>
                  );
                }
                if (b.kind === 'list') {
                  return (
                    <ul class="prose-list">
                      {b.items.map((item) => (
                        <li set:html={item} />
                      ))}
                    </ul>
                  );
                }
                return <p set:html={b.html} />;
              })}
            </section>
          ))}
        </div>
      </div>
    </Band>
  ) : (
    <>
      <Band>
        {/* Ruled label/detail list: the label is the furniture sans, the detail the
               reading serif. */}
        <dl class="ledger">
          {allRows.map((row, index) => (
            <div class="ledger-row" data-reveal={index < 2 ? undefined : ''}>
              <dt>{row.label}</dt>
              <dd>{row.detail}</dd>
            </div>
          ))}
        </dl>
      </Band>

      {/* Quiet close, funnels onward like the rest of the site. */}
      <Band ground="paper-contours" still tight label="Next steps">
        <div class="ledger-close">
          <a href="/contact/" class={buttonVariants({ variant: 'brand', size: 'cta' })}>
            Start a project
          </a>
          <a class="card-link" href="/work/">
            See the work
          </a>
        </div>
      </Band>
    </>
  )}

  <script>
    // Scroll-spy: marks the "On this page" link for the section in view with
    // aria-current. Purely additive. With no JS or no IntersectionObserver the
    // list stays a set of working anchor links and the prose is untouched. It
    // adds no motion of its own, so there is nothing to gate for reduced motion.
    // Wrapped in astro:page-load so it re-binds after a View Transitions
    // navigation; the dataset flag keeps it from observing twice.
    function initProseToc() {
      const toc = document.querySelector<HTMLElement>('nav[aria-label="On this page"]');
      if (!toc || toc.dataset.spyBound || !('IntersectionObserver' in window)) return;
      toc.dataset.spyBound = 'true';

      const links = new Map<string, HTMLAnchorElement>();
      toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((a) => {
        const id = a.getAttribute('data-toc-link');
        if (id) links.set(id, a);
      });
      if (links.size === 0) return;

      // Track which sections are currently intersecting; the topmost one wins.
      const visible = new Set<string>();

      const setCurrent = (id: string | null) => {
        links.forEach((a, key) => {
          if (key === id) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const id = entry.target.id;
            if (entry.isIntersecting) visible.add(id);
            else visible.delete(id);
          }
          // Pick the visible section nearest the top of the document order.
          let topId: string | null = null;
          for (const id of links.keys()) {
            if (visible.has(id)) {
              topId = id;
              break;
            }
          }
          setCurrent(topId);
        },
        // Bias the active zone toward the upper portion of the viewport so a
        // heading is marked current as it reaches reading position.
        { rootMargin: '-20% 0px -65% 0px', threshold: 0 },
      );

      links.forEach((_, id) => {
        const heading = document.getElementById(id);
        if (heading) observer.observe(heading);
      });
    }
    document.addEventListener('astro:page-load', initProseToc);
    initProseToc();
  </script>
</BaseLayout>

<style>
  .prose-head {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-m);
    max-width: 52rem;
  }
  .prose-head :global(.type-lede) {
    max-width: 44ch;
  }

  /* ---- document layout ---- */
  .prose-layout {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }
  @media (min-width: 64rem) {
    .prose-layout {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--spacing-2xl);
    }
  }
  /* The list is for wide screens only; a phone reads straight down. */
  .prose-toc {
    display: none;
  }
  @media (min-width: 64rem) {
    .prose-toc {
      display: block;
      position: sticky;
      top: 6rem;
      flex: none;
      width: 14rem;
    }
  }
  .prose-toc-label {
    margin-bottom: var(--spacing-s);
  }
  .prose-toc ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--border);
  }
  .prose-toc a {
    /* A 44px row at least (the studio's touch bar; a tablet in landscape
       shows this list): the padding alone made 42px. */
    display: flex;
    align-items: center;
    min-height: var(--tap);
    margin-left: -1px;
    padding: 0.7rem 0 0.7rem var(--spacing-m);
    border-left: 2px solid transparent;
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .prose-toc a:hover,
  .prose-toc a:focus-visible {
    color: var(--link);
  }
  .prose-toc a[aria-current='true'] {
    border-left-color: var(--marker);
    font-weight: 600;
    color: var(--link);
  }

  .prose-body {
    max-width: 44rem;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--foreground);
  }
  .prose-section + .prose-section {
    margin-top: var(--spacing-xl);
  }
  /* scroll-margin keeps an anchored heading clear of the sticky site header. */
  .prose-h2 {
    margin-bottom: var(--spacing-s);
    scroll-margin-top: 6rem;
    font-size: var(--text-h3);
  }
  .prose-h3 {
    margin: var(--spacing-l) 0 var(--spacing-xs);
    scroll-margin-top: 6rem;
    font-size: var(--text-h4);
  }
  .prose-body :global(p) {
    margin-bottom: var(--spacing-m);
  }
  .prose-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .prose-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  /* The dash list: a short china-marker dash in front of each item. */
  .prose-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s);
    margin: 0 0 var(--spacing-m);
    padding: 0;
    list-style: none;
  }
  .prose-list > :global(li) {
    position: relative;
    padding-left: 1.75rem;
  }
  .prose-list > :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 1rem;
    height: 2px;
    background: var(--marker);
  }
  .prose-list--ordered {
    list-style: decimal;
    padding-left: var(--spacing-l);
  }
  .prose-list--ordered > :global(li) {
    padding-left: 0;
  }
  .prose-list--ordered > :global(li)::before {
    content: none;
  }

  /* ---- ledger layout ---- */
  .ledger {
    display: flex;
    flex-direction: column;
    margin: 0;
  }
  .ledger-row {
    display: grid;
    gap: var(--spacing-s);
    padding-block: var(--spacing-l);
    border-top: 1px solid var(--border);
  }
  @media (min-width: 48rem) {
    .ledger-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--spacing-l);
    }
  }
  .ledger dt {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    line-height: 1.05;
    letter-spacing: 0.015em;
    color: var(--heading);
  }
  .ledger dd {
    max-width: 60ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--foreground);
  }
  .ledger-close {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-m) var(--spacing-l);
  }
</style>
