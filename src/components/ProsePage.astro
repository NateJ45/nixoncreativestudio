---
// Foundation, edit with care. Draws /privacy, /accessibility and /colophon from
// one CMS entry each (docs/CMS-DESIGN.md 1.10). The class strings below are the
// ones the three hand-written pages carried; they are kept byte for byte so the
// move to the CMS changed no pixel (checked with the render-parity harness).
/* ============================================================================
   ProsePage
   ============================================================================
   One template for the long-text pages. The route (src/pages/privacy.astro and
   its two siblings) reads its `pages` entry with getProsePage() and hands the
   result here; this component wraps it in BaseLayout and picks a layout:

   DOCUMENT (page.showToc true: Privacy, Accessibility)
     A small label, the headline, the lead paragraph and a "Last updated" badge,
     then two columns on wide screens: a sticky "On this page" list (built from
     the body's Heading 2s, so it can never drift from the headings) beside the
     prose. A tiny scroll-spy script marks the section in view with aria-current.
     It is purely additive: without JS the list is plain anchor links. Each block
     reveals on scroll through the global data-reveal system (reduced-motion safe
     and, because it is below the first block of <main>, exempt from the LCP rule
     in CLAUDE.md gotcha 10).

   LEDGER (page.showToc false: Colophon)
     The headline and lead paragraph over a ruled label/detail list, closing on
     the "Start a project / See the work" links. `extraRows` are appended after
     the CMS rows (the Colophon's computed "Last built" row lives in code).

   The body arrives as trusted HTML strings (src/lib/prosePage.ts builds them
   from restricted Portable Text), so paragraphs and list items are set with
   set:html.

   Page script: registers on astro:page-load with the dataset re-bind guard so it
   survives View Transitions navigations (the footer links are the usual way in).
   ============================================================================ */

import BaseLayout from '../layouts/BaseLayout.astro';
import { buttonVariants } from './ui/button';
import { getSite } from '../data/site';
import { lastUpdatedLabel, proseTitle, type ProsePage, type ProseRow } from '../lib/prosePage';

interface Props {
  page: ProsePage;
  /** Rows added after the CMS rows (ledger layout only). */
  extraRows?: ProseRow[];
}

const { page, extraRows = [] } = Astro.props;
const site = await getSite(Astro);

// The on-this-page list: only sections that have a heading (text before the first
// Heading 2 forms a heading-less section and gets no entry).
const tocSections = page.sections.filter((s) => s.heading);
const headingId = `${page.slug}-heading`;
const allRows = [...page.rows, ...extraRows];
const updated = page.lastUpdated ? lastUpdatedLabel(page.lastUpdated) : undefined;

// Inline h2 styling: h3 visual size, since the page already has an h1. scroll-mt
// keeps an anchored heading clear of the sticky site header.
const h2Class = 'mb-s text-h3 text-heading scroll-mt-[6rem]';
const h3Class = 'mb-xs mt-l text-lg font-semibold text-heading scroll-mt-[6rem]';
const pClass = 'mb-m last:mb-0';
---

<BaseLayout title={proseTitle(page.title, site.studioName)} description={page.summary}>
  <section class="py-2xl" aria-labelledby={headingId}>
    {page.showToc ? (
      <div class="ncs-container">
        <header class="mb-xl flex max-w-[70ch] flex-col gap-m" data-reveal>
          {page.eyebrow && <p class="font-mono text-sm text-text-muted">{page.eyebrow}</p>}
          <h1 id={headingId} class="leading-[0.95]">
            {page.heading}
          </h1>
          {page.intro.map((html) => (
            <p class="text-lg leading-[1.6] text-text" set:html={html} />
          ))}
          {updated && (
            <p>
              <span class="inline-flex items-center gap-xs rounded-full border border-border bg-bg-soft px-s py-xs text-sm text-text-muted">
                <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true" />
                Last updated {updated}
              </span>
            </p>
          )}
        </header>

        <div class="flex flex-col gap-xl lg:flex-row lg:items-start lg:gap-2xl">
          {tocSections.length > 0 && (
            <nav
              class="hidden shrink-0 lg:sticky lg:top-[6rem] lg:block lg:w-56"
              aria-label="On this page"
              data-prose-toc
              data-reveal="left"
            >
              <p class="mb-s text-sm tracking-[0.16em] text-text-muted uppercase">On this page</p>
              <ul class="gap-2xs flex flex-col border-l border-border">
                {tocSections.map((s) => (
                  <li>
                    <a
                      href={`#${s.id}`}
                      data-toc-link={s.id}
                      class={
                        'py-2xs block border-l-2 border-transparent pl-m text-[0.95rem] ' +
                        'text-text-muted transition-colors duration-200 ' +
                        'hover:text-link focus-visible:text-link ' +
                        'aria-[current=true]:border-accent aria-[current=true]:font-semibold ' +
                        'aria-[current=true]:text-link'
                      }
                      style="margin-left: -1px;"
                    >
                      {s.heading}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          <div class="max-w-[70ch] text-[1.0625rem] leading-[1.7] text-text">
            {page.sections.map((s, index) => (
              <div class={index === 0 ? 'mt-0' : 'mt-xl'} data-reveal>
                {s.heading && (
                  <h2 id={s.id} class={h2Class}>
                    {s.heading}
                  </h2>
                )}
                {s.blocks.map((b) => {
                  if (b.kind === 'h3') {
                    return (
                      <h3 id={b.id} class={h3Class}>
                        {b.text}
                      </h3>
                    );
                  }
                  if (b.kind === 'list' && b.ordered) {
                    return (
                      <ol class="mb-m flex list-decimal flex-col gap-s pl-l">
                        {b.items.map((item) => (
                          <li set:html={item} />
                        ))}
                      </ol>
                    );
                  }
                  if (b.kind === 'list') {
                    // The amber-dash tick list (the ledger motif used on About).
                    return (
                      <ul class="mb-m flex flex-col gap-s">
                        {b.items.map((item) => (
                          <li class="flex items-start gap-s">
                            <span
                              class="mt-[0.6em] h-[2px] w-4 shrink-0 bg-tertiary"
                              aria-hidden="true"
                            />
                            <span set:html={item} />
                          </li>
                        ))}
                      </ul>
                    );
                  }
                  return <p class={pClass} set:html={b.html} />;
                })}
              </div>
            ))}

            {updated && (
              <p
                class="mt-xl border-t border-border pt-l text-[0.95rem] text-text-muted italic"
                data-reveal="fade"
              >
                Last updated: {updated}.
              </p>
            )}
          </div>
        </div>
      </div>
    ) : (
      <div class="ncs-container flex flex-col gap-l">
        <header class="flex max-w-[60ch] flex-col gap-xs" data-reveal>
          <h1 id={headingId}>{page.heading}</h1>
          {page.intro.map((html) => (
            <p class="text-lg leading-[1.55] text-text-muted" set:html={html} />
          ))}
        </header>

        {/* Ruled label/detail list, matching the /about principles pattern so the
              page reads as authored rather than scaffolded. */}
        <dl class="mt-l flex flex-col">
          {allRows.map((row, index) => (
            <div
              class="grid gap-s border-t border-border py-l md:grid-cols-[1fr_2fr] md:gap-l"
              data-reveal
              style={`--reveal-delay: ${index * 80}ms;`}
            >
              <dt class="font-mono text-[0.8rem] tracking-[0.08em] text-text-muted uppercase">
                {row.label}
              </dt>
              <dd class="max-w-[60ch] leading-[1.7] text-text">{row.detail}</dd>
            </div>
          ))}
        </dl>

        {/* Quiet close, funnels onward like the rest of the site. */}
        <div
          class="mt-l flex flex-wrap items-center gap-m border-t border-border pt-2xl"
          data-reveal
        >
          <a
            href="/contact"
            class={buttonVariants({ variant: 'brand', size: 'cta', className: 'shine' })}
          >
            Start a project
          </a>
          <a class="card-link text-lg" href="/work/">
            See the work
          </a>
        </div>
      </div>
    )}
  </section>

  <script>
    // Scroll-spy: marks the "On this page" link for the section in view with
    // aria-current. Purely additive. With no JS or no IntersectionObserver the
    // list stays a set of working anchor links and the prose is untouched. It
    // adds no motion of its own, so there is nothing to gate for reduced motion.
    // Wrapped in astro:page-load so it re-binds after a View Transitions
    // navigation; the dataset flag keeps it from observing twice.
    function initProseToc() {
      const toc = document.querySelector<HTMLElement>('nav[aria-label="On this page"]');
      if (!toc || toc.dataset.spyBound || !('IntersectionObserver' in window)) return;
      toc.dataset.spyBound = 'true';

      const links = new Map<string, HTMLAnchorElement>();
      toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((a) => {
        const id = a.getAttribute('data-toc-link');
        if (id) links.set(id, a);
      });
      if (links.size === 0) return;

      // Track which sections are currently intersecting; the topmost one wins.
      const visible = new Set<string>();

      const setCurrent = (id: string | null) => {
        links.forEach((a, key) => {
          if (key === id) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const id = entry.target.id;
            if (entry.isIntersecting) visible.add(id);
            else visible.delete(id);
          }
          // Pick the visible section nearest the top of the document order.
          let topId: string | null = null;
          for (const id of links.keys()) {
            if (visible.has(id)) {
              topId = id;
              break;
            }
          }
          setCurrent(topId);
        },
        // Bias the active zone toward the upper portion of the viewport so a
        // heading is marked current as it reaches reading position.
        { rootMargin: '-20% 0px -65% 0px', threshold: 0 },
      );

      links.forEach((_, id) => {
        const heading = document.getElementById(id);
        if (heading) observer.observe(heading);
      });
    }
    document.addEventListener('astro:page-load', initProseToc);
    initProseToc();
  </script>
</BaseLayout>
