---
/* A client's window. A phone by default; with `desk` a large desktop browser
   window showing the real page (/work/ and the lean sector pages). A real link to
   their case study; with JavaScript a click opens the client sheet instead, unless
   `direct` keeps it a plain link. The footage is only fetched when something asks
   the window to play. */
import { LOCK, TOOLS } from '../lib/window-chrome';
import type { Client } from '../lib/clients';

interface Props {
  client: Client;
  /** Place in the deck, written to data-i. */
  index?: number;
  lazy?: boolean;
  direct?: boolean;
  /** A different picture on the screen and no footage (the churches' long pages). */
  long?: string;
  /** The desktop capture and footage, in a wide window. */
  desk?: boolean;
  /** The phone still's `sizes`: the tile's CSS width where it sits. The default is a loose fit. */
  sizes?: string;
}
const {
  client: s,
  index,
  lazy = false,
  direct = false,
  long,
  desk = false,
  sizes = '(max-width: 480px) 60vw, 346px',
} = Astro.props;
---

<a
  class:list={['tile', { desk }]}
  href={s.study}
  data-slug={s.slug}
  data-direct={direct ? '' : undefined}
  data-i={index}
  aria-label={`${s.name}, ${s.host}: ${s.hook}`}
  style={`--c:${s.accent};--p:${s.paper}`}
>
  <span class="b-top" aria-hidden="true">
    <span class="url">
      <Fragment set:html={LOCK} />
      <span>{s.host}</span>
    </span>
  </span>
  <span class="scr" aria-hidden="true">
    {long ? (
      <img src={long} alt="" loading={lazy ? 'lazy' : 'eager'} />
    ) : desk ? (
      <>
        <img
          src={s.deskStill}
          alt=""
          loading={lazy ? 'lazy' : 'eager'}
          decoding="async"
          width="1000"
          height="750"
        />
        <video muted loop playsinline preload="none" data-src={s.desk} />
      </>
    ) : (
      <>
        <img
          src={s.still}
          srcset={s.stillSet}
          sizes={sizes}
          alt=""
          loading={lazy ? 'lazy' : 'eager'}
          width="584"
          height="1138"
        />
        <video muted loop playsinline preload="none" data-src={s.clip} />
      </>
    )}
  </span>
  {!desk && (
    <span class="b-bot" aria-hidden="true">
      <Fragment set:html={TOOLS} />
    </span>
  )}
</a>
