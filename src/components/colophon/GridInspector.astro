---
// Safe to edit.
/* ============================================================================
   GridInspector: "Show the grid" (overhaul package 3.4, signature E)
   ============================================================================
   A button that lays the site's 12-column .page-grid over the whole page, so
   you can see the rail (columns 1 to 3), the prose measure (4 to 10) and the
   body (4 to 12) line up with what is on screen.

   The overlay uses the real .ncs-container and .page-grid classes, so it is
   the grid, not a drawing of it: change the grid in globals.css and the
   overlay follows. It is fixed to the viewport, pointer-events: none (every
   link under it still works) and aria-hidden (it is a picture of the layout,
   not content).

   Button only (Part A decision 18): no keyboard shortcut, because a single
   key would fail WCAG 2.1.4 and a modifier combination is one more thing to
   learn. The button is a real <button> with aria-pressed and a constant name,
   so Tab, Enter and Space work and a screen reader hears "pressed". It is
   hidden without JavaScript. The overlay is appended to <body> and removed
   on astro:before-swap, so it never follows a navigation. Nothing animates.
   ============================================================================ */
---

<div class="inspector" data-grid-inspector>
  <button type="button" class="inspector-button" aria-pressed="false" data-grid-toggle>
    <span class="inspector-mark" aria-hidden="true"></span>
    Show the grid
  </button>
</div>

<script>
  const OVERLAY_ID = 'grid-inspector-overlay';

  function buildOverlay(): HTMLElement {
    const overlay = document.createElement('div');
    overlay.id = OVERLAY_ID;
    overlay.className = 'grid-overlay';
    overlay.setAttribute('aria-hidden', 'true');
    overlay.dataset.gridOverlay = '';
    const container = document.createElement('div');
    container.className = 'ncs-container page-grid grid-overlay-grid';
    for (let i = 1; i <= 12; i += 1) {
      const col = document.createElement('div');
      col.className = 'grid-overlay-col';
      col.style.gridColumn = `${i} / span 1`;
      const n = document.createElement('span');
      n.textContent = String(i);
      col.append(n);
      container.append(col);
    }
    overlay.append(container);
    return overlay;
  }

  function initGridInspector() {
    const root = document.querySelector<HTMLElement>('[data-grid-inspector]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = 'true';
    const button = root.querySelector<HTMLButtonElement>('[data-grid-toggle]');
    if (!button) return;

    const set = (on: boolean) => {
      button.setAttribute('aria-pressed', String(on));
      document.getElementById(OVERLAY_ID)?.remove();
      if (on) document.body.append(buildOverlay());
    };

    button.addEventListener('click', () => {
      set(button.getAttribute('aria-pressed') !== 'true');
    });

    // Never carry the overlay to the next page.
    document.addEventListener('astro:before-swap', () => set(false), { once: true });
  }

  document.addEventListener('astro:page-load', initGridInspector);
  initGridInspector();
</script>

<style>
  .inspector {
    margin-bottom: var(--spacing-m);
  }
  .inspector-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-link);
    font-weight: 600;
    cursor: pointer;
  }
  .inspector-button:hover,
  .inspector-button:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .inspector-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* The pressed state is more than colour: the mark fills and the edge thickens. */
  .inspector-mark {
    width: 0.9rem;
    height: 0.9rem;
    border: 1.5px solid currentColor;
    border-radius: 2px;
    background-image: linear-gradient(
      90deg,
      currentColor 0 1.5px,
      transparent 1.5px calc(50% - 0.75px),
      currentColor calc(50% - 0.75px) calc(50% + 0.75px),
      transparent calc(50% + 0.75px)
    );
  }
  .inspector-button[aria-pressed='true'] {
    border-width: 2px;
    border-color: var(--color-link);
  }
  .inspector-button[aria-pressed='true'] .inspector-mark {
    background: currentColor;
  }
  :global(html:not(.js)) .inspector {
    display: none;
  }

  /* The overlay lives on <body>, outside this component, so its rules are global. */
  :global(.grid-overlay) {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
  }
  :global(.grid-overlay-grid) {
    height: 100%;
  }
  :global(.grid-overlay-col) {
    min-width: 0;
    background: color-mix(in srgb, var(--live) 10%, transparent);
    border-inline: 1px solid color-mix(in srgb, var(--live) 45%, transparent);
  }
  /* The column number sits on a solid chip of the page colour, so the amber
     text keeps its AA contrast over the tint (axe checks it). */
  :global(.grid-overlay-col span) {
    display: block;
    width: fit-content;
    margin: 5.5rem auto 0;
    padding: 0 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-align: center;
    color: var(--live);
    background: var(--background);
  }
  @media (forced-colors: active) {
    :global(.grid-overlay-col) {
      border-inline: 1px solid CanvasText;
    }
  }
</style>
