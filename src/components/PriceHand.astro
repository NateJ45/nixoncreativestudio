---
/* The three price cards, from src/data/pricing.ts. Each is lettered in its
   corners like a face card. On a wide screen kit.js deals them out of one stack
   into a fan; on a phone CSS stacks them.

   Each card turns over (src/scripts/price-turn.js, src/styles/price-turn.css): a real
   "Turn over" button under the price shows the back, which lists what that tier includes,
   word for word from `features` in pricing.ts, with a link to the tier and "Turn back". It is
   the same turn as About's "Off the clock" cards: the face you cannot see is inert, focus
   moves to the back and returns to the button. The front is still the link it always was, so
   the card still grows into its tier on the Prices page (src/scripts/price-morph.js picks
   `a.pc-face`). Without JavaScript the button and the back are not shown and the card is the
   plain link. */
import '../styles/price-turn.css';
import { webTiers } from '../data/pricing';
import { money } from '../lib/money';

const faces = ['paper', 'blue', 'ink'];
---

<ul class="hand" data-prices data-track-view="pricing_view" data-track-variant="teaser">
  {webTiers.map((t, i) => {
    const key = t.name.toLowerCase();
    return (
      <li class={`pc pc-${faces[i]}`} style={`--i:${i}`} data-pt>
        <div class="pt-card">
          <a href={`/services/#${key}`} class="pc-face">
            <span class="pip" aria-hidden="true">
              {t.name.charAt(0)}
            </span>
            <span class="pip flip" aria-hidden="true">
              {t.name.charAt(0)}
            </span>
            <h3 class="label">{t.name}</h3>
            <strong>{money(t.priceFrom)}</strong>
            <span class="pc-who">
              Starting price.
              <br />
              {t.who}.
            </span>
          </a>
          <button
            type="button"
            class="pt-turn"
            aria-expanded="false"
            aria-controls={`pt-${key}`}
            data-pt-turn
            data-cursor="Turn"
          >
            Turn over <span class="vh">the {t.name} card</span>
          </button>
          <div
            class="pt-back keyed"
            id={`pt-${key}`}
            role="group"
            aria-label={`${t.name}, what it includes`}
            tabindex="-1"
          >
            <p class="label">{t.name} includes</p>
            <ul>
              {t.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <div class="pt-foot">
              <a href={`/services/#${key}`} data-peek="off">
                See {t.name}
              </a>
              <button type="button" class="pt-turn" data-pt-back data-cursor="Turn">
                Turn back
              </button>
            </div>
          </div>
        </div>
      </li>
    );
  })}
</ul>

<script>
  import '../scripts/price-turn.js';
</script>
