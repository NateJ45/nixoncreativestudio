---
/* Microsoft Clarity's project id, for src/lib/clarity.ts (run from BaseLayout's script bundle).
   Rendered by Analytics.astro only when PUBLIC_CLARITY_ID is set. A meta tag rather than an
   inline script: every inline script costs a hash in the CSP line, which Cloudflare caps at
   2,000 characters. The rules for when Clarity runs live in src/lib/clarity.ts. */
interface Props {
  clarityId: string;
}
const { clarityId } = Astro.props;
---

<meta name="ncs-clarity" content={clarityId} />
