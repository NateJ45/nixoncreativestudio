---
/* ============================================================================
   Google Analytics 4 (gtag.js), loaded after the page is idle
   ============================================================================
   Foundation, edit with care.

   The dataLayer + gtag() stub exist immediately, so anything that calls
   gtag() before the library arrives is queued rather than lost. The
   ~100KB gtag.js itself loads AFTER the load event and at idle: the
   2026-09-04 Lighthouse pass moved everything else off the mobile critical
   path. Nothing about page views changes; GA4 records the view when the
   script arrives, a second or so later.

   Rendered by Analytics.astro only when PUBLIC_GA_ID looks like a real
   Measurement ID. Its own component because prettier-plugin-astro cannot
   parse a <script> nested inside a template expression; Analytics.astro
   keeps the condition and this file keeps the script at the top level.
   ============================================================================ */

interface Props {
  /** The GA4 web data stream Measurement ID (G-XXXXXXXXXX). */
  gaId: string;
}
const { gaId } = Astro.props;
---

<script is:inline define:vars={{ gaId }}>
  window.dataLayer = window.dataLayer || [];
  // gtag.js requires a real `arguments` object here (it type-checks it), so
  // rest parameters would silently break every queued call.
  function gtag() {
    // eslint-disable-next-line prefer-rest-params
    window.dataLayer.push(arguments);
  }
  window.gtag = gtag;
  gtag('js', new Date());
  gtag('config', gaId);

  function loadGa() {
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
    document.head.appendChild(s);
  }
  function whenIdle() {
    if ('requestIdleCallback' in window) requestIdleCallback(loadGa, { timeout: 4000 });
    else setTimeout(loadGa, 500);
  }
  if (document.readyState === 'complete') whenIdle();
  else window.addEventListener('load', whenIdle, { once: true });
</script>
