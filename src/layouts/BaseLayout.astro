---
/* ============================================================================
   Base Layout
   ============================================================================
   The shell every page renders inside. Owns the document <head>, the
   global stylesheet import, the Header, the Footer, and any sitewide
   bookkeeping like analytics and font preloads.

   Page-specific content goes in the <slot /> inside <main>.
   ============================================================================ */

import '../styles/globals.css';
// Starwind UI supplementary CSS. Imported AFTER globals.css so globals owns
// the :root semantic tokens and the @custom-variant dark rule, and
// this file only adds the accordion keyframes plus @theme inline mappings for
// the Starwind-only tokens (--outline and the status colors). See the file
// header in starwind.css for the split.
import '../styles/starwind.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import BackToTop from '../components/BackToTop.astro';
import StructuredData from '../components/StructuredData.astro';
import ComingSoon from '../components/ComingSoon.astro';
import ComingSoonGate from '../components/ComingSoonGate.astro';
import { getSite } from '../data/site';
import { cachePublicPage } from '../lib/routeCache';

// Astro View Transitions. Wires same-origin link clicks into the browser's
// View Transitions API for a smooth fade between pages instead of a hard
// reload. Same-origin navigation only; external links work as normal.
import { ClientRouter } from 'astro:transitions';

// Font preloads (DESIGN.md "Type"). The ?url query hands back the hashed public
// path of the SAME file globals.css's @font-face points at, so the preload and
// the stylesheet's fetch are one request.
//
// Preloaded on every page: Bebas Neue (every headline, the wordmark-sized
// numerals; often the LCP text) and Newsreader regular (all body copy; without
// it the swap from the fallback relays real text, which is what pushed CLS to
// 0.17 on /work in 2026-09 with the old body face). The fallbacks are
// metric-matched in globals.css, so even a late swap barely moves anything.
//
// Opt-in per page with preloadFonts: 'italic' (a page whose first screen sets
// the italic second voice, like the home hero) and 'semibold' (bold body copy
// above the fold). Preload only what the first screen uses: each file is
// about 24 KB on the simulated slow-4G link.
import bebasWoff2 from '../assets/fonts/bebas-neue-latin-400.woff2?url';
import newsreaderWoff2 from '../assets/fonts/newsreader-latin-400.woff2?url';
import newsreaderItalicWoff2 from '../assets/fonts/newsreader-latin-400-italic.woff2?url';
import newsreaderSemiboldWoff2 from '../assets/fonts/newsreader-latin-600.woff2?url';

// Coming-soon gate. Implemented client-side so the owner can bypass
// per-device by visiting a magic URL, while everyone else lands on
// the ComingSoon view. See ComingSoonGate.astro (rendered further down in
// <head>) for the runtime logic.
//
// PUBLIC_COMING_SOON=true at build time:
//   - Every page ships with BOTH the real content (Header / Main /
//     Footer) AND the ComingSoon overlay div.
//   - A blocking inline <script> in <head> adds class="ncs-gated" to
//     <html> unless the visitor's localStorage carries the bypass
//     token (or the current URL contains ?preview=<TOKEN>).
//   - CSS in globals.css hides everything but .ncs-overlay when
//     html.ncs-gated is present, and hides .ncs-overlay otherwise.
//   - <meta name="robots" content="noindex"> ships so search engines
//     don't index the WIP content while gated.
//
// PUBLIC_COMING_SOON unset (or anything other than "true") at build time:
//   - No overlay, no gating script, no noindex. Normal site.
//
// PUBLIC_PREVIEW_TOKEN is the bypass secret. Visit any page with
// ?preview=<PUBLIC_PREVIEW_TOKEN> once and the script saves it to
// localStorage; from then on, that browser bypasses on every page.
//
// PUBLIC_ prefix on both: required because they're read at build
// time AND inlined into the client script. The token is technically
// visible in shipped HTML for anyone viewing source — soft gate, not
// security. For real auth, use Cloudflare Access at the DNS layer.
const comingSoonEnabled = import.meta.env.PUBLIC_COMING_SOON === 'true';
const previewToken = import.meta.env.PUBLIC_PREVIEW_TOKEN || '';

interface Props {
  title: string;
  description?: string;
  /** Open Graph image URL. Defaults to the site-wide OG image in
      public/. Pages with a richer hero (case studies) pass their own
      cover so social shares render the project's actual artwork. */
  ogImage?: string;
  /** Override the default og:type. Case study detail pages set this to
      "article" so platforms that treat articles specially (search,
      readers) render them correctly. */
  ogType?: 'website' | 'article';
  /** Page-specific schema.org JSON-LD blocks. Layered on top of the
      site-wide Organization schema by StructuredData. Used by About
      (Person), case study detail pages (Article + CreativeWork),
      /services (Service + FAQPage). */
  schemas?: Array<Record<string, unknown>>;
  /** Extra fonts to preload because this page's first screen uses them
      (see the font note at the top of this file). */
  preloadFonts?: Array<'italic' | 'semibold'>;
  /** Robots directive for this page ("noindex, follow"). Leave unset for an
      indexable page. Used by /photography while its gallery is empty
      (src/lib/photos.ts photographyRobots). The Coming Soon gate's own
      noindex wins when it is on. */
  robots?: string;
}
// Site settings (studio name, default description, feed title) come from the
// CMS, with the committed fallback; the Header, Footer and StructuredData share
// this one read through getSite()'s per-request memo.
const site = await getSite(Astro);

const {
  title,
  description = site.defaultDescription,
  ogImage,
  ogType = 'website',
  schemas = [],
  preloadFonts = [],
  robots,
} = Astro.props;

// Build a canonical URL for the current page so og:url and JSON-LD have
// the right absolute reference. Astro.url is the live request URL in
// dev and the resolved page URL at build time.
const canonical = new URL(Astro.url.pathname, site.url).toString();

// Route cache (CMS-DESIGN PR 2). Every page that renders inside this layout is
// cacheable at Cloudflare's edge for a day; the CMS readers add the tags that
// purge it when Nathan publishes an edit. See src/lib/routeCache.ts. The status
// check keeps the 404 page (which renders in this layout) out of the cache, so a
// page published later never hits a stored 404.
if ((Astro.response.status ?? 200) < 400) cachePublicPage(Astro.cache, Astro.url);

// Per-page Open Graph card. Derived from the pathname to match the images
// generated by src/pages/og/[...route].ts ('' becomes 'index'), so every page
// gets its own branded card. An explicit ogImage prop still overrides, and
// any path without a generated card would 404 the image, so the known routes
// are kept in sync with STATIC_PAGES in that route file. The default OG
// (public/og-default.png) remains as a manual fallback if a prop passes it.
const ogSlug = Astro.url.pathname.replace(/^\/+|\/+$/g, '') || 'index';
const resolvedOgImage = ogImage ?? `/og/${ogSlug}.png`;
const ogImageUrl = new URL(resolvedOgImage, site.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover lets the navy hero and footer run edge-to-edge into
         the notch / rounded-corner area on modern phones. The safe-area insets
         that pairs with (so content never sits under the notch or home
         indicator) are handled in .ncs-container, the sticky header, the mobile
         nav panel, the footer, and the fixed back-to-top / lightbox controls. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Canonical URL. Tells search engines the authoritative location
         for this page, even if it's reached through alternate query
         strings or aliased paths. -->
    <link rel="canonical" href={canonical} />

    {/* Favicon / app-icon set. The mark is a white Bebas "N" on a navy squircle
        with one amber spark, generated from the real wordmark glyph by
        scripts/generate-icons.mjs (run `npm run icons` after a brand change).
        Modern browsers take the SVG; the .ico is the legacy fallback; iOS uses
        the apple-touch PNG; the manifest carries the PWA / maskable icons.
        theme-color is the paper the page and the header sit on. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f3eee4" />

    {(comingSoonEnabled || robots) && (
      <meta name="robots" content={comingSoonEnabled ? 'noindex, follow' : robots} />
    )}

    {/* The blocking gate script itself lives in ComingSoonGate.astro (a
        <script> cannot sit inside this expression: prettier-plugin-astro
        cannot parse it there). */}
    {comingSoonEnabled && <ComingSoonGate previewToken={previewToken} />}

    <!-- RSS auto-discovery. Lets feed readers (and browser extensions
         that detect feeds) pick up /rss.xml without manual entry. -->
    <link rel="alternate" type="application/rss+xml" title={site.rssTitle} href="/rss.xml" />

    <!-- Open Graph + Twitter card meta. Drives the rich preview that
         appears when the URL is shared on Slack, iMessage, LinkedIn, etc.
         Pages that pass an `ogImage` prop (typically case studies, using
         their cover) get a project-specific preview; everything else
         falls back to the site-wide default in public/og-default.png. -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={site.studioName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!--
      JS marker. Runs synchronously before <body> paints and adds .js to <html>,
      so CSS can scope the scroll-reveal hidden state to visitors who have
      JavaScript (without it every [data-reveal] element stays visible). The
      site has one art-directed theme since the 2026 redesign: there is no dark
      mode, no theme toggle and no stored theme preference any more.
      data-astro-rerun re-applies it after a View Transitions swap.
    -->
    <script is:inline data-astro-rerun>
      document.documentElement.classList.add('js');
    </script>
    <!-- Font preloads (see the note in the frontmatter). crossorigin is
         required: without it the preload and the stylesheet's font fetch are
         different requests and the font downloads twice. -->
    <link rel="preload" as="font" type="font/woff2" href={bebasWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={newsreaderWoff2} crossorigin />
    {preloadFonts.includes('italic') && (
      <link rel="preload" as="font" type="font/woff2" href={newsreaderItalicWoff2} crossorigin />
    )}
    {preloadFonts.includes('semibold') && (
      <link rel="preload" as="font" type="font/woff2" href={newsreaderSemiboldWoff2} crossorigin />
    )}

    <!-- Cloudflare Web Analytics. Component renders the beacon script
         only when PUBLIC_CF_ANALYTICS_TOKEN is set, so local dev and any
         deploy without the token simply emits nothing. -->
    <Analytics />

    <!-- Astro View Transitions. Renders in <head> so the client router
         is in place before the first navigation. -->
    <ClientRouter />

    <!-- schema.org JSON-LD. Always emits the studio's Organization /
         LocalBusiness blocks; pages can layer in per-page schemas
         (Article for case studies, Service for /services, etc.) via
         the schemas prop. -->
    <StructuredData extra={schemas} />
  </head>
  <body>
    <!--
      Hello, curious visitor. This site is custom-built by Nathan Nixon on Astro,
      Tailwind, and Cloudflare, no page builder and no template. How it is made:
      /colophon. Want one like it: /contact.
    -->

    <!--
      Skip link. Hidden off-screen until it receives focus (Tab from the
      address bar), then jumps into view at top-left. Lets keyboard and
      screen reader users bypass the header / nav and land directly on
      page content. The href targets the <main id="main"> below.
    -->
    <a
      href="#main"
      class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-2 focus-visible:left-2 focus-visible:z-50 focus-visible:rounded-md focus-visible:bg-primary focus-visible:px-3 focus-visible:py-2 focus-visible:font-body focus-visible:text-sm focus-visible:font-semibold focus-visible:text-primary-foreground focus-visible:no-underline focus-visible:ring-3 focus-visible:ring-accent/50"
    >
      Skip to main content
    </a>

    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    {/* Floating back-to-top button: plain HTML plus a few lines of script, so
        no framework loads for it. Appears after 600px of scroll. */}
    <BackToTop />

    {comingSoonEnabled && (
      <div class="ncs-overlay" aria-label="Launching soon">
        <ComingSoon />
      </div>
    )}

    {/* No smooth-scroll library: scrolling is the browser's own (decided 2026-10-04). */}
    <!--
      Progressive enhancement layer. Wires the declarative data-* effects
      (cursor spotlight, count-up numbers, scroll-aware header)
      on every page including View Transitions navigations. Everything it does
      is optional polish: the page is fully functional without it, and each
      effect self-disables under prefers-reduced-motion or coarse pointers.
    -->
    <script>
      import '../scripts/enhance';
    </script>
    <!--
      Grounds: attaches the ground textures after the load event (so they never
      delay LCP) and pauses a moving ground while it is off screen. See
      src/scripts/grounds.ts and DESIGN.md "Grounds".
    -->
    <script>
      import '../scripts/grounds';
    </script>
    <!--
      Mailto graceful fallback. A mailto: link only opens anything if the device
      has a mail app registered for it; without one (common on desktops) the
      click is a silent dead-end. This watches for that case and, when nothing
      opens, copies the address and shows a confirmation toast. It never blocks
      the real mailto for visitors who do have a mail app. See the script header.
    -->
    <script>
      import '../scripts/mailto-fallback';
    </script>
    <!--
      Scroll-reveal observer. Reveals every [data-reveal] element as it
      enters the viewport by toggling .is-visible (styled in globals.css,
      section 8). Re-runs on every View Transitions navigation via the
      astro:page-load event, which fires on the initial load too, so the
      listener registered once here covers all pages.

      Accessibility: when the visitor prefers reduced motion (or the browser
      lacks IntersectionObserver), every tagged element is shown immediately,
      so nothing depends on motion to appear.
    -->
    <script>
      function initReveal() {
        const els = Array.from(document.querySelectorAll('[data-reveal]:not(.is-visible)'));
        if (!els.length) return;

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );

        els.forEach((el) => io.observe(el));
      }

      document.addEventListener('astro:page-load', initReveal);
    </script>
    <!-- A quiet hello in the console for anyone who opens dev tools. Honest:
         the real stack, with pointers to the colophon and contact. -->
    <script is:inline>
      console.log(
        '%cNixon Creative Studio',
        'font: 600 16px ui-sans-serif, system-ui; color: #ae2f1b;',
      );
      console.log(
        'Hand-built on Astro, Tailwind, and Cloudflare. How it is made: /colophon  ·  Want one like it: /contact',
      );
    </script>
  </body>
</html>
