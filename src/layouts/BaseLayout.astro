---
/* ============================================================================
   Base Layout
   ============================================================================
   The shell every page renders inside. Owns the document <head> (title,
   description, canonical, Open Graph and share cards, JSON-LD, analytics, the
   Coming Soon gate) and the chrome: the top line, the floating dock and the
   client sheet. A page brings its own content and usually ends on <Closing />.

   One light theme. Every other color on the site is a client's. The design rules
   are in DESIGN.md; the shared look is src/styles/kit.css, and each page imports
   its own stylesheet from src/styles/pages/.

   Navigation between pages is a normal page load with a cross-document view
   transition (the @view-transition rule in kit.css), so scripts just run on load.
   ============================================================================ */

import '../styles/kit.css';
import TopLine from '../components/TopLine.astro';
import Dock from '../components/Dock.astro';
import ClientSheet from '../components/ClientSheet.astro';
import Analytics from '../components/Analytics.astro';
import StructuredData from '../components/StructuredData.astro';
import ComingSoon from '../components/ComingSoon.astro';
import ComingSoonGate from '../components/ComingSoonGate.astro';
import { site } from '../data/site';
import type { Crumb, Node } from '../lib/schema';

// Coming-soon gate. Implemented client-side so the owner can bypass per-device
// by visiting a magic URL, while everyone else lands on the ComingSoon view. See
// ComingSoonGate.astro (rendered further down in <head>) for the runtime logic.
//
// PUBLIC_COMING_SOON=true at build time:
//   - Every page ships with BOTH the real content AND the ComingSoon overlay div.
//   - A blocking inline <script> in <head> adds class="ncs-gated" to <html>
//     unless the visitor's localStorage carries the bypass token (or the current
//     URL contains ?preview=<TOKEN>).
//   - CSS in kit.css hides everything but .ncs-overlay when html.ncs-gated is
//     present, and hides .ncs-overlay otherwise.
//   - <meta name="robots" content="noindex"> ships so search engines don't index
//     the WIP content while gated.
//
// PUBLIC_COMING_SOON unset (or anything other than "true") at build time:
//   - No overlay, no gating script, no noindex. Normal site.
//
// PUBLIC_PREVIEW_TOKEN is the bypass secret. PUBLIC_ prefix on both: required
// because they're read at build time AND inlined into the client script. Soft
// gate, not security. For real auth, use Cloudflare Access at the DNS layer.
const comingSoonEnabled = import.meta.env.PUBLIC_COMING_SOON === 'true';
const previewToken = import.meta.env.PUBLIC_PREVIEW_TOKEN || '';

interface Props {
  title: string;
  description?: string;
  /** Open Graph image URL. Defaults to the page's generated card in public/og/. */
  ogImage?: string;
  /** The image's real size, when it is not a generated 1200x630 card. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** What the share image shows. Defaults to naming the page's generated card. */
  ogImageAlt?: string;
  /** The 404: it is at no one address, so it declares no canonical and no og:url. */
  notFound?: boolean;
  /** Override the default og:type. Case study pages set "article". */
  ogType?: 'website' | 'article';
  /** Page-specific schema.org nodes, added to the site-wide @graph. */
  schemas?: Node[];
  /** Breadcrumb trail after Home, for nested pages. */
  breadcrumbs?: Crumb[];
  /** The JSON-LD page type: WebPage unless set. */
  pageType?: 'WebPage' | 'CollectionPage';
  /** Keep this page out of search results (robots noindex). Pair it with the
      sitemap filter in astro.config.mjs. */
  noindex?: boolean;
  /** The top line sits on a client's color (the case studies). */
  onColor?: boolean;
  /** Inline style on <body>: the case studies set the client's colors here. */
  bodyStyle?: string;
}
const {
  title,
  description = 'Nixon Creative Studio',
  ogImage,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageAlt,
  notFound = false,
  ogType = 'website',
  schemas = [],
  breadcrumbs = [],
  pageType,
  noindex = false,
  onColor = false,
  bodyStyle,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).toString();

// Per-page Open Graph card. Derived from the pathname to match the images written
// to public/og/ by scripts/generate-og.mjs ('' becomes 'index'). An explicit
// ogImage prop still overrides.
const ogSlug = Astro.url.pathname.replace(/^\/+|\/+$/g, '') || 'index';
const resolvedOgImage = ogImage ?? `/og/${ogSlug}.png`;
const ogImageUrl = new URL(resolvedOgImage, site.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {!notFound && <link rel="canonical" href={canonical} />}

    {/* Favicon set: the white N on studio blue. public/favicon.svg is the source;
        npm run icons writes the rest from it. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f5f5f3" />

    {(comingSoonEnabled || noindex) && <meta name="robots" content="noindex, follow" />}

    {/* The blocking gate script itself lives in ComingSoonGate.astro (a <script>
        cannot sit inside this expression: prettier-plugin-astro cannot parse it). */}
    {comingSoonEnabled && <ComingSoonGate previewToken={previewToken} />}

    <!-- RSS auto-discovery. -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.studioName}: Case Studies`}
      href="/rss.xml"
    />

    <!-- Open Graph + Twitter card meta. -->
    <meta property="og:type" content={ogType} />
    {!notFound && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt ?? `Share card: ${title}`} />
    <meta property="og:site_name" content={site.studioName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Marks that scripts run, before first paint, so CSS can gate the entrances
         on .js. Without JavaScript the class is absent and everything is simply there. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <!-- The one typeface, self-hosted. Starts with the HTML so text is laid out in
         its real metrics from the first paint. -->
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/hanken.woff2" crossorigin />

    <!-- Cloudflare Web Analytics and GA4. Each renders only when its env var is set. -->
    <Analytics />

    <!-- schema.org JSON-LD: one connected @graph per page. -->
    <StructuredData
      url={canonical}
      title={title}
      description={description}
      breadcrumbs={breadcrumbs}
      extra={schemas}
      pageType={pageType}
    />
  </head>
  <body style={bodyStyle}>
    <!--
      Hello, curious visitor. This site is custom-built by Nathan Nixon on Astro and
      Cloudflare, no page builder and no template. How it is made: /colophon/. Want one
      like it: /contact/.
    -->
    <TopLine onColor={onColor} />
    {/* The dock is fixed, so nothing moves on screen: above main it comes straight after the
        skip link in the tab order, where a nav belongs, rather than dozens of stops down. */}
    <Dock />
    <main id="main">
      <slot />
    </main>
    <ClientSheet />

    {comingSoonEnabled && (
      <div class="ncs-overlay" aria-label="Launching soon">
        <ComingSoon />
      </div>
    )}

    <script>
      import '../scripts/kit.js';
      // Mailto fallback: a click with no mail app copies the address and says so.
      import '../scripts/mailto-fallback';
      // GA4 events: a no-op unless the GA tag defined window.gtag. See src/lib/track.ts.
      import { initTracking } from '../lib/track';
      initTracking();
    </script>
    <!-- A quiet hello in the console for anyone who opens dev tools. -->
    <script is:inline>
      console.log(
        '%cNixon Creative Studio',
        'font: 600 16px ui-sans-serif, system-ui; color: #2f3fe6;',
      );
      console.log(
        'Hand-built on Astro and Cloudflare. How it is made: /colophon/  ·  Want one like it: /contact/',
      );
    </script>
  </body>
</html>
